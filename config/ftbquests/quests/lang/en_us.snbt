	quest.4D4B88AE8272D8F4.quest_subtitle: "Catch 35 unique fish"
	quest.4D5DD939E3B0E80D.quest_desc: ["Make a Pumpkin Milkshake and fill a bucket with it. It is a seasonal treat with an autumn flavor for your milkshake collection."]
