	quest.433863879CFD076B.quest_desc: ["The Basic Fluid Tank can hold up to 14000mB of fluids. It can double as a bucket by switching its mode to bucket mode."]
	quest.433863879CFD076B.quest_subtitle: "Obtain Basic Fluid Tank"
	quest.434D23129E54AAB9.quest_desc: ["Extracts Spawner Cores from Vanilla Spawners. Be ready for a challenge…."]
