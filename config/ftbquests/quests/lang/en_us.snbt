	quest.5EB89B994640BB45.quest_desc: ["The Incubator is a small multiblock used to recombine Principles of matter into objects. It is composed of one of each vessel type placed on the sides - Salt, Sulfur, and Mercury - the Incubator itself, and a source of heat, in this case a Pyromantic Brazier, below."]
	quest.5EB89B994640BB45.quest_subtitle: "Obtain Incubator, Incubator Mercury Vessel, Incubator Sulfur Vessel and 2 more items"
	quest.5EBB6D61B6319A8A.quest_desc: ["This quest asks for Piston Extension Pole. EMI shows the recipe if you press R while hovering over it."]
	quest.5EBB6D61B6319A8A.quest_subtitle: "Obtain Piston Extension Pole"
