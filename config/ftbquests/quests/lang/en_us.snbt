	quest.062557BB3627030F.quest_desc: ["Robotic Arms are ways to automatically move things around within a machine. These can be very complex components and thus are made of Steel to stay strong and prevent internal damage. You should automate these."]
	quest.062557BB3627030F.quest_subtitle: "Obtain Robot Arm"
	quest.062557BB3627030F.title: "Robotic Arms"
	quest.062990FC54A64086.quest_desc: ["Finish your Steeleaf tool set by crafting the Steeleaf Hoe and Steeleaf Shovel from Steeleaf." "They combine the toughness of steel with Twilight Forest magic and make farming and clearing dirt and gravel quicker."]
	quest.062990FC54A64086.quest_subtitle: "Obtain Steeleaf Shovel and Steeleaf Hoe"
	quest.062990FC54A64086.title: "Steeleaf Farming Tools"
	quest.0646E9C66008AEC7.quest_desc: ["An Energy Cube is an advanced type of battery that is compatible with multiple energy systems. An upgraded version of the Elite Energy Cube."]
	quest.0646E9C66008AEC7.quest_subtitle: "Obtain Ultimate Energy Cube"
	quest.0650B75F3E47F798.quest_desc: ["Has a chance to not use durability."]
	quest.0650B75F3E47F798.quest_subtitle: "Obtain Iron Hook"
	quest.065E318C78569F9D.quest_desc: ["Purple Chalk is common in rituals that bind spirits into objects."]
	quest.065E318C78569F9D.quest_subtitle: "Obtain Chalk Purple Impure"
	quest.066CC09B798DD4F8.quest_desc: ["The Wand of Teleportation is a utility item from Eternal Starlight that lets you change your position within the dimension."]
	quest.066CC09B798DD4F8.quest_subtitle: "Obtain Wand of Teleportation"
	quest.066CC09B798DD4F8.title: "Wand Of Teleportation"
