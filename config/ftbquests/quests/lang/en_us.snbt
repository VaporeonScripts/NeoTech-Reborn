	quest.5181194EE635D762.quest_desc: ["Moves items from the backpack into an inventory you sneak and right-click."]
	quest.5181194EE635D762.quest_subtitle: "Obtain Deposit Upgrade"
	quest.51923E16358CAEA6.quest_desc: ["Use the Charger to charge Certus Quartz. Charged Certus is an important ingredient for Fluix and other AE2 components."]
	quest.51923E16358CAEA6.title: "Charge Certus Quartz"
	quest.51AD0B9A21D4FC9A.quest_desc: ["Combine two Flawless Gems of the same type and rarity at the Gem Cutting Table to create a Perfect Gem, the highest possible Purity."]
	quest.51AD0B9A21D4FC9A.quest_subtitle: "Obtain Smart Filter"
