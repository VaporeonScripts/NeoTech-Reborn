	quest.42109075C0A25655.quest_desc: ["This unit allows you to add the &#00D9FFFortune Enchantment&r to your &#00D9FFMekaTool&r. It basically provides more drops per ore mined. You can stack it to 3."]
	quest.42109075C0A25655.quest_subtitle: "Obtain Module Fortune Unit"
	quest.42143EA2B5C62F62.quest_desc: ["Bring &#00D9FFStuffed Pumpkin&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.42143EA2B5C62F62.quest_subtitle: "Obtain Stuffed Pumpkin"
	quest.42162C6248690A73.quest_desc: ["This quest asks for &#00D9FFScroll&r. EMI shows the recipe if you press R while hovering over it."]
	quest.42162C6248690A73.quest_subtitle: "Obtain Scroll"
	quest.42181284A31A5165.quest_desc: ["Tier Installers are used to upgrade various machines into their &#00D9FFFactory&r equivalent. Right-click on the machine with the &#00D9FFTier Installer&r and it will upgrade that machine. its level (&#00D9FFBasic&r, Advanced, or &#00D9FFElite&r) depending on the level of the &#00D9FFTier Installer&r used."]
	quest.42181284A31A5165.quest_subtitle: "Obtain Elite Tier Installer"
	quest.421A6CCE09FF7F0C.quest_desc: ["Use this to record your glyphs."]
	quest.421A6CCE09FF7F0C.quest_subtitle: "Obtain Annotated Codex"
	quest.421AFA4CE29C4436.quest_desc: ["The &#00D9FFGuide&r is your collection log for everything fishing, from rare fish to shiny trophies."]
	quest.421AFA4CE29C4436.quest_subtitle: "Get the Starcatcher's Guide"
	quest.421AFA4CE29C4436.title: "Starcatcher's Guide"
	quest.421F14535BF99CEF.quest_desc: ["Bring &#00D9FFStratus Helmet&r, &#00D9FFStratus Chestplate&r, &#00D9FFStratus Leggings&r and 2 more items into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.421F14535BF99CEF.quest_subtitle: "Obtain Stratus Helmet, Stratus Chestplate, Stratus Leggings and 2 more items"
	quest.421F14535BF99CEF.title: "Cover Me in Sunshine"
	quest.421F73A5E2956E4E.quest_desc: ["While bearing some similarity to the &#00D9FFFluix ME Covered Cable&r in appearance, they provide diagnostic function by visualizing the channel usage on the cables, the channels appear as lit colored lines that run along the black stripe on the cables giving you an understanding of how your channels are being used on your network. The first four channels show as lines matching the color of the cable, the next four show as white lines."]
	quest.421F73A5E2956E4E.quest_subtitle: "Obtain Fluix Smart Cable"
	quest.421F73A5E2956E4E.title: "Fluix Smart Cable"
	quest.422038A57A98E578.quest_desc: ["Creepers avoid the wearer."]
	quest.422038A57A98E578.quest_subtitle: "Obtain Kitty Slippers"
	quest.4223BF97E3C79811.quest_desc: ["Craft &#00D9FFthe Ignitium Elytra Chestplate&r from &#FFA500Cataclysm&r." "It combines an &#00D9FFIgnitium Chestplate's&r protection with the flight of an &#00D9FFElytra&r, and is one of the strongest pieces made from &#00D9FFIgnis'&r metal."]
	quest.4223BF97E3C79811.quest_subtitle: "Obtain Ignitium Chestplate and Ignitium Elytra Chestplate"
	quest.423B9402EE6E71DD.quest_desc: ["Remember this: &#00D9FFLarge Cogwheel&r drives small = higher rpm. Small drives big = lower rpm. &#00D9FFLarge and Small&r sharing a shaft = no rpm change."]
	quest.423B9402EE6E71DD.quest_subtitle: "Obtain Cogwheel and Large Cogwheel"
	quest.4247CEF103B52481.quest_desc: ["Bring &#00D9FFYellow Meranti Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.4247CEF103B52481.quest_subtitle: "Obtain Yellow Meranti Sapling"
	quest.424DDEC8E79F1254.quest_desc: ["This quest asks for &#00D9FFFiery Ingot Seeds&r. EMI shows the recipe if you press R while hovering over it."]
	quest.424DDEC8E79F1254.quest_subtitle: "Obtain Fiery Ingot Seeds"
	quest.4255579365AD7B81.quest_desc: ["Simple version: clicks the facing target with left, right or hold clicks, with sneak-click toggle, selectable target category and orientation, and redstone sensitivity options. Advanced version: adds filtering and offset AOE, can charge inserted equipment, and needs power."]
	quest.4255579365AD7B81.quest_subtitle: "Obtain Smart Filter"
	quest.425CEAA9CA5DA690.quest_desc: ["Variants to find: &#00D9FFBirch&r, &#00D9FFDesert&r, &#00D9FFJungle&r, &#00D9FFMangrove&r, Oak, &#00D9FFSavanna&r, &#00D9FFSnowy and Taiga&r."]
	quest.425CEAA9CA5DA690.quest_subtitle: "Find all 8 Mansion variants"
