	quest.5B52F8FCFF692B78.quest_subtitle: "Obtain Heavy Chain Necklace"
	quest.5B563B6A8ED067A5.quest_desc: ["This quest asks for Lawson Cypress Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.5B563B6A8ED067A5.quest_subtitle: "Obtain Lawson Cypress Sapling"
