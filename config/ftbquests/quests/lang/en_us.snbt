	quest.3AC89BD7683ED8D1.quest_subtitle: "Obtain Blockbreakert1"
	quest.3AC95C4FF910D68A.quest_desc: ["Use this tablet to create magical helpers to include the weald walker and amethyst golem."]
	quest.3AC95C4FF910D68A.quest_subtitle: "Obtain Ritual Awakening"
	quest.3ACF0EAC5C5CEAB0.quest_desc: ["Divination Rods locate valuable blocks from afar. Sneak-use the rod on a block to attune it, then charge it up to send a particle toward the nearest matching block, which uses durability. Use it normally to ping that location again. The gem turns more purple the closer you get." "The Glass Rod is the cheapest and only locates Abundant and Common blocks."]
	quest.3ACF0EAC5C5CEAB0.quest_subtitle: "Obtain Divination Rod T1"
	quest.3B0687AFEC997D89.quest_desc: ["This quest asks for Relic Experience Bottle. EMI shows the recipe if you press R while hovering over it."]
