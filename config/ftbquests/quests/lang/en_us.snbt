	quest.40EF421A1673BED6.quest_subtitle: "Obtain Mithril Scrap"
	quest.40F1800B8526827B.quest_desc: ["Break Ender Ore, found in many End biomes, to get Ender Shards." "Craft End Dust from them in an Anvil. They are also needed for the Eternal Crystal Infusion Ritual."]
	quest.40F1800B8526827B.quest_subtitle: "Obtain Ender Shard"
	quest.4103A339CA4439F9.quest_desc: ["It needs a Raven Feather, Glowstone Dust and Torchberries."]
	quest.4103A339CA4439F9.quest_subtitle: "Craft the Magic Map Focus"
	quest.4103A339CA4439F9.title: "With Fire It Writes"
