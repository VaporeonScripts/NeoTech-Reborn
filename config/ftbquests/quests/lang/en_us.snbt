	quest.075E928BF17CFB99.quest_subtitle: "Obtain Tenacious Petal"
	quest.075E928BF17CFB99.title: "Tenacious Petal"
	quest.075ECACCF45B7B90.quest_desc: ["Fires up your Blaze Burners to new highs."]
	quest.075ECACCF45B7B90.quest_subtitle: "Obtain Blaze Cake"
	quest.076855CC603B3A6F.quest_desc: ["This quest asks for Beliy Naliv Apple Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.076855CC603B3A6F.quest_subtitle: "Obtain Beliy Naliv Apple Sapling"
