	quest.426281CA792DE329.quest_subtitle: "Obtain Pumpkin Soup"
	quest.42661369E4C2C36A.quest_desc: ["To find the &#00D9FFLunar Monstrosity&r, hold the &#00D9FFSeeking Eye&r in your main hand and a matching item in your off-hand. The Eye will then point to the &#00D9FFCursed Garden&r where the boss lives." "Valid items: Vines, &#00D9FFLunar Berries&r, &#00D9FFCave Moss&r (block or carpet), Red or &#00D9FFBlue Crystal Moss&r (block or carpet), and Red or &#00D9FFBlue Crystal Roots&r."]
	quest.42661369E4C2C36A.quest_subtitle: "Obtain Smart Filter"
