	quest.3C3F8AF9841A1D11.title: "The two Cores"
	quest.3C4D234ED85FC063.quest_desc: ["Upgrades a Basic or Copper storage to Iron tier."]
	quest.3C4D234ED85FC063.quest_subtitle: "Obtain Basic to Iron Tier Upgrade and Copper to Iron Tier Upgrade"
	quest.3C4D234ED85FC063.title: "Iron Tier Upgrade"
