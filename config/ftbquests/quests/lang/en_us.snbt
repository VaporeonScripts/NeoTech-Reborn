	quest.54912D3E3E21B31D.quest_subtitle: "Obtain Fire Essence"
	quest.54969178967229F2.quest_desc: ["Earn the advancement: Hill3."]
	quest.54969178967229F2.quest_subtitle: "Defeat a Twilight Wraith in a large Hollow Hill"
