	quest.1D5501CAEAF15FC5.quest_subtitle: "Obtain Battery Basic"
	quest.1D5B3CAA6D3A5FB7.quest_desc: ["Archevoker Boots are part of the Archevoker Armor set in Iron's Spells 'n Spellbooks. They give +3 Armor, +125 Max Mana, +10% Evocation Spell Power and +5% Spell Power." "Make them from 1 Wizard Boots, 1 Evocation Rune and 1 Arcane Essence."]
	quest.1D5B3CAA6D3A5FB7.quest_subtitle: "Obtain Archevoker Boots"
	quest.1D6719170DB0E21E.quest_desc: ["Icy Fang is a crafting material in Iron's Spells 'n Spellbooks, dropped by the Ice Spider. It can be processed into Mithril Scrap." "It is a step toward mithril equipment and other advanced magical crafting."]
	quest.1D6719170DB0E21E.quest_subtitle: "Obtain Icy Fang"
	quest.1D7CF9865A661477.quest_desc: ["Used for conversion and output of potions."]
	quest.1D7CF9865A661477.quest_subtitle: "Obtain Potion Melder"
