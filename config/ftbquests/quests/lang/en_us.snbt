	quest.025B156068AD8570.quest_desc: ["The Waxed Hoglin Trophy is a preserved version of the Hoglin Trophy from My Nether's Delight. The wax protects it, so it makes a lasting decoration for your base."]
	quest.025B156068AD8570.quest_subtitle: "Obtain Waxed Hoglin Trophy"
	quest.025B973C8F1C68E1.quest_desc: ["Get hold of Unassembled Pcb. Hover over it in EMI and press R to see how it is made."]
	quest.025B973C8F1C68E1.quest_subtitle: "Obtain Unassembled Pcb"
	quest.025E6B68BB357C2A.quest_desc: ["Bring Shadowsting into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.025E6B68BB357C2A.quest_subtitle: "Obtain Shadowsting"
	quest.02674667B7D47E42.quest_desc: ["The Runic Tablet is a mysterious item tied to the ancient runes of Simply Swords. Its purpose connects to the mod's unique weapons and magic."]
	quest.02674667B7D47E42.quest_subtitle: "Obtain Runic Tablet"
	quest.026FC31ABA2CD5DA.quest_desc: ["Chipped greatly expands decorative variants for many block families. Use its workstations to browse the available styles and personalize your builds."]
	quest.026FC31ABA2CD5DA.title: "Getting Started"
	quest.027479F050E443BF.quest_desc: ["Get hold of Forge Hammer. Hover over it in EMI and press R to see how it is made."]
	quest.027479F050E443BF.quest_subtitle: "Obtain Forge Hammer"
	quest.027479F050E443BF.title: "Forged!"
	quest.027A197AF3241F85.quest_desc: ["This Rod can locate Precious materials, and has far superior durability."]
	quest.027A197AF3241F85.quest_subtitle: "Obtain Divination Rod T4"
	quest.027B0CC766DB4A9C.quest_desc: ["These are pylons designed to outline the volume you wish to store into spatial drives. You must use these to outline 3 edges to an imaginary box surrounding the build. Each line of them uses 1 channel and each line needs to be at at least 2 pylons long. Try experimenting with the number of lines and how much power it uses! You might be able to optimize your digitizing."]
	quest.027B0CC766DB4A9C.quest_subtitle: "Obtain Spatial Pylon"
	quest.027B0CC766DB4A9C.title: "Spatial Pylon"
	quest.02963979BBAA3050.quest_desc: ["Get hold of Ferricore Boots. Hover over it in EMI and press R to see how it is made."]
	quest.02963979BBAA3050.quest_subtitle: "Obtain Ferricore Boots"
	quest.029E8FC235C1117E.quest_desc: ["Get hold of Knightmetal Sword, Knightmetal Pickaxe and Knightmetal Axe. Hover over it in EMI and press R to see how it is made."]
	quest.029E8FC235C1117E.quest_subtitle: "Craft Knightmetal tools"
	quest.02CAC3E0CBFF241E.quest_desc: ["Raw Amaramber can be refined into ingots in Eternal Starlight." "These hold concentrated starlight energy and go into stronger equipment and advanced crafting, so your first Amaramber Ingot is a big step."]
	quest.02CAC3E0CBFF241E.quest_subtitle: "Obtain Amaramber Ingot"
	quest.02CAC3E0CBFF241E.title: "Amaramber Ingot"
	quest.02CE3C394159EDF4.quest_desc: ["The vanilla Netherite Upgrade Smithing Template is also needed for several late-game Better End recipes." "You will use it together with Aeternium materials for some of the mod's strongest tools and weapons."]
	quest.02CE3C394159EDF4.quest_subtitle: "Obtain Netherite Upgrade Smithing Template"
	quest.02DC100ACB25CBA8.quest_desc: ["The Ignis Music Disc from Cataclysm is a rare disc dropped by Ignis, the ruler of the Burning Arena." "Keep it as proof of your victory."]
	quest.02DC100ACB25CBA8.quest_subtitle: "Obtain Music Disc Ignis"
	quest.02E5089FC1A73285.quest_desc: ["The Energy Sword is a special late-game weapon from Eternal Starlight." "Its blade is infused with concentrated dimensional energy, making it one of the stronger weapons in the mod."]
	quest.02E5089FC1A73285.quest_subtitle: "Obtain Energy Sword"
	quest.02E5089FC1A73285.title: "Energy Sword"
	quest.02E810A2D58CBEC3.quest_desc: ["This quest asks for Skeleton Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.02E810A2D58CBEC3.quest_subtitle: "Obtain Skeleton Seeds"
	quest.02E991CBB6AB992B.quest_desc: ["Bring Dragon Blood Vial into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.02E991CBB6AB992B.quest_subtitle: "Obtain Dragon Blood Vial"
	quest.02EB96EA4A64DA01.quest_desc: ["Crafted with 4 Fluix Crystals in a 2x2 pattern you will obtain a Fluix Block."]
	quest.02EB96EA4A64DA01.quest_subtitle: "Obtain Fluix Block"
	quest.03002257490538C8.quest_desc: ["Bring Configurable Honeycomb into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.03002257490538C8.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.0305F6BC214119CF.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.0305F6BC214119CF.quest_subtitle: "Obtain Glyph Projectile"
	quest.03111EB3457F9F75.quest_desc: ["Get hold of Blank Card. Hover over it in EMI and press R to see how it is made."]
	quest.03111EB3457F9F75.quest_subtitle: "Obtain Blank Card"
	quest.0312FBF9DE73FB5B.quest_desc: ["The leggings of the Ironwood armor set. Together with the chestplate, they unlock the helmet."]
	quest.03259AC69C0167C8.quest_desc: ["Monster Plus adds new hostile creatures and encounters. Stay alert while exploring and adapt your equipment to the threats you meet."]
	quest.03259AC69C0167C8.title: "Getting Started"
	quest.0337113F58D9ED70.quest_desc: ["Induction Cells provide the bulk storage of the battery. Capacity: 204.80 GFE."]
	quest.0337113F58D9ED70.quest_subtitle: "Obtain Elite Induction Cell"
	quest.033FDEA602740088.quest_desc: ["This quest asks for Osage Orange Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.033FDEA602740088.quest_subtitle: "Obtain Osage Orange Sapling"
	quest.035DAAC67D4337B8.quest_desc: ["The Thallasium Hoe is a farming tool forged from Thallasium Ingots for tilling farmland." "It is part of Better End's earliest tool tier."]
	quest.035DAAC67D4337B8.quest_subtitle: "Obtain Thallasium Hoe"
	quest.036692B9714892B7.quest_desc: ["A crafting component for the Rainbow Furnace."]
	quest.036692B9714892B7.quest_subtitle: "Obtain Rainbow Plating"
	quest.0367109A7050BA27.quest_desc: ["By simply placing down the Altar it will display how you need to place the pedestals."]
	quest.0367109A7050BA27.quest_subtitle: "Obtain Infusion Altar and 8x Infusion Pedestal"
	quest.0367109A7050BA27.title: "Infusion Altar and Pedestals"
	quest.0372F307B2B6D926.quest_desc: ["Simple redstone control for drive Shafts or Cogwheels."]
	quest.0372F307B2B6D926.quest_subtitle: "Obtain Clutch"
	quest.03739A6021AC1FC2.quest_desc: ["The Jukebox Upgrade lets you play music discs straight from your storage, so you do not need a separate jukebox." "The Advanced Jukebox Upgrade adds more control over your discs and playback."]
	quest.03739A6021AC1FC2.quest_subtitle: "Obtain Jukebox Upgrade and Advanced Jukebox Upgrade"
	quest.03739A6021AC1FC2.title: "Jukebox and Advanced Jukebox Upgrade"
	quest.03820542940AABD6.quest_desc: ["Make a Vanilla Milkshake and fill a bucket with it. It is one of the milkshakes in Create: Dreams n' Desires and also appears in some of the mod's more elaborate fluid recipes."]
	quest.03820542940AABD6.quest_subtitle: "Obtain Vanilla Milkshake Bucket"
	quest.03A378D31005B99D.quest_desc: ["Archwood trees generate in every biome, most commonly in the Archwood Forest. The base mod has 4 archwood types."]
	quest.03A378D31005B99D.quest_subtitle: "Obtain Smart Filter"
	quest.03A378D31005B99D.title: "Archwood Logs"
	quest.03A91D89E7C4153D.quest_desc: ["You can use substrate, water, and liquid ethylene in a Pressurized Reaction Chamber to make an HDPE Pellet. These pellets are used to make sheets and rods, which make various blocks, machines, and upgrades."]
	quest.03A91D89E7C4153D.quest_subtitle: "Obtain Hdpe Pellet"
	quest.03AFD7996A27511C.quest_desc: ["Craft a Black Steel Sword from Cataclysm. It deals heavy damage against dangerous enemies and belongs to the Black Steel equipment set."]
	quest.03AFD7996A27511C.quest_subtitle: "Obtain Black Steel Sword"
	quest.03B6ED82B0291F4D.quest_desc: ["The soft fur keeps you safe from the Glacier's cold."]
	quest.03B6ED82B0291F4D.quest_subtitle: "Line your gear with Alpha Yeti Fur"
	quest.03B6F3FCD19E2413.quest_desc: ["Bring Thread Chilling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.03B6F3FCD19E2413.quest_subtitle: "Obtain Thread Chilling"
	quest.03CB77A6DA0228B2.quest_desc: ["This quest asks for Hot Cream Cone. EMI shows the recipe if you press R while hovering over it."]
	quest.03CB77A6DA0228B2.quest_subtitle: "Obtain Hot Cream Cone"
	quest.03D230EA5473B03F.quest_desc: ["Get hold of Music Disc Wait. Hover over it in EMI and press R to see how it is made."]
	quest.03D230EA5473B03F.quest_subtitle: "Obtain Music Disc Wait"
	quest.03DA423C597944B9.quest_desc: ["Bring Roller Skate into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.03DA423C597944B9.quest_subtitle: "Obtain Roller Skate"
	quest.03DA5DD590484294.quest_desc: ["Induction Cells provide the bulk storage of the battery. Capacity: 3.2 GRF."]
	quest.03DA5DD590484294.quest_subtitle: "Obtain Basic Induction Cell"
	quest.03DACD9B79FA1E57.quest_desc: ["For only a measly 8EU/t, the Steam Farmer can perform the following things: Tilling: When enabled, dirt blocks will be turned into farmland. This will not work unless water is supplied. Hydrating: When supplied with water, tilled soil will be hydrated. Harvesting: When there is enough output space provided, it will harvest fully grown crops and trees. Plating: When supplied with crops or saplings, it will plant them on valid soil. Using different plating modes will plant them in different arrangements."]
	quest.03DACD9B79FA1E57.quest_subtitle: "Obtain Steam Farmer, 7x Bronze Machine Casing Pipe and 26x Bronze Plated Bricks"
	quest.03E0202A37564A13.quest_desc: ["This quest asks for Tertium Farmland. EMI shows the recipe if you press R while hovering over it."]
	quest.03E0202A37564A13.quest_subtitle: "Obtain Tertium Farmland"
	quest.03E882FF1F52E0F5.quest_desc: ["Get hold of Upgrade Gold2. Hover over it in EMI and press R to see how it is made."]
	quest.03E882FF1F52E0F5.quest_subtitle: "Obtain Upgrade Gold2"
	quest.03EB5B8E01725CEE.quest_desc: ["Bring Large Steam Boiler into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.03EB5B8E01725CEE.quest_subtitle: "Obtain Large Steam Boiler"
	quest.03EB5B8E01725CEE.title: "Kiss Your Fuel Goodbye!"
	quest.040631F1D08D19EA.quest_desc: ["Brassy on the edges, but classy-not-brassy all over."]
	quest.040631F1D08D19EA.quest_subtitle: "Obtain Brass Casing"
	quest.041C6B1A87A4492E.quest_desc: ["This quest asks for Piranha Bucket. EMI shows the recipe if you press R while hovering over it."]
	quest.041C6B1A87A4492E.quest_subtitle: "Obtain Piranha Bucket"
	quest.042E1D71D486A576.quest_desc: ["The Starlit Diamond Pickaxe is a late-game mining tool made from Starlit Diamond materials." "It mines much more efficiently than Glacite and Springstone tools and is the last step before celestial weapon progression."]
	quest.042E1D71D486A576.quest_subtitle: "Obtain Starlit Diamond Pickaxe"
	quest.0439891C7681967A.quest_desc: ["Automates the furnace using items from the storage."]
	quest.0439891C7681967A.quest_subtitle: "Obtain Auto Smelting Upgrade"
	quest.044C58AB635DD2B8.quest_desc: ["Gives more control over when to use potions, milk buckets, or food with effects."]
	quest.044C58AB635DD2B8.quest_subtitle: "Obtain Advanced Alchemy Upgrade"
	quest.044E89EDFE34FE6C.quest_desc: ["Sulfur can be obtained by mining the ore underground, or by processing gunpowder with oxygen in a chemical injection chamber. You will need to make Sulfuric Acid with this sulfur."]
	quest.044E89EDFE34FE6C.quest_subtitle: "Obtain Dust Sulfur"
	quest.044FAE6E9C0D85A4.quest_desc: ["This quest asks for Coral Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.044FAE6E9C0D85A4.quest_subtitle: "Obtain Coral Seeds"
	quest.04546DD184DA76B1.quest_desc: ["The Elite Fluid Tank is an upgraded version of the Advanced Fluid Tank that can hold 56000 mB of liquid. You can toggle its Bucket Mode on and off by shift-right clicking while holding it. When Bucket Mode is on it can collect water and lava like a bucket. When Bucket Mode is off it can be placed like a block so you can attach Mechanical Pipe to it."]
	quest.04546DD184DA76B1.quest_subtitle: "Obtain Elite Fluid Tank"
	quest.04680DFFB36F4C48.quest_desc: ["Tier 2 glyph. Craft it at the Scribe\'s Table."]
	quest.04680DFFB36F4C48.quest_subtitle: "Obtain Glyph Dampen"
	quest.046BAD21D9397B5C.quest_desc: ["The Annihilation Plane will break blocks and pick up items directly in front of it."]
	quest.046BAD21D9397B5C.quest_subtitle: "Obtain Annihilation Plane and Formation Plane"
	quest.046BAD21D9397B5C.title: "ME Planes"
	quest.0479BA53DFA3BCD2.quest_desc: ["Common resources are somewhat scarcer than their Abundant counterparts, but are still relatively easy to find."]
	quest.0479BA53DFA3BCD2.quest_subtitle: "Obtain Alchemical Sulfur Osmium, Alchemical Sulfur Nickel, Alchemical Sulfur Lead and 6 more items"
	quest.0479BA53DFA3BCD2.title: "Common Sulfurs"
	quest.0480A2ACBE05260F.quest_desc: ["The Accumulator from Create Crafts and Additions is an energy storage block for Forge Energy (FE). Connect it to your network to save power for later, which is handy for buffering between generators and machines with uneven demand. The current NeoForge 1.21.1 release of the mod is 1.6.0."]
	quest.0480A2ACBE05260F.quest_subtitle: "Obtain Modular Accumulator"
	quest.0483D05FCF6C526D.quest_desc: ["Adds a crafting grid to the storage."]
	quest.0483D05FCF6C526D.quest_subtitle: "Obtain Crafting Upgrade"
	quest.04A2E1F7B34D5290.quest_desc: ["Rare Ink is the third tier of magical ink in Iron's Spells 'n Spellbooks. It is used in the Scroll Forge to make Rare-rarity spell scrolls, and in the Arcane Anvil to upgrade scrolls that need Rare Ink." "You can find it in magic structures or get it from powerful magical creatures."]
	quest.04A2E1F7B34D5290.quest_subtitle: "Obtain Rare Ink"
	quest.04A2E1F7B34D5290.title: "Rare Ink"
	quest.04A8C232EA825D63.quest_desc: ["Get hold of Battlemage Hood, Battlemage Robes, Battlemage Leggings and Battlemage Boots. Hover over it in EMI and press R to see how it is made."]
	quest.04A8C232EA825D63.quest_subtitle: "Obtain Battlemage Hood, Battlemage Robes, Battlemage Leggings and Battlemage Boots"
	quest.04C442B1564F13F7.quest_desc: ["Craft a Lightning Rod. It protects your structures from lightning strikes."]
	quest.04C442B1564F13F7.quest_subtitle: "Obtain Lightning Rod"
	quest.04C442B1564F13F7.title: "Catch the Lightning"
	quest.04CCFA4A76886726.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.04CCFA4A76886726.quest_subtitle: "Obtain Glyph Amplify"
	quest.04D17D4625DA1C77.quest_desc: ["A Mekanism machine upgrade to make them process items faster each Mekanism machine can store 8 of these upgrades."]
	quest.04D17D4625DA1C77.quest_subtitle: "Obtain Upgrade Speed"
	quest.04DD255BCC082736.quest_desc: ["Bring Brown Shrooma into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.04DD255BCC082736.quest_subtitle: "Obtain Brown Shrooma"
	quest.04E52A67D5351CFD.quest_desc: ["Bring Music Disc 5 into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.04E52A67D5351CFD.quest_subtitle: "Obtain Music Disc 5"
	quest.04F28F76877D5CBB.quest_desc: ["Bring Mandarin Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.04F28F76877D5CBB.quest_subtitle: "Obtain Mandarin Sapling"
	quest.04F6758F8F06F5B0.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.04F6758F8F06F5B0.quest_subtitle: "Obtain Elite Injecting Factory"
	quest.04F8E790B6B969C1.quest_desc: ["The Calculation Processor is made in an Inscriber from a Printed Calculation Circuit, Printed Silicon and Redstone. It is used for storage cells, crafting storage and more."]
	quest.04FBB7D8C2789148.quest_desc: ["The Advanced Solar Generator is a highly upgraded version of the basic Solar Generator. Construction of an Advanced Solar Generator requires four Solar Generators, but it produces six times the power of its smaller cousin. It also requires an area of 3x3x3 Blocks in order to be placed."]
	quest.04FBB7D8C2789148.quest_subtitle: "Obtain Advanced Solar Generator"
	quest.04FCE3DA39375B25.quest_desc: ["Compacts items into their compressed variants. Only 2x2 recipes."]
	quest.04FCE3DA39375B25.quest_subtitle: "Obtain Compacting Upgrade"
	quest.050589083FF5E743.quest_desc: ["Get hold of Anglerfish Bucket. Hover over it in EMI and press R to see how it is made."]
	quest.050589083FF5E743.quest_subtitle: "Obtain Anglerfish Bucket"
	quest.05169AACAFD296C7.quest_desc: ["These Export Buses have more advanced functionality compared to the regular Export Bus. Tag Export Bus exports items from filtered tags. Mod Export Bus exports items from filtered mods. Precise Export Bus exports the exact amount of items you set, no less, no more. Threshold Export Bus exports items when the amount of items is above/below the set threshold."]
	quest.05169AACAFD296C7.quest_subtitle: "Obtain Tag Export Bus, Mod Export Bus, Precise Export Bus and Threshold Export Bus"
	quest.05169AACAFD296C7.title: "Advanced Export Buses"
	quest.052BA8035DDE0E09.quest_desc: ["Don’t be fooled… it may appear similar to the humble cauldron, but is flexible enough to work with Belts, Fluid Pipes, and Mechanical Mixers and Presses, enabling the automation of many recipes."]
	quest.052BA8035DDE0E09.quest_subtitle: "Obtain Basin"
	quest.05334CEDD6D1FF3A.quest_desc: ["Armor Tomes limit their stored enchantments to the matching armor category, which keeps gear progression focused."]
	quest.05334CEDD6D1FF3A.quest_subtitle: "Obtain Smart Filter"
	quest.05334CEDD6D1FF3A.title: "Tomes of Armor"
	quest.053443DA1DDBC511.quest_desc: ["Uraninite is the reactor fuel."]
	quest.053443DA1DDBC511.quest_subtitle: "Obtain Uraninite"
	quest.054B83A174D0427F.quest_desc: ["The leggings of the Neptunium armor set. Together with the chestplate, they unlock the helmet."]
	quest.054D2D26D71D140A.quest_desc: ["You have reached the final step to invincibility. Armor infused with Quantum Technology to repel all physical and magical attacks. You cannot die, not even by a God's Smite. You can now fly freely without the need of electricity. This set of armor interacts directly with the quantum realm to alter space and time surrounding you. Theoretically, you sitll be stationary, and space will just be moving relative to you. --This-- is the power you wield. This sword can and will slice through anything in it's path. The edge of it's blade has the ability to cleave through time and erase any entity you choose from existence. Use this power responsibly."]
	quest.054D2D26D71D140A.quest_subtitle: "Obtain Quantum Sword, Quantum Helmet, Quantum Leggings and 2 more items"
	quest.054D2D26D71D140A.title: "Quantum Armory"
	quest.055085FE22FDA8CB.quest_desc: ["This quest asks for Wing of the Wild Stalker. EMI shows the recipe if you press R while hovering over it."]
	quest.055085FE22FDA8CB.quest_subtitle: "Obtain Wing of the Wild Stalker"
	quest.0550AA9B785EB30E.quest_desc: ["The Archevoker Hat is the headpiece of the Archevoker Armor set in Iron's Spells 'n Spellbooks. It gives +3 Armor, +125 Max Mana, +10% Evocation Spell Power and +5% Spell Power." "Craft it from 5 Arcane Cloth and 1 Evocation Rune, or upgrade a Wizard Helmet with 1 Evocation Rune at a Smithing Table."]
	quest.0550AA9B785EB30E.quest_subtitle: "Obtain Archevoker Helmet"
	quest.05544D209000FDC6.quest_desc: ["Scarecrow Leggings are part of the Scarecrow Armor set in Iron's Spells 'n Spellbooks. They give +6 Armor and +75 Max Mana." "Craft them from Hay Bales and Leather."]
	quest.05544D209000FDC6.quest_subtitle: "Obtain Pumpkin Leggings"
	quest.0561F734BC053E72.quest_desc: ["Bring Creosote Bucket into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0561F734BC053E72.quest_subtitle: "Obtain Creosote Bucket"
	quest.05675F46ECA3A99A.quest_desc: ["Adds a jukebox to the storage."]
	quest.05675F46ECA3A99A.quest_subtitle: "Obtain Jukebox Upgrade"
	quest.0568907D9675E7BA.quest_desc: ["The Productivity upgrade will increase the number of combs a bee produces per trip."]
	quest.0568907D9675E7BA.quest_subtitle: "Obtain Upgrade Productivity 3"
	quest.05779A1233579600.quest_desc: ["The Starlit Diamond Boots is crafted from Starlit Diamonds in Eternal Starlight." "Starlit Diamond armor gives protection comparable to Netherite, with higher armor toughness and knockback resistance."]
	quest.05779A1233579600.quest_subtitle: "Obtain Starlit Diamond Boots"
	quest.057C87CCBAC1E6F0.quest_desc: ["Bring Turbo Upgrade into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.057C87CCBAC1E6F0.quest_subtitle: "Obtain Turbo Upgrade"
	quest.057C87CCBAC1E6F0.title: "Gotta Go Fast"
	quest.05850E439ABECC5C.quest_desc: ["Get hold of Menril Seeds. Hover over it in EMI and press R to see how it is made."]
	quest.05850E439ABECC5C.quest_subtitle: "Obtain Menril Seeds"
	quest.0590CC808954BB66.quest_desc: ["Extracts a small sample from each pollinating bee on every visit, without hurting them."]
	quest.0590CC808954BB66.quest_subtitle: "Obtain Upgrade Gene Sampler"
	quest.059B625288CE656A.quest_desc: ["Craft the Apothic Enchanting Table and use Eterna, Quanta and Arcana to push enchanting beyond vanilla limits, up to level 100."]
	quest.059B625288CE656A.quest_subtitle: "Obtain Smart Filter"
	quest.059B625288CE656A.title: "The Secrets of Enchanting"
	quest.059D260B8D391003.quest_desc: ["The Starfire Smithing Template is a smithing item added by Eternal Starlight." "Use it at a smithing table to apply Starfire-style armor trims. In newer versions it is also needed for some Starfire weapons and gear."]
	quest.059D260B8D391003.quest_subtitle: "Obtain Starfire Upgrade Smithing Template"
	quest.059D260B8D391003.title: "Starfire Smithing Template"
	quest.05A3F4A64EC4B268.quest_desc: ["Makes the backpack pick up items within its range."]
	quest.05A3F4A64EC4B268.quest_subtitle: "Obtain Magnet Upgrade"
	quest.05A6199C5BDEE5EE.quest_desc: ["Used in Pattern Provides or Interfaces, which allows them to provide power to touching blocks/cables."]
