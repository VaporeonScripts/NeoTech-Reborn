	quest.044C58AB635DD2B8.quest_subtitle: "Obtain Advanced Alchemy Upgrade"
	quest.044E89EDFE34FE6C.quest_desc: ["Sulfur can be obtained by mining the ore underground, or by processing gunpowder with oxygen in a chemical injection chamber. You will need to make Sulfuric Acid with this sulfur."]
	quest.044E89EDFE34FE6C.quest_subtitle: "Obtain Dust Sulfur"
	quest.044FAE6E9C0D85A4.quest_desc: ["This quest asks for Coral Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.044FAE6E9C0D85A4.quest_subtitle: "Obtain Coral Seeds"
	quest.04546DD184DA76B1.quest_desc: ["The Elite Fluid Tank is an upgraded version of the Advanced Fluid Tank that can hold 56000 mB of liquid. You can toggle its Bucket Mode on and off by shift-right clicking while holding it. When Bucket Mode is on it can collect water and lava like a bucket. When Bucket Mode is off it can be placed like a block so you can attach Mechanical Pipe to it."]
	quest.04546DD184DA76B1.quest_subtitle: "Obtain Elite Fluid Tank"
	quest.04680DFFB36F4C48.quest_desc: ["Tier 2 glyph. Craft it at the Scribe\'s Table."]
	quest.04680DFFB36F4C48.quest_subtitle: "Obtain Glyph Dampen"
	quest.046BAD21D9397B5C.quest_desc: ["The Annihilation Plane will break blocks and pick up items directly in front of it."]
	quest.046BAD21D9397B5C.quest_subtitle: "Obtain Annihilation Plane and Formation Plane"
	quest.046BAD21D9397B5C.title: "ME Planes"
	quest.0479BA53DFA3BCD2.quest_desc: ["Common resources are somewhat scarcer than their Abundant counterparts, but are still relatively easy to find."]
	quest.0479BA53DFA3BCD2.quest_subtitle: "Obtain Alchemical Sulfur Osmium, Alchemical Sulfur Nickel, Alchemical Sulfur Lead and 6 more items"
