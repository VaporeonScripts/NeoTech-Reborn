	quest.42A7EB8639B4BAD2.quest_subtitle: "The sixth Bank tier"
	quest.42B6AC4E503E5F7F.quest_desc: ["Bring Mixed Ingot Iridium into your inventory. Check EMI with R on the item if you are unsure how to get it."]
