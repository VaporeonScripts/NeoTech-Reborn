	quest.42B6AC4E503E5F7F.quest_subtitle: "Obtain Mixed Ingot Iridium"
	quest.42B6AC4E503E5F7F.title: "Oreo Ingot"
	quest.42BA7939CF703CB4.quest_desc: ["This quest asks for Cloak of the Bloody Feather. EMI shows the recipe if you press R while hovering over it."]
	quest.42BA7939CF703CB4.quest_subtitle: "Obtain Cloak of the Bloody Feather"
	quest.42C397FE505CC3C9.quest_desc: ["The Jukebox Upgrade turns your backpack into a portable jukebox. You can play music discs from its upgrade tab." "The Advanced Jukebox Upgrade stores several discs and adds track switching, shuffle and repeat modes."]
	quest.42C397FE505CC3C9.quest_subtitle: "Obtain Jukebox Upgrade and Advanced Jukebox Upgrade"
