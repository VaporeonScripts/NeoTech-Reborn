	quest.657A2F7D9D62CAB9.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.659859FDDFB43D6A.quest_desc: ["Drive them with a Threshold Switch on a Vault to get a progress bar showing how full it is."]
