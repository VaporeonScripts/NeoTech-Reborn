	quest.3959498A55970754.quest_subtitle: "Obtain Processing Unit"
	quest.3959498A55970754.title: "Bitcoin Miner"
	quest.395A0D7134FE9513.quest_desc: ["Rotate components precisely. Open and close Fluid Valves. Dye-able."]
