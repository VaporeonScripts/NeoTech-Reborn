	quest.659A5309A77BDDFD.quest_desc: ["This quest asks for Graphite Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.659A5309A77BDDFD.quest_subtitle: "Obtain Graphite Seeds"
	quest.65A949B3F6F8049E.quest_desc: ["Bring Programmable Controller into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.65A949B3F6F8049E.quest_subtitle: "Obtain Programmable Controller"
	quest.65CCF4B3E7A9F67D.quest_desc: ["Upgrades a Gold tier or below to a Diamond tier."]
	quest.65CCF4B3E7A9F67D.quest_subtitle: "Obtain Basic to Diamond Tier Upgrade, Copper to Diamond Tier Upgrade, Iron to Diamond Tier Upgrade and Gold to Diamond Tier Upgrade"
	quest.65CCF4B3E7A9F67D.title: "Diamond Tier Upgrade"
	quest.65CDA8AFE4EC9F0D.quest_desc: ["Tier 2 glyph. Craft it at the Scribe\'s Table."]
	quest.65CDA8AFE4EC9F0D.quest_subtitle: "Obtain Glyph Fell"
	quest.65F921DCB4A7FCE7.quest_desc: ["Simple redstone control for reversing rotational motion. Very handy when your build needs one."]
	quest.65F921DCB4A7FCE7.quest_subtitle: "Obtain Gearshift"
	quest.65FA4A7FE399C79D.quest_desc: ["The Advanced Bin is a storage block which can hold 8192 of a single item. It will retain its inventory when broken."]
	quest.65FA4A7FE399C79D.quest_subtitle: "Obtain Advanced Bin"
	quest.662D3632D4E28C1C.quest_desc: ["The main block of the mod's storage system. Right-click it with Bookwyrm Charms to summon Bookwyrms, and each one raises the number of storages you can bind. Use the Dominion Wand to bind a storage to the Lectern. It needs no source."]
	quest.662D3632D4E28C1C.quest_subtitle: "Obtain Storage Lectern"
	quest.663B52B7C99A8858.quest_desc: ["Bio Fuel can be used for numerous things. We are after substrate."]
	quest.663B52B7C99A8858.quest_subtitle: "Obtain Bio Fuel"
	quest.663E618B3E57F6F6.quest_desc: ["Bring Imperium Sword, Imperium Pickaxe, Imperium Shovel and 2 more items into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.663E618B3E57F6F6.quest_subtitle: "Obtain Imperium Sword, Imperium Pickaxe, Imperium Shovel and 2 more items"
	quest.663E618B3E57F6F6.title: "Imperium Tools and Weaponry"
	quest.667AEEA648FABA79.quest_desc: ["This quest asks for Ender Bow. EMI shows the recipe if you press R while hovering over it."]
	quest.667AEEA648FABA79.quest_subtitle: "Obtain Ender Bow"
	quest.66954C678B1B21A1.quest_desc: ["EMI may not show this recipe because of a bug. In a Smithing Table, combine a Celestigem Pickaxe, Axe and Shovel, in that order."]
	quest.66954C678B1B21A1.quest_subtitle: "Obtain Celestigem Paxel"
	quest.6699ADB734C1C57B.quest_desc: ["A Thermopneumatic Processing Plant is used to convert liquids into other liquids. For example, combining LPG and Coal in this machine can produce Liquid Plastic. Additionally, the TPP can perform fuel cracking, where heavier fuels are transformed into lighter ones. This means: Diesel -> Kerosene. Kerosene -> Gasoline. Gasoline -> LPG."]
	quest.6699ADB734C1C57B.quest_subtitle: "Obtain Thermopneumatic Processing Plant"
	quest.66B27D8FA9533AE2.quest_desc: ["Tier 3 glyph. Craft it at the Scribe\'s Table."]
	quest.66B27D8FA9533AE2.quest_subtitle: "Obtain Glyph Summon Decoy"
	quest.66B52DD6E837486C.quest_desc: ["For packing and unpacking packages."]
	quest.66B52DD6E837486C.quest_subtitle: "Obtain Packager"
	quest.66BCA7F7CE25650E.quest_desc: ["Get hold of Brazil Nut Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.66BCA7F7CE25650E.quest_subtitle: "Obtain Brazil Nut Sapling"
