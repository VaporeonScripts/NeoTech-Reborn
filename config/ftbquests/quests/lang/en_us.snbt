	quest.0005C3D91F8DD316.quest_desc: ["The Teleporter Portal is a multi-block structure that allows the player to teleport between Teleporters on the same frequency."]
	quest.0005C3D91F8DD316.quest_subtitle: "Obtain Teleporter and 9x Teleporter Frame"
	quest.000D896537822FF3.quest_desc: ["The Fluidic Plenisher lets you fill empty spaces with any fluid you provide. Feed it a fluid and it will replace open spaces beneath it, allowing you to create entire lakes, reservoirs, or even seas of virtually any fluid. Connect it to your Mechanical Pipe network and let it do the work for you. Perfect for large-scale fluid projects - or simply making an absolutely massive pool of something that probably shouldn't be swimming in."]
	quest.000D896537822FF3.quest_subtitle: "Obtain Fluidic Plenisher"
	quest.000D896537822FF3.title: "Fluidic Plenisher"
	quest.0017A61AF0AB3F9E.quest_desc: ["The Headless Ratman steals the heads of mobs killed near it. It, then, provides you with a damage bonus against that mob type."]
	quest.0017A61AF0AB3F9E.quest_subtitle: "Earn the advancement: Familiar Headless"
	quest.004DACCD4C920845.quest_desc: ["This quest asks for Hv Diesel Generator. EMI shows the recipe if you press R while hovering over it."]
	quest.004DACCD4C920845.quest_subtitle: "Obtain Hv Diesel Generator"
	quest.004DACCD4C920845.title: "Fast and Furious 2: Revenge"
	quest.0060AB9E6885BAC9.quest_desc: ["Hydra meat is overpowered, so save it for when you are hungry."]
	quest.0060AB9E6885BAC9.quest_subtitle: "Eat Hydra meat on an empty food bar"
