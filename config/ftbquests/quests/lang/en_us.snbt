	quest.5A34F69B6E170B00.quest_subtitle: "Obtain Pocket Generator"
	quest.5A3D7080068189F4.quest_desc: ["Tier 3 glyph. Craft it at the Scribe\'s Table."]
	quest.5A3D7080068189F4.quest_subtitle: "Obtain Glyph Intangible"
	quest.5A4A78398CB1737F.quest_desc: ["Red Fertilizer speeds up crop growth."]
	quest.5A4A78398CB1737F.quest_subtitle: "A faster fertilizer for crops"
	quest.5A58AFE2E7E6BE73.quest_desc: ["Turns the wearer invisible."]
	quest.5A58AFE2E7E6BE73.quest_subtitle: "Obtain Scarf of Invisibility"
	quest.5A7A1F75252F820E.quest_desc: ["An Import Bus pulls items from an attached inventory into your ME network. Configure its filters and connect it to a chest or machine output."]
	quest.5A7A1F75252F820E.title: "Import Items into Storage"
	quest.5A7B2AA840270C1B.quest_desc: ["This quest asks for Date Palm Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.5A7B2AA840270C1B.quest_subtitle: "Obtain Date Palm Sapling"
	quest.5ABB1E1E00F4C232.quest_desc: ["With them you can.. Drive close, parallel Shafts* with the same rotation, or. Have any of them turned 90° to the others, and.. Speed doubling, or halving, with a Chain Gearshift and a touch of redstone! (* or Encased Fans, etc)."]
	quest.5ABB1E1E00F4C232.quest_subtitle: "Obtain Encased Chain Drive"
	quest.5ABE0839F7584525.quest_desc: ["Get hold of Red Shrooma. Hover over it in EMI and press R to see how it is made."]
	quest.5ABE0839F7584525.quest_subtitle: "Obtain Red Shrooma"
	quest.5AD2A23776A6102F.quest_desc: ["The handy, dandy Fluid Tank works alone or can be joined up in single-wide, 2-by-2, 3-by-3 wide columns, up to 30 blocks tall! Place it over some heat sources, pump in sufficient water, and it becomes a boiler that can power Steam Engines, a larger boiler, provided more water and heating, can drive more Steam Engines."]
	quest.5AD2A23776A6102F.quest_subtitle: "Obtain Fluid Tank"
	quest.5AD3778914B00934.quest_desc: ["This quest asks for Player Transmitter Basic. EMI shows the recipe if you press R while hovering over it."]
	quest.5AD3778914B00934.quest_subtitle: "Obtain Player Transmitter Basic"
	quest.5ADDFD9B9279CDDF.quest_desc: ["Turrets cast their spell when they receive a redstone pulse and need source to run. Apply a spell with a Spell Book or Spell Parchment, and make sure it starts with a Form glyph." "The Basic Spell Turret uses twice the source of the spell, and the Enhanced one uses the same amount. With a Pickup glyph, items are deposited into a storage block touching the turret."]
	quest.5ADDFD9B9279CDDF.quest_subtitle: "Obtain Basic Spell Turret and Spell Turret"
	quest.5ADDFD9B9279CDDF.title: "Spell Turrets"
	quest.5B0E17C76F5F3F8A.quest_desc: ["Bring Spawn Egg Configurable Bee into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5B0E17C76F5F3F8A.quest_subtitle: "Obtain Spawn Egg Configurable Bee"
	quest.5B0F35D236824DD6.quest_desc: ["The imbuement chamber is used to create source gems. Place amethyst or lapis into the chamber, but be sure to have source nearby which is used to create source gems."]
	quest.5B0F35D236824DD6.quest_subtitle: "Obtain Imbuement Chamber"
	quest.5B1297C2D45DD486.quest_desc: ["Bring Configurable Honeycomb into your inventory. Check EMI with R on the item if you are unsure how to get it."]
