	quest.55DEBC832812CF8F.title: "Reactor (Basic)"
	quest.55E8C6D47904BB82.quest_desc: ["Get hold of Chicken Seeds. Hover over it in EMI and press R to see how it is made."]
	quest.55E8C6D47904BB82.quest_subtitle: "Obtain Chicken Seeds"
	quest.55F46067FA02A024.quest_desc: ["Adds a jukebox to the backpack."]
	quest.55F46067FA02A024.quest_subtitle: "Obtain Jukebox Upgrade"
	quest.560969584D4C4400.quest_desc: ["The Chemical Oxidizer is used for making gases from materials. It's left side accepts incoming materials, while it's right side dispenses the gas created from those materials."]
	quest.560969584D4C4400.quest_subtitle: "Obtain Chemical Oxidizer"
	quest.560B2C83B7DE350D.quest_desc: ["This substance is used in a Thermopneumatic Processing Plant with Coal to produce Plastic. It is a superior liquid fuel and can also be placed in a Furnace."]
	quest.560B2C83B7DE350D.quest_subtitle: "Obtain Lpg Bucket"
	quest.560B2C83B7DE350D.title: "LPG"
	quest.561A6175E04A6634.quest_desc: ["Lightning Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, used for advanced Lightning crafting such as Lightning Upgrade Orbs. The Lightning school uses Bottle o' Lightning as its Focus." "Combine 1 Blank Runestone with 8 Bottles o' Lightning to make one."]
	quest.561A6175E04A6634.quest_subtitle: "Obtain Lightning Rune"
	quest.561AF9843D55966C.quest_desc: ["Craft a Cursium Helmet from Cataclysm by upgrading a Netherite Helmet with a Cursium Upgrade Smithing Template and a Cursium Ingot at a Smithing Table." "It belongs to the Cursium armor set and grants Ghost Vision, which reveals living entities through walls."]
	quest.561AF9843D55966C.quest_subtitle: "Obtain Cursium Helmet"
	quest.5632FB0D793F2720.quest_desc: ["Wizard Boots are part of the basic Wizard Armor set in Iron's Spells 'n Spellbooks. They give +3 Armor, +125 Max Mana and +5% Spell Power." "Wear them to complete the Wizard set."]
	quest.5632FB0D793F2720.quest_subtitle: "Obtain Wizard Boots"
	quest.56395334C532D306.quest_desc: ["Bring Rubber Tree Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.56395334C532D306.quest_subtitle: "Obtain Rubber Tree Sapling"
	quest.563F1D4928570796.quest_desc: ["Upgrade Terminite Leggings with an Aeternium Forged Plate at a Smithing Table to craft Aeternium Leggings." "They complete Better End's top armor tier, made for the most dangerous fights."]
	quest.563F1D4928570796.quest_subtitle: "Obtain Aeternium Leggings"
	quest.564E10E67012E447.quest_desc: ["This gem is able to store most mobs inside it, for easy transport."]
	quest.564E10E67012E447.quest_subtitle: "Obtain Soul Gem"
	quest.565971DD1DC0ECD4.quest_desc: ["Multiplies the number of items that fit in each slot by 4."]
	quest.565971DD1DC0ECD4.quest_subtitle: "Obtain Stack Upgrade Tier 2"
	quest.565A82F5628F3940.quest_desc: ["Using the Scroll Forge and a Frozen Bone to craft an Ice Scrolls."]
	quest.565A82F5628F3940.quest_subtitle: "Obtain Scroll"
	quest.565C945151442FE0.quest_desc: ["Notable rituals: Conjure Island: Desert converts the area around it into another biome. Disintegration needs both source and experience in item form, and using a stack at a time is a hassle, so it may not be worth it."]
	quest.565C945151442FE0.quest_subtitle: "Obtain Ritual Disintegration, Ritual Sunrise and Ritual Conjure Island Desert"
	quest.565C945151442FE0.title: "Red Tablets"
	quest.566DC620374FC300.quest_desc: ["The energized smelter is your basic electric furnace that uses energy instead of fuel to smelt items."]
	quest.566DC620374FC300.quest_subtitle: "Obtain Energized Smelter"
	quest.567EBD733A7FE49A.quest_desc: ["Use the Configurator to open, edit or delete networks from anywhere. Shift-right-click a connector to copy its settings, then right-click another connector to paste them." "Right-clicking anything else opens the network screen, where you can also rename the Configurator."]
	quest.567EBD733A7FE49A.quest_subtitle: "Manage networks and copy connector settings"
	quest.56843154A56360DF.quest_desc: ["Ender Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, used for advanced Ender crafting such as the Ender Upgrade Orb. The Ender school uses Ender Pearl as its Focus." "Combine 1 Blank Runestone with 8 Ender Pearls to make one."]
	quest.56843154A56360DF.quest_subtitle: "Obtain Ender Rune"
	quest.568AFFD1946E87E4.quest_desc: ["This quest asks for Celestigem Boots. EMI shows the recipe if you press R while hovering over it."]
	quest.568AFFD1946E87E4.quest_subtitle: "Obtain Celestigem Boots"
	quest.5695223839DAEDE9.quest_desc: ["Bring Furnator Nitro into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5695223839DAEDE9.quest_subtitle: "Obtain Furnator Nitro"
	quest.569AAE39DE56597A.quest_desc: ["After unlocking an Eldritch scroll with a Manuscript, use an Echo Shard in the Scroll Forge to craft Eldritch spells. They can only be crafted with Legendary Ink." "Abyssal Shroud turns you into an enderman that teleports away when attacked. Eldritch Blast fires up to 7 blasts of energy, each reaching up to 30 blocks. Planar Sight lets you see any entity within render distance."]
	quest.569AAE39DE56597A.quest_subtitle: "Obtain Echo Shard"
	quest.56B33BEA6CD9F2E9.quest_desc: ["Captures both monsters and animals."]
	quest.56B33BEA6CD9F2E9.quest_subtitle: "Obtain Creaturecatcher"
	quest.56D0FFBF354E9F19.quest_desc: ["Bring Furnator Blazing into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.56D0FFBF354E9F19.quest_subtitle: "Obtain Furnator Blazing"
	quest.56D42BA7AB71A083.quest_desc: ["The Bio-Generator takes biofuel to generate power. You can make biofuel by crushing down almost any organic based material."]
	quest.56D42BA7AB71A083.quest_subtitle: "Obtain Bio Generator"
	quest.56D42BA7AB71A083.title: "Bio-Generator"
	quest.56E52560258EB049.quest_desc: ["This quest asks for Singularity. EMI shows the recipe if you press R while hovering over it."]
	quest.56E52560258EB049.quest_subtitle: "Obtain Singularity"
	quest.56E52560258EB049.title: "Pocket Black Hole"
	quest.570E23CBBC8F7D93.quest_desc: ["Upgrade an Echoing Deepshelf with a Warden Tendril, a Sculk Catalyst and Sculk. The tendril drops from the Warden, so prepare well." "It gives +10 Eterna (up to 80), +10 Quanta, +15 Arcana and +1 Clue."]
	quest.570E23CBBC8F7D93.quest_subtitle: "Obtain Echoing Sculkshelf"
	quest.571A3278898D55F7.quest_desc: ["Make the Warden Sword in a Mechanical Crafter using a Netherite Sword, Echo Ingots, a Reinforced Echo Shard and a Warden Upgrade Template."]
	quest.571A3278898D55F7.quest_subtitle: "Obtain Warden Sword"
	quest.573007C25B63A94A.quest_desc: ["Get hold of Ender Cell Niotic. Hover over it in EMI and press R to see how it is made."]
	quest.573007C25B63A94A.quest_subtitle: "Obtain Ender Cell Niotic"
	quest.5737E6152282101F.quest_desc: ["The Crafting Blueprint saves crafting recipes so you can craft them on demand. Place it like a painting, right-click a slot and insert the ingredients to save a recipe. Filters let a slot accept multiple recipes." "Right-click the Blueprint to craft using available materials, or Shift + right-click to craft up to a full stack. Left-click removes a saved recipe. It can cover up to 3×3 blocks."]
	quest.5737E6152282101F.quest_subtitle: "Obtain Crafting Blueprint"
	quest.57457A03BC29CD0F.quest_desc: ["Crafted by infusing Obsidian Dust with Diamond Dust or Compressed Diamond in the Metallurgic Infuser."]
	quest.57457A03BC29CD0F.quest_subtitle: "Obtain Dust Refined Obsidian"
	quest.5760FD83AC802D74.quest_desc: ["Bring Tuscarora Crepe Myrtle Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5760FD83AC802D74.quest_subtitle: "Obtain Tuscarora Crepe Myrtle Sapling"
	quest.576B2CCE6BAA4A0D.quest_desc: ["Amadron Tablets allow you to order items and fluids, functioning like Villager Trading but with the added benefit of delivery by Drones, much cooler than dealing with Villagers. To use the Tablet, specify pick-up and drop-off locations by right-clicking on the inventory or tank with the Tablet."]
	quest.576B2CCE6BAA4A0D.quest_subtitle: "Obtain Amadron Tablet"
	quest.5782D9AC2F601F6B.quest_desc: ["It is stored in the secret vault of the labyrinth."]
	quest.5782D9AC2F601F6B.quest_subtitle: "Find the Mazebreaker pickaxe"
	quest.578D180F2DD79D7B.quest_desc: ["Using a Scroll Forge and an Emerald create an Evocation Scrolls."]
	quest.578D180F2DD79D7B.quest_subtitle: "Obtain Scroll"
	quest.578E1D412686F874.quest_desc: ["A Mekanism machine upgrade to make them process a bit quiet. Install full 4 upgrades to completely muff the machines noises."]
	quest.578E1D412686F874.quest_subtitle: "Obtain Upgrade Muffling"
	quest.579D119E48AEB4EB.quest_desc: ["Increases your mana regeneration."]
	quest.579D119E48AEB4EB.quest_subtitle: "Obtain Amulet of Mana Regen"
	quest.57A1832B650C95E7.quest_desc: ["Wizard Leggings are part of the basic Wizard Armor set in Iron's Spells 'n Spellbooks. They give +6 Armor, +125 Max Mana and +5% Spell Power." "You can craft them from 7 Arcane Cloth."]
	quest.57A1832B650C95E7.quest_subtitle: "Obtain Wizard Leggings"
	quest.57AC7CB719C65969.quest_desc: ["A Flux Point extracts energy from the network. It can output from every side at the same time."]
	quest.57AC7CB719C65969.quest_subtitle: "Pulls energy out of the network"
	quest.57C22655F8E5774D.quest_desc: ["The Accumulator Processor is used for all of the MEGA Storage Components."]
	quest.57C22655F8E5774D.quest_subtitle: "Obtain Accumulation Processor"
	quest.57C2497A99C83C03.quest_desc: ["Astrape from Cataclysm deals 10.5 attack damage and can launch a Lightning Spear." "The spear does lightning damage and leaves a static field that keeps hurting nearby creatures. Craft it with 2 Essence of the Storm and 3 Lacrima."]
	quest.57C2497A99C83C03.quest_subtitle: "Obtain Astrape"
	quest.57C2497A99C83C03.title: "Astrape"
	quest.57D0D16B8B6FABBC.quest_desc: ["Bring Yeti Helmet, Yeti Chestplate, Yeti Leggings and Yeti Boots into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.57D0D16B8B6FABBC.quest_subtitle: "Craft a full set of Yeti Armor"
	quest.57D0D16B8B6FABBC.title: "Yeti Armorer"
	quest.57D905CBEEF23465.quest_desc: ["Get hold of Thermo Generator Niotic. Hover over it in EMI and press R to see how it is made."]
	quest.57D905CBEEF23465.quest_subtitle: "Obtain Thermo Generator Niotic"
	quest.57E7527B3AE717E0.quest_desc: ["The Time Wand speeds up block entities such as machines and furnaces. Fill it with Time Fluid and power to use it."]
	quest.57E7527B3AE717E0.quest_subtitle: "Obtain Time Wand"
	quest.57FC1DFC6D27AA44.quest_desc: ["Variants to find: Badlands, Bamboo, Birch, Crimson, Cherry, Dark Forest, Giant Taiga, Jungle, Mountains, Mushroom, Oak, Ocean, Swamp and Warped."]
	quest.57FC1DFC6D27AA44.quest_subtitle: "Find all 14 Village variants"
	quest.5807A3FB4E4A3EA3.quest_desc: ["The Flowglaze Axe is both a tool and a weapon from Eternal Starlight in the Flowglaze tier." "It is crafted from Flowglaze materials and fits mid-to-late game."]
	quest.5807A3FB4E4A3EA3.quest_subtitle: "Obtain Flowglaze Axe"
	quest.580B7447D8DAE769.quest_desc: ["The Industrial Casing from Create: Dreams n' Desires is a sturdy building block for advanced machinery and larger mechanical systems. It is the base for more demanding factory builds."]
	quest.580B7447D8DAE769.quest_subtitle: "Obtain Industrial Casing"
	quest.58192317181791CD.quest_desc: ["This quest asks for Nano Quantum Helmet, Nano Quantum Chestplate, Nano Quantum Leggings and Nano Quantum Boots. EMI shows the recipe if you press R while hovering over it."]
	quest.58192317181791CD.quest_subtitle: "Obtain Nano Quantum Helmet, Nano Quantum Chestplate, Nano Quantum Leggings and Nano Quantum Boots"
	quest.58192317181791CD.title: "Quantum Nano Set"
	quest.58201F1F2E5301E8.quest_desc: ["4 pedestals are needed to use the Awakening Altar."]
	quest.58201F1F2E5301E8.quest_subtitle: "Obtain 4x Awakening Pedestal"
	quest.58201F1F2E5301E8.title: "Awakening Pedestal"
