	quest.118598E0C12F5E86.quest_desc: ["Ancient Metal Ingots from Cataclysm drop from Koboletons, Kobolediators and Wadjet in the Desert Site and Cursed Pyramid, or from the Ancient Remnant." "They are used for the Ancient Spear, Bone Reptile Armor and other ancient equipment."]
	quest.118598E0C12F5E86.quest_subtitle: "Obtain Ancient Metal Ingot"
