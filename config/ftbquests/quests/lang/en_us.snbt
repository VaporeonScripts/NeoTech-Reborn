	quest.41B09F04DCB392A5.title: "Starlight Golem"
	quest.41B56DDD404A9E28.quest_desc: ["Logistical Transporters are Mekanism's way of transporting items. They are smarter compared to other item pipes and can be highly configured with the Configurator. Transfer Rate: 2 items/1 m/s."]
	quest.41B56DDD404A9E28.quest_subtitle: "Obtain Basic Logistical Transporter"
	quest.41C4CEED66FD93C0.quest_desc: ["Some weapons and armor drop with powerful Affixes, which can grant anything from extra damage and durability to new abilities. Find your first piece to start your journey into Apotheosis."]
	quest.41C4CEED66FD93C0.quest_subtitle: "Find your first piece of Affix Gear"
