	quest.5B81420F5B4091BA.quest_desc: ["Resin and Amber bees can trap and encase mobs in amber. Encased mobs are immobile and can only be released when the amber is placed over a campfire. Soul campfires release them faster."]
	quest.5B81420F5B4091BA.quest_subtitle: "Obtain Amber"
	quest.5B836FFF1D589FB8.quest_desc: ["Quartz Fiber separates power between connected ME networks while still allowing data to pass. It is also used in wireless components."]
