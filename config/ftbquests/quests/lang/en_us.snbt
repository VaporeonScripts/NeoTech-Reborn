	quest.4F6E32B8CB884726.quest_desc: ["Hold a fiery tool or weapon while wearing at least one piece of fiery armor."]
	quest.4F6E32B8CB884726.quest_subtitle: "Wield a fiery tool with fiery armor"
	quest.4F7098D2509E257D.quest_desc: ["This quest asks for &#00D9FFThread Depths&r. EMI shows the recipe if you press R while hovering over it."]
	quest.4F7098D2509E257D.quest_subtitle: "Obtain Thread Depths"
	quest.4F76DE20AF936BC1.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.4F76DE20AF936BC1.quest_subtitle: "Obtain Ultimate Infusing Factory"
	quest.4F81E669986ED173.quest_desc: ["This quest asks for &#00D9FFSmart Filter&r. EMI shows the recipe if you press R while hovering over it."]
	quest.4F81E669986ED173.quest_subtitle: "Obtain Smart Filter"
	quest.4F82D1371F8A516C.quest_desc: ["Make &#00D9FFthe Resonarium Helmet&r in a &#00D9FFMechanical Crafter&r using a &#00D9FFDiamond Helmet&r, &#00D9FFSturdy Sheets&r, a &#00D9FFResonarium Plate&r and a &#00D9FFResonarium Upgrade Template&r." "The template can be found in &#00D9FFAncient Cities&r, &#00D9FFTrial Chambers and Strongholds&r."]
	quest.4F82D1371F8A516C.quest_subtitle: "Obtain Resonarium Helmet"
	quest.4FA993F05C028A1C.quest_desc: ["&#00D9FFMithril Weave&r is a &#00D9FFRare&r crafting material in &#FFA500Iron's Spells 'n Spellbooks&r. It is crafted from 5 &#00D9FFMithril Ingots&r and 4 &#00D9FFChains&r." "It is used for powerful gear such as &#00D9FFLightbringer's Chestplate and Boots of Speed&r."]
	quest.4FA993F05C028A1C.quest_subtitle: "Obtain Mithril Weave"
	quest.4FB44A8D0FB6BC11.quest_desc: ["This quest asks for &#00D9FFSupremium Gemstone&r. EMI shows the recipe if you press R while hovering over it."]
	quest.4FB44A8D0FB6BC11.quest_subtitle: "Obtain Supremium Gemstone"
	quest.4FBA4CF59C8996AF.quest_desc: ["This quest asks for &#00D9FFThread Undying&r. EMI shows the recipe if you press R while hovering over it."]
	quest.4FBA4CF59C8996AF.quest_subtitle: "Obtain Thread Undying"
	quest.4FC4E2F0CDBA12AF.quest_desc: ["Bring &#00D9FFDeviled Egg&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.4FC4E2F0CDBA12AF.quest_subtitle: "Obtain Deviled Egg"
	quest.4FE17CA304A1ACA5.quest_desc: ["Lets the wearer swim in the air for a limited time. Press &#00D9FFLeft Shift&r while airborne to start."]
	quest.4FE17CA304A1ACA5.quest_subtitle: "Obtain Helium Flamingo"
	quest.4FF54BF5B48FCC3E.quest_desc: ["This quest asks for &#00D9FFDiamond Fishing Rod&r. EMI shows the recipe if you press R while hovering over it."]
	quest.4FF54BF5B48FCC3E.quest_subtitle: "Obtain Diamond Fishing Rod"
	quest.4FFBFF6F945CCEEA.quest_desc: ["This quest asks for &#00D9FFEnergy Cable Blazing&r. EMI shows the recipe if you press R while hovering over it."]
	quest.4FFBFF6F945CCEEA.quest_subtitle: "Obtain Energy Cable Blazing"
	quest.501648F2CF9AE9C3.quest_desc: ["Casts further."]
	quest.501648F2CF9AE9C3.quest_subtitle: "Obtain Light Hook"
	quest.50366CD34600CEB1.quest_desc: ["Can be dual-wielded and enchanted. Different foods (ammo) has different effects."]
	quest.50366CD34600CEB1.quest_subtitle: "Obtain Potato Cannon"
	quest.5036A624A1FCB30E.quest_desc: ["This quest asks for &#00D9FFTreat&r on a &#00D9FFStick&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5036A624A1FCB30E.quest_subtitle: "Obtain Treat on a Stick"
	quest.503EAA79D946B3B9.quest_desc: ["The nature of a &#00D9FFSulfur&r is able to be changed. This is the basis for transmutation. This Vat, when given the right ingredients, is able to transform &#00D9FFSulfur&r into a much more malleable state - &#00D9FFAlchemical Niter&r."]
	quest.503EAA79D946B3B9.quest_subtitle: "Obtain Fermentation Vat"
	quest.5042EBFD483B3111.quest_desc: ["Bring &#00D9FFRefined Glowstone Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5042EBFD483B3111.quest_subtitle: "Obtain Refined Glowstone Seeds"
	quest.5050338A941A4C43.quest_desc: ["Changes the produces output to comb blocks instead of honeycombs. Having this upgrade installed will increase the time bees spend in the hive by &#00D9AA100%&r."]
	quest.5050338A941A4C43.quest_subtitle: "Obtain Upgrade Block"
	quest.505154D1786B1A9D.quest_desc: ["The &#00D9FFCombiner&r allows the player to create an ore block from 8 dust. Place the ore dust in the top slot, and some cobblestone in the bottom slot, and it will combine to make the ore block."]
	quest.505154D1786B1A9D.quest_subtitle: "Obtain Combiner"
	quest.505ACD03E11564C3.quest_desc: ["Get hold of &#00D9FFMusic Disc Pigstep&r. Hover over it in EMI and press R to see how it is made."]
	quest.505ACD03E11564C3.quest_subtitle: "Obtain Music Disc Pigstep"
	quest.5062A1486094FBBB.quest_desc: ["Bring &#00D9FFProsperity Gemstone&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5062A1486094FBBB.quest_subtitle: "Obtain Prosperity Gemstone"
	quest.5070950F9F3CFBBC.quest_desc: ["Craft &#00D9FFTerminite Leggings&r from &#00D9FFTerminite Plating&r at a &#00D9FFSmithing Table&r." "Like the rest of the set, they can later be upgraded into &#00D9FFCrystalite&r or &#00D9FFAeternium&r armor."]
	quest.5070950F9F3CFBBC.quest_subtitle: "Obtain Terminite Leggings"
	quest.507E749D84C60E7F.quest_desc: ["Bring &#00D9FFKelp Roll Slice&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.507E749D84C60E7F.quest_subtitle: "Obtain Kelp Roll Slice"
	quest.5089229344DFAD07.quest_desc: ["Get hold of &#00D9FFEnergy Hopper Niotic&r. Hover over it in EMI and press R to see how it is made."]
	quest.5089229344DFAD07.quest_subtitle: "Obtain Energy Hopper Niotic"
	quest.508AEE688CA78966.quest_desc: ["&#00D9FFDemonic Partners&r serve you and keep you company. They come in two forms, so you may want to summon both."]
	quest.508AEE688CA78966.quest_subtitle: "Earn the advancement: Summon Demonic Wife. Earn the advancement: Summon Demonic Husband"
	quest.508AEE688CA78966.title: "Summon Demonic Partners"
	quest.5095DD4AED24B2EE.quest_desc: ["Generates &#00D9FFCompressed Air&r using various fuel fluids. To view all available fuels, open the ‘&#00D9FFAvailable Fuels&r’ tab, which is sorted from most to least effective."]
	quest.5095DD4AED24B2EE.quest_subtitle: "Obtain Liquid Compressor"
	quest.509C7816670DC8DE.quest_desc: ["The chestplate of the &#00D9FFTertium&r armor set. Together with the leggings, it unlocks the helmet."]
	quest.50A55424E2E6F062.quest_desc: ["Get hold of &#00D9FFRed Loin&r on a &#00D9FFStick&r. Hover over it in EMI and press R to see how it is made."]
	quest.50A55424E2E6F062.quest_subtitle: "Obtain Red Loin on a Stick"
	quest.50A6BEFF620EE480.quest_desc: ["&#00D9FFAdd Etching Acid&r to an &#00D9FFEtching Tank&r to convert: &#00D9FFEmpty PCBs&r -> &#00D9FFUnassembled PCBs&r."]
	quest.50A6BEFF620EE480.quest_subtitle: "Obtain Etching Acid Bucket"
	quest.50A6BEFF620EE480.title: "Etching Acid"
	quest.50AE358F27E83A76.quest_desc: ["Craft it from &#00D9FFEnd Stone Bricks&r, an &#00D9FFEnder Pearl&r, a bookshelf and &#00D9FFInfused Dragon's Breath&r. To make the breath, infuse &#00D9FFDragon's Breath&r with at least 80 &#00D9FFEterna&r and &#00D9AA60%&r &#00D9FFArcana&r, keeping &#00D9FFQuanta&r between &#00D9AA15%&r and &#00D9AA30%&r." "It gives &#00D9AA+5&r &#00D9FFEterna&r (up to 90), &#00D9AA+5&r &#00D9FFQuanta&r and &#00D9AA+5&r &#00D9FFArcana&r."]
	quest.50AE358F27E83A76.quest_subtitle: "Obtain Endshelf"
	quest.50AF84E458B8413F.quest_desc: ["Tier 2 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.50AF84E458B8413F.quest_subtitle: "Obtain Glyph Extend Time"
	quest.50C499D419120339.quest_desc: ["Expands the inventory of the chest."]
	quest.50C499D419120339.quest_subtitle: "Obtain Diamond Chest"
	quest.50C499D419120339.title: "Diamond Chest"
	quest.50C73129350342EB.quest_desc: ["&#00D9FFTwilight Gale&r is a crystalline &#00D9FFLightning&r spear in &#FFA500Iron's Spells 'n Spellbooks&r with 13 &#00D9FFAttack Damage&r and 1.4 &#00D9FFAttack Speed&r. It comes imbued with &#00D9FFVolt Strike V&r." "You can throw it like a trident. Throwing does not use it up but puts it on a 10-second cooldown. It also accepts &#00D9FFSword&r enchantments, &#00D9FFLoyalty and Channeling&r."]
	quest.50C73129350342EB.quest_subtitle: "Obtain Twilight Gale"
	quest.50D6DCE497E0FB14.quest_desc: ["The &#00D9FFAmaramber Pickaxe&r was added in version 0.4.2 as part of the &#00D9FFAmaramber&r set in &#FFA500Eternal Starlight&r." "It handles standard mining and is crafted from &#00D9FFAmaramber&r materials from &#00D9FFTorreya&r-related resources."]
	quest.50D6DCE497E0FB14.quest_subtitle: "Obtain Amaramber Pickaxe"
	quest.50F5BF288092DA4C.quest_desc: ["&#00D9FFBlazebloom Goo&r turns &#00D9FFGold Blocks&r into &#00D9FFRaw Blazegold&r. It is fed with &#00D9FFNether Warts&r or &#00D9FFBlaze Powder&r."]
	quest.50F5BF288092DA4C.quest_subtitle: "Obtain 2x Raw Blazegold, 2x Blazegold Ingot and Gooblock Tier2"
	quest.50F5BF288092DA4C.title: "Making Blazegold"
	quest.50F67A8AF91B5527.quest_desc: ["The &#00D9FFThallasium Hammer&r has two uses. It shapes ingots at the &#00D9FFAnvil&r, and it also works as a heavy melee weapon with strong knockback." "It is the &#00D9FFThallasium&r version of &#00D9FFBetter End's Hammer&r weapon class."]
	quest.50F67A8AF91B5527.quest_subtitle: "Obtain Thallasium Hammer"
	quest.50F703A1F6C58861.quest_desc: ["This quest asks for &#00D9FFSpicy Cotton&r. EMI shows the recipe if you press R while hovering over it."]
	quest.50F703A1F6C58861.quest_subtitle: "Obtain Spicy Cotton"
	quest.50F91BB8CC3D567C.quest_desc: ["The &#00D9FFSupercritical Phase Shapeshifter&r, or SPS, is a machine that allows you to make &#00D9FFAnti&r-&#00D9FFMatter&r with &#00D9FFPolonium Gas&r. It is a very expensive machine as each casing requires about 50,000 mb of processed nuclear waste. The next step will give you a list of the cheapest machine that can be built."]
	quest.50F91BB8CC3D567C.quest_subtitle: "Obtain Sps Casing and 64x Reactor Glass"
	quest.510764F4358838A6.quest_desc: ["This pickaxe may be more useful for making miner spirits than it is for you, but it is far better than its brittle predecessor."]
	quest.510764F4358838A6.quest_subtitle: "Obtain Iesnium Pickaxe"
	quest.5134C2510677E046.quest_desc: ["Make &#00D9FFthe Eternal Crystal&r with an &#00D9FFInfusion Ritual&r using an &#00D9FFEnd Crystal&r, four &#00D9FFEnder Shards&r and four &#00D9FFCrystal Shards&r around an &#00D9FFInfusion Pedestal&r." "Place it on the six pedestals of an &#00D9FFEternal Portal&r to light the gateway back to the &#00D9FFOverworld&r."]
	quest.5134C2510677E046.quest_subtitle: "Obtain Eternal Crystal"
	quest.5134C2510677E046.title: "Eternal Crystal"
	quest.514AA10FB8E9C13D.quest_desc: ["Bring &#00D9FFLimited Iron Barrel&r 3 into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.514AA10FB8E9C13D.quest_subtitle: "Obtain Limited Iron Barrel 3"
	quest.515537F876D9FDF2.quest_desc: ["This quest asks for &#00D9FFSoulkeeper&r. EMI shows the recipe if you press R while hovering over it."]
	quest.515537F876D9FDF2.quest_subtitle: "Obtain Soulkeeper"
	quest.515E9B6FC30553FF.quest_desc: ["Bring &#00D9FFConfigurable Honeycomb&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.515E9B6FC30553FF.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.516669F1F39CDFF3.quest_desc: ["This quest asks for &#00D9FFConfigurable Honeycomb&r. EMI shows the recipe if you press R while hovering over it."]
	quest.516669F1F39CDFF3.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.51680D03A890C7A7.quest_desc: ["Get hold of &#00D9FFRefined Obsidian Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.51680D03A890C7A7.quest_subtitle: "Obtain Refined Obsidian Seeds"
	quest.5177FE5D2F015777.quest_desc: ["Finish your &#00D9FFIronwood&r tool set by crafting the &#00D9FFIronwood Hoe and Ironwood Shovel&r from &#00D9FFIronwood Ingots&r." "They speed up everyday tasks like farming and clearing dirt, sand and gravel, and they stay durable."]
	quest.5177FE5D2F015777.quest_subtitle: "Obtain Ironwood Shovel and Ironwood Hoe"
	quest.5177FE5D2F015777.title: "Ironwood Utility Tools"
	quest.5181194EE635D762.quest_desc: ["Moves items from the backpack into an inventory you sneak and right-click."]
	quest.5181194EE635D762.quest_subtitle: "Obtain Deposit Upgrade"
	quest.51923E16358CAEA6.quest_desc: ["Use &#00D9FFthe Charger&r to charge &#00D9FFCertus Quartz&r. &#00D9FFCharged Certus&r is an important ingredient for &#00D9FFFluix&r and other AE2 components."]
	quest.51923E16358CAEA6.title: "Charge Certus Quartz"
	quest.51AD0B9A21D4FC9A.quest_desc: ["Combine two &#00D9FFFlawless Gems&r of the same type and rarity at the &#00D9FFGem Cutting Table&r to create a &#00D9FFPerfect Gem&r, the highest possible &#00D9FFPurity&r."]
	quest.51AD0B9A21D4FC9A.quest_subtitle: "Obtain Smart Filter"
	quest.51AD0B9A21D4FC9A.title: "Perfect"
	quest.51AFFE2D8BA060F1.quest_desc: ["Tier 2 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.51AFFE2D8BA060F1.quest_subtitle: "Obtain Glyph Grow"
	quest.51B4ED362FAEA90C.quest_desc: ["Bring &#00D9FFMirror of Transgression&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.51B4ED362FAEA90C.quest_subtitle: "Obtain Mirror of Transgression"
	quest.51C2957AF520806C.quest_desc: ["Make &#00D9FFthe Soul Elytra&r in a &#00D9FFMechanical Crafter&r using an &#00D9FFElytra&r, &#00D9FFSculk Bones&r, &#00D9FFSoul Dust&r, a &#00D9FFSoul Crystal and Phantom Membranes&r."]
	quest.51C2957AF520806C.quest_subtitle: "Obtain Soul Elytra"
	quest.51D1ABEB17EE7C28.quest_desc: ["Bring &#00D9FFKumquat Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.51D1ABEB17EE7C28.quest_subtitle: "Obtain Kumquat Sapling"
	quest.51D48123DBE621D9.quest_desc: ["The highest tier of the standard spawner upgrade path."]
	quest.51D48123DBE621D9.quest_subtitle: "Obtain Pinnacle Spawner Upgrade Rune"
	quest.51D48123DBE621D9.title: "Pinnacle Spawner Upgrade Rune"
	quest.51DE330522B63BCD.quest_desc: ["This quest asks for &#00D9FFExperience Seeds&r. EMI shows the recipe if you press R while hovering over it."]
	quest.51DE330522B63BCD.quest_subtitle: "Obtain Experience Seeds"
	quest.51E1D9A455E35136.quest_desc: ["Get hold of &#00D9FFBlazegold Hoe&r. Hover over it in EMI and press R to see how it is made."]
	quest.51E1D9A455E35136.quest_subtitle: "Obtain Blazegold Hoe"
	quest.51E7C2E50E79D554.quest_desc: ["This quest asks for &#00D9AA36x&r &#00D9FFReactor Hardened&r. EMI shows the recipe if you press R while hovering over it."]
	quest.51E7C2E50E79D554.quest_subtitle: "Obtain 36x Reactor Hardened"
	quest.51EEABBE1E2F6328.quest_desc: ["Mobs spawned by the spawner stay young. Useful for a reliable source of baby mobs."]
	quest.51EEABBE1E2F6328.quest_subtitle: "Obtain Youthful Spawner Rune"
	quest.51EEABBE1E2F6328.title: "Youthful Spawner Rune"
	quest.51F2C82D9D23C8B6.quest_desc: ["The extended devices are too complex for a crafting table to craft, so you will need a &#00D9FFCrystal Assembler&r to craft most of them. Note: The screen face can't connect to network. It can also perform certain in-world transformation recipes, like fluix transformation."]
	quest.51F2C82D9D23C8B6.quest_subtitle: "Obtain Crystal Assembler"
	quest.520117A4C0AB83B0.quest_desc: ["&#00D9FFLogistical Transporters&r are &#FFA500Mekanism&r's way of transporting items. They are smarter compared to other item pipes and can be highly configured with the &#00D9FFConfigurator&r. Transfer Rate: 128 items/10 m/s."]
	quest.520117A4C0AB83B0.quest_subtitle: "Obtain Ultimate Logistical Transporter"
	quest.520DC59E286485A5.quest_desc: ["The Cthulhu allows you to breathe underwater."]
	quest.520DC59E286485A5.quest_subtitle: "Earn the advancement: Familiar Cthulhu"
	quest.5211110B50732D75.title: "Lich"
	quest.52242A836ECF9338.quest_desc: ["Variants to find: &#00D9FFCrimson&r, End, &#00D9FFNether Brick and Warped&r."]
	quest.52242A836ECF9338.quest_subtitle: "Find all 4 Shipwreck variants"
	quest.52263E1ACB092CB6.quest_desc: ["The &#00D9FFME Active Formation Plane&r works like the regular &#00D9FFFormation Plane&r, except it pulls the blocks/items from the system without you having to push to it, pretty handy, isn't it?"]
	quest.52263E1ACB092CB6.quest_subtitle: "Obtain Active Formation Plane"
	quest.5228BC5CD6332CB9.quest_desc: ["Increases damage dealt by the wearer."]
	quest.5228BC5CD6332CB9.quest_subtitle: "Obtain Power Glove"
	quest.522E47967E2D1302.quest_desc: ["Tier 2 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.522E47967E2D1302.quest_subtitle: "Obtain Glyph Crush"
	quest.522FDC021EBBD310.quest_desc: ["The &#00D9FFLimited Oak Barrel I&r is an early &#FFA500Sophisticated Storage&r option. Its capacity is small, but it keeps items organized in a compact space." "Treat it as a stepping stone to larger containers."]
	quest.522FDC021EBBD310.quest_subtitle: "Obtain Limited Barrel 1"
	quest.523A813DCCD4F794.quest_desc: ["Bring &#00D9FFImperium Farmland&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.523A813DCCD4F794.quest_subtitle: "Obtain Imperium Farmland"
	quest.523D227B254066FF.quest_desc: ["Get hold of &#00D9FFExperience Disperser&r. Hover over it in EMI and press R to see how it is made."]
	quest.523D227B254066FF.quest_subtitle: "Obtain Experience Disperser"
	quest.524BF2ADF436A2C8.quest_desc: ["Bring &#00D9FFButterfly&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.524BF2ADF436A2C8.quest_subtitle: "Obtain Butterfly"
	quest.525383DAACB08E92.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.525383DAACB08E92.quest_subtitle: "Obtain Advanced Combining Factory"
	quest.5256C7A334ACCF16.quest_desc: ["The &#00D9FFAmaramber Chestplate&r is crafted from &#00D9FFAmaramber&r materials in &#FFA500Eternal Starlight&r." "It belongs to the &#00D9FFAmaramber&r armor set and gives better protection while exploring and fighting."]
	quest.5256C7A334ACCF16.quest_subtitle: "Obtain Amaramber Chestplate"
	quest.5257768CB9588EB9.quest_desc: ["Get hold of &#00D9FFAtlantic Cod&r. Hover over it in EMI and press R to see how it is made."]
	quest.5257768CB9588EB9.quest_subtitle: "Obtain Atlantic Cod"
	quest.526AB0635FE0C56A.quest_desc: ["The &#00D9FFGauntlet of Bulwark&r from &#FFA500Cataclysm&r is a legendary gauntlet that releases fiery shockwaves." "It helps you control the battlefield and is one of the &#00D9FFNether's&r signature relics."]
	quest.526AB0635FE0C56A.quest_subtitle: "Obtain Gauntlet of Bulwark"
	quest.526AB0635FE0C56A.title: "Gauntlet Of Bulwark"
	quest.526B004FC046694E.quest_desc: ["The &#00D9FFGrimoire of Evokation&r is a unique &#00D9FFEvocation&r spellbook that comes pre-inscribed with &#00D9FFFang Strike&r 6, &#00D9FFFang Ward&r 4 and &#00D9FFSummon Vex&r 4. Equipped, it gives &#00D9AA+10%&r &#00D9FFEvocation Spell Power&r and &#00D9AA+200&r &#00D9FFMax Mana&r." "It is a rare drop from &#00D9FFEvokers and Archevokers&r."]
	quest.526B004FC046694E.quest_subtitle: "Obtain Evoker Spell Book"
	quest.527EB36537EAF0E1.quest_desc: ["Get hold of &#00D9FFFerricore Shovel&r. Hover over it in EMI and press R to see how it is made."]
	quest.527EB36537EAF0E1.quest_subtitle: "Obtain Ferricore Shovel"
	quest.528055FF0AF18D4E.quest_desc: ["The &#00D9FFRefinery&r is a multiblock in which you place the &#00D9FFRefinery Controller&r on the bottom and &#00D9FFRefineries&r on top of it, two to begin with. You can place up to 4 but this will not increase the speed of the &#00D9FFRefinery&r, but allow it to produce other fluids from &#00D9FFCrude Oil&r. With just the two &#00D9FFRefineries&r on top of it you will start outputting &#00D9FFDiesel and LPG&r , as you gather the resources, adding another &#00D9FFRefinery&r will get you &#00D9FFKerosene&r and another, you will get &#00D9FFGasoline&r. To use the &#00D9FFRefinery&r you will need heat, heat can be sourced from &#00D9FFTorches&r around the machine for low efficiency, lava for mid efficiency, and produced heat from a &#00D9FFVortex Tube&r using pressure."]
	quest.528055FF0AF18D4E.quest_subtitle: "Obtain Refinery, 4x Refinery Output and Liquid Hopper"
	quest.528055FF0AF18D4E.title: "Refinery"
	quest.528FA94494267B63.quest_desc: ["An &#00D9FFEnergy Cube&r is an advanced type of battery that is compatible with multiple energy systems. An upgraded version of the &#00D9FFBasic Energy Cube&r."]
	quest.528FA94494267B63.quest_subtitle: "Obtain Advanced Energy Cube"
	quest.529CF4A2148025ED.quest_desc: ["Not every item needs to go wherever the network sends it. &#00D9FFRestrictive and Diversion Transporters&r give you more control over how items move through your &#00D9FFLogistical Transporter&r network. &#00D9FFRestrictive Transporter&r. Acts as an overflow route. Items will only enter it when they have nowhere else to go, making it useful for handling excess items or directing unwanted materials to a backup destination. &#00D9FFDiversion Transporter&r. Acts as a priority route. It encourages items to pass through it before normal transporter paths, making it useful for directing specific items toward a preferred destination. Use both together to build organized item networks that know where your resources should - and shouldn't - go."]
	quest.529CF4A2148025ED.quest_subtitle: "Obtain Restrictive Transporter and Diversion Transporter"
	quest.529CF4A2148025ED.title: "Transporters"
	quest.52B649A4C67B36B5.quest_desc: ["Achieved by enriching &#00D9FFObsidian&r in the &#00D9FFEnrichment Chamber&r."]
	quest.52B649A4C67B36B5.quest_subtitle: "Obtain Dust Obsidian"
	quest.52CB38CAD6FC7C19.quest_desc: ["Get hold of &#00D9FFMusic Disc Ward&r. Hover over it in EMI and press R to see how it is made."]
	quest.52CB38CAD6FC7C19.quest_subtitle: "Obtain Music Disc Ward"
	quest.52D99D07D61411D7.quest_desc: ["The &#00D9FFME Extended Drive&r an &#00D9FFME Drive&r with a larger cell inventory. It can hold 20 storage cells."]
	quest.52D99D07D61411D7.quest_subtitle: "Obtain Ex Drive"
	quest.52DD1E34E09CDDA6.quest_desc: ["A crafting component for the &#00D9FFRainbow Furnace&r and the &#00D9FFLinker&r."]
	quest.52DD1E34E09CDDA6.quest_subtitle: "Obtain Rainbow Core"
	quest.52E14D8C193546FC.quest_desc: ["Expands the inventory of the barrel."]
	quest.52E14D8C193546FC.quest_subtitle: "Obtain Diamond Barrel"
	quest.52E14D8C193546FC.title: "Diamond Barrel"
	quest.52E2B96B9F768E56.quest_desc: ["&#FFA500Waystones&r provide a way to travel between discovered destinations. Find and activate them as you explore to make future journeys easier."]
	quest.52E2B96B9F768E56.title: "Getting Started"
	quest.52E582A995B952D6.quest_desc: ["Found in the &#00D9FFBronze Dungeon&r. Time to challenge the &#00D9FFSilver Dungeon&r."]
	quest.52E582A995B952D6.quest_subtitle: "Get the Valkyrie Lance"
	quest.52E73ABC3B31C9BD.quest_desc: ["This quest asks for &#00D9FFNether Seeds&r. EMI shows the recipe if you press R while hovering over it."]
	quest.52E73ABC3B31C9BD.quest_subtitle: "Obtain Nether Seeds"
	quest.52E87C7AF1EB20C6.quest_desc: ["Defeat 5 &#00D9FFUrchinkin&r from &#FFA500Cataclysm&r, creatures that live in its oceans." "Take them out one by one."]
	quest.52E87C7AF1EB20C6.quest_subtitle: "Defeat Urchinkin"
	quest.52E87C7AF1EB20C6.title: "Urchinkin"
	quest.5303D7406990F417.quest_desc: ["Smelts 12 items."]
	quest.5303D7406990F417.quest_subtitle: "Obtain Inferium Coal"
	quest.530DC28051799876.quest_desc: ["A magical light that follows you."]
	quest.530DC28051799876.quest_subtitle: "Obtain Jar of Light"
	quest.5319081C2EC86C50.quest_desc: ["&#FFA500Ender Zoology&r adds new creatures and drops to encounter during exploration. Learn what each mob does before approaching unfamiliar threats."]
	quest.5319081C2EC86C50.title: "Getting Started"
	quest.531AA88962E0DDB5.quest_desc: ["Craft a &#00D9FFBlack Steel Hoe&r from &#FFA500Cataclysm&r. It is a durable tool and part of the &#00D9FFBlack Steel&r equipment set."]
	quest.531AA88962E0DDB5.quest_subtitle: "Obtain Black Steel Hoe"
	quest.5320FC69E4A5A080.quest_desc: ["Chutes are more flexible than you might at first think. They can stack vertically, but also diagonally. A Wrench will place, or remove, windows in &#00D9FFChutes&r. Moves items up, using &#00D9FFEncased Fans&r at either end to force air up. Move items down with.. nothing else. (thank you, gravity!)."]
	quest.5320FC69E4A5A080.quest_subtitle: "Obtain Chute"
	quest.53263CE35A8A8B52.quest_desc: ["This quest asks for &#00D9FFEnder Cell Spirited&r. EMI shows the recipe if you press R while hovering over it."]
	quest.53263CE35A8A8B52.quest_subtitle: "Obtain Ender Cell Spirited"
	quest.532AA97F7EA39DD6.quest_desc: ["This quest asks for &#00D9FFEnergy Hopper Hardened&r. EMI shows the recipe if you press R while hovering over it."]
	quest.532AA97F7EA39DD6.quest_subtitle: "Obtain Energy Hopper Hardened"
	quest.53329AA1FCDDAEDB.quest_desc: ["You can have my &#00D9FFExtendo Grip&r.."]
	quest.53329AA1FCDDAEDB.quest_subtitle: "Obtain Extendo Grip"
	quest.5338A64F0DBEBCAD.quest_desc: ["Earn the advancement: &#00D9FFCoke Oven&r."]
	quest.5338A64F0DBEBCAD.quest_subtitle: "Earn the advancement: Coke Oven"
	quest.533932E685A2E77A.quest_desc: ["Like &#00D9FFthe Tool Swapper Upgrade&r, with filtering options. It can also swap wrench-like tools for the block or entity you look at."]
	quest.533932E685A2E77A.quest_subtitle: "Obtain Advanced Tool Swapper Upgrade"
	quest.533D9936392A7D45.quest_desc: ["This oven makes it possible to calcinate a variety of materials into &#00D9FFAlchemical Salt&r. Place a &#00D9FFPyromantic Brazier&r below the &#00D9FFOven&r and fuel it with furnace fuel to provide heat. Fuels last twice as long as in a &#00D9FFFurnace&r."]
	quest.533D9936392A7D45.quest_subtitle: "Obtain Calcination Oven and Pyromantic Brazier"
	quest.5353A2764C526C75.quest_desc: ["Increases the maximum speed of an electric recipe."]
	quest.5353A2764C526C75.quest_subtitle: "Obtain Basic Upgrade"
	quest.5353A2764C526C75.title: "Machine Speedup"
	quest.5360FBB4DEBA2DFB.quest_desc: ["The &#00D9FFGem Cutting Table&r improves your &#00D9FFGems&r using &#00D9FFGem Dust and Rarity Materials&r."]
	quest.5360FBB4DEBA2DFB.quest_subtitle: "Obtain Gem Cutting Table"
	quest.5360FBB4DEBA2DFB.title: "Cut to Size"
	quest.5369221D98B15931.quest_desc: ["The first piece of the &#00D9FFIronwood&r armor set. Get the boots to unlock the chestplate and leggings."]
	quest.536C62938DD74583.quest_desc: ["Increases the experience dropped by creatures."]
	quest.536C62938DD74583.quest_subtitle: "Obtain Golden Hook"
	quest.5371AFA52B1522B8.quest_desc: ["Tier 2 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.5371AFA52B1522B8.quest_subtitle: "Obtain Glyph Extract"
	quest.5388CE7578033C00.quest_desc: ["This quest asks for &#00D9FFTertium Watering Can&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5388CE7578033C00.quest_subtitle: "Obtain Tertium Watering Can"
	quest.538C72A1FA160C25.quest_desc: ["Craft a &#00D9FFCursium Chestplate&r from &#FFA500Cataclysm&r by upgrading a &#00D9FFNetherite Chestplate&r with a &#00D9FFCursium Upgrade Smithing Template&r and a &#00D9FFCursium Ingot&r at a &#00D9FFSmithing Table&r." "It belongs to the &#00D9FFCursium&r armor set and grants powerful abilities when worn."]
	quest.538C72A1FA160C25.quest_subtitle: "Obtain Cursium Chestplate"
	quest.539337A980A33EB0.quest_desc: ["Bring &#00D9FFSweet Chestnut Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.539337A980A33EB0.quest_subtitle: "Obtain Sweet Chestnut Sapling"
	quest.53962F2FB02FF005.quest_desc: ["&#00D9FFME Crystal Fixer&r can repair budding certus block and turn it to the upgraded one. It needs &#00D9FFCharged Certus Quartz Crystal&r and power to work. Right-click it with &#00D9FFCharged Certus Quartz Crystal&r to input. However, it can't turn flawed into flawless. The max tier it can reach is flawed."]
	quest.53962F2FB02FF005.quest_subtitle: "Obtain Crystal Fixer"
	quest.539A534A7273297F.quest_desc: ["This device can be placed on any inventory. When heated by an adjacent heat source, it smelts items in the inventory, and when cooled it freezes them. Smelting only works if there is space for the result. It works faster with more heat, up to one item per second, and freezing speeds up with more cooling."]
	quest.539A534A7273297F.quest_subtitle: "Obtain Heat Frame and Chest"
	quest.539E860FE450D437.quest_desc: ["A &#00D9FFDense Energy Cell&r stores more power than the standard cell. It is also a component for the &#00D9FFWireless Terminal&r."]
	quest.53A7C8397B068371.quest_desc: ["This quest asks for &#00D9FFPomelo Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.53A7C8397B068371.quest_subtitle: "Obtain Pomelo Sapling"
	quest.53BA9F2BA5C29302.quest_desc: ["This is a challenging and destructive mob, be prepared."]
	quest.53BA9F2BA5C29302.quest_subtitle: "Obtain Wilden Tribute"
	quest.53C705C777BF4E64.quest_desc: ["This entity mines almost ten times as many resources as the &#00D9FFMarid&r miner."]
	quest.53C705C777BF4E64.quest_subtitle: "Obtain Miner Ancient Eldritch"
	quest.53D5219AFA6C0D60.quest_desc: ["Get hold of &#00D9FFQuantum Circuit&r. Hover over it in EMI and press R to see how it is made."]
	quest.53D5219AFA6C0D60.quest_subtitle: "Obtain Quantum Circuit"
	quest.53DC59B99AF4985C.quest_desc: ["Fridges hold ingredients that your kitchen recipes can use."]
	quest.53DC59B99AF4985C.quest_subtitle: "Storage for your ingredients"
	quest.53E90A223D5B12C3.quest_desc: ["Bring &#00D9FFTear Popsicle&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.53E90A223D5B12C3.quest_subtitle: "Obtain Tear Popsicle"
	quest.53EC902D03A8B035.quest_desc: ["The Beholder makes nearby mobs glow, and shoots lasers at your enemies."]
	quest.53EC902D03A8B035.quest_subtitle: "Earn the advancement: Familiar Beholder"
	quest.53F7C95E2F98E7FE.quest_desc: ["Any type of chest counts, not just oak. Expands the inventory of the chest."]
	quest.53F7C95E2F98E7FE.quest_subtitle: "Obtain Iron Chest"
	quest.53F7C95E2F98E7FE.title: "Iron Chest"
	quest.53F85B1A9BC00739.quest_desc: ["Bring &#00D9FFPlayer Transmitter Nitro&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.53F85B1A9BC00739.quest_subtitle: "Obtain Player Transmitter Nitro"
	quest.5408C3AD40037219.quest_desc: ["The &#00D9FFPortal Gun&r creates portals you can travel through. Left-click makes a blue portal and right-click makes an orange one. It uses power."]
	quest.5408C3AD40037219.quest_subtitle: "Obtain Portalgun"
	quest.545436346CB1DFD6.quest_desc: ["A &#00D9FFMiddle Tier Storage Cell&r in normal AE2, which can contain 16,384 bytes of storage. 16,384 bytes of storage can hold 2,032 &#00D9FFStacks&r of a single item. or 1,040 &#00D9FFStacks&r,while holding 63 &#00D9FFDifferent&r items."]
	quest.545436346CB1DFD6.quest_subtitle: "Obtain Item Storage Cell 16k"
	quest.54560669033F5A82.quest_desc: ["Get hold of &#00D9FFHarvester&r. Hover over it in EMI and press R to see how it is made."]
	quest.54560669033F5A82.quest_subtitle: "Obtain Harvester"
	quest.546A1D6C611FD5B0.quest_desc: ["Used to create focus of necromancy and also provided a few benefits."]
	quest.546A1D6C611FD5B0.quest_subtitle: "Obtain Summon Focus"
	quest.546A74F503A75C96.quest_desc: ["Bring &#00D9FFAechor Petal&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.546A74F503A75C96.quest_subtitle: "Obtain Aechor Petal"
	quest.54704F03A61485EA.quest_desc: ["&#FFA500DivineRPG&r is a large adventure and progression mod with new creatures, equipment, and worlds. Explore its content at your own pace and consult EMI for unfamiliar items."]
	quest.54704F03A61485EA.title: "Getting Started"
	quest.5470DC50F2FDF094.quest_desc: ["This quest asks for &#00D9FFSquid Seeds&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5470DC50F2FDF094.quest_subtitle: "Obtain Squid Seeds"
	quest.5473549C9C867C22.quest_desc: ["The &#00D9FFDecrepit Scythe&r is a strong weapon in &#FFA500Iron's Spells 'n Spellbooks&r. In the main hand it gives 11 &#00D9FFAttack Damage&r and 1.4 &#00D9FFAttack Speed&r." "You can upgrade it into the &#00D9FFHellrazor&r with 1 &#00D9FFTimeless Slurry&r and 1 &#00D9FFPyrium Ingot&r."]
	quest.5473549C9C867C22.quest_subtitle: "Obtain Decrepit Scythe"
	quest.5477AC52145920C7.quest_desc: ["Bring Dumplings into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5477AC52145920C7.quest_subtitle: "Obtain Dumplings"
	quest.54828FDA9808FD99.quest_desc: ["Get hold of &#00D9FFPlantain Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.54828FDA9808FD99.quest_subtitle: "Obtain Plantain Sapling"
	quest.5485831755DDF5D5.quest_desc: ["Bring &#00D9FFPlum Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5485831755DDF5D5.quest_subtitle: "Obtain Plum Sapling"
	quest.548A154C22F9455E.quest_desc: ["Not just a craft component and decorative… can be slapped on &#00D9FFFluid Pipes&r, both to hold them in their orientation and prevent them from joining later adjacently placed pipes."]
	quest.548A154C22F9455E.quest_subtitle: "Obtain Copper Casing"
	quest.548AB9735D138A10.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.548AB9735D138A10.quest_subtitle: "Obtain Ultimate Injecting Factory"
	quest.548AE7B019E3AA7B.quest_desc: ["This machine calls for a whole 'nother level of strength. Time to put that new &#00D9FFTitanium&r you've made to use. The &#00D9FFPressurizer&r allows you to pressurize &#00D9FFWater&r into HP, or high pressure, water and &#00D9FFSteam&r into &#00D9FFHP Steam&r. It also works the other way around to depressurize the fluids. The &#00D9FFPressurizer&r also allows you to collect &#00D9FFLiquid Air&r via the &#00D9FFAir Intake&r, plus it's much more efficient than the &#00D9FFVacuum Freezer&r."]
	quest.548AE7B019E3AA7B.quest_subtitle: "Obtain 9x Titanium Machine Casing Pipe, Pressurizer and 10x Solid Titanium Machine Casing"
	quest.548AE7B019E3AA7B.title: "Pressurizer"
	quest.548ECF7E7EA642C5.quest_desc: ["Bring &#00D9FFInsanium Farmland&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.548ECF7E7EA642C5.quest_subtitle: "Obtain Insanium Farmland"
	quest.548FAF1B465EEDD0.quest_desc: ["Bring &#00D9FFGold Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.548FAF1B465EEDD0.quest_subtitle: "Obtain Gold Seeds"
	quest.54912D3E3E21B31D.quest_desc: ["Used in the creation of some glyphs."]
	quest.54912D3E3E21B31D.quest_subtitle: "Obtain Fire Essence"
	quest.54969178967229F2.quest_desc: ["Earn the advancement: Hill3."]
	quest.54969178967229F2.quest_subtitle: "Defeat a Twilight Wraith in a large Hollow Hill"
	quest.5498AFD674FA3707.quest_desc: ["&#00D9FFProgrammable Rotation Control&r!"]
	quest.5498AFD674FA3707.quest_subtitle: "Obtain Sequenced Gearshift"
	quest.54991AEF88B37ADD.quest_desc: ["This quest asks for &#00D9FFResistor&r. EMI shows the recipe if you press R while hovering over it."]
	quest.54991AEF88B37ADD.quest_subtitle: "Obtain Resistor"
	quest.54991AEF88B37ADD.title: "The R in RLC"
	quest.549A78E49047E439.quest_desc: ["Bring &#00D9FFConfigurable Honeycomb&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.549A78E49047E439.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.54A3C7842E902094.quest_desc: ["Make &#00D9FFthe Crystalite Chestplate&r with an &#00D9FFInfusion Ritual&r using a &#00D9FFTerminite Chestplate&r, an &#00D9FFAmber Gem and Crystal Shards&r around an &#00D9FFInfusion Pedestal&r." "Worn, it gives extra armor and permanent &#00D9FFHaste I&r."]
	quest.54A3C7842E902094.quest_subtitle: "Obtain Crystalite Chestplate"
	quest.54A3C7842E902094.title: "Crystalite Chestplate"
	quest.54A63B9174BAF730.quest_desc: ["The &#00D9FFAmulet of Teleportation&r grants &#00D9FFEvasion&r for &#00D9AA3 seconds&r after you use a teleport spell." "It lets you use teleportation to dodge incoming attacks as well as to reposition."]
	quest.54A63B9174BAF730.quest_subtitle: "Obtain Teleportation Amulet"
	quest.54AD34481E98DBBF.quest_desc: ["Funnels are fairly flexible in placement: on the sides, top or bottom. The &#00D9FFBrass Funnel&r is the upgraded version. Tip: when placed on a belt, hit a funnel with a &#00D9FFWrench&r to expand it to its full block width."]
	quest.54AD34481E98DBBF.quest_subtitle: "Obtain Andesite Funnel"
	quest.54C4EDB7AA5A310E.quest_desc: ["Shadow-&#00D9FFWalker Leggings&r are part of the &#00D9FFShadow&r-&#00D9FFWalker Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. They give &#00D9AA+6&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFEnder Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "Craft them from 7 &#00D9FFArcane Cloth&r and 1 &#00D9FFEnder Rune&r, or upgrade &#00D9FFWizard Leggings&r with 1 &#00D9FFEnder Rune&r at a &#00D9FFSmithing Table&r in supported versions. Runestones are used for stronger school-specific armor."]
	quest.54C4EDB7AA5A310E.quest_subtitle: "Obtain Shadowwalker Leggings"
	quest.54D0D040DA21A329.quest_desc: ["Bring &#00D9FFSparkle Cherry Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.54D0D040DA21A329.quest_subtitle: "Obtain Sparkle Cherry Sapling"
	quest.54D75D95A8447CE1.quest_desc: ["For both assembling your trains and, well, being train stations."]
	quest.54D75D95A8447CE1.quest_subtitle: "Obtain Track Station"
	quest.54E617FB4EAF6D61.quest_desc: ["Use this to configure source relays and automation entities."]
	quest.54E617FB4EAF6D61.quest_subtitle: "Obtain Dominion Wand"
	quest.54E97DF9649B0954.quest_desc: ["The &#00D9FFHoglin Trophy&r is a decorative block from &#FFA500My Nether's Delight&r. It works as a keepsake of your &#00D9FFNether&r adventures and your fights with its dangerous mobs."]
	quest.54E97DF9649B0954.quest_subtitle: "Obtain Hoglin Trophy"
	quest.54F40B7042EB8A98.quest_desc: ["Bring &#00D9FFOld Fustic Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.54F40B7042EB8A98.quest_subtitle: "Obtain Old Fustic Sapling"
	quest.54FCC1E9A6303FAD.quest_desc: ["The &#00D9FFGarden Cloche&r grows crops in a controlled setup. Open its screen and check EMI for the soils and plants it supports."]
	quest.54FCC1E9A6303FAD.quest_subtitle: "Obtain Cloche"
	quest.55018ADB9008498D.quest_desc: ["Get hold of &#00D9FFEnergy Hopper Spirited&r. Hover over it in EMI and press R to see how it is made."]
	quest.55018ADB9008498D.quest_subtitle: "Obtain Energy Hopper Spirited"
	quest.550C1BAD098D97F8.quest_desc: ["Get hold of &#00D9FFWorkbench&r. Hover over it in EMI and press R to see how it is made."]
	quest.550C1BAD098D97F8.quest_subtitle: "Obtain Workbench"
	quest.551505F4EC862817.quest_desc: ["The &#00D9FFMoonring Greatsword&r is a lunar-themed weapon that can be crafted in some versions or configurations of &#FFA500Eternal Starlight&r."]
	quest.551505F4EC862817.quest_subtitle: "Obtain Moonring Greatsword"
	quest.551505F4EC862817.title: "Moonring Greatsword"
	quest.551573CBF238C6EC.quest_desc: ["Get hold of &#00D9FFStars Edge&r. Hover over it in EMI and press R to see how it is made."]
	quest.551573CBF238C6EC.quest_subtitle: "Obtain Stars Edge"
	quest.552A7195A247DA5B.quest_desc: ["The &#00D9FFTraveler's Wings&r are crafted from magical resources found in the &#FFA500Twilight Forest&r. They do not grant true flight, but let you glide over long distances, which makes exploring faster and safer." "They are handy for crossing ravines and cliffs and reaching places that are otherwise hard to get to."]
	quest.552A7195A247DA5B.quest_subtitle: "Obtain Travellers Wings"
	quest.553A0826A531DECD.quest_desc: ["&#FFA500Ice and Fire&r adds formidable creatures, including dragons, along with related equipment and discoveries. Observe the dangers from a safe distance and prepare before engaging."]
	quest.553A0826A531DECD.title: "Getting Started"
	quest.553E642DBDD047ED.quest_desc: ["Bring &#00D9FFGhostly Mantle&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.553E642DBDD047ED.quest_subtitle: "Obtain Ghostly Mantle"
	quest.554166DF244AE6DC.quest_desc: ["Bring &#00D9FFBlack Cherry Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.554166DF244AE6DC.quest_subtitle: "Obtain Black Cherry Sapling"
	quest.5563212C7059C690.quest_desc: ["Bring &#00D9FFButternut Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5563212C7059C690.quest_subtitle: "Obtain Butternut Sapling"
	quest.556B6540231D5D2A.quest_desc: ["This quest asks for &#00D9FFTime Traveller Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.556B6540231D5D2A.quest_subtitle: "Obtain Time Traveller Sapling"
	quest.556CD406202CFA44.quest_desc: ["This quest asks for &#00D9FFEnergy Discharger Spirited&r. EMI shows the recipe if you press R while hovering over it."]
	quest.556CD406202CFA44.quest_subtitle: "Obtain Energy Discharger Spirited"
	quest.55964C3EF312FCC3.quest_desc: ["Kobolediators are strong elite warriors from &#FFA500Cataclysm&r that guard the depths of the &#00D9FFCursed Pyramid&r with heavy weapons." "They protect the path to the &#00D9FFAncient Remnant&r. Defeat one."]
	quest.55964C3EF312FCC3.quest_subtitle: "Defeat Kobolediator"
	quest.55964C3EF312FCC3.title: "Kobolediator"
	quest.55A7FB72B95316C1.quest_desc: ["This machine produces &#00D9FFCompressed Air&r. To operate it, place any solid-fuel item that can burn in a &#00D9FFFurnace&r into the fuel slot. Please note that fuel buckets are not compatible; for liquid fuels, use a &#00D9FFLiquid Compressor&r instead."]
	quest.55A7FB72B95316C1.quest_subtitle: "Obtain Air Compressor"
	quest.55AE2E483A7378B7.quest_desc: ["Ether is a volatile liquid in &#FFA500Eternal Starlight&r that you can collect with a bucket." "Unlike lava it does not destroy items, but it is still dangerous to handle."]
	quest.55AE2E483A7378B7.quest_subtitle: "Obtain Ether Bucket"
	quest.55C59AEBE1A1E96B.quest_desc: ["Get hold of &#00D9FFMixed Salad&r. Hover over it in EMI and press R to see how it is made."]
	quest.55C59AEBE1A1E96B.quest_subtitle: "Obtain Mixed Salad"
	quest.55D73B77B111F117.quest_desc: ["The &#00D9FFPump Upgrade&r lets your storage transfer fluids to and from connected fluid systems, which makes automated fluid handling easier." "The &#00D9FFAdvanced Pump Upgrade&r adds more control and filtering options. The &#00D9FFExperience Pump Upgrade&r lets your storage handle experience and transfer it when needed."]
	quest.55D73B77B111F117.quest_subtitle: "Obtain Pump Upgrade, Advanced Pump Upgrade and Xp Pump Upgrade"
	quest.55D73B77B111F117.title: "Pump, Advanced Pump and Experience Pump Upgrade"
	quest.55DE7DCF31A45D9E.quest_desc: ["Get hold of &#00D9FFStuffed Potato&r. Hover over it in EMI and press R to see how it is made."]
	quest.55DE7DCF31A45D9E.quest_subtitle: "Obtain Stuffed Potato"
	quest.55DEBC832812CF8F.quest_desc: ["Bring &#00D9AA36x&r &#00D9FFReactor Basic&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.55DEBC832812CF8F.quest_subtitle: "Obtain 36x Reactor Basic"
	quest.55DEBC832812CF8F.title: "Reactor (Basic)"
	quest.55E8C6D47904BB82.quest_desc: ["Get hold of &#00D9FFChicken Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.55E8C6D47904BB82.quest_subtitle: "Obtain Chicken Seeds"
	quest.55F46067FA02A024.quest_desc: ["Adds a jukebox to the backpack."]
	quest.55F46067FA02A024.quest_subtitle: "Obtain Jukebox Upgrade"
	quest.560969584D4C4400.quest_desc: ["The &#00D9FFChemical Oxidizer&r is used for making gases from materials. It's left side accepts incoming materials, while it's right side dispenses the gas created from those materials."]
	quest.560969584D4C4400.quest_subtitle: "Obtain Chemical Oxidizer"
	quest.560B2C83B7DE350D.quest_desc: ["This substance is used in a &#00D9FFThermopneumatic Processing Plant&r with &#00D9FFCoal&r to produce &#00D9FFPlastic&r. It is a superior liquid fuel and can also be placed in a &#00D9FFFurnace&r."]
	quest.560B2C83B7DE350D.quest_subtitle: "Obtain Lpg Bucket"
	quest.560B2C83B7DE350D.title: "LPG"
	quest.561A6175E04A6634.quest_desc: ["&#00D9FFLightning Rune&r is a crafting ingredient in &#FFA500Iron's Spells 'n Spellbooks&r, used for advanced &#00D9FFLightning&r crafting such as &#00D9FFLightning Upgrade Orbs&r. The Lightning school uses &#00D9FFBottle&r o' &#00D9FFLightning&r as its &#00D9FFFocus&r." "Combine 1 &#00D9FFBlank Runestone&r with 8 &#00D9FFBottles&r o' &#00D9FFLightning&r to make one."]
	quest.561A6175E04A6634.quest_subtitle: "Obtain Lightning Rune"
	quest.561AF9843D55966C.quest_desc: ["Craft a &#00D9FFCursium Helmet&r from &#FFA500Cataclysm&r by upgrading a &#00D9FFNetherite Helmet&r with a &#00D9FFCursium Upgrade Smithing Template&r and a &#00D9FFCursium Ingot&r at a &#00D9FFSmithing Table&r." "It belongs to the &#00D9FFCursium&r armor set and grants &#00D9FFGhost Vision&r, which reveals living entities through walls."]
	quest.561AF9843D55966C.quest_subtitle: "Obtain Cursium Helmet"
	quest.5632FB0D793F2720.quest_desc: ["&#00D9FFWizard Boots&r are part of the basic &#00D9FFWizard Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. They give &#00D9AA+3&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "Wear them to complete the &#00D9FFWizard&r set."]
	quest.5632FB0D793F2720.quest_subtitle: "Obtain Wizard Boots"
	quest.56395334C532D306.quest_desc: ["Bring &#00D9FFRubber Tree Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.56395334C532D306.quest_subtitle: "Obtain Rubber Tree Sapling"
	quest.563F1D4928570796.quest_desc: ["Upgrade &#00D9FFTerminite Leggings&r with an &#00D9FFAeternium Forged Plate&r at a &#00D9FFSmithing Table&r to craft &#00D9FFAeternium Leggings&r." "They complete &#00D9FFBetter End's&r top armor tier, made for the most dangerous fights."]
	quest.563F1D4928570796.quest_subtitle: "Obtain Aeternium Leggings"
	quest.564E10E67012E447.quest_desc: ["This gem is able to store most mobs inside it, for easy transport."]
	quest.564E10E67012E447.quest_subtitle: "Obtain Soul Gem"
	quest.565971DD1DC0ECD4.quest_desc: ["Multiplies the number of items that fit in each slot by 4."]
	quest.565971DD1DC0ECD4.quest_subtitle: "Obtain Stack Upgrade Tier 2"
	quest.565A82F5628F3940.quest_desc: ["Using &#00D9FFthe Scroll Forge&r and a &#00D9FFFrozen Bone&r to craft an &#00D9FFIce Scrolls&r."]
	quest.565A82F5628F3940.quest_subtitle: "Obtain Scroll"
	quest.565C945151442FE0.quest_desc: ["Notable rituals: &#00D9FFConjure Island&r: Desert converts the area around it into another biome. Disintegration needs both source and experience in item form, and using a stack at a time is a hassle, so it may not be worth it."]
	quest.565C945151442FE0.quest_subtitle: "Obtain Ritual Disintegration, Ritual Sunrise and Ritual Conjure Island Desert"
	quest.565C945151442FE0.title: "Red Tablets"
	quest.566DC620374FC300.quest_desc: ["The energized smelter is your basic electric furnace that uses energy instead of fuel to smelt items."]
	quest.566DC620374FC300.quest_subtitle: "Obtain Energized Smelter"
	quest.567EBD733A7FE49A.quest_desc: ["Use &#00D9FFthe Configurator&r to open, edit or delete networks from anywhere. Shift-right-click a connector to copy its settings, then right-click another connector to paste them." "Right-clicking anything else opens the network screen, where you can also rename the &#00D9FFConfigurator&r."]
	quest.567EBD733A7FE49A.quest_subtitle: "Manage networks and copy connector settings"
	quest.56843154A56360DF.quest_desc: ["&#00D9FFEnder Rune&r is a crafting ingredient in &#FFA500Iron's Spells 'n Spellbooks&r, used for advanced &#00D9FFEnder&r crafting such as the &#00D9FFEnder Upgrade Orb&r. The Ender school uses &#00D9FFEnder Pearl&r as its &#00D9FFFocus&r." "Combine 1 &#00D9FFBlank Runestone&r with 8 &#00D9FFEnder Pearls&r to make one."]
	quest.56843154A56360DF.quest_subtitle: "Obtain Ender Rune"
	quest.568AFFD1946E87E4.quest_desc: ["This quest asks for &#00D9FFCelestigem Boots&r. EMI shows the recipe if you press R while hovering over it."]
	quest.568AFFD1946E87E4.quest_subtitle: "Obtain Celestigem Boots"
	quest.5695223839DAEDE9.quest_desc: ["Bring &#00D9FFFurnator Nitro&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5695223839DAEDE9.quest_subtitle: "Obtain Furnator Nitro"
	quest.569AAE39DE56597A.quest_desc: ["After unlocking an &#00D9FFEldritch&r scroll with a &#00D9FFManuscript&r, use an &#00D9FFEcho Shard&r in the &#00D9FFScroll Forge&r to craft &#00D9FFEldritch&r spells. They can only be crafted with &#00D9FFLegendary Ink&r." "&#00D9FFAbyssal Shroud&r turns you into an enderman that teleports away when attacked. &#00D9FFEldritch Blast&r fires up to 7 blasts of energy, each reaching up to &#00D9AA30 blocks&r. &#00D9FFPlanar Sight&r lets you see any entity within render distance."]
	quest.569AAE39DE56597A.quest_subtitle: "Obtain Echo Shard"
	quest.56B33BEA6CD9F2E9.quest_desc: ["Captures both monsters and animals."]
	quest.56B33BEA6CD9F2E9.quest_subtitle: "Obtain Creaturecatcher"
	quest.56D0FFBF354E9F19.quest_desc: ["Bring &#00D9FFFurnator Blazing&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.56D0FFBF354E9F19.quest_subtitle: "Obtain Furnator Blazing"
	quest.56D42BA7AB71A083.quest_desc: ["The Bio-&#00D9FFGenerator&r takes biofuel to generate power. You can make biofuel by crushing down almost any organic based material."]
	quest.56D42BA7AB71A083.quest_subtitle: "Obtain Bio Generator"
	quest.56D42BA7AB71A083.title: "Bio-Generator"
	quest.56E52560258EB049.quest_desc: ["This quest asks for &#00D9FFSingularity&r. EMI shows the recipe if you press R while hovering over it."]
	quest.56E52560258EB049.quest_subtitle: "Obtain Singularity"
	quest.56E52560258EB049.title: "Pocket Black Hole"
	quest.570E23CBBC8F7D93.quest_desc: ["Upgrade an &#00D9FFEchoing Deepshelf&r with a &#00D9FFWarden Tendril&r, a &#00D9FFSculk Catalyst and Sculk&r. The tendril drops from the &#00D9FFWarden&r, so prepare well." "It gives &#00D9AA+10&r &#00D9FFEterna&r (up to 80), &#00D9AA+10&r &#00D9FFQuanta&r, &#00D9AA+15&r &#00D9FFArcana&r and &#00D9AA+1&r &#00D9FFClue&r."]
	quest.570E23CBBC8F7D93.quest_subtitle: "Obtain Echoing Sculkshelf"
	quest.571A3278898D55F7.quest_desc: ["Make &#00D9FFthe Warden Sword&r in a &#00D9FFMechanical Crafter&r using a &#00D9FFNetherite Sword&r, &#00D9FFEcho Ingots&r, a &#00D9FFReinforced Echo Shard&r and a &#00D9FFWarden Upgrade Template&r."]
	quest.571A3278898D55F7.quest_subtitle: "Obtain Warden Sword"
	quest.573007C25B63A94A.quest_desc: ["Get hold of &#00D9FFEnder Cell Niotic&r. Hover over it in EMI and press R to see how it is made."]
	quest.573007C25B63A94A.quest_subtitle: "Obtain Ender Cell Niotic"
	quest.5737E6152282101F.quest_desc: ["The &#00D9FFCrafting Blueprint&r saves crafting recipes so you can craft them on demand. Place it like a painting, right-click a slot and insert the ingredients to save a recipe. Filters let a slot accept multiple recipes." "Right-click the &#00D9FFBlueprint&r to craft using available materials, or &#00D9FFShift&r + right-click to craft up to a full stack. Left-click removes a saved recipe. It can cover up to 3×&#00D9AA3 blocks&r."]
	quest.5737E6152282101F.quest_subtitle: "Obtain Crafting Blueprint"
	quest.57457A03BC29CD0F.quest_desc: ["Crafted by infusing &#00D9FFObsidian Dust&r with &#00D9FFDiamond Dust&r or &#00D9FFCompressed Diamond&r in the &#00D9FFMetallurgic Infuser&r."]
	quest.57457A03BC29CD0F.quest_subtitle: "Obtain Dust Refined Obsidian"
	quest.5760FD83AC802D74.quest_desc: ["Bring &#00D9FFTuscarora Crepe Myrtle Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5760FD83AC802D74.quest_subtitle: "Obtain Tuscarora Crepe Myrtle Sapling"
	quest.576B2CCE6BAA4A0D.quest_desc: ["&#00D9FFAmadron Tablets&r allow you to order items and fluids, functioning like &#00D9FFVillager Trading&r but with the added benefit of delivery by &#00D9FFDrones&r, much cooler than dealing with &#00D9FFVillagers&r. To use the &#00D9FFTablet&r, specify pick-up and drop-off locations by right-clicking on the inventory or tank with the &#00D9FFTablet&r."]
	quest.576B2CCE6BAA4A0D.quest_subtitle: "Obtain Amadron Tablet"
	quest.5782D9AC2F601F6B.quest_desc: ["It is stored in the secret vault of the labyrinth."]
	quest.5782D9AC2F601F6B.quest_subtitle: "Find the Mazebreaker pickaxe"
	quest.578D180F2DD79D7B.quest_desc: ["Using a &#00D9FFScroll Forge&r and an &#00D9FFEmerald&r create an &#00D9FFEvocation Scrolls&r."]
	quest.578D180F2DD79D7B.quest_subtitle: "Obtain Scroll"
	quest.578E1D412686F874.quest_desc: ["A &#FFA500Mekanism&r machine upgrade to make them process a bit quiet. Install full 4 upgrades to completely muff the machines noises."]
	quest.578E1D412686F874.quest_subtitle: "Obtain Upgrade Muffling"
	quest.579D119E48AEB4EB.quest_desc: ["Increases your mana regeneration."]
	quest.579D119E48AEB4EB.quest_subtitle: "Obtain Amulet of Mana Regen"
	quest.57A1832B650C95E7.quest_desc: ["&#00D9FFWizard Leggings&r are part of the basic &#00D9FFWizard Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. They give &#00D9AA+6&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "You can craft them from 7 &#00D9FFArcane Cloth&r."]
	quest.57A1832B650C95E7.quest_subtitle: "Obtain Wizard Leggings"
	quest.57AC7CB719C65969.quest_desc: ["A &#00D9FFFlux Point&r extracts energy from the network. It can output from every side at the same time."]
	quest.57AC7CB719C65969.quest_subtitle: "Pulls energy out of the network"
	quest.57C22655F8E5774D.quest_desc: ["The &#00D9FFAccumulator Processor&r is used for all of the &#00D9FFMEGA Storage Components&r."]
	quest.57C22655F8E5774D.quest_subtitle: "Obtain Accumulation Processor"
	quest.57C2497A99C83C03.quest_desc: ["Astrape from &#FFA500Cataclysm&r deals 10.5 attack damage and can launch a &#00D9FFLightning Spear&r." "The spear does lightning damage and leaves a static field that keeps hurting nearby creatures. Craft it with 2 &#00D9FFEssence&r of the &#00D9FFStorm&r and 3 &#00D9FFLacrima&r."]
	quest.57C2497A99C83C03.quest_subtitle: "Obtain Astrape"
	quest.57C2497A99C83C03.title: "Astrape"
	quest.57D0D16B8B6FABBC.quest_desc: ["Bring &#00D9FFYeti Helmet&r, &#00D9FFYeti Chestplate&r, &#00D9FFYeti Leggings and Yeti Boots&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.57D0D16B8B6FABBC.quest_subtitle: "Craft a full set of Yeti Armor"
	quest.57D0D16B8B6FABBC.title: "Yeti Armorer"
	quest.57D905CBEEF23465.quest_desc: ["Get hold of &#00D9FFThermo Generator Niotic&r. Hover over it in EMI and press R to see how it is made."]
	quest.57D905CBEEF23465.quest_subtitle: "Obtain Thermo Generator Niotic"
	quest.57E7527B3AE717E0.quest_desc: ["The &#00D9FFTime Wand&r speeds up block entities such as machines and furnaces. Fill it with &#00D9FFTime Fluid&r and power to use it."]
	quest.57E7527B3AE717E0.quest_subtitle: "Obtain Time Wand"
	quest.57FC1DFC6D27AA44.quest_desc: ["Variants to find: Badlands, &#00D9FFBamboo&r, &#00D9FFBirch&r, &#00D9FFCrimson&r, &#00D9FFCherry&r, &#00D9FFDark Forest&r, &#00D9FFGiant Taiga&r, &#00D9FFJungle&r, &#00D9FFMountains&r, &#00D9FFMushroom&r, Oak, &#00D9FFOcean&r, &#00D9FFSwamp and Warped&r."]
	quest.57FC1DFC6D27AA44.quest_subtitle: "Find all 14 Village variants"
	quest.5807A3FB4E4A3EA3.quest_desc: ["The &#00D9FFFlowglaze Axe&r is both a tool and a weapon from &#FFA500Eternal Starlight&r in the &#00D9FFFlowglaze&r tier." "It is crafted from &#00D9FFFlowglaze&r materials and fits mid-to-late game."]
	quest.5807A3FB4E4A3EA3.quest_subtitle: "Obtain Flowglaze Axe"
	quest.580B7447D8DAE769.quest_desc: ["The &#00D9FFIndustrial Casing&r from &#FFA500Create: Dreams n' Desires&r is a sturdy building block for advanced machinery and larger mechanical systems. It is the base for more demanding factory builds."]
	quest.580B7447D8DAE769.quest_subtitle: "Obtain Industrial Casing"
	quest.58192317181791CD.quest_desc: ["This quest asks for &#00D9FFNano Quantum Helmet&r, &#00D9FFNano Quantum Chestplate&r, &#00D9FFNano Quantum Leggings and Nano Quantum Boots&r. EMI shows the recipe if you press R while hovering over it."]
	quest.58192317181791CD.quest_subtitle: "Obtain Nano Quantum Helmet, Nano Quantum Chestplate, Nano Quantum Leggings and Nano Quantum Boots"
	quest.58192317181791CD.title: "Quantum Nano Set"
	quest.58201F1F2E5301E8.quest_desc: ["4 pedestals are needed to use the &#00D9FFAwakening Altar&r."]
	quest.58201F1F2E5301E8.quest_subtitle: "Obtain 4x Awakening Pedestal"
	quest.58201F1F2E5301E8.title: "Awakening Pedestal"
	quest.582D3D0E840593DC.quest_desc: ["This quest asks for &#00D9FFAquilaria Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.582D3D0E840593DC.quest_subtitle: "Obtain Aquilaria Sapling"
	quest.58374602DC0D8189.quest_desc: ["This quest asks for &#00D9FFMushroom Rice&r. EMI shows the recipe if you press R while hovering over it."]
	quest.58374602DC0D8189.quest_subtitle: "Obtain Mushroom Rice"
	quest.5838285BF1AD308C.quest_desc: ["Automatically uses potions, milk buckets, or food with effects on nearby players."]
	quest.5838285BF1AD308C.quest_subtitle: "Obtain Alchemy Upgrade"
	quest.583A580BF8561A66.quest_desc: ["Bring &#00D9FFSulfur Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.583A580BF8561A66.quest_subtitle: "Obtain Sulfur Seeds"
	quest.584F07C31B01C578.quest_desc: ["This quest asks for &#00D9FFEnder Gate Starter&r. EMI shows the recipe if you press R while hovering over it."]
	quest.584F07C31B01C578.quest_subtitle: "Obtain Ender Gate Starter"
	quest.5862FD2BB97DBBEF.quest_desc: ["Bring &#00D9FFTotem of Death Recall&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5862FD2BB97DBBEF.quest_subtitle: "Obtain Totem of Death Recall"
	quest.587BC74FBAD5C41D.quest_desc: ["Lithium dust can be created by putting gaseous &#00D9FFLithium&r in a chemical crystalliser. Lithium can be obtained by putting &#00D9FFBrine&r into an &#00D9FFEvaporation Plant&r."]
	quest.587BC74FBAD5C41D.quest_subtitle: "Obtain Dust Lithium"
	quest.587E8746261103A4.quest_desc: ["Get hold of &#00D9FFGranny Smith Apple Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.587E8746261103A4.quest_subtitle: "Obtain Granny Smith Apple Sapling"
	quest.5885BA8CA0DBFD3D.quest_desc: ["The &#00D9FFBlazing Grips&r from &#FFA500Cataclysm&r are legendary gauntlets infused with the &#00D9FFNether's&r flames." "They let you unleash strong fiery attacks, and make a fitting trophy from the &#00D9FFNether&r."]
	quest.5885BA8CA0DBFD3D.quest_subtitle: "Obtain Blazing Grips"
	quest.589D884468EFC2E8.quest_desc: ["Bring &#00D9FFStrider Slice&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.589D884468EFC2E8.quest_subtitle: "Obtain Strider Slice"
	quest.589D9DE912C34D76.quest_desc: ["The &#00D9FFSuper Enchanting Template&r from &#FFA500Create: Enchantment Industry&r is made by pressing a &#00D9FFBlock of Super Experience&r with a &#00D9FFMechanical Press&r." "It is used for &#00D9FFSuper Enchanting&r to transfer or remove enchantments beyond normal limits, and must be processed in a &#00D9FFBlaze Forger&r set to &#00D9FFSuper Enchanting&r mode."]
	quest.589D9DE912C34D76.quest_subtitle: "Obtain Super Enchanting Template"
	quest.58B2E6215EB69587.quest_desc: ["The &#00D9FFDeepsilver Boots&r is crafted from &#00D9FFDeepsilver Ingots&r in &#FFA500Eternal Starlight&r." "Deepsilver armor raises movement speed, attack speed and knockback resistance. The full set also grants immunity to several negative status effects."]
	quest.58B2E6215EB69587.quest_subtitle: "Obtain Deepsilver Boots"
	quest.58C45A8D5B5FE0CE.quest_desc: ["Transporter spirits, as one may expect, can transfer items between containers. That includes &#00D9FFDimensional Storage&r, and other spirits."]
	quest.58C45A8D5B5FE0CE.quest_subtitle: "Obtain Book of Binding Bound Foliot, Minecart, Dispenser and Hopper. Earn the advancement: Summon Foliot Transport Items"
	quest.58C45A8D5B5FE0CE.title: "Ritual: Summon Foliot Transporter"
	quest.58D191083F0F5E27.quest_desc: ["The chestplate of the &#00D9FFImperium&r armor set. Together with the leggings, it unlocks the helmet."]
	quest.58DB0F8F3113AC3A.quest_desc: ["Bring &#00D9FFMold Plate&r, &#00D9FFMold Gear&r, &#00D9FFMold Rod and Mold Wire&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.58DB0F8F3113AC3A.quest_subtitle: "Obtain Mold Plate, Mold Gear, Mold Rod and Mold Wire"
	quest.58F3A6DAABAC505E.quest_desc: ["Use a &#00D9FFTome of Extraction&r on an enchanted item in an &#00D9FFAnvil&r to move all its enchantments onto an &#00D9FFEnchanted Book&r. Unlike &#00D9FFthe Scrapping&r tomes, the item is preserved."]
	quest.58F3A6DAABAC505E.quest_subtitle: "Obtain Extraction Tome"
	quest.58F4FA7E46B1F9D2.quest_desc: ["Tier 1 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.58F4FA7E46B1F9D2.quest_subtitle: "Obtain Glyph Bounce"
	quest.5905756CBF77C076.quest_desc: ["Get hold of &#00D9FFRaw Osmium&r. Hover over it in EMI and press R to see how it is made."]
	quest.5905756CBF77C076.quest_subtitle: "Obtain Raw Osmium"
	quest.591DFC78708CC956.quest_desc: ["Bring &#00D9FFAlder Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.591DFC78708CC956.quest_subtitle: "Obtain Alder Sapling"
	quest.5925AD7C309A579B.quest_desc: ["This quest asks for &#00D9FFConfigurable Honeycomb&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5925AD7C309A579B.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.5925CDB7C3DED2F8.quest_desc: ["Bring &#00D9FFAmethyst Rapier&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5925CDB7C3DED2F8.quest_subtitle: "Obtain Amethyst Rapier"
	quest.5928E1DE506333BE.quest_desc: ["Enter an &#00D9FFEnd Portal&r to reach the End, a dimension of void and floating islands where the &#00D9FFEnder Dragon&r lives." "It opens the way to &#00D9FFBetter End's&r new biomes and strong late-game gear."]
	quest.5928E1DE506333BE.quest_subtitle: "Travel to The End"
	quest.5928E1DE506333BE.title: "The End"
	quest.593D941609297E5A.quest_desc: ["Bring &#00D9FFOrange Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.593D941609297E5A.quest_subtitle: "Obtain Orange Sapling"
	quest.59408E596F262032.quest_desc: ["This quest asks for &#00D9AA8x&r &#00D9FFDielectric Rod&r and &#00D9AA8x&r &#00D9FFDielectric Rod Horizontal&r. EMI shows the recipe if you press R while hovering over it."]
	quest.59408E596F262032.quest_subtitle: "Obtain 8x Dielectric Rod and 8x Dielectric Rod Horizontal"
	quest.596104C336DED4D8.quest_desc: ["The &#00D9FFTeleportation Core&r is a &#00D9FFCrafting Component&r used in the crafting of the &#00D9FFPortable Teleporter&r, the &#00D9FFTeleporter&r and the &#00D9FFDigital Miner&r."]
	quest.596104C336DED4D8.quest_subtitle: "Obtain Teleportation Core"
	quest.596EE214DE2D3ADB.quest_desc: ["Blocks placed around the &#00D9FFApothic Enchanting Table&r can add bonuses. Candles raise &#00D9FFEterna&r, and &#00D9FFMob Heads and Skulls&r give different bonuses depending on the type, such as &#00D9FFQuanta&r or &#00D9FFArcana&r. They work alongside your shelves without using up shelf slots."]
	quest.596EE214DE2D3ADB.quest_subtitle: "Obtain Smart Filter"
	quest.596EE214DE2D3ADB.title: "Enchanting Catalysts"
	quest.596FB815E5EE5183.quest_desc: ["Bring &#00D9FFTangerine Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.596FB815E5EE5183.quest_subtitle: "Obtain Tangerine Sapling"
	quest.59766A965BB25104.quest_desc: ["The &#00D9FFHarbinger's Music Disc&r contains &#00D9FFSelf&r-&#00D9FFDestruct Sequence&r, the theme of the fight against &#00D9FFThe Harbinger&r."]
	quest.59766A965BB25104.quest_subtitle: "Obtain Music Disc the Harbinger"
	quest.598BE22C08E7CEFC.quest_desc: ["Make &#00D9FFthe Resonarium Boots&r in a &#00D9FFMechanical Crafter&r using a &#00D9FFDiamond Boots&r, &#00D9FFSturdy Sheets&r, a &#00D9FFResonarium Plate&r and a &#00D9FFResonarium Upgrade Template&r." "The template can be found in &#00D9FFAncient Cities&r, &#00D9FFTrial Chambers and Strongholds&r."]
	quest.598BE22C08E7CEFC.quest_subtitle: "Obtain Resonarium Boots"
	quest.599AEE2B5B814A71.quest_desc: ["Get hold of &#00D9FFDeepslate Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.599AEE2B5B814A71.quest_subtitle: "Obtain Deepslate Seeds"
	quest.59A6A9C1DD04C53A.quest_desc: ["This machine drops &#00D9FFItems&r into the world."]
	quest.59A6A9C1DD04C53A.quest_subtitle: "Obtain Droppert1"
	quest.59A911D20AA336EA.quest_desc: ["Automates the furnace using items from the backpack."]
	quest.59A911D20AA336EA.quest_subtitle: "Obtain Auto Smelting Upgrade"
	quest.59AB04527499B229.quest_desc: ["The chestplate of the &#00D9FFInferium&r armor set. Together with the leggings, it unlocks the helmet."]
	quest.59B1143FF8336A1F.quest_desc: ["Get hold of &#00D9FFBlazegold Pickaxe&r. Hover over it in EMI and press R to see how it is made."]
	quest.59B1143FF8336A1F.quest_subtitle: "Obtain Blazegold Pickaxe"
	quest.59C340E40A7FC0F7.quest_desc: ["Bring &#00D9FFCreeper Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.59C340E40A7FC0F7.quest_subtitle: "Obtain Creeper Seeds"
	quest.59CB785ED2B137B4.quest_desc: ["Pour the liquid into the world or chill it in an inventory with a &#00D9FFHeat Frame&r to solidify it into &#00D9FFPlastic Sheets&r. Using a &#00D9FFHeat Frame&r may yield better results."]
	quest.59CB785ED2B137B4.quest_subtitle: "Obtain Plastic Bucket"
	quest.59CB785ED2B137B4.title: "Molten Plastic"
	quest.59D463F0C0DE61DE.quest_desc: ["Halves the cook time of smoking recipes, but the furnace can only process smoking recipes."]
	quest.59D463F0C0DE61DE.quest_subtitle: "Obtain Augment Smoking"
	quest.59D7A1F1F17B834D.quest_desc: ["The &#00D9FFTwilight Lich&r is a major boss that lives in a large, corrupted tower full of undead magic. It commands skeletons and dark spells to defend its home." "The fight involves shields, magical projectiles and summoned minions, so come prepared."]
	quest.59D7A1F1F17B834D.quest_subtitle: "Defeat Lich"
	quest.59D7A1F1F17B834D.title: "Twilight Lich"
	quest.59E79D81F69C5C45.quest_desc: ["Get hold of &#00D9FFBoxwood Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.59E79D81F69C5C45.quest_subtitle: "Obtain Boxwood Sapling"
	quest.59EE242A52A77DCE.quest_desc: ["This quest asks for &#00D9FFStuffed Pumpkin Block&r. EMI shows the recipe if you press R while hovering over it."]
	quest.59EE242A52A77DCE.quest_subtitle: "Obtain Stuffed Pumpkin Block"
	quest.59F535E72CDBF7D9.quest_desc: ["Bring &#00D9FFInvar Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.59F535E72CDBF7D9.quest_subtitle: "Obtain Invar Seeds"
	quest.5A1EE986FD863870.quest_desc: ["Bring &#00D9FFLimited Iron Barrel&r 2 into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5A1EE986FD863870.quest_subtitle: "Obtain Limited Iron Barrel 2"
	quest.5A21EE5AEF40FFCD.quest_desc: ["The &#00D9FFVampiric Spell Book&r is a strong &#00D9FFBlood&r magic spellbook from &#FFA500Iron's Spells 'n Spellbooks&r. It adds &#00D9AA+1 level&r to &#00D9FFBlood Slash and Blood Step&r, and gives &#00D9AA+10%&r &#00D9FFBlood Spell Power&r, &#00D9AA+10%&r &#00D9FFSpell Resistance&r and &#00D9AA+200&r &#00D9FFMax Mana&r when equipped."]
	quest.5A21EE5AEF40FFCD.quest_subtitle: "Obtain Cursed Doll Spell Book"
	quest.5A2763AA6D473387.quest_desc: ["Make &#00D9FFthe Warden Pickaxe&r in a &#00D9FFMechanical Crafter&r using a &#00D9FFNetherite Pickaxe&r, &#00D9FFEcho Ingots&r, a &#00D9FFReinforced Echo Shard&r and a &#00D9FFWarden Upgrade Template&r."]
	quest.5A2763AA6D473387.quest_subtitle: "Obtain Warden Pickaxe"
	quest.5A34F69B6E170B00.quest_desc: ["Charges every item in your inventory that needs power. It pairs well with the &#00D9FFFuel Canister&r."]
	quest.5A34F69B6E170B00.quest_subtitle: "Obtain Pocket Generator"
	quest.5A3D7080068189F4.quest_desc: ["Tier 3 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.5A3D7080068189F4.quest_subtitle: "Obtain Glyph Intangible"
	quest.5A4A78398CB1737F.quest_desc: ["&#00D9FFRed Fertilizer&r speeds up crop growth."]
	quest.5A4A78398CB1737F.quest_subtitle: "A faster fertilizer for crops"
	quest.5A58AFE2E7E6BE73.quest_desc: ["Turns the wearer invisible."]
	quest.5A58AFE2E7E6BE73.quest_subtitle: "Obtain Scarf of Invisibility"
	quest.5A70F71BC20CB82D.quest_desc: ["This quest asks for &#00D9FFMolten Edge&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5A70F71BC20CB82D.quest_subtitle: "Obtain Molten Edge"
	quest.5A7A1F75252F820E.quest_desc: ["An &#00D9FFImport Bus&r pulls items from an attached inventory into your ME network. Configure its filters and connect it to a chest or machine output."]
	quest.5A7A1F75252F820E.title: "Import Items into Storage"
	quest.5A7B2AA840270C1B.quest_desc: ["This quest asks for &#00D9FFDate Palm Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5A7B2AA840270C1B.quest_subtitle: "Obtain Date Palm Sapling"
	quest.5AB02C8BF55AB237.quest_desc: ["A &#00D9FFKinetic Dynamo&r is needed to turn its rotation into FE."]
	quest.5AB02C8BF55AB237.quest_subtitle: "Obtain Watermill"
	quest.5ABB1E1E00F4C232.quest_desc: ["With them you can.. Drive close, parallel &#00D9FFShafts&r* with the same rotation, or. Have any of them turned 90° to the others, and.. Speed doubling, or halving, with a &#00D9FFChain Gearshift&r and a touch of redstone! (* or &#00D9FFEncased Fans&r, etc)."]
	quest.5ABB1E1E00F4C232.quest_subtitle: "Obtain Encased Chain Drive"
	quest.5ABD0A8BF4340B86.quest_desc: ["Craft a full set of iron tools: pickaxe, axe and sword. They help you gather resources faster and handle tougher challenges."]
	quest.5ABD0A8BF4340B86.quest_subtitle: "Obtain Iron Pickaxe, Iron Sword and Iron Axe"
	quest.5ABD0A8BF4340B86.title: "Iron Tools"
	quest.5ABE0839F7584525.quest_desc: ["Get hold of &#00D9FFRed Shrooma&r. Hover over it in EMI and press R to see how it is made."]
	quest.5ABE0839F7584525.quest_subtitle: "Obtain Red Shrooma"
	quest.5AD1E3CB5D43240B.quest_desc: ["&#00D9FFUncommon Ink&r is the second tier of magical ink in &#FFA500Iron's Spells 'n Spellbooks&r. The &#00D9FFScroll Forge&r uses it to make &#00D9FFUncommon&r-rarity spell scrolls." "Look for it in magical structures or get it from powerful magical creatures. It makes stronger scrolls than &#00D9FFCommon Ink&r."]
	quest.5AD1E3CB5D43240B.quest_subtitle: "Obtain Uncommon Ink"
	quest.5AD1E3CB5D43240B.title: "Uncommon Ink"
	quest.5AD2A23776A6102F.quest_desc: ["The handy, dandy &#00D9FFFluid Tank&r works alone or can be joined up in single-wide, 2-by-2, 3-by-3 wide columns, up to &#00D9AA30 blocks&r tall! Place it over some heat sources, pump in sufficient water, and it becomes a boiler that can power &#00D9FFSteam Engines&r, a larger boiler, provided more water and heating, can drive more &#00D9FFSteam Engines&r."]
	quest.5AD2A23776A6102F.quest_subtitle: "Obtain Fluid Tank"
	quest.5AD3778914B00934.quest_desc: ["This quest asks for &#00D9FFPlayer Transmitter Basic&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5AD3778914B00934.quest_subtitle: "Obtain Player Transmitter Basic"
	quest.5ADA2741E24C7E84.quest_desc: ["The &#00D9FFWandering Magician Robe&r is part of the basic &#00D9FFWandering Magician Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. It gives &#00D9AA+6&r &#00D9FFArmor&r and &#00D9AA+25&r &#00D9FFMax Mana&r." "Craft it from a &#00D9FFLeather Tunic and Arcane Essence&r. It is a good early piece for extra mana with solid protection."]
	quest.5ADA2741E24C7E84.quest_subtitle: "Obtain Wandering Magician Chestplate"
	quest.5ADDFD9B9279CDDF.quest_desc: ["Turrets cast their spell when they receive a redstone pulse and need source to run. Apply a spell with a &#00D9FFSpell Book&r or &#00D9FFSpell Parchment&r, and make sure it starts with a &#00D9FFForm&r glyph." "The &#00D9FFBasic Spell Turret&r uses twice the source of the spell, and the &#00D9FFEnhanced&r one uses the same amount. With a &#00D9FFPickup&r glyph, items are deposited into a storage block touching the turret."]
	quest.5ADDFD9B9279CDDF.quest_subtitle: "Obtain Basic Spell Turret and Spell Turret"
	quest.5ADDFD9B9279CDDF.title: "Spell Turrets"
	quest.5B0E17C76F5F3F8A.quest_desc: ["Bring &#00D9FFSpawn Egg Configurable Bee&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5B0E17C76F5F3F8A.quest_subtitle: "Obtain Spawn Egg Configurable Bee"
	quest.5B0F35D236824DD6.quest_desc: ["The imbuement chamber is used to create source gems. Place amethyst or lapis into the chamber, but be sure to have source nearby which is used to create source gems."]
	quest.5B0F35D236824DD6.quest_subtitle: "Obtain Imbuement Chamber"
	quest.5B1297C2D45DD486.quest_desc: ["Bring &#00D9FFConfigurable Honeycomb&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5B1297C2D45DD486.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.5B16B578CC697BCE.quest_desc: ["Bring &#00D9FFEmerald Stoneplate Ring&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5B16B578CC697BCE.quest_subtitle: "Obtain Emerald Stoneplate Ring"
	quest.5B33FAF0B6FB9231.quest_desc: ["Craft a &#00D9FFBlock of Ancient Metal&r from &#FFA500Cataclysm&r by combining 9 &#00D9FFAncient Metal Ingots&r." "It stores a large amount of this rare material."]
	quest.5B33FAF0B6FB9231.quest_subtitle: "Obtain Ancient Metal Block"
	quest.5B48AF91D71DA38E.quest_desc: ["This quest asks for &#00D9FFLimited Copper Barrel&r 4. EMI shows the recipe if you press R while hovering over it."]
	quest.5B48AF91D71DA38E.quest_subtitle: "Obtain Limited Copper Barrel 4"
	quest.5B52F8FCFF692B78.quest_desc: ["Bring &#00D9FFHeavy Chain Necklace&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5B52F8FCFF692B78.quest_subtitle: "Obtain Heavy Chain Necklace"
	quest.5B563B6A8ED067A5.quest_desc: ["This quest asks for &#00D9FFLawson Cypress Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5B563B6A8ED067A5.quest_subtitle: "Obtain Lawson Cypress Sapling"
	quest.5B6043B5A527D364.quest_desc: ["Get hold of &#00D9FFEclipsealloy Pickaxe&r. Hover over it in EMI and press R to see how it is made."]
	quest.5B6043B5A527D364.quest_subtitle: "Obtain Eclipsealloy Pickaxe"
	quest.5B67C1C37B62D3E0.quest_desc: ["Bring &#00D9FFConfigurable Honeycomb&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5B67C1C37B62D3E0.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.5B6C41D511701B5A.quest_desc: ["Get hold of &#00D9FFFlickering Sun Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.5B6C41D511701B5A.quest_subtitle: "Obtain Flickering Sun Sapling"
	quest.5B6CDA27883802D1.quest_desc: ["The chestplate of the &#00D9FFNeptunium&r armor set. Together with the leggings, it unlocks the helmet."]
	quest.5B6CFEC4F689FF3B.quest_desc: ["&#00D9FFDefeating the Hydra&r drops &#00D9FFFiery Blood and Fiery Tears&r, two rare &#FFA500Twilight Forest&r materials." "Both are needed to craft powerful equipment, so they prepare you for the dangers deeper in the dimension."]
	quest.5B6CFEC4F689FF3B.quest_subtitle: "Obtain Fiery Blood and Fiery Tears"
	quest.5B6E54D22404B035.quest_desc: ["Multiplies the number of items that fit in each slot by 2."]
	quest.5B6E54D22404B035.quest_subtitle: "Obtain Stack Upgrade Tier 1"
	quest.5B760D87B0F7ACCF.quest_desc: ["Get hold of &#00D9FFPrudentium Farmland&r. Hover over it in EMI and press R to see how it is made."]
	quest.5B760D87B0F7ACCF.quest_subtitle: "Obtain Prudentium Farmland"
	quest.5B8026F5E505444C.quest_desc: ["Bring &#00D9FFRay Bucket&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5B8026F5E505444C.quest_subtitle: "Obtain Ray Bucket"
	quest.5B81420F5B4091BA.quest_desc: ["&#00D9FFResin and Amber&r bees can trap and encase mobs in amber. Encased mobs are immobile and can only be released when the amber is placed over a campfire. Soul campfires release them faster."]
	quest.5B81420F5B4091BA.quest_subtitle: "Obtain Amber"
	quest.5B836FFF1D589FB8.quest_desc: ["&#00D9FFQuartz Fiber&r separates power between connected ME networks while still allowing data to pass. It is also used in wireless components."]
	quest.5B8CD701C9465BD5.quest_desc: ["Get hold of &#00D9FFSandalwood Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.5B8CD701C9465BD5.quest_subtitle: "Obtain Sandalwood Sapling"
	quest.5B8F6BC51DC02E27.quest_desc: ["Generates source from nearby crop and tree growth."]
	quest.5B8F6BC51DC02E27.quest_subtitle: "Obtain Agronomic Sourcelink"
	quest.5B99B9F930012741.quest_desc: ["Get hold of &#00D9FFEnergetic Alloy Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.5B99B9F930012741.quest_subtitle: "Obtain Energetic Alloy Seeds"
	quest.5BA0BE0EBBF0FEFA.quest_desc: ["The Underminer is a specialized mining tool from &#FFA500Eternal Starlight&r." "It is made for resource extraction and underground exploration."]
	quest.5BA0BE0EBBF0FEFA.quest_subtitle: "Obtain Underminer"
	quest.5BA0BE0EBBF0FEFA.title: "Underminer"
	quest.5BA6B722B2CD05D4.quest_desc: ["Augment the ritual with an item to get a &#00D9FFWayfinder&r, which works like a compass. It points to the nearest structure from the ritual location and shows how far away it is." "Notable structures: &#00D9FFNether Fortress&r, &#00D9FFBastion&r, &#00D9FFOcean Monument&r, &#00D9FFAncient City&r, &#00D9FFEnd City&r, &#00D9FFWilden Den and Arcane Library&r."]
	quest.5BA6B722B2CD05D4.quest_subtitle: "Obtain Ritual Locate Structure"
	quest.5BAB31083049E0D5.quest_desc: ["Get hold of &#00D9FFMagmator Nitro&r. Hover over it in EMI and press R to see how it is made."]
	quest.5BAB31083049E0D5.quest_subtitle: "Obtain Magmator Nitro"
	quest.5BC08AC74035D855.quest_desc: ["Get hold of &#00D9FFCatfish&r. Hover over it in EMI and press R to see how it is made."]
	quest.5BC08AC74035D855.quest_subtitle: "Obtain Catfish"
	quest.5BC3092941F3CF3E.quest_desc: ["Place &#00D9FFthe Altar&r to see a in-world preview for the vessels and pedestal placements."]
	quest.5BC3092941F3CF3E.quest_subtitle: "Obtain Awakening Altar"
	quest.5BC46158F3323CB4.quest_desc: ["This tablet is used to create daytime."]
	quest.5BC46158F3323CB4.quest_subtitle: "Obtain Ritual Sunrise"
	quest.5BD202341683BEAA.quest_desc: ["[ { \"text\": \"Open the &#FFA500NeoTech Reborn&r issue tracker\", \"underlined\": true, \"clickEvent\": { \"action\": \"open_url\", \"value\": \"https://github.com/&#00D9FFVaporeonScripts&r/&#00D9FFNeoTech&r-&#00D9FFReborn&r/issues\" }, \"color\": \"aqua\" } ]"]
	quest.5BD202341683BEAA.quest_subtitle: "Found a bug or have an idea? Let the team know."
	quest.5BD202341683BEAA.title: "Report an Issue or Suggest an Idea"
	quest.5BDDED81AB054124.quest_desc: ["The Signet of the &#00D9FFBetrayer&r gives &#00D9AA+10%&r &#00D9FFEldritch Spell Power&r. Its passive has a 5-second cooldown and deals extra damage based on a creature's maximum mana, which makes it especially effective against strong spellcasters and mana-rich enemies."]
	quest.5BDDED81AB054124.quest_subtitle: "Obtain Betrayer Signet"
	quest.5BF1E219A0CCFB64.quest_desc: ["The &#00D9FFPurpur Pedestal&r is a decorative pillar used to build the ring around an &#00D9FFEternal Portal&r." "It holds the &#00D9FFEternal Crystals&r that light the portal back to the &#00D9FFOverworld&r."]
	quest.5BF1E219A0CCFB64.quest_subtitle: "Obtain 8x Purpur Pedestal"
	quest.5BF1E219A0CCFB64.title: "Purpur Pedestal"
	quest.5BFBBB1442CA38A3.quest_desc: ["This quest asks for &#00D9FFClot of Time&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5BFBBB1442CA38A3.quest_subtitle: "Obtain Clot of Time"
	quest.5C0234DC4B2D451C.quest_desc: ["Source gems can be found in loot chests or created in a crystallizer. Source gems are required for many ars nouveau crafting recipes."]
	quest.5C0234DC4B2D451C.quest_subtitle: "Obtain Source Gem"
	quest.5C05D1074390A539.quest_desc: ["Bring &#00D9FFEclipsealloy Boots&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5C05D1074390A539.quest_subtitle: "Obtain Eclipsealloy Boots"
	quest.5C16B8E0C3AC4D6D.quest_desc: ["Expands the inventory and upgrade slots of the backpack."]
	quest.5C16B8E0C3AC4D6D.quest_subtitle: "Obtain Diamond Backpack"
	quest.5C27BB16E2310B9F.quest_desc: ["This quest asks for &#00D9FFFluid Cell Housing&r, &#00D9FFChemical Cell Housing and Item Cell Housing&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5C27BB16E2310B9F.quest_subtitle: "Obtain Fluid Cell Housing, Chemical Cell Housing and Item Cell Housing"
	quest.5C27BB16E2310B9F.title: "ME Cell Housing"
	quest.5C294A87FDAD8206.quest_desc: ["This quest asks for &#00D9FFDisk Drive&r 1k. EMI shows the recipe if you press R while hovering over it."]
	quest.5C294A87FDAD8206.quest_subtitle: "Obtain Disk Drive 1k"
	quest.5C2CC9D34865D3EE.quest_desc: ["Bring &#00D9FFWhirlisprig Shards&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5C2CC9D34865D3EE.quest_subtitle: "Obtain Whirlisprig Shards"
	quest.5C3F231ED47BDD97.quest_desc: ["&#00D9FFDisables AI&r for mobs spawned by the spawner. Useful for efficient farms."]
	quest.5C3F231ED47BDD97.quest_subtitle: "Obtain No Ai Spawner Rune"
	quest.5C3F231ED47BDD97.title: "No AI Spawner Rune"
	quest.5C4798EE39DFB73A.quest_desc: ["&#FFA500Aquaculture&r 2 adds the Box, a container you can catch as fishing loot. Open it to see which valuable items it holds."]
	quest.5C4798EE39DFB73A.quest_subtitle: "Obtain Box"
	quest.5C4E3F69BE5E7C86.quest_desc: ["The base item used to craft backpack upgrades."]
	quest.5C4E3F69BE5E7C86.quest_subtitle: "Obtain Upgrade Base"
	quest.5C4F3C3A59E0F533.quest_desc: ["Get hold of &#00D9FFRing&r of the &#00D9FFSeven Deadly Sins&r. Hover over it in EMI and press R to see how it is made."]
	quest.5C4F3C3A59E0F533.quest_subtitle: "Obtain Ring of the Seven Deadly Sins"
	quest.5C50B14D94E8EFFC.quest_desc: ["A &#00D9FFFlux Plug&r inserts energy into the network. It accepts energy from every side at the same time."]
	quest.5C50B14D94E8EFFC.quest_subtitle: "Feeds energy into the network"
	quest.5C60CB2E63AB79B6.quest_desc: ["The Skillet from &#FFA500Farmer's Delight&r is used to fry and prepare ingredients. It is handy for many dishes and makes cooking quicker and easier."]
	quest.5C60CB2E63AB79B6.quest_subtitle: "Obtain Skillet"
	quest.5C744C31AC3CC5AB.quest_desc: ["Get hold of &#00D9FFPandanus Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.5C744C31AC3CC5AB.quest_subtitle: "Obtain Pandanus Sapling"
	quest.5C8327BEE271ED56.quest_desc: ["Bring &#00D9FFLimited Netherite Barrel&r 4 into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5C8327BEE271ED56.quest_subtitle: "Obtain Limited Netherite Barrel 4"
	quest.5C87FF98E1B122CF.quest_desc: ["The &#00D9FFMalarite Hoe&r is an early-game farming tool in &#FFA500Eternal Starlight&r, crafted from &#00D9FFMalarite&r found in swamp biomes." "It is used to create farmland."]
	quest.5C87FF98E1B122CF.quest_subtitle: "Obtain Malarite Hoe"
	quest.5C92808D99179762.quest_desc: ["Bring &#00D9FFEmpty Pcb&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5C92808D99179762.quest_subtitle: "Obtain Empty Pcb"
	quest.5C946809CA15F321.quest_desc: ["This quest asks for &#00D9FFInferium Seeds&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5C946809CA15F321.quest_subtitle: "Obtain Inferium Seeds"
	quest.5C9D71668407484E.quest_desc: ["Steam machines need, well, &#00D9FFSteam&r! The way to get it is to make a &#00D9FFSteam Boiler&r! The &#00D9FFSteam Boiler&r will gradually consume almost any fuel you give it to heat up. When it's at a high enough temperature, it will begin to produce &#00D9FFSteam&r so long as there is &#00D9FFWater&r in its internal tank; if not, you'd be wasting fuel. Or you can put a &#00D9FFWater Bucket&r into a &#00D9FFFurnace&r to obtain a &#00D9FFSteam Bucket&r. In this world is seems that fluid containers keep any fluid inside of them, having a persistent temperature and bound to the confined container; so don't worry about it condensing down into water or escaping. With Steam pre-boiler, you can make a &#00D9FFCompressor&r to save on &#00D9FFBronze Plates&r. It might seem a bit expensive at this current moment, but remember that you can practically triple your ores using the &#00D9FFForge Hammer&r. Not to mention that in due time, when you have your first two machines, it will become more than twice less expensive than before! The Boiler will automatically begin to produce and send the &#00D9FFSteam&r to adjacent machines or connected pipes, up to 8 millibuckets per tick. Bronze machines can only process recipes up to 2 energy unit per tick. You might see it as \"2 EU/t\" when using the machines. Once your &#00D9FFBoiler&r is at maximum temperature, it can supply 4 machines with &#00D9FFSteam&r simultaneously! Now that's hot."]
	quest.5C9D71668407484E.quest_subtitle: "Obtain Bronze Boiler"
	quest.5C9D71668407484E.title: "Bronze Boiler"
	quest.5C9FC7FFEF293D53.quest_desc: ["The &#00D9FFAncient Remnant&r is a huge dragon-like guardian sleeping beneath &#FFA500Cataclysm&r's Cursed Pyramid and one of the toughest desert bosses." "Use &#00D9FFthe Necklace&r of the &#00D9FFDesert&r to wake it, and prepare well."]
	quest.5C9FC7FFEF293D53.quest_subtitle: "Defeat Ancient Remnant"
	quest.5C9FC7FFEF293D53.title: "Ancient Remnant"
	quest.5C9FD770397A56FE.quest_desc: ["Bring &#00D9FFInvisibility Elixir&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5C9FD770397A56FE.quest_subtitle: "Obtain Invisibility Elixir"
	quest.5CAD9B88DEA90278.quest_desc: ["The &#00D9FFAmethyst Crab Shell&r from &#FFA500Cataclysm&r is a rare trophy taken from the defeated &#00D9FFAmethyst Crab&r."]
	quest.5CAD9B88DEA90278.quest_subtitle: "Obtain Amethyst Crab Shell"
	quest.5CBBFAE060ECF746.quest_desc: ["The &#00D9FFVacuum Pump&r is used to create a vaccum seal, used for the &#00D9FFVacuum Trap&r."]
	quest.5CBBFAE060ECF746.quest_subtitle: "Obtain Vacuum Pump"
	quest.5CC633D153C51191.quest_desc: ["&#00D9FFThirst Walkers&r wander the harsh regions of &#FFA500Eternal Starlight&r and are very aggressive when approached." "Their speed and relentless attacks can overwhelm unprepared players, so deal with them before exploring deeper."]
	quest.5CC633D153C51191.quest_subtitle: "Defeat Thirst Walker"
	quest.5CC633D153C51191.title: "Thirst Walker"
	quest.5CCA397599A0C34E.quest_desc: ["This quest asks for &#00D9FFFlaming Bracer&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5CCA397599A0C34E.quest_subtitle: "Obtain Flaming Bracer"
	quest.5CD0B044BD6C9011.quest_desc: ["Compacts items into their compressed versions. Works with 2x2 and 3x3 recipes."]
	quest.5CD0B044BD6C9011.quest_subtitle: "Obtain Advanced Compacting Upgrade"
	quest.5CDCAA4CC67FFFE0.quest_desc: ["Basic tools stop being enough as danger grows. Diamonds let you craft sturdier equipment that mines faster and fights better." "With them, gathering and defending become much easier."]
	quest.5CDCAA4CC67FFFE0.quest_subtitle: "Obtain Diamond Pickaxe, Diamond Sword and Diamond Axe"
	quest.5CDCAA4CC67FFFE0.title: "Diamond Tools"
	quest.5CEE82CD02A980BF.quest_desc: ["The &#00D9FFQIO Drive Array&r is the first step in creating &#FFA500Mekanism&r's mass storage. The storage is similar to AE2 and &#00D9FFRefined Storage's&r system where you put drives in a drive bay to digitally hold items. The cool part about the QIO system though, is that it does not require power. It does require you to set a frequency, though."]
	quest.5CEE82CD02A980BF.quest_subtitle: "Obtain Qio Drive Array"
	quest.5CFFCDBF3CE8BDBA.quest_desc: ["An upgraded &#00D9FFElite Control Circuit&r, used in many tier 4 machines and items."]
	quest.5CFFCDBF3CE8BDBA.quest_subtitle: "Obtain Ultimate Control Circuit"
	quest.5D043F46D43DBE4B.quest_desc: ["Not consumed when eaten."]
	quest.5D043F46D43DBE4B.quest_subtitle: "Obtain Everlasting Beef"
	quest.5D1B2FB511D44AFD.quest_desc: ["This quest asks for &#00D9FFHoneycomb Powdery&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5D1B2FB511D44AFD.quest_subtitle: "Obtain Honeycomb Powdery"
	quest.5D22FAF561841E50.quest_desc: ["The chestplate of the &#00D9FFChainmail&r armor set. Together with the leggings, it unlocks the helmet."]
	quest.5D29B9D8AEE2D551.quest_desc: ["&#FFA500Create Crafts and Additions&r offers three connectors: the &#00D9FFSmall Connector&r, the &#00D9FFSmall Connector&r with &#00D9FFLight&r and the &#00D9FFLarge Connector&r. Use them with spools to link machines and move &#00D9FFForge Energy&r around your factory." "The &#00D9FFSmall Connector&r supports up to four connections and the &#00D9FFLarge Connector&r up to eight. The lit version glows when powered."]
	quest.5D29B9D8AEE2D551.quest_subtitle: "Obtain Connector, Small Light Connector and Large Connector"
	quest.5D3B43FF72E5DBB5.quest_desc: ["&#00D9FFTimeless Slurry&r is a strong crafting ingredient in &#FFA500Iron's Spells 'n Spellbooks&r. Make it in the &#00D9FFAlchemist Cauldron&r by processing a &#00D9FFMundane Potion&r with an &#00D9FFEcho Shard&r." "It is required to upgrade the &#00D9FFDecrepit Scythe&r into the &#00D9FFHellrazor&r and the &#00D9FFDecrepit Flamberge&r into the &#00D9FFLegionnaire Flamberge&r."]
	quest.5D3B43FF72E5DBB5.quest_subtitle: "Obtain Timeless Slurry"
	quest.5D4103E73ABCB6B9.quest_desc: ["allows the player to fly, equippable in the chestplate slot. It uses &#00D9FFHydrogen&r gas as a fuel, of which it can store up to &#00D9AA24,000 mB&r."]
	quest.5D4103E73ABCB6B9.quest_subtitle: "Obtain Jetpack"
	quest.5D5148CE0DED97BB.quest_desc: ["The scribe's table is used to craft glyphs and or a specific spell to parchment or items."]
	quest.5D5148CE0DED97BB.quest_subtitle: "Obtain Scribes Table"
	quest.5D53B034F7A93D35.quest_desc: ["Bring &#00D9FFCopper Chest&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5D53B034F7A93D35.quest_subtitle: "Obtain Copper Chest"
	quest.5D61DE361F0F9FEA.quest_desc: ["Melee attacks have a chance to inflict &#00D9FFWither&r."]
	quest.5D61DE361F0F9FEA.quest_subtitle: "Obtain Withered Bracelet"
	quest.5D6289D558C4A039.quest_desc: ["Bring &#00D9FFMagma Cake Slice&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5D6289D558C4A039.quest_subtitle: "Obtain Magma Cake Slice"
	quest.5D6836138CED402F.quest_desc: ["This quest asks for &#00D9FFThread Drygmy&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5D6836138CED402F.quest_subtitle: "Obtain Thread Drygmy"
	quest.5D74208E6F774487.quest_desc: ["Make &#00D9FFthe Warden Helmet&r in a &#00D9FFMechanical Crafter&r using a &#00D9FFNetherite Helmet&r, &#00D9FFEcho Ingots&r, &#00D9FFWarden Carapace&r, a &#00D9FFReinforced Echo Shard&r and a &#00D9FFWarden Upgrade Template&r." "Enchantments on the netherite piece are not kept, so enchant the result afterwards."]
	quest.5D74208E6F774487.quest_subtitle: "Obtain Warden Helmet"
	quest.5D766FE42709632F.quest_desc: ["Use &#00D9FFthe Terminite Anvil&r with a &#00D9FFSmith Hammer&r to shape &#00D9FFTerminite Ingots&r into &#00D9FFForged Plates&r and tool heads." "It unlocks &#00D9FFTerminite's&r improved tools and armor."]
	quest.5D766FE42709632F.quest_subtitle: "Obtain Terminite Anvil"
	quest.5D775DA4936B7AC2.quest_desc: ["These magical helpers harvest, collect, and grow amethyst for you."]
	quest.5D775DA4936B7AC2.quest_subtitle: "Obtain Amethyst Golem Charm"
	quest.5D7CDDA1E072DCE6.quest_desc: ["Craft &#00D9FFthe Bone Reptile Helmet&r from &#FFA500Cataclysm&r using &#00D9FFAncient Metal Ingots&r, &#00D9FFKoboleton Bones&r and a &#00D9FFKobolediator Skull&r." "It is a trophy for clearing the &#00D9FFCursed Pyramid&r."]
	quest.5D7CDDA1E072DCE6.quest_subtitle: "Obtain Bone Reptile Helmet"
	quest.5D91D93192325C15.quest_desc: ["Combine &#00D9FFthe Item Cell Housing&r and 1k &#00D9FFCell Component&r to make a 1k &#00D9FFItem Storage Cell&r. Insert it into an &#00D9FFME Drive&r to store items on the network."]
	quest.5D9900CD4D01048A.quest_desc: ["Get hold of &#00D9FFSuperconductor Cable&r. Hover over it in EMI and press R to see how it is made."]
	quest.5D9900CD4D01048A.quest_subtitle: "Obtain Superconductor Cable"
	quest.5D9900CD4D01048A.title: "Unlimited Power (Transfer)"
	quest.5D9EDEBA88805F6D.quest_desc: ["&#00D9FFBurning Ashes&r from &#FFA500Cataclysm&r are required to awaken &#00D9FFIgnis&r in the &#00D9FFBurning Arena&r." "Without them he stays dormant on his throne."]
	quest.5D9EDEBA88805F6D.quest_subtitle: "Obtain Burning Ashes"
	quest.5DB8752414032D64.quest_desc: ["Get hold of &#00D9FFSolar Panel Basic&r. Hover over it in EMI and press R to see how it is made."]
	quest.5DB8752414032D64.quest_subtitle: "Obtain Solar Panel Basic"
	quest.5DC3E35E7523BC90.quest_desc: ["Like &#00D9FFthe Deposit Upgrade&r, with more filtering options."]
	quest.5DC3E35E7523BC90.quest_subtitle: "Obtain Advanced Deposit Upgrade"
	quest.5DC982042E0955E7.quest_desc: ["Get hold of &#00D9FFHeat Exchanger&r. Hover over it in EMI and press R to see how it is made."]
	quest.5DC982042E0955E7.quest_subtitle: "Obtain Heat Exchanger"
	quest.5DCAC60D8B46EBA0.quest_desc: ["A blank &#00D9FFRunestone&r can be infused with different types of magic. Runes are used to craft upgrades for your gear or better gear in general."]
	quest.5DCAC60D8B46EBA0.quest_subtitle: "Obtain Blank Rune"
	quest.5DE5BB7D23290BE7.quest_desc: ["It is found in the &#00D9FFAurora Palace&r. A hit covers the target in ice and inflicts &#00D9FFFrosted III&r for &#00D9AA10 seconds&r."]
	quest.5DE5BB7D23290BE7.quest_subtitle: "Find the Ice Bow"
	quest.5DE5BB7D23290BE7.title: "The Ice Bow"
	quest.5DF5827AEDEBAEA6.quest_desc: ["The &#00D9FFRing of Invisibility&r is a joke curio in &#FFA500Iron's Spells 'n Spellbooks&r. It does not make you invisible, since the ring itself is what is invisible."]
	quest.5DF5827AEDEBAEA6.quest_subtitle: "Obtain Invisibility Ring"
	quest.5DF91C3757A70806.quest_desc: ["Upgrade a &#00D9FFTerminite Helmet&r with an &#00D9FFAeternium Forged Plate&r at a &#00D9FFSmithing Table&r to get the &#00D9FFAeternium Helmet&r." "It is &#00D9FFBetter End's&r top-tier armor and protects better than &#00D9FFNetherite&r."]
	quest.5DF91C3757A70806.quest_subtitle: "Obtain Aeternium Helmet"
	quest.5E02C9683D1CA756.quest_desc: ["This quest asks for &#00D9FFEclipsealloy Chestplate&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5E02C9683D1CA756.quest_subtitle: "Obtain Eclipsealloy Chestplate"
	quest.5E0338759F8ED924.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.5E0338759F8ED924.quest_subtitle: "Obtain Basic Enriching Factory"
	quest.5E0A66C2017FB163.quest_desc: ["Bring &#00D9FFSycamore Fig Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5E0A66C2017FB163.quest_subtitle: "Obtain Sycamore Fig Sapling"
	quest.5E0DCE90537C4595.quest_desc: ["The &#00D9FFOak Chest&r is a basic &#FFA500Sophisticated Storage&r container and works with the mod's upgrade system." "It makes a good base for a setup you can later expand with more capacity, automation and specialized upgrades."]
	quest.5E0DCE90537C4595.quest_subtitle: "Obtain Chest"
	quest.5E0DF3631880979E.quest_desc: ["This quest asks for &#00D9FFSource Berry Pie&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5E0DF3631880979E.quest_subtitle: "Obtain Source Berry Pie"
	quest.5E4A7D592E592265.quest_desc: ["This machine converts &#00D9FFForge Energy&r (compatible with RF and many other mods’ energy) into compressed air. It operates with a base efficiency of &#00D9AA40%&r, meaning &#00D9AA100 FE&r generates 40 mL of compressed air. Using &#00D9FFSpeed Upgrades&r will slightly decrease this efficiency. Additionally, the &#00D9FFCompressor&r produces heat, which needs to be managed to prevent a reduction in efficiency."]
	quest.5E4A7D592E592265.quest_subtitle: "Obtain Flux Compressor"
	quest.5E4BDB19F93334A1.quest_desc: ["You'll want this for wireless access to your &#00D9FFME System&r. You can also link some other items to your &#00D9FFME System&r other than just the &#00D9FFWireless Terminals&r, such as &#00D9FFBuilding Gadgets&r."]
	quest.5E4BDB19F93334A1.quest_subtitle: "Obtain Wireless Access Point"
	quest.5E61271F6FF6C12B.quest_desc: ["Get hold of &#00D9FFReflective Necklace&r. Hover over it in EMI and press R to see how it is made."]
	quest.5E61271F6FF6C12B.quest_subtitle: "Obtain Reflective Necklace"
	quest.5E6531ACFF7B13EB.quest_desc: ["The &#00D9FFItem Cell Housing&r combines with a storage component to make an item cell. Keep item storage cells distinct from fluid and spatial cells."]
	quest.5E67D21449700ED5.quest_desc: ["A &#00D9FFWindmill&r needs 8 &#00D9FFSails&r to reach its maximum output."]
	quest.5E67D21449700ED5.quest_subtitle: "Obtain Windmill Sail"
	quest.5E689B83C70042C1.quest_desc: ["This inscriber can run 4 jobs at the same time."]
	quest.5E689B83C70042C1.quest_subtitle: "Obtain Ex Inscriber"
	quest.5E6A6191BE1D38D0.quest_desc: ["The &#00D9FFLimited Oak Barrel IV&r has even more capacity than the previous tiers while keeping the practical barrel design." "It is another step up as your storage system grows."]
	quest.5E6A6191BE1D38D0.quest_subtitle: "Obtain Limited Barrel 4"
	quest.5E6E865CF683DF4D.quest_desc: ["Makes the backpack indestructible. It cannot despawn or fall into the void."]
	quest.5E6E865CF683DF4D.quest_subtitle: "Obtain Everlasting Upgrade"
	quest.5E70E59A00E287D7.quest_desc: ["A spell turret can be used with a redstone signal to cast spells."]
	quest.5E70E59A00E287D7.quest_subtitle: "Obtain Basic Spell Turret"
	quest.5E7C31BAD6E59105.quest_desc: ["&#00D9FFTotal Uses&r: Unlimited!"]
	quest.5E7C31BAD6E59105.quest_subtitle: "Obtain Master Infusion Crystal"
	quest.5E80B669A8DF5773.quest_desc: ["&#FFA500Powah&r is a tech mod for generating, storing and transmitting energy. It adds several generators, from the classic coal &#00D9FFFurnator&r to a self-building multiblock reactor." "All machines are tier-based. You start with &#00D9FFStarter&r machines and upgrade them as you go: Starter, &#00D9FFBasic&r, &#00D9FFHardened&r, &#00D9FFBlazing&r, &#00D9FFNiotic&r, &#00D9FFSpirited and Nitro&r."]
	quest.5E80B669A8DF5773.quest_subtitle: "Obtain Dielectric Paste"
	quest.5E817C2ED2304CD0.quest_desc: ["This quest asks for &#00D9FFEnergizing Rod Blazing&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5E817C2ED2304CD0.quest_subtitle: "Obtain Energizing Rod Blazing"
	quest.5E854D7F1348255B.quest_desc: ["Obtained by smelting &#00D9FFCertus Quartz Dust&r, &#00D9FFSilicon&r is used in 3 different processors you will need to proceed."]
	quest.5E854D7F1348255B.quest_subtitle: "Obtain Silicon"
	quest.5E854D7F1348255B.title: "Silicon"
	quest.5EA9356560930826.quest_desc: ["Get hold of &#00D9FFStrider Stew&r. Hover over it in EMI and press R to see how it is made."]
	quest.5EA9356560930826.quest_subtitle: "Obtain Strider Stew"
	quest.5EAE572EA1BFCE46.quest_desc: ["&#00D9FFTotal Uses&r: 1,000."]
	quest.5EAE572EA1BFCE46.quest_subtitle: "Obtain Infusion Crystal"
	quest.5EB89B994640BB45.quest_desc: ["The &#00D9FFIncubator&r is a small multiblock used to recombine &#00D9FFPrinciples&r of matter into objects. It is composed of one of each vessel type placed on the sides - &#00D9FFSalt&r, &#00D9FFSulfur&r, and &#00D9FFMercury&r - the &#00D9FFIncubator&r itself, and a source of heat, in this case a &#00D9FFPyromantic Brazier&r, below."]
	quest.5EB89B994640BB45.quest_subtitle: "Obtain Incubator, Incubator Mercury Vessel, Incubator Sulfur Vessel and 2 more items"
	quest.5EBB6D61B6319A8A.quest_desc: ["This quest asks for &#00D9FFPiston Extension Pole&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5EBB6D61B6319A8A.quest_subtitle: "Obtain Piston Extension Pole"
	quest.5EC884935B631CDE.quest_desc: ["Get hold of &#00D9FFPollock&r. Hover over it in EMI and press R to see how it is made."]
	quest.5EC884935B631CDE.quest_subtitle: "Obtain Pollock"
	quest.5ED01C913DDE8FCB.quest_desc: ["Tier 1 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.5ED01C913DDE8FCB.quest_subtitle: "Obtain Glyph Delay"
	quest.5ED86ED76D2AB79D.quest_desc: ["The leggings of the &#00D9FFKnightmetal&r armor set. Together with the chestplate, they unlock the helmet."]
	quest.5EED3766F9BFFB62.quest_desc: ["This quest asks for &#00D9FFEnder Gate Niotic&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5EED3766F9BFFB62.quest_subtitle: "Obtain Ender Gate Niotic"
	quest.5EEE5033B49668C3.quest_desc: ["The most unique machine in the pack. It copies an area and rewinds time in it, so you can place blocks, harvest them, rewind and harvest them again. The &#00D9FFGuide Book&r is strongly recommended for this one."]
	quest.5EEE5033B49668C3.quest_subtitle: "Obtain Paradoxmachine"
	quest.5F1A70A256C95E92.quest_desc: ["&#00D9FFRose Quartz&r is a crafting material in &#FFA500Create&r. Polish it with &#00D9FFSand Paper&r to get &#00D9FFPolished Rose Quartz&r, which is used for &#00D9FFElectron Tubes&r, &#00D9FFRose Quartz Lamps&r and decorative &#00D9FFRose Quartz&r blocks." "You can also automate the polishing with a &#00D9FFDeployer&r holding &#00D9FFSand Paper&r."]
	quest.5F1A70A256C95E92.quest_subtitle: "Obtain Rose Quartz"
	quest.5F1B37269D42EDF5.quest_desc: ["This miner spirit is second to none, able to get most ores. It will also occasionally yield a special item...."]
	quest.5F1B37269D42EDF5.quest_subtitle: "Obtain Miner Marid Master"
	quest.5F21F743E5393EAA.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.5F21F743E5393EAA.quest_subtitle: "Obtain Elite Combining Factory"
	quest.5F2AADF7E4E410A1.quest_desc: ["Get hold of &#00D9FFDouglas Fir Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.5F2AADF7E4E410A1.quest_subtitle: "Obtain Douglas Fir Sapling"
	quest.5F350D671122B35E.quest_desc: ["Bring &#00D9FFAffinity Ring&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5F350D671122B35E.quest_subtitle: "Obtain Affinity Ring"
	quest.5F38264AC01FB036.quest_desc: ["Get hold of &#00D9FFBlazegold Chestplate&r. Hover over it in EMI and press R to see how it is made."]
	quest.5F38264AC01FB036.quest_subtitle: "Obtain Blazegold Chestplate"
	quest.5F3CF8C042B1EA0F.quest_desc: ["Get hold of &#00D9FFBlackthorn Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.5F3CF8C042B1EA0F.quest_subtitle: "Obtain Blackthorn Sapling"
	quest.5F3D089B84D1F005.quest_desc: ["This quest asks for &#00D9FFEgg Soup&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5F3D089B84D1F005.quest_subtitle: "Obtain Egg Soup"
	quest.5F3D5CFDCAB77C5C.quest_desc: ["Demand-side drivers at the heart of the modern smart &#FFA500Create&r factory."]
	quest.5F3D5CFDCAB77C5C.quest_subtitle: "Obtain Factory Gauge"
	quest.5F3EE79C401EB144.quest_desc: ["Get hold of &#00D9FFKey Lime Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.5F3EE79C401EB144.quest_subtitle: "Obtain Key Lime Sapling"
	quest.5F4AB509F62FCC04.quest_desc: ["Upgrade an &#00D9FFInfused Hellshelf&r with &#00D9FFBlaze Powder and Fire Charges&r." "It gives &#00D9AA+10&r &#00D9FFEterna&r (up to 65) and &#00D9AA+10&r &#00D9FFQuanta&r, but removes 1 &#00D9FFClue&r, so you see less of what you will get."]
	quest.5F4AB509F62FCC04.quest_subtitle: "Obtain Blazing Hellshelf"
	quest.5F4CE2C211D3C196.quest_desc: ["&#00D9FFExtended Pattern Provider&r holds quadruple the patterns compared to a regular. &#00D9FFExtended Molecular Assembler&r does 8 crafting jobs at once at &#00D9AA2x&r the speed of a regular, totaling to a &#00D9AA16x&r increase in crafting speed."]
	quest.5F4CE2C211D3C196.quest_subtitle: "Obtain Ex Pattern Provider and Ex Molecular Assembler"
	quest.5F5503976BB2D2E1.quest_desc: ["This Emitter uses &#00D9FFMercury Flux&r to generate heat that can be used in place of the &#00D9FFPyromantic Brazier&r."]
	quest.5F5503976BB2D2E1.quest_subtitle: "Obtain Caloric Flux Emitter"
	quest.5F6125EF968FC2B1.quest_desc: ["Bring &#00D9FFHoney Cookie&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5F6125EF968FC2B1.quest_subtitle: "Obtain Honey Cookie"
	quest.5F6D2504DB8572FD.quest_desc: ["This quest asks for &#00D9FFSlimy Delight Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5F6D2504DB8572FD.quest_subtitle: "Obtain Slimy Delight Sapling"
	quest.5F8A91444A82D83D.quest_desc: ["The &#00D9FFSink&r provides water for recipes, and it also works as an endless water source."]
	quest.5F8A91444A82D83D.quest_subtitle: "Water for recipes"
	quest.5FA03F32B08B10A8.quest_desc: ["An &#00D9FFIsotopic Centrifuge&r is yet another machine that turns one fluid into another. This time, by pumping in &#00D9FFUranium HexaFluoride&r, you get &#00D9FFFissile Fuel&r."]
	quest.5FA03F32B08B10A8.quest_subtitle: "Obtain Isotopic Centrifuge"
	quest.5FA04FD81B534CB4.quest_desc: ["The leggings of the &#00D9FFObsidian&r armor set. Together with the chestplate, they unlock the helmet."]
	quest.5FA0C345999713B1.quest_desc: ["Adds a furnace to the storage."]
	quest.5FA0C345999713B1.quest_subtitle: "Obtain Smelting Upgrade"
	quest.5FAD05D83FC3CA5A.quest_desc: ["&#00D9FFEnder Pearls&r are not consumed but cost hunger instead, and they deal no damage."]
	quest.5FAD05D83FC3CA5A.quest_subtitle: "Obtain Warp Drive"
	quest.5FB1EAE6C4CFACE6.quest_desc: ["The &#00D9FFQIO Dashboard&r is your main interface with the &#00D9FFQIO System&r. You just need to set the frequency and you're good to go."]
	quest.5FB1EAE6C4CFACE6.quest_subtitle: "Obtain Qio Dashboard"
	quest.5FB42611559F0E41.quest_desc: ["With a &#00D9FFQuantum Bridge Card&r you can access your &#00D9FFME System&r from anywhere in the world. You'll need to setup a &#00D9FFQuantum Ring&r with an &#00D9FFEntangled Singularity&r and another in your &#00D9FFWireless Terminal&r after placing the &#00D9FFQuantum Bridge Card&r in the terminal. Make sure the &#00D9FFQuantum Ring&r is chunk loaded or else it will not work."]
	quest.5FB42611559F0E41.quest_subtitle: "Obtain Quantum Bridge Card"
	quest.5FB5927BAEE09C89.quest_desc: ["Use &#00D9FFthe Thallasium Anvil&r with a &#00D9FFSmith Hammer&r to turn &#00D9FFThallasium Ingots&r into &#00D9FFForged Plates&r and tool heads." "It is the first crafting station in &#00D9FFBetter End's&r equipment progression."]
	quest.5FB5927BAEE09C89.quest_subtitle: "Obtain Thallasium Anvil"
	quest.5FD345FA75B8AE3F.quest_desc: ["The &#00D9FFCursium Upgrade Smithing Template&r from &#FFA500Cataclysm&r is used at a &#00D9FFSmithing Table&r." "With &#00D9FFCursium Ingots&r, it upgrades &#00D9FFNetherite&r equipment into &#00D9FFCursium&r equipment."]
	quest.5FD345FA75B8AE3F.quest_subtitle: "Obtain Cursium Upgrade Smithing Template"
	quest.5FD811D4BCBB4E6E.quest_desc: ["Get hold of &#00D9FFConfigurable Honeycomb&r. Hover over it in EMI and press R to see how it is made."]
	quest.5FD811D4BCBB4E6E.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.5FD928205FF68580.quest_desc: ["This Rod is pre-attuned to find a &#00D9FFCommon&r material."]
	quest.5FD928205FF68580.quest_subtitle: "Obtain Sulfur Attuned Divination Rod Common"
	quest.5FDD0DEDD188DC2A.quest_desc: ["Get hold of &#00D9FFBlue Mahoe Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.5FDD0DEDD188DC2A.quest_subtitle: "Obtain Blue Mahoe Sapling"
	quest.5FE73F232130E6A6.quest_desc: ["This quest asks for &#00D9FFConfigurable Honeycomb&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5FE73F232130E6A6.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.5FE7580EFCAA5541.quest_desc: ["This quest asks for &#00D9FFPersimmon Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.5FE7580EFCAA5541.quest_subtitle: "Obtain Persimmon Sapling"
	quest.5FE974C5F1ED3A4E.quest_desc: ["Make &#00D9FFthe Resonarium Chestplate&r in a &#00D9FFMechanical Crafter&r using a &#00D9FFDiamond Chestplate&r, &#00D9FFSturdy Sheets&r, a &#00D9FFResonarium Plate&r and a &#00D9FFResonarium Upgrade Template&r." "The template can be found in &#00D9FFAncient Cities&r, &#00D9FFTrial Chambers and Strongholds&r."]
	quest.5FE974C5F1ED3A4E.quest_subtitle: "Obtain Resonarium Chestplate"
	quest.5FF1D816C65069DE.quest_desc: ["The &#00D9FFThermal Springstone Hoe&r is crafted from &#00D9FFThermal Springstone Ingots&r in &#FFA500Eternal Starlight&r." "It prepares farmland in geothermal regions and belongs to the mid-tier set."]
	quest.5FF1D816C65069DE.quest_subtitle: "Obtain Thermal Springstone Hoe"
	quest.5FFB3B0D15EAF602.quest_desc: ["Bring &#00D9FFBlack Ember Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5FFB3B0D15EAF602.quest_subtitle: "Obtain Black Ember Sapling"
	quest.5FFC4F9FA66E9BAA.quest_desc: ["A fishing line that can be dyed like leather armor."]
	quest.5FFC4F9FA66E9BAA.quest_subtitle: "Obtain Fishing Line"
	quest.5FFEE28730576AC9.quest_desc: ["The &#00D9FFPlate Upgrade Smithing Template&r turns a &#00D9FFForged Plate&r into a finished piece of &#00D9FFBetter End&r armor at a &#00D9FFSmithing Table&r." "Every Thallasium, &#00D9FFTerminite and Aeternium&r armor piece needs it."]
	quest.5FFEE28730576AC9.quest_subtitle: "Obtain Plate Upgrade Smithing Template"
	quest.600E2ACA57353D2A.quest_desc: ["This quest asks for &#00D9FFConfigurable Honeycomb&r. EMI shows the recipe if you press R while hovering over it."]
	quest.600E2ACA57353D2A.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.6011352BFD9D24D5.quest_desc: ["The &#00D9FFAluminum Drill&r allows you to drill for &#00D9FFCrude Oil&r. It'll find pockets of oil in the ground and automatically pump it up through the drill and to the surface."]
	quest.6011352BFD9D24D5.quest_subtitle: "Obtain 4x Aluminum Drill"
	quest.6011352BFD9D24D5.title: "Aluminum Drill"
	quest.6021868566F8DB3F.quest_desc: ["The &#00D9FFElectromancer Hat&r is the headpiece of the &#00D9FFElectromancer Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. It gives &#00D9AA+3&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFLightning Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "Craft it from 5 &#00D9FFArcane Cloth&r and 1 &#00D9FFLightning Rune&r, or upgrade a &#00D9FFWizard Helmet&r with 1 &#00D9FFLightning Rune&r at a &#00D9FFSmithing Table&r in supported versions."]
	quest.6021868566F8DB3F.quest_subtitle: "Obtain Electromancer Helmet"
	quest.60219D7184AA733B.quest_desc: ["Bring &#00D9FFUpgrade Netherite&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.60219D7184AA733B.quest_subtitle: "Obtain Upgrade Netherite"
	quest.60246E7D64B41228.quest_desc: ["The &#00D9FFMalarite Shovel&r is an early-game digging tool in &#FFA500Eternal Starlight&r, crafted from &#00D9FFMalarite&r found in swamp biomes." "It is used for excavation and clearing terrain."]
	quest.60246E7D64B41228.quest_subtitle: "Obtain Malarite Shovel"
	quest.6026BE73E182679F.quest_desc: ["Bring &#00D9FFSatsuma Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.6026BE73E182679F.quest_subtitle: "Obtain Satsuma Sapling"
	quest.60283FE9E80266CC.quest_desc: ["Craft &#00D9FFTerminite Boots&r from &#00D9FFTerminite Plating&r at a &#00D9FFSmithing Table&r." "They complete the &#00D9FFTerminite&r set and are the base for &#00D9FFBetter End's&r higher-tier armors."]
	quest.60283FE9E80266CC.quest_subtitle: "Obtain Terminite Boots"
	quest.602DABCF31E4CDF8.quest_desc: ["Obtain an &#00D9FFAnalog Lever&r from &#FFA500Create&r. Unlike a normal lever, it can output any &#00D9FFRedstone&r signal strength from 0 to 15." "Right-click to raise the strength and sneak-right-click to lower it. &#00D9FFWearing Engineer's Goggles&r shows the current strength."]
	quest.602DABCF31E4CDF8.quest_subtitle: "Obtain Analog Lever"
	quest.60368BCBBFEC07E5.quest_desc: ["Get hold of &#00D9FFKapok Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.60368BCBBFEC07E5.quest_subtitle: "Obtain Kapok Sapling"
	quest.603A53222BA33D67.quest_desc: ["Used to cast tier 3 glyphs or lower."]
	quest.603A53222BA33D67.quest_subtitle: "Obtain Archmage Spell Book"
	quest.604330BFCBF3E6E5.quest_desc: ["This quest asks for &#00D9FFMithril Ingot&r. EMI shows the recipe if you press R while hovering over it."]
	quest.604330BFCBF3E6E5.quest_subtitle: "Obtain Mithril Ingot"
	quest.604DE6C9DB5D3375.quest_desc: ["The &#00D9FFFluid Gauge&r from &#FFA500Create: Dreams n' Desires&r monitors fluid systems, which makes large fluid setups easier to manage. The latest 2.3a-BETA update also improved its display to show boiler statistics."]
	quest.604DE6C9DB5D3375.quest_subtitle: "Obtain Fluid Gauge"
	quest.60509B38B16DE593.quest_desc: ["&#00D9FFInserters and Extractors&r move items into and out of containers from the &#00D9FFMercurial Logistics&r network, respectively."]
	quest.60509B38B16DE593.quest_subtitle: "Obtain Logistics Item Inserter and Logistics Item Extractor"
	quest.60509B38B16DE593.title: "Mercurial Item Manipulation"
	quest.605831AAA7204025.quest_desc: ["The &#00D9FFSteel Drill&r gives you the rest of the more commonly used ores that you'll need for further progression in your journey to total automation, but also in your journey of the world itself. Check your EMI for all the possible outputs."]
	quest.605831AAA7204025.quest_subtitle: "Obtain 4x Steel Drill"
	quest.605831AAA7204025.title: "Steel Drill"
	quest.6059837BAEAFF55B.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.6059837BAEAFF55B.quest_subtitle: "Obtain Advanced Purifying Factory"
	quest.60615A1924DA628E.quest_desc: ["The &#00D9FFRuined Book&r is an &#00D9FFEpic&r item found in the sculk-filled &#00D9FFAncient Cities&r. It is a key crafting component for powerful spellbooks." "Searching the ruins is the way to get one."]
	quest.60615A1924DA628E.quest_subtitle: "Obtain Ruined Book"
	quest.6076DF388C346FA1.quest_desc: ["Used to create spells that can be placed on the ground to affect those walking over it."]
	quest.6076DF388C346FA1.quest_subtitle: "Obtain Runic Chalk"
	quest.6080BB6D642F98D6.quest_desc: ["Get hold of &#00D9FFSolar Wafer&r. Hover over it in EMI and press R to see how it is made."]
	quest.6080BB6D642F98D6.quest_subtitle: "Obtain Solar Wafer"
	quest.608A2E3B5C762AD7.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.608A2E3B5C762AD7.quest_subtitle: "Obtain Elite Enriching Factory"
	quest.60900CE57A1160C3.quest_desc: ["Obtain a &#00D9FFCopper Valve Handle&r from &#FFA500Create&r. It is a hand-powered source of rotation that gives precise control over angle and direction." "Each use turns it 45° by default, and this angle can be configured. It produces 32 RPM and 256 SU."]
	quest.60900CE57A1160C3.quest_subtitle: "Obtain Copper Valve Handle"
	quest.609DB7F8B0684C8A.quest_desc: ["The Ink comes in different rarities and you will need higher tier Ink for the higher tier scrolls."]
	quest.609DB7F8B0684C8A.quest_subtitle: "Obtain Smart Filter"
	quest.609DB7F8B0684C8A.title: "Ink"
	quest.60ADB70BA2114BD3.quest_desc: ["This quest asks for &#00D9FFRainbow Trout&r. EMI shows the recipe if you press R while hovering over it."]
	quest.60ADB70BA2114BD3.quest_subtitle: "Obtain Rainbow Trout"
	quest.60B8E8055DEBAC2A.quest_desc: ["Can be (dis)charged using a &#00D9FFCharging Station&r. It's essential for crafting most pneumatically chargeable items and can also be used to charge other items. The amount of power generated depends heavily on the speed of the wind (obviously), and the speed of the wind increases the higher in the world the &#00D9FFWind Generator&r is placed."]
	quest.60B8E8055DEBAC2A.quest_subtitle: "Obtain Gps Tool and Air Canister"
	quest.60BC50AD613C919D.quest_desc: ["Bring Bramblethorn into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.60BC50AD613C919D.quest_subtitle: "Obtain Bramblethorn"
	quest.60C4E393073232E5.quest_desc: ["This quest asks for &#00D9FFWhirlisprig Petals&r. EMI shows the recipe if you press R while hovering over it."]
	quest.60C4E393073232E5.quest_subtitle: "Obtain Whirlisprig Petals"
	quest.60CB5D832D9891C5.quest_desc: ["This quest asks for &#00D9FFGolden Delicious Apple Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.60CB5D832D9891C5.quest_subtitle: "Obtain Golden Delicious Apple Sapling"
	quest.60CCE0548A624AC1.quest_desc: ["Tier 1 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.60CCE0548A624AC1.quest_subtitle: "Obtain Glyph Launch"
	quest.60D3ACF2FD523282.quest_desc: ["Bring &#00D9FFNutritional Liquifier&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.60D3ACF2FD523282.quest_subtitle: "Obtain Nutritional Liquifier"
	quest.60DF8D3D225B1EC6.quest_desc: ["Bring &#00D9FFQuantum Upgrade&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.60DF8D3D225B1EC6.quest_subtitle: "Obtain Quantum Upgrade"
	quest.60DF8D3D225B1EC6.title: "Time Dilation"
	quest.60E221AB4714CED9.quest_desc: ["This quest asks for &#00D9FFTinkering Table&r. EMI shows the recipe if you press R while hovering over it."]
	quest.60E221AB4714CED9.quest_subtitle: "Obtain Tinkering Table"
	quest.60E4B5A700DD6DB5.quest_desc: ["Makes the wearer briefly immune to fire damage after being hurt by fire."]
	quest.60E4B5A700DD6DB5.quest_subtitle: "Obtain Obsidian Skull"
	quest.60E6D85182577BD3.quest_desc: ["This quest asks for &#00D9FFEnergizing Rod Nitro&r. EMI shows the recipe if you press R while hovering over it."]
	quest.60E6D85182577BD3.quest_subtitle: "Obtain Energizing Rod Nitro"
	quest.60F9DAC7A6182643.quest_desc: ["This quest asks for &#00D9FFConfigurable Honeycomb&r. EMI shows the recipe if you press R while hovering over it."]
	quest.60F9DAC7A6182643.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.61017859BD7731C2.quest_desc: ["Get hold of &#00D9FFInferium Gemstone&r. Hover over it in EMI and press R to see how it is made."]
	quest.61017859BD7731C2.quest_subtitle: "Obtain Inferium Gemstone"
	quest.61059F7A62620351.quest_desc: ["This quest asks for &#00D9FFFerricore Axe&r. EMI shows the recipe if you press R while hovering over it."]
	quest.61059F7A62620351.quest_subtitle: "Obtain Ferricore Axe"
	quest.6107790F6E5B8CB0.quest_desc: ["Bring &#00D9FFDecaying Relic&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.6107790F6E5B8CB0.quest_subtitle: "Obtain Decaying Relic"
	quest.610CA03AB78E0470.quest_desc: ["This quest asks for &#00D9FFSoulrender&r. EMI shows the recipe if you press R while hovering over it."]
	quest.610CA03AB78E0470.quest_subtitle: "Obtain Soulrender"
	quest.610F8B72053EB9C0.quest_desc: ["Removes light-level restrictions from the spawner, so you don't need a pitch-black room."]
	quest.610F8B72053EB9C0.quest_subtitle: "Obtain Ignore Light Spawner Rune"
	quest.610F8B72053EB9C0.title: "Ignore Light Spawner Rune"
	quest.6114372D527B5903.quest_desc: ["Earn the advancement: &#00D9FFRead Lore&r."]
	quest.6114372D527B5903.quest_subtitle: "Earn the advancement: Read Lore"
	quest.611FF57AA7803C4A.quest_desc: ["A &#00D9FFNeptunium Ingot&r is a rare material from &#FFA500Aquaculture&r 2 fishing treasures. It is used to craft &#00D9FFNeptunium&r tools, armor and advanced fishing items."]
	quest.611FF57AA7803C4A.quest_subtitle: "Obtain Neptunium Ingot"
	quest.61206C8A863A5203.quest_desc: ["The &#00D9FFQIO Redstone Adapter&r monitors contents from the &#00D9FFQIO System&r. It activates based on different filters you set."]
	quest.61206C8A863A5203.quest_subtitle: "Obtain Qio Redstone Adapter"
	quest.6125C73CE0DA081B.quest_desc: ["The machine frame of &#FFA500Powah&r, used in most machine recipes."]
	quest.6125C73CE0DA081B.quest_subtitle: "Obtain Dielectric Casing"
	quest.6139FDEF401AFF5B.quest_desc: ["The &#00D9FFTerminite Sword Handle&r is a component for assembling a &#00D9FFTerminite Sword&r at the &#00D9FFSmithing Table&r." "Like other &#00D9FFBetter End&r handles, it is combined with a matching tool head."]
	quest.6139FDEF401AFF5B.quest_subtitle: "Obtain Terminite Sword Handle"
	quest.616C40032A91B84D.quest_desc: ["This Machine can collect &#00D9FFFluids&r from the world, It's also highly configurable!"]
	quest.616C40032A91B84D.quest_subtitle: "Obtain Fluidcollectort1"
	quest.61713E2E40B328BD.quest_desc: ["Guardians of order in an unpredicatble world of &#00D9FFChains&r, &#00D9FFBelts&r, and &#00D9FFBoxes&r."]
	quest.61713E2E40B328BD.quest_subtitle: "Obtain Repackager"
	quest.617193F8D9F5578D.quest_desc: ["The &#00D9FFDeepsilver Sickle&r is crafted from &#00D9FFDeepsilver Ingots&r in &#FFA500Eternal Starlight&r." "It gathers plants and vegetation efficiently in swamp and &#00D9FFNightfall&r regions."]
	quest.617193F8D9F5578D.quest_subtitle: "Obtain Deepsilver Sickle"
	quest.61736104E96470BD.quest_desc: ["Polonium is created by putting &#00D9FFNuclear Waste&r in a &#00D9FFSolar Neutron Activator&r. Then, you put the polonium into a &#00D9FFPressurized Reaction Chamber&r with water and fluorite dust."]
	quest.61736104E96470BD.quest_subtitle: "Obtain Pellet Polonium"
	quest.61743EF197A17A12.quest_desc: ["The &#00D9FFScroll Forge&r crafts scrolls from &#00D9FFPaper and Ink&r. Different focus items give different kinds of scrolls, and higher-tier ink unlocks rarer and more powerful scrolls."]
	quest.61743EF197A17A12.quest_subtitle: "Obtain Scroll Forge"
	quest.61766197A58086E4.quest_desc: ["Get hold of &#00D9AA4x&r &#00D9FFProsperity Shard&r. Hover over it in EMI and press R to see how it is made."]
	quest.61766197A58086E4.quest_subtitle: "Obtain 4x Prosperity Shard"
	quest.61766197A58086E4.title: "Prosperity Shard"
	quest.6190C58F236DC745.quest_desc: ["The &#00D9FFThallasium Shovel&r is a digging tool forged from &#00D9FFThallasium Ingots&r, handy for excavating and clearing terrain." "It rounds out the basic &#00D9FFThallasium&r tool set."]
	quest.6190C58F236DC745.quest_subtitle: "Obtain Thallasium Shovel"
	quest.619CC2A5B57E2148.quest_desc: ["Bring &#00D9FFSteam Mining Drill&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.619CC2A5B57E2148.quest_subtitle: "Obtain Steam Mining Drill"
	quest.619CC2A5B57E2148.title: "Getting That 3x3 Going"
	quest.619E60387DC202AD.quest_desc: ["Defeat &#00D9FFCryomancer&r."]
	quest.619E60387DC202AD.quest_subtitle: "Defeat Cryomancer"
	quest.619E60387DC202AD.title: "Cryomancer"
	quest.61AEF81C114513BB.quest_desc: ["Bring &#00D9FFQuantum Sword&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.61AEF81C114513BB.quest_subtitle: "Obtain Quantum Sword"
	quest.61AEF81C114513BB.title: "Annihilation Operator"
	quest.61BC4DC8D08E44FE.quest_desc: ["The &#00D9FFOverdrive Module&r will prevent the efficiency of an electric machine from going down, but force the machine to use full power all the time, even if it isn't processing anything. The effiency will reset if the recipe the machine is processing changes."]
	quest.61BC4DC8D08E44FE.quest_subtitle: "Obtain Overdrive Module"
	quest.61BDFE874D356920.quest_desc: ["The &#00D9FFSimple Reforging Table&r replaces an item's &#00D9FFAffixes&r with a new random combination. It is a cheaper alternative to the full &#00D9FFReforging Table&r."]
	quest.61BDFE874D356920.quest_subtitle: "Obtain Simple Reforging Table"
	quest.61BDFE874D356920.title: "Simple Reforging"
	quest.61E515AF1B72B1FA.quest_desc: ["It's hover and SHIFT info says it all: \"&#00D9FFUnidirectional&r powered rail with variable speed controlled by the signal strength supplied to it.\"."]
	quest.61E515AF1B72B1FA.quest_subtitle: "Obtain Controller Rail"
	quest.61E727F68F8EA832.quest_desc: ["The &#00D9FFConcurrent Press&r is used inside the &#00D9FFInscriber&r to craft the &#00D9FFConcurrent Processor&r."]
	quest.61E727F68F8EA832.quest_subtitle: "Obtain Concurrent Processor Press"
	quest.61EA178AF98220E7.quest_desc: ["Get hold of &#00D9FFMv Diesel Generator&r. Hover over it in EMI and press R to see how it is made."]
	quest.61EA178AF98220E7.quest_subtitle: "Obtain Mv Diesel Generator"
	quest.61EA178AF98220E7.title: "Fast and Furious"
	quest.61EFF94B2CBDACCF.quest_desc: ["To rotate blocks, right-click them. To toggle the corresponding side of a &#00D9FFPressure Tube&r between open and closed, right-click the tube."]
	quest.61EFF94B2CBDACCF.quest_subtitle: "Obtain Pneumatic Wrench"
	quest.61F3771F024D83E7.quest_desc: ["Like &#00D9FFthe Feeding Upgrade&r, with more control over when you get fed."]
	quest.61F3771F024D83E7.quest_subtitle: "Obtain Advanced Feeding Upgrade"
	quest.620784E4A0FFDA66.quest_desc: ["This quest asks for &#00D9FFKelp Roll&r. EMI shows the recipe if you press R while hovering over it."]
	quest.620784E4A0FFDA66.quest_subtitle: "Obtain Kelp Roll"
	quest.620AC078F80866B3.quest_desc: ["This special &#FFA500Simply Swords&r item turns into a random unique weapon after being kept in your inventory."]
	quest.620AC078F80866B3.quest_subtitle: "Obtain Tampered Remnant"
	quest.623F27E9DA2E2993.quest_desc: ["This quest asks for &#00D9FFPrudentium Gemstone&r. EMI shows the recipe if you press R while hovering over it."]
	quest.623F27E9DA2E2993.quest_subtitle: "Obtain Prudentium Gemstone"
	quest.624035E8E15B72C2.quest_desc: ["Tier 2 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.624035E8E15B72C2.quest_subtitle: "Obtain Glyph Cold Snap"
	quest.62439CE494A41F1C.quest_desc: ["The leggings of the &#00D9FFSupremium&r armor set. Together with the chestplate, they unlock the helmet."]
	quest.62495CE3803F2B21.quest_desc: ["A &#00D9FFTreasure Chest&r is fishing loot from &#FFA500Aquaculture&r 2. Catch one while fishing, then open it to claim the valuable items inside."]
	quest.62495CE3803F2B21.quest_subtitle: "Obtain Treasure Chest"
	quest.625FBA4D1405E41A.quest_desc: ["&#FFA500Quark&r adds many smaller features across building, exploration, items, and quality of life. Check its in-game descriptions and config-enabled features to discover what is active in this pack."]
	quest.625FBA4D1405E41A.title: "Getting Started"
	quest.625FF6B855DA850D.quest_desc: ["&#00D9FFMachine Hulls&r contain the main electronics to allow machines to run. There are different tiers to machine hulls, each allowing you to upgrade your machines. The &#00D9FFBasic Machine Hull&r is the base of every machine that takes LV power. If you want your machine to accept MV power, you must upgrade it using an &#00D9FFAdvanced Machine Hull&r. You can do this by right clicking the machine with the upgraded hull in your hand or by placing it in the top right slot of the machine's GUI that seems to have a small isometric cube depiction. You can do the same with higher tier hulls as they will allow for higher tier power sources."]
	quest.625FF6B855DA850D.quest_subtitle: "Obtain Basic Machine Hull"
	quest.625FF6B855DA850D.title: "Machine Hulls"
	quest.6265515BFE6B5CC2.quest_desc: ["This quest asks for &#00D9FFCell Component&r 4m. EMI shows the recipe if you press R while hovering over it."]
	quest.6265515BFE6B5CC2.quest_subtitle: "Obtain Cell Component 4m"
	quest.626D147109725807.quest_desc: ["Get hold of &#00D9FFLimited Netherite Barrel&r 1. Hover over it in EMI and press R to see how it is made."]
	quest.626D147109725807.quest_subtitle: "Obtain Limited Netherite Barrel 1"
	quest.6274CAF76FF7FAFB.quest_desc: ["Find a &#00D9FFJungle Fortress&r, the &#FFA500Repurposed Structures&r version of a &#00D9FFNether Fortress&r."]
	quest.6274CAF76FF7FAFB.quest_subtitle: "Enter a Jungle Fortress"
	quest.627926A7677D452B.quest_desc: ["The &#00D9FFCoral Spear&r is a powerful &#FFA500Cataclysm&r melee weapon that &#00D9FFDeepling&r enemies can drop." "Defeat Deeplings to get this rare ocean weapon."]
	quest.627926A7677D452B.quest_subtitle: "Obtain Coral Spear"
	quest.6292351BF8CBF481.quest_desc: ["The &#00D9FFThallasium Sword&r is &#00D9FFBetter End's&r entry-level sword, assembled from a &#00D9FFThallasium&r tool head and sword handle at a &#00D9FFSmithing Table&r." "It begins the mod's weapon progression."]
	quest.6292351BF8CBF481.quest_subtitle: "Obtain Thallasium Sword"
	quest.629387962F410B01.quest_desc: ["The &#00D9FFGlacite Shield&r is crafted from &#00D9FFGlacite&r materials in &#FFA500Eternal Starlight&r." "It is more durable than the vanilla shield and helps you survive in cold biomes where frost effects are common."]
	quest.629387962F410B01.quest_subtitle: "Obtain Glacite Shield"
	quest.62A978B0A256B155.quest_desc: ["&#00D9FFPoisonous Potatoes&r are used to craft &#00D9FFNature Scrolls&r."]
	quest.62A978B0A256B155.quest_subtitle: "Obtain Poisonous Potato"
	quest.62BD7379CE46897A.quest_desc: ["The Shadow-&#00D9FFWalker Mask&r is the headpiece of the &#00D9FFShadow&r-&#00D9FFWalker Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. It gives &#00D9AA+3&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFEnder Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "Craft it from 5 &#00D9FFArcane Cloth&r and 1 &#00D9FFEnder Rune&r, or upgrade a &#00D9FFWizard Helmet&r with 1 &#00D9FFEnder Rune&r and 1 &#00D9FFArcane Essence&r in supported versions."]
	quest.62BD7379CE46897A.quest_subtitle: "Obtain Shadowwalker Helmet"
	quest.62CDE865C4D7CB2F.quest_desc: ["Applies a potion effect to the surrounding mobs, players included."]
	quest.62CDE865C4D7CB2F.quest_subtitle: "Obtain Potion Diffuser"
	quest.62E86F002AD0EDD5.quest_desc: ["Get hold of &#00D9FFDiesel Chainsaw&r. Hover over it in EMI and press R to see how it is made."]
	quest.62E86F002AD0EDD5.quest_subtitle: "Obtain Diesel Chainsaw"
	quest.62E86F002AD0EDD5.title: "The Texas Chain Saw Massacre"
	quest.62EEDBF406A37C3A.quest_desc: ["&#00D9FFWandering Magician Pants&r are part of the basic &#00D9FFWandering Magician Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. They give &#00D9AA+5&r &#00D9FFArmor&r and &#00D9AA+25&r &#00D9FFMax Mana&r." "Craft them from &#00D9FFLeather Pants and Arcane Essence&r. They are a good early piece for extra mana with solid protection."]
	quest.62EEDBF406A37C3A.quest_subtitle: "Obtain Wandering Magician Leggings"
	quest.62F0AC5E95D09D6F.quest_desc: ["The &#00D9FFAeternium Axe&r is a top-tier woodcutting and combat tool made from &#00D9FFAeternium&r, which is stronger than &#00D9FFNetherite&r." "It sits at the top of &#00D9FFBetter End's&r tool progression."]
	quest.62F0AC5E95D09D6F.quest_subtitle: "Obtain Aeternium Axe"
	quest.63018989221AC000.quest_desc: ["Simply a must have for the fast factory."]
	quest.63018989221AC000.quest_subtitle: "Obtain Rotation Speed Controller"
	quest.63048F22F1981561.quest_desc: ["Bring &#00D9FFCrafting Unit&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.63048F22F1981561.quest_subtitle: "Obtain Crafting Unit"
	quest.63068E939646FE7A.quest_desc: ["Get hold of &#00D9FFPrairie Crabapple Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.63068E939646FE7A.quest_subtitle: "Obtain Prairie Crabapple Sapling"
	quest.630C7784CE9C7EAA.quest_desc: ["Use a &#00D9FFFreezer&r together with &#00D9FFIcestone&r on an accessory."]
	quest.630C7784CE9C7EAA.quest_subtitle: "Freeze an accessory"
	quest.6311E7A0ED0B034B.quest_desc: ["Craft it from &#00D9FFCracked Deepslate Tiles&r and books. Alone it is weak, giving only &#00D9AA+2&r &#00D9FFEterna&r (up to 30)." "Its real use is to be awakened: infuse it in the enchanting table with at least 60 &#00D9FFEterna&r, &#00D9AA40%&r &#00D9FFQuanta&r and &#00D9AA40%&r &#00D9FFArcana&r to make a &#00D9FFDeepshelf&r."]
	quest.6311E7A0ED0B034B.quest_subtitle: "Obtain Dormant Deepshelf"
	quest.632B8206B3F33C7C.quest_desc: ["Variants to find: &#00D9FFBirch&r, &#00D9FFDark Forest&r, &#00D9FFGiant Tree Taiga&r, &#00D9FFMangrove&r, &#00D9FFOak and Taiga&r."]
	quest.632B8206B3F33C7C.quest_subtitle: "Find all 6 Witch Hut variants"
	quest.632BD42D55D3EA8E.quest_desc: ["Bring &#00D9FFFrostward Ring and Ice Staff&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.632BD42D55D3EA8E.quest_subtitle: "Obtain Frostward Ring and Ice Staff"
	quest.632D1610BEBF4E27.quest_desc: ["The &#00D9FFRing of Grudged&r is a rare &#FFA500Cataclysm&r ring found in chests inside the &#00D9FFAbandoned Temple&r structure." "When equipped, it grants &#00D9AA+10%&r &#00D9FFCritical Damage&r."]
	quest.632D1610BEBF4E27.quest_subtitle: "Obtain Ring of Grudged"
	quest.632D1610BEBF4E27.title: "Ring Of Grudged"
	quest.6332C7EE9A88D842.quest_desc: ["This Machine can place &#00D9FFBlocks&r in the world, It's highly configurable."]
	quest.6332C7EE9A88D842.quest_subtitle: "Obtain Blockplacert1"
	quest.6337A88D3784E1FA.quest_desc: ["Used to bring an illager raid when used within a village."]
	quest.6337A88D3784E1FA.quest_subtitle: "Obtain Ritual Challenge"
	quest.634D71B683337622.quest_desc: ["Get hold of &#00D9FFFirefly&r. Hover over it in EMI and press R to see how it is made."]
	quest.634D71B683337622.quest_subtitle: "Obtain Firefly"
	quest.6351CC7A32F8CD13.quest_desc: ["The quests in this chapter only show a suggested progression. You can complete them in any order."]
	quest.6351CC7A32F8CD13.quest_subtitle: "Earn the advancement: Enter Aether"
	quest.635D2EAFF7FA5E7E.quest_desc: ["To craft &#00D9FFRedstone Crystal&r throw 1 &#00D9FFBlock of Redstone&r, 1 &#00D9FFGlowstone Dust&r, and 1 &#00D9FFFluix Crystal&r into water and watch the magic happen."]
	quest.635D2EAFF7FA5E7E.quest_subtitle: "Obtain Redstone Crystal"
	quest.6381EB59F371696B.quest_desc: ["Several types of &#00D9FFSalt&r exist, each used to create different resources in the end. Some Salts can be calcinated again into other kinds."]
	quest.6381EB59F371696B.quest_subtitle: "Obtain Alchemical Salt Strata, Alchemical Salt Mineral, Alchemical Salt Plant and Alchemical Salt Creature"
	quest.6381EB59F371696B.title: "Alchemical Salts"
	quest.63860999421539AC.quest_desc: ["The &#00D9FFSurvival Infinity Upgrade&r lets you mark items in your storage as infinite. You can withdraw them without the stored amount going down." "It suits late-game players who want their key resources to never run out."]
	quest.63860999421539AC.quest_subtitle: "Obtain Survival Infinity Upgrade"
	quest.6386B9D6B0829708.quest_desc: ["A pre-programmed &#00D9FFDrone&r that performs logistics tasks within a 31x31x31 area centered on the position it is deployed from."]
	quest.6386B9D6B0829708.quest_subtitle: "Obtain Logistics Drone"
	quest.639BE4FC6AF750B4.quest_desc: ["Bring &#00D9FFCapacitor&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.639BE4FC6AF750B4.quest_subtitle: "Obtain Capacitor"
	quest.639BE4FC6AF750B4.title: "The C in RLC"
	quest.63BBBD09FE89D89D.quest_desc: ["Get hold of &#00D9FFPink Ipe Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.63BBBD09FE89D89D.quest_subtitle: "Obtain Pink Ipe Sapling"
	quest.63C3CA53448C57EC.quest_desc: ["A &#00D9FFBucket of Seed Oil&r holds the fluid from &#FFA500Create Crafts and Additions&r that you get by processing seeds. It can fuel compatible &#FFA500Create&r machinery, which gives common seeds a new use."]
	quest.63C3CA53448C57EC.quest_subtitle: "Obtain Seed Oil Bucket"
	quest.63CB2C4A3B28C05D.quest_desc: ["The &#00D9FFMatter Cannon&r uses &#00D9FFMatter Balls&r and different &#00D9FFMetal Nuggets&r to deal damage by shooting them at opponents. It can be charged in the &#00D9FFCharger&r and refilled in an &#00D9FFME Chest&r, just as you would a &#00D9FFStorage Drive&r. Test out upgrades to see if any can make your &#00D9FFMatter Cannon&r better!"]
	quest.63CB2C4A3B28C05D.quest_subtitle: "Obtain Matter Cannon"
	quest.63CB2C4A3B28C05D.title: "Matter Cannon"
	quest.63E4BEB3B88F6540.quest_desc: ["&#00D9FFThermodynamic Conductors&r are a way of transporting heat. Insulation: 400."]
	quest.63E4BEB3B88F6540.quest_subtitle: "Obtain Advanced Thermodynamic Conductor"
	quest.63EA98542E0BD49C.quest_desc: ["&#00D9FFCarminite&r is a magical material found in the &#00D9FFDark Tower&r. It powers many of the tower's machines and mechanical creatures." "It is a rare resource needed to craft advanced devices and equipment unique to the &#FFA500Twilight Forest&r."]
	quest.63EA98542E0BD49C.quest_subtitle: "Obtain Carminite"
	quest.63F5C2E3B748FFAA.quest_desc: ["Ancient structures in &#FFA500Eternal Starlight&r hide &#00D9FFStarlight Golems&r." "They are hard to find, so use the &#00D9FFSeeking Eye&r together with the correct off-hand item."]
	quest.63F5C2E3B748FFAA.title: "Golem Forge"
	quest.640052AE59DB4B84.quest_desc: ["This is the last CPU you'll ever need, it handles all the crafting jobs you throw at it. The more &#00D9FFQuantum Computer Storage&r blocks you have in the structure, the more crafting jobs it can handle at once."]
	quest.640052AE59DB4B84.quest_subtitle: "Obtain Quantum Core, Data Entangler, Quantum Multi Threader and 3 more items"
	quest.64076EB04BF0AC2B.quest_desc: ["Get hold of &#00D9FFBurnt Roll&r. Hover over it in EMI and press R to see how it is made."]
	quest.64076EB04BF0AC2B.quest_subtitle: "Obtain Burnt Roll"
	quest.64082A47876182EF.quest_desc: ["The &#00D9FFArchevoker Coat&r is the chestpiece of the &#00D9FFArchevoker Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. It gives &#00D9AA+8&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFEvocation Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r, and can hold 1 imbued spell." "Craft it from 8 &#00D9FFArcane Cloth&r and 1 &#00D9FFEvocation Rune&r, or upgrade &#00D9FFWizard Robes&r with 1 &#00D9FFEvocation Rune&r at a &#00D9FFSmithing Table&r."]
	quest.64082A47876182EF.quest_subtitle: "Obtain Archevoker Chestplate"
	quest.640A6C22B23AF91D.quest_desc: ["Extends the invincibility time after taking damage."]
	quest.640A6C22B23AF91D.quest_subtitle: "Obtain Cross Necklace"
	quest.641933EA19F2BB50.quest_desc: ["The &#00D9FFIce Upgrade Orb&r is an upgrade material in &#FFA500Iron's Spells 'n Spellbooks&r. Applied at the &#00D9FFArcane Anvil&r, it gives &#00D9AA+5%&r &#00D9FFIce Spell Power&r." "Craft it from 1 &#00D9FFEmpty Upgrade Orb&r and 8 &#00D9FFIce Runes&r."]
	quest.641933EA19F2BB50.quest_subtitle: "Obtain Ice Upgrade Orb"
	quest.6419797CDC6482E2.quest_desc: ["Bring &#00D9FFConfigurable Honeycomb&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.6419797CDC6482E2.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.642644B33DEC6D7E.quest_desc: ["Bring &#00D9FFCoal Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.642644B33DEC6D7E.quest_subtitle: "Obtain Coal Seeds"
	quest.642CC869E844C762.quest_desc: ["Generates source by consuming burnables."]
	quest.642CC869E844C762.quest_subtitle: "Obtain Volcanic Sourcelink"
	quest.6430F9D2F201DA49.quest_desc: ["Tier 2 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.6430F9D2F201DA49.quest_subtitle: "Obtain Glyph Slowfall"
	quest.6445C75E5366698D.quest_desc: ["Get hold of &#00D9FFLapis Lazuli Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.6445C75E5366698D.quest_subtitle: "Obtain Lapis Lazuli Seeds"
	quest.644D11CAA593EB55.quest_desc: ["Make a &#00D9FFPumpkin Milkshake&r for a seasonal twist on your drink production. Combine pumpkin with the other ingredients to get this rich, creamy treat from &#FFA500Create: Dreams n' Desires&r."]
	quest.644D11CAA593EB55.quest_subtitle: "Obtain Pumpkin Milkshake"
	quest.6461D4F6C50DEA4C.quest_desc: ["Swaps blocks and entities between paired &#00D9FFSwappers&r, so you can transport blocks between worlds."]
	quest.6461D4F6C50DEA4C.quest_subtitle: "Obtain Blockswappert1"
	quest.646C854E999B52D2.quest_desc: ["This quest asks for &#00D9FFLimited Diamond Barrel&r 3. EMI shows the recipe if you press R while hovering over it."]
	quest.646C854E999B52D2.quest_subtitle: "Obtain Limited Diamond Barrel 3"
	quest.6472989111B260A5.quest_desc: ["Motors take electricity and produce a rotational force. You'll use motors to create many of the machines and other components in the future. You should automate these."]
	quest.6472989111B260A5.quest_subtitle: "Obtain Motor"
	quest.6472989111B260A5.title: "Motors"
	quest.64730C62AE083D95.quest_desc: ["Speeds up the growth of baby bees. &#00D9FFPut the BaBee&r in a cage and insert it with some honey treats."]
	quest.64730C62AE083D95.quest_subtitle: "Obtain Incubator"
	quest.648457225C137DDD.quest_desc: ["Get hold of &#00D9FFMagiscythe&r. Hover over it in EMI and press R to see how it is made."]
	quest.648457225C137DDD.quest_subtitle: "Obtain Magiscythe"
	quest.64876E4A94758E1C.quest_desc: ["Bring power, a controller, a terminal, a drive with a storage cell, and cable together to form a working ME network. Use the network as a foundation for the branches that follow."]
	quest.64876E4A94758E1C.title: "Build Your First ME Network"
	quest.64A6A68085FAFF36.quest_desc: ["Flexible, non-conductive, and strong. &#00D9FFRubber&r will be a major part of every electric machine. You can produce it by mixing &#00D9FFPaper&r with either &#00D9FFSynthetic Oil&r or &#00D9FFSynthetic Rubber&r. &#00D9FFMix the Coke Dust&r you made with &#00D9FFWater&r in a &#00D9FFMixer&r to produce &#00D9FFRaw Synthetic Oil&r. Use a &#00D9FFSteam Blast Furnace&r to produce these two fluids. &#00D9FFSynthetic Rubber&r is more difficult to obtain, but will yield more rubber per sheet of paper. Remember that you'll need a lot of &#00D9FFRubber Sheets&r in the long run, so you'll need to make them constantly. Note that you can use &#00D9FFWood&r to grind down and turn into &#00D9FFWood Pulp&r which can then be turned into &#00D9FFPaper&r with a high output yield."]
	quest.64A6A68085FAFF36.quest_subtitle: "Obtain Rubber Sheet"
	quest.64A6A68085FAFF36.title: "Rubber"
	quest.64A6E404227AA12A.quest_desc: ["&#00D9FFQIO Drives&r hold the items in a &#00D9FFQIO System&r. They work similar to AE2 drives where it has a maximum amount of space and types it can hold."]
	quest.64A6E404227AA12A.quest_subtitle: "Obtain Qio Drive Base"
	quest.64A8A849A96982CF.quest_desc: ["Get hold of &#00D9FFKnightmetal Helmet&r, &#00D9FFKnightmetal Chestplate&r, &#00D9FFKnightmetal Leggings and Knightmetal Boots&r. Hover over it in EMI and press R to see how it is made."]
	quest.64A8A849A96982CF.quest_subtitle: "Craft a full set of Knightmetal Armor"
	quest.64A8A849A96982CF.title: "Knightmetal Armorer"
	quest.64AEB967047B14B1.quest_desc: ["This quest asks for &#00D9FFWenge Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.64AEB967047B14B1.quest_subtitle: "Obtain Wenge Sapling"
	quest.64B15654C8144611.quest_desc: ["&#00D9FFEnriched Tin&r is used in the &#00D9FFMetallurgic Infuser&r. &#00D9FFEnriched Tin&r yields 80 units of tin in the &#00D9FFMetallurgic Infuser&r, the same as 8 &#00D9FFTin Dust&r."]
	quest.64B15654C8144611.quest_subtitle: "Obtain Enriched Tin"
	quest.64C0EB318F14295F.quest_desc: ["The &#00D9FFAdvanced Fluid Tank&r can hold up to &#00D9AA28000mB&r of fluids which is double the amount of the &#00D9FFBasic Fluid Tank&r. It can double as a bucket by switching its mode to bucket mode."]
	quest.64C0EB318F14295F.quest_subtitle: "Obtain Advanced Fluid Tank"
	quest.64D31A0D53E19DE6.quest_desc: ["Deepsilver is a basic metal in &#FFA500Eternal Starlight&r that you can smelt into ingots." "It is used for tools, armor and several utility recipes. Formerly called &#00D9FFSwamp Silver&r, it now generates in underground areas."]
	quest.64D31A0D53E19DE6.quest_subtitle: "Obtain Deepsilver Ingot"
	quest.64D31A0D53E19DE6.title: "Deepsilver Ingot"
	quest.64EA511602416211.quest_desc: ["The &#00D9FFStarfall Longbow&r is a ranged weapon from &#FFA500Eternal Starlight&r." "On hit it calls down stars that strike the target after a short delay, adding burst damage to one target or a small area."]
	quest.64EA511602416211.quest_subtitle: "Obtain Starfall Longbow"
	quest.64F322D0A5CD3973.quest_desc: ["The &#00D9FFGolden Mixer&r is a kinetic machine from &#FFA500Create: Dreams n' Desires&r, crafted with a &#00D9FFGolden Whisk&r. It is a specialized mixer that adds new processing options to your factory."]
	quest.64F322D0A5CD3973.quest_subtitle: "Obtain Gold Mixer"
	quest.64F465D465EBF4FB.quest_desc: ["Bring &#00D9FFSheep Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.64F465D465EBF4FB.quest_subtitle: "Obtain Sheep Seeds"
	quest.64F82315C1528711.quest_desc: ["The &#00D9FFHellshelf of Sight&r adds &#00D9AA+1&r &#00D9FFClue&r, so the enchanting table shows more of your enchantments before you pay." "Craft it from &#00D9FFInfused Hellshelves&r, an &#00D9FFEye of Ender&r, a &#00D9FFSpyglass&r, &#00D9FFGold Blocks&r and a potion."]
	quest.64F82315C1528711.quest_subtitle: "Obtain Sightshelf"
	quest.650AE6855EB4D7B6.quest_desc: ["This quest asks for &#00D9FFArmadillo Seeds&r. EMI shows the recipe if you press R while hovering over it."]
	quest.650AE6855EB4D7B6.quest_subtitle: "Obtain Armadillo Seeds"
	quest.652564CDB1B4370B.quest_desc: ["The &#00D9FFBelt of Beginner&r from &#FFA500Cataclysm&r is a simple belt that adds two &#00D9FFCurio&r slots for &#00D9FFSkulls&r." "It lets you equip relics such as the &#00D9FFUnbreakable Skull&r."]
	quest.652564CDB1B4370B.quest_subtitle: "Obtain Belt of Beginner"
	quest.652D5A92A02A8CAD.quest_desc: ["This quest asks for &#00D9FFSpawn Egg Configurable Bee&r. EMI shows the recipe if you press R while hovering over it."]
	quest.652D5A92A02A8CAD.quest_subtitle: "Obtain Spawn Egg Configurable Bee"
