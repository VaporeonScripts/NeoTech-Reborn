	quest.1B118921161500F2.quest_desc: ["Upgrade an Endshelf with End Rods and Ender Pearls." "It gives +10 Eterna (up to 90), +7.5 Quanta and +7.5 Arcana."]
	quest.1B118921161500F2.quest_subtitle: "Obtain Pearl Endshelf"
	quest.1B1C1BE6BB26761B.quest_desc: ["The Glacite Axe is a mid-tier axe crafted from Glacite Ingots in Eternal Starlight." "It is used in cold biomes for harvesting wood and fighting, with better durability and efficiency than earlier tiers."]
	quest.1B1C1BE6BB26761B.quest_subtitle: "Obtain Starlit Diamond Axe"
