	quest.582D3D0E840593DC.quest_subtitle: "Obtain Aquilaria Sapling"
	quest.58374602DC0D8189.quest_desc: ["This quest asks for Mushroom Rice. EMI shows the recipe if you press R while hovering over it."]
	quest.58374602DC0D8189.quest_subtitle: "Obtain Mushroom Rice"
