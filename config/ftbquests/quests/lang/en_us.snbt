	quest.021FC1E140F7F9FA.quest_subtitle: "Obtain Breeze Seeds"
	quest.02212DBD7C402385.quest_desc: ["Fluoride can only be obtained by mining it underground, or using Mystical Agriculture. You will need to combined it with the Sulfuric Acid made earlier to make Hydrofluoric Acid."]
	quest.02212DBD7C402385.quest_subtitle: "Obtain Fluorite Gem"
	quest.02246742726A7152.quest_desc: ["The Gold Drill produces ores and building blocks that you'd expect to find in the confines of the Nether Region."]
