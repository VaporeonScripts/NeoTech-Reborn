	quest.50F5BF288092DA4C.title: "Making Blazegold"
	quest.50F67A8AF91B5527.quest_desc: ["The Thallasium Hammer has two uses. It shapes ingots at the Anvil, and it also works as a heavy melee weapon with strong knockback." "It is the Thallasium version of Better End's Hammer weapon class."]
	quest.50F67A8AF91B5527.quest_subtitle: "Obtain Thallasium Hammer"
