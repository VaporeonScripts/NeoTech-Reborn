	quest.4373ED4700D90FC3.quest_desc: ["The Engineering Processor is made in an Inscriber from a Printed Engineering Circuit, Printed Silicon and Redstone. It is used for the ME Controller, Molecular Assembler and many other machines."]
	quest.437C9CE5AC044541.quest_desc: ["Bring Canteen into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.437C9CE5AC044541.quest_subtitle: "Obtain Canteen"
