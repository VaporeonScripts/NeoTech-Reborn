	quest.41AC69B1AEB55A80.quest_desc: ["&#00D9FFAll Chalk&r is crafted impure, and can be purified in &#00D9FFSpiritfire&r to become usable. &#00D9FFWhite Chalk&r is the simplest foundation chalk, and has no unique properties on its own."]
	quest.41AC69B1AEB55A80.quest_subtitle: "Obtain Chalk White Impure"
	quest.41B09F04DCB392A5.quest_desc: ["Once you find the hidden structure, you can face its guardian, the &#00D9FFStarlight Golem&r." "It is strong and durable, so beating it shows you are ready for elite threats in the dimension."]
	quest.41B09F04DCB392A5.quest_subtitle: "Defeat Starlight Golem"
	quest.41B09F04DCB392A5.title: "Starlight Golem"
	quest.41B56DDD404A9E28.quest_desc: ["&#00D9FFLogistical Transporters&r are &#FFA500Mekanism&r's way of transporting items. They are smarter compared to other item pipes and can be highly configured with the &#00D9FFConfigurator&r. Transfer Rate: 2 items/1 m/s."]
	quest.41B56DDD404A9E28.quest_subtitle: "Obtain Basic Logistical Transporter"
	quest.41C4CEED66FD93C0.quest_desc: ["Some weapons and armor drop with powerful &#00D9FFAffixes&r, which can grant anything from extra damage and durability to new abilities. Find your first piece to start your journey into &#FFA500Apotheosis&r."]
	quest.41C4CEED66FD93C0.quest_subtitle: "Find your first piece of Affix Gear"
	quest.41C4CEED66FD93C0.title: "A New Power"
	quest.41C610394B897796.quest_desc: ["Increases the knockback dealt by the wearer."]
	quest.41C610394B897796.quest_subtitle: "Obtain Pocket Piston"
	quest.41DC432CE80CB61F.quest_desc: ["Bring &#00D9FFBox Turtle&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.41DC432CE80CB61F.quest_subtitle: "Obtain Box Turtle"
	quest.41DCA8545FE4A445.quest_desc: ["This quest asks for &#00D9FFBinding Card&r. EMI shows the recipe if you press R while hovering over it."]
	quest.41DCA8545FE4A445.quest_subtitle: "Obtain Binding Card"
	quest.41E804D67538E375.quest_desc: ["Craft candles from honeycombs and string. Place them to decorate your home and give light at night."]
