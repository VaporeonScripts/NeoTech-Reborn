	quest.40D43B60506C8CE2.quest_desc: ["Defeat an &#00D9FFAngler Fish&r in the waters of the &#00D9FFOtherside&r." "Its glowing lure is the only light down there, so avoid following it too far."]
	quest.40D43B60506C8CE2.quest_subtitle: "Defeat Angler Fish"
	quest.40D43B60506C8CE2.title: "Angler Fish"
	quest.40E5FC2377896450.quest_desc: ["The &#00D9FFFrostbranded Book&r is a top-tier Ice spellbook in &#FFA500Iron's Spells 'n Spellbooks&r. It offers 12 spell slots, &#00D9AA+10%&r &#00D9FFIce Spell Power&r and &#00D9AA+200&r &#00D9FFMax Mana&r, a great pick for frost mages."]
