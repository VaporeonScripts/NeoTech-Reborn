	quest.6B9E34653D582016.quest_desc: ["The Eclipse Gate Wand has Lava Repair, Air Burst up to strength 8, Void Shift up to 30 blocks and Eclipse Gate, which opens a portable hole. All blocks except tile entities vanish temporarily, and after a short time the hole collapses and the blocks return."]
	quest.6B9E34653D582016.quest_subtitle: "Obtain Eclipsegate Wand"
