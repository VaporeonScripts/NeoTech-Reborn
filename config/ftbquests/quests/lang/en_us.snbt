	quest.4DD84C192C13BA30.quest_desc: ["The Deepsilver Hoe is crafted from Deepsilver Ingots in Eternal Starlight." "It prepares farmland in swamp and Nightfall regions and lasts longer than an iron hoe."]
	quest.4DD84C192C13BA30.quest_subtitle: "Obtain Deepsilver Hoe"
