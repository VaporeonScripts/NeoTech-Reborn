	quest.230308CD365396D6.quest_desc: ["Get hold of Conjurers Talisman. Hover over it in EMI and press R to see how it is made."]
	quest.230308CD365396D6.quest_subtitle: "Obtain Conjurers Talisman"
	quest.2328F563FE287CB7.quest_desc: ["This quest asks for Bloody Voodoo Doll. EMI shows the recipe if you press R while hovering over it."]
