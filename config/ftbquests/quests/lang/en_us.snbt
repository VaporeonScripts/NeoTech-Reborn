	quest.336DD356AC4AEA0B.quest_desc: ["The &#00D9FFLimited Oak Barrel II&r has more capacity than the previous tier while keeping the compact barrel design." "It is a good next step before moving on to larger containers."]
	quest.336DD356AC4AEA0B.quest_subtitle: "Obtain Limited Barrel 2"
