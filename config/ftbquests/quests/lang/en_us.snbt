	quest.22A31024A138B0F7.quest_subtitle: "Obtain Meka Tool"
	quest.22AE205952E2DD8B.quest_desc: ["Get hold of Furnator Niotic. Hover over it in EMI and press R to see how it is made."]
	quest.22AE205952E2DD8B.quest_subtitle: "Obtain Furnator Niotic"
