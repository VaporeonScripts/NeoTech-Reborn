	quest.5838285BF1AD308C.quest_subtitle: "Obtain Alchemy Upgrade"
	quest.583A580BF8561A66.quest_desc: ["Bring Sulfur Seeds into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.583A580BF8561A66.quest_subtitle: "Obtain Sulfur Seeds"
	quest.584F07C31B01C578.quest_desc: ["This quest asks for Ender Gate Starter. EMI shows the recipe if you press R while hovering over it."]
