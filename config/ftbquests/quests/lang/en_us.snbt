	quest.4BB45B2E57D2CDC7.title: "Fast and Furious 42: Armageddon"
	quest.4BBDF2C2666D8BA1.quest_desc: ["The Terminite Axe is a woodcutting and combat tool forged from Terminite Ingots, one step above Thallasium." "It is not the strongest gear, but it is a needed step toward Aeternium and Crystalite equipment."]
	quest.4BBDF2C2666D8BA1.quest_subtitle: "Obtain Terminite Axe"
	quest.4BCD6192960BB513.quest_desc: ["The QIO Exporter exports items from the QIO System into other inventories. You just need to set the frequency and the filters for exporting."]
	quest.4BCD6192960BB513.quest_subtitle: "Obtain Qio Exporter"
	quest.4BFE4A17CDC64114.quest_desc: ["The Elite Bin is a storage block which can hold 32,768 of a single item. It will retain its inventory when broken."]
	quest.4BFE4A17CDC64114.quest_subtitle: "Obtain Elite Bin"
	quest.4BFE77077C798033.quest_desc: ["The Basic Card is a crafting component used to craft Upgrades."]
	quest.4BFE77077C798033.quest_subtitle: "Obtain Basic Card"
	quest.4BFE77077C798033.title: "Basic Card"
	quest.4C05BB9DDAD2583A.quest_desc: ["Get hold of Cinnamon Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.4C05BB9DDAD2583A.quest_subtitle: "Obtain Cinnamon Sapling"
	quest.4C16A7BA37C9F6C0.quest_desc: ["The Legionnaire Flamberge is the upgraded Decrepit Flamberge in Iron's Spells 'n Spellbooks. It has 11 Attack Damage, 1.5 Attack Speed and +4 Armor." "Upgrade the Decrepit Flamberge at a Smithing Table with 1 Timeless Slurry and 1 Pyrium Ingot."]
	quest.4C16A7BA37C9F6C0.quest_subtitle: "Obtain Legionnaire Flamberge"
