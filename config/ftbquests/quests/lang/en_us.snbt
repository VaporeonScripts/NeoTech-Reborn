	quest.42109075C0A25655.quest_desc: ["This unit allows you to add the Fortune Enchantment to your MekaTool. It basically provides more drops per ore mined. You can stack it to 3."]
	quest.42109075C0A25655.quest_subtitle: "Obtain Module Fortune Unit"
	quest.42162C6248690A73.quest_desc: ["This quest asks for Scroll. EMI shows the recipe if you press R while hovering over it."]
	quest.42162C6248690A73.quest_subtitle: "Obtain Scroll"
	quest.42181284A31A5165.quest_desc: ["Tier Installers are used to upgrade various machines into their Factory equivalent. Right-click on the machine with the Tier Installer and it will upgrade that machine. its level (Basic, Advanced, or Elite) depending on the level of the Tier Installer used."]
	quest.42181284A31A5165.quest_subtitle: "Obtain Elite Tier Installer"
	quest.421A6CCE09FF7F0C.quest_desc: ["Use this to record your glyphs."]
	quest.421A6CCE09FF7F0C.quest_subtitle: "Obtain Annotated Codex"
	quest.421AFA4CE29C4436.quest_desc: ["The Guide is your collection log for everything fishing, from rare fish to shiny trophies."]
	quest.421AFA4CE29C4436.quest_subtitle: "Get the Starcatcher's Guide"
	quest.421AFA4CE29C4436.title: "Starcatcher's Guide"
	quest.421F14535BF99CEF.quest_desc: ["Bring Stratus Helmet, Stratus Chestplate, Stratus Leggings and 2 more items into your inventory. Check EMI with R on the item if you are unsure how to get it."]
