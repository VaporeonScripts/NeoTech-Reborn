	quest.0601E6F777AF3E03.quest_desc: ["The first piece of the Neptunium armor set. Get the boots to unlock the chestplate and leggings."]
	quest.06020F92ADD95F9A.quest_desc: ["The core element for a molecular assembler of Create, basically. Tip: use a Redstone signal next to an array of these to close all unused spots when crafting a smaller recipe."]
	quest.06020F92ADD95F9A.quest_subtitle: "Obtain Mechanical Crafter"
	quest.0611328B9AA27828.quest_desc: ["The Flowglaze Shovel is a digging tool from Eternal Starlight in the Flowglaze tier." "It is used for excavation and terrain clearing in mid-to-late game."]
