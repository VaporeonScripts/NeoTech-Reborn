	quest.6BCC1A61CD7E90B2.quest_subtitle: "Obtain Ritual Cloudshaping"
	quest.6C45809FFDD0FBCF.quest_desc: ["Through the power of gravity, throwing 1 Gold Ingot, 1 Lapis Lazuli, and 1 Entro dust you will obtain 1 Entro Infused Ingot."]
	quest.6C45809FFDD0FBCF.quest_subtitle: "Obtain Entro Ingot"
	quest.6C494F9D6CCE6111.quest_desc: ["Voidshimmer Goo turns Diamond Blocks into Celestigems. It is fed with Ender Pearls or Chorus Fruit, and it can produce the resources of lower tiers faster. Celestigem and Eclipse Alloy tools, weapons and armor need power to work."]
	quest.6C494F9D6CCE6111.quest_subtitle: "Obtain 2x Celestigem and Gooblock Tier3"
	quest.6C494F9D6CCE6111.title: "Making Celestigems"
	quest.6C4A85F9A1C02D1D.quest_desc: ["This quest asks for Monkey Puzzle Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.6C4A85F9A1C02D1D.quest_subtitle: "Obtain Monkey Puzzle Sapling"
	quest.6C5729829DB3D863.quest_desc: ["The Ur-Ghast holds the top of the Dark Forest Tower, found in a small clearing in the middle of the Dark Forest. The area has reddish leaves and faded grass." "Defeating it completes the Dark Forest phase."]
	quest.6C5729829DB3D863.quest_subtitle: "Defeat the Ur-Ghast"
	quest.6C5729829DB3D863.title: "Ur-Ghast"
	quest.6C5889B6CFE66D67.quest_desc: ["Get hold of Energy Cell Spirited. Hover over it in EMI and press R to see how it is made."]
	quest.6C5889B6CFE66D67.quest_subtitle: "Obtain Energy Cell Spirited"
	quest.6CA2B05E986937CB.quest_desc: ["Polymorphic Catalyst is the key to unlock Just Dire Things' better fuels. Drop one piece of polymorphic catalyst into water, and polymorphic fluid will result."]
	quest.6CA2B05E986937CB.quest_subtitle: "Obtain Polymorphic Catalyst and Polymorphic Fluid Bucket"
	quest.6CA786134D0DA32B.quest_desc: ["Pulls items to it within a configurable area. You can place the magnet field somewhere else and increase its range."]
	quest.6CA786134D0DA32B.quest_subtitle: "Obtain Itemcollector"
	quest.6CC786A9FFA28065.quest_desc: ["The scepter clears the poisonous mosquitoes from the Swamp, the blinding darkness of the Dark Forest and the chill of the Snowy Forest."]
	quest.6CC786A9FFA28065.quest_subtitle: "Defeat the Lich and take a scepter"
	quest.6CCC0C85FD188EB8.quest_desc: ["Bring Grapefruit Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.6CCC0C85FD188EB8.quest_subtitle: "Obtain Grapefruit Sapling"
	quest.6CEFF519AC0F4981.quest_desc: ["This quest asks for Blazegold Leggings. EMI shows the recipe if you press R while hovering over it."]
	quest.6CEFF519AC0F4981.quest_subtitle: "Obtain Blazegold Leggings"
