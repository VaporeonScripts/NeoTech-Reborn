	quest.47FD673F259F1C85.quest_desc: ["Variants to find: Badlands, Basalt, Birch, Crimson, Desert, End, Giant Tree Taiga, Icy, Jungle, Mangrove, Nether Brick, Oak, Ocean, Savanna, Soul, Snowy, Taiga and Warped."]
	quest.47FD673F259F1C85.quest_subtitle: "Find all 18 Pillager Outpost variants"
	quest.481148E497D80C70.quest_desc: ["This quest asks for Sealed Claymore. EMI shows the recipe if you press R while hovering over it."]
