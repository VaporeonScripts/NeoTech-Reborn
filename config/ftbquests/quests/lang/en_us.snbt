	quest.42F88B4FEBBDA6FE.quest_subtitle: "Obtain Hydraulic Press"
	quest.42FC15CB7B7D0CD5.quest_desc: ["Make the Warden Leggings in a Mechanical Crafter using a Netherite Leggings, Echo Ingots, Warden Carapace, a Reinforced Echo Shard and a Warden Upgrade Template." "Enchantments on the netherite piece are not kept, so enchant the result afterwards."]
	quest.42FC15CB7B7D0CD5.quest_subtitle: "Obtain Warden Leggings"
