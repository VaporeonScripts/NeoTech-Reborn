	quest.322BD88DD2CCDB7D.quest_desc: ["Use this to download saved Schematics into a new Schematic ready for use in the Schematicannon."]
	quest.322BD88DD2CCDB7D.quest_subtitle: "Obtain Schematic Table"
	quest.323DC671CF4F16C8.quest_desc: ["This quest asks for Cell Component 256m. EMI shows the recipe if you press R while hovering over it."]
	quest.323DC671CF4F16C8.quest_subtitle: "Obtain Cell Component 256m"
	quest.3243ADA9881FFFBA.quest_desc: ["Use it to make fish fillets. The amount you get depends on the type of fish."]
	quest.3243ADA9881FFFBA.quest_subtitle: "Obtain Stone Fillet Knife"
	quest.32530CEA82AB0E41.quest_desc: ["When a Diamond is thrown into Spiritfire, it becomes a Spirit Attuned Gem. You may need several."]
	quest.32530CEA82AB0E41.quest_subtitle: "Obtain Spirit Attuned Gem"
	quest.325E280DC8B94661.quest_desc: ["This quest asks for Netherite Diving Helmet, Netherite Diving Boots and Netherite Backtank. EMI shows the recipe if you press R while hovering over it."]
	quest.325E280DC8B94661.quest_subtitle: "Obtain Netherite Diving Helmet, Netherite Diving Boots and Netherite Backtank"
	quest.3261FFB968EAC0BE.quest_desc: ["Bring Source Berry Roll into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3261FFB968EAC0BE.quest_subtitle: "Obtain Source Berry Roll"
	quest.326C6166A14D641E.quest_desc: ["Flux Cores are the main crafting ingredient for Flux Networks blocks and items. The mod's GitHub wiki explains the rest of the system."]
	quest.326C6166A14D641E.quest_subtitle: "The core ingredient for Flux Networks parts"
	quest.326C6166A14D641E.title: "Flux Core"
