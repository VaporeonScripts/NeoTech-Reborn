	quest.1DAA172754E4E1C3.quest_subtitle: "Obtain Eclipsealloy Paxel"
	quest.1DB25C56BA9B49D7.quest_desc: ["Crafted in the Inscriber, the Accumulation Press is used with Sky Stone Ingots to produce Accumulation Circuits."]
	quest.1DB25C56BA9B49D7.quest_subtitle: "Obtain Accumulation Processor Press"
	quest.1DBB999D5D5A9586.quest_desc: ["Sculk Centipedes crawl through the caves of the Otherside. Defeat one." "They move fast, so keep your shield up."]
	quest.1DBB999D5D5A9586.quest_subtitle: "Defeat Sculk Centipede"
	quest.1DBB999D5D5A9586.title: "Sculk Centipede"
	quest.1DC3EA1F37C08EEC.quest_desc: ["Get hold of Scroll. Hover over it in EMI and press R to see how it is made."]
