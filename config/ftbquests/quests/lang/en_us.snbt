	quest.1E2CCB2E0D3633D2.quest_subtitle: "Obtain Bumble Bee Nest"
	quest.1E3A2AFD59BBAED5.quest_desc: ["This special pickaxe, while very brittle, will allow you to harvest Otherworld materials, such as Iesnium, more effectively."]
	quest.1E3A2AFD59BBAED5.quest_subtitle: "Obtain Infused Pickaxe"
	quest.1E3FC9FC0023F9A6.quest_desc: ["Use the Scroll Forge and a Bottle O' Lightning to craft a lightning Scrolls."]
	quest.1E3FC9FC0023F9A6.quest_subtitle: "Obtain Scroll"
	quest.1E4CB1835FA3CE58.quest_desc: ["Get hold of Inferium Ingot. Hover over it in EMI and press R to see how it is made."]
	quest.1E4CB1835FA3CE58.quest_subtitle: "Obtain Inferium Ingot"
	quest.1E570B6A61BC574A.quest_desc: ["The Glacite Scythe is crafted from Glacite Ingots in Eternal Starlight." "It makes wide melee attacks and slows enemies, which helps control crowds in cold biomes."]
	quest.1E570B6A61BC574A.quest_subtitle: "Obtain Glacite Scythe"
	quest.1E5766EA0B9E55D3.quest_desc: ["The Snow Queen waits at the top of the Aurora Palace, surrounded by living ice, and guards what lies beyond." "She fights in the air across several phases, summoning floating ice shields, dropping icicles and firing blasts of frozen magic. Adapt to each phase to win. Defeating her opens the path to the deepest secrets of the Twilight Forest."]
	quest.1E5766EA0B9E55D3.quest_subtitle: "Defeat Snow Queen"
	quest.1E5766EA0B9E55D3.title: "SnowQueen"
	quest.1E5F687D7F621301.quest_desc: ["Free Runners are an item that allows players to ascend 1-block inclines automatically (like the Horse), as well as preventing fall damage as long as they are charged. A fall will reduce the item's charge, depending on how far the fall was."]
	quest.1E5F687D7F621301.quest_subtitle: "Obtain Free Runners Armored"
	quest.1E656655600FBCEA.quest_desc: ["Wrap a furnace up as a gift for a friend."]
	quest.1E656655600FBCEA.quest_subtitle: "Obtain Item Xmas"
	quest.1E6D0C7597FC5060.quest_desc: ["Allows storages to work as a configurable hopper."]
	quest.1E6D0C7597FC5060.quest_subtitle: "Obtain Hopper Upgrade"
	quest.1E756592BDE0C97B.quest_desc: ["Flux Storage keeps excess energy and only fills once every Flux Point has received enough. Stored energy can only leave through a Flux Point. This tier has a transfer limit of 1,440,000. Networks do not need storage to work."]
	quest.1E756592BDE0C97B.quest_subtitle: "The largest energy buffer for your network"
	quest.1E7FEB231735D129.quest_desc: ["The Hydra is a huge, many-headed beast that rules the Fire Swamp of the Twilight Forest." "Each head can attack with fire or powerful bites, and the fight gets harder as it goes, so stay alert and adapt. Beating it grants valuable treasure and brings you closer to the dimension's deepest secrets."]
	quest.1E7FEB231735D129.quest_subtitle: "Defeat Hydra"
	quest.1E7FEB231735D129.title: "Hydra"
	quest.1E86061C29212C13.quest_desc: ["The Alpha Yeti rules the icy Glacier of the Twilight Forest and defends its frozen cave. It is much larger than ordinary Yetis." "It throws large blocks of ice, creates freezing shockwaves and hits hard. Bring strong gear, position carefully and prepare for the cold. Beating it opens the way to further challenges."]
	quest.1E86061C29212C13.quest_subtitle: "Defeat Alpha Yeti"
	quest.1E86061C29212C13.title: "AlphaYeti"
	quest.1E8FD73A62415312.quest_desc: ["The Blood Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. Applied at the Arcane Anvil, it gives +5% Blood Spell Power." "Craft it from 1 Empty Upgrade Orb and 8 Blood Runes. Upgrade Orbs can be applied to compatible equipment to raise its magical power."]
	quest.1E8FD73A62415312.quest_subtitle: "Obtain Blood Upgrade Orb"
	quest.1E917C10CA1C7C20.quest_desc: ["Look for an End City, a tall purpur and end stone brick structure on the outer End islands." "Shulkers guard it, and its loot is among the best in the dimension, including Elytra and Shulker Shells."]
	quest.1E917C10CA1C7C20.title: "End City"
	quest.1E99E55742762FD6.quest_desc: ["Reduces the time it takes to drink and eat."]
	quest.1E99E55742762FD6.quest_subtitle: "Obtain Novelty Drinking Hat"
	quest.1EAE47F9C0288679.quest_desc: ["The Steel Brewery can automatically brew four potions at a time at a considerably quicker rate than a regular brewing stand. Remember it needs Blazing Essence in place of Blaze Powder."]
	quest.1EAE47F9C0288679.quest_subtitle: "Obtain Steel Brewery"
	quest.1EB22FA1F8CCCE6C.quest_desc: ["Another upgrade in speed and fuel efficiency."]
	quest.1EB22FA1F8CCCE6C.quest_subtitle: "Obtain Crystal Furnace"
	quest.1EB49A6611387393.quest_desc: ["Up there with Ad Astra’s."]
	quest.1EB49A6611387393.quest_subtitle: "Obtain Train Door"
	quest.1ECBEA78F8E62FAF.quest_desc: ["This quest asks for Awakened Supremium Sword, Awakened Supremium Pickaxe, Awakened Supremium Shovel and 2 more items. EMI shows the recipe if you press R while hovering over it."]
	quest.1ECBEA78F8E62FAF.quest_subtitle: "Obtain Awakened Supremium Sword, Awakened Supremium Pickaxe, Awakened Supremium Shovel and 2 more items"
	quest.1ECBEA78F8E62FAF.title: "Awakened Supremium Tools"
	quest.1ED2AA4068C17DA4.quest_desc: ["Adventurer Skills adds character progression through skills. Review the available choices and build toward the bonuses that support your preferred playstyle."]
	quest.1ED2AA4068C17DA4.title: "Getting Started"
	quest.1ED3465F0C3B958C.quest_desc: ["Earn the advancement: Steel Machine Casing."]
	quest.1ED3465F0C3B958C.quest_subtitle: "Earn the advancement: Steel Machine Casing"
	quest.1ED4EC6096D38FF5.quest_desc: ["Transfers source for an infinite distance between relays, but it has a chance to lose source after 30 blocks."]
	quest.1ED4EC6096D38FF5.quest_subtitle: "Obtain Relay Warp"
	quest.1EDF214FFEE5173D.quest_desc: ["Bring Eclipsealloy Axe into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1EDF214FFEE5173D.quest_subtitle: "Obtain Eclipsealloy Axe"
	quest.1EF3F77676A93FE7.quest_desc: ["Get hold of Icewhisper. Hover over it in EMI and press R to see how it is made."]
	quest.1EF3F77676A93FE7.quest_subtitle: "Obtain Icewhisper"
	quest.1F12C2ADC89B8584.quest_desc: ["A Thermal Compressor uses temperature differences on opposite sides of the block to compress air. To operate it, place a high-temperature block on one side and a low-temperature block on the opposite side. Note: North-South faces are thermally connected to each other, as are the East-West faces, but there is no thermal connection between the North-South and East-West sides. The thermally connected sides will try to equalize their temperatures, so it's important to maintain a significant temperature differential for effective operation."]
	quest.1F12C2ADC89B8584.quest_subtitle: "Obtain Thermal Compressor"
	quest.1F2BCDA26D310572.quest_desc: ["Heat Generators create power using heat. Lava or other burnables can be used as it's heat source."]
	quest.1F2BCDA26D310572.quest_subtitle: "Obtain Heat Generator"
	quest.1F2E8A17A11EA9D1.quest_desc: ["This quest asks for Beech Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.1F2E8A17A11EA9D1.quest_subtitle: "Obtain Beech Sapling"
	quest.1F3FAF8151DD596D.quest_desc: ["This quest asks for Insanium Essence. EMI shows the recipe if you press R while hovering over it."]
	quest.1F3FAF8151DD596D.quest_subtitle: "Obtain Insanium Essence"
	quest.1F428A4E81D19351.quest_desc: ["This quest asks for Jellyfish Bucket. EMI shows the recipe if you press R while hovering over it."]
	quest.1F428A4E81D19351.quest_subtitle: "Obtain Jellyfish Bucket"
	quest.1F486D8E2EC696A1.quest_desc: ["This quest asks for Magma Cake Block. EMI shows the recipe if you press R while hovering over it."]
	quest.1F486D8E2EC696A1.quest_subtitle: "Obtain Magma Cake Block"
	quest.1F4DB18F49025B83.quest_desc: ["This Ring can store an occult familiar inside, providing some of its benefits without it needing to be by your side."]
	quest.1F4DB18F49025B83.quest_subtitle: "Obtain Familiar Ring"
	quest.1F51BCEA863D8050.quest_desc: ["This quest asks for Music Disc Stal. EMI shows the recipe if you press R while hovering over it."]
	quest.1F51BCEA863D8050.quest_subtitle: "Obtain Music Disc Stal"
	quest.1F599AED12C40EB7.quest_desc: ["Bring Silver Lime Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1F599AED12C40EB7.quest_subtitle: "Obtain Silver Lime Sapling"
	quest.1F671291375277C6.quest_desc: ["Tier 3 glyph. Craft it at the Scribe\'s Table."]
	quest.1F671291375277C6.quest_subtitle: "Obtain Glyph Blink"
	quest.1F6E1D72B79DB31C.quest_desc: ["Bring Ender Cell Hardened into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1F6E1D72B79DB31C.quest_subtitle: "Obtain Ender Cell Hardened"
	quest.1F93468FAB015372.quest_desc: ["A sleek bronze casing with a vicious spinning blade inside will give you even better cutting ratios than you ever experienced using your Forge Hammer. Time for extra bolts, gears, rings, and rods! Just remember that you can't cut for free. This machine runs off Steam and uses Lubricant to make clean cuts without overheating. Lubricant can be produced inside of the Mixer, using Redstone and one of the various hydrocarbons. You may find something to mix with Redstone!"]
	quest.1F93468FAB015372.quest_subtitle: "Obtain Bronze Cutting Machine"
	quest.1F93468FAB015372.title: "Bronze Cutting Machine"
	quest.1F96B7A6858E5DD1.quest_desc: ["You probably met this unassuming little guy while pressing your first plates in Create. The Depot holds items in place for many other Create things to interact with them."]
	quest.1F96B7A6858E5DD1.quest_subtitle: "Obtain Depot"
	quest.1F997447CADA740E.quest_desc: ["Get hold of 4x Capacitor Basic. Hover over it in EMI and press R to see how it is made."]
	quest.1F997447CADA740E.quest_subtitle: "Obtain 4x Capacitor Basic"
	quest.1F997447CADA740E.title: "Basic Capacitor"
	quest.1FA6F802D3054074.quest_desc: ["Bring Greenheart Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1FA6F802D3054074.quest_subtitle: "Obtain Greenheart Sapling"
	quest.1FB09C79472857DE.quest_desc: ["Get hold of Immaterial Disperser. Hover over it in EMI and press R to see how it is made."]
	quest.1FB09C79472857DE.quest_subtitle: "Obtain Immaterial Disperser"
	quest.1FB2EAFEA9A787AC.quest_desc: ["Get hold of Vacuum Freezer. Hover over it in EMI and press R to see how it is made."]
	quest.1FB2EAFEA9A787AC.quest_subtitle: "Obtain Vacuum Freezer"
	quest.1FB2EAFEA9A787AC.title: "Enslaved Winter"
	quest.1FBA503950AAE24A.quest_desc: ["The Portable Storage Interface moves items between a moving Contraption and stationary storage. Place two Interfaces facing each other with 1 to 2 blocks between them, one on the Contraption and one fixed." "When they connect, the Contraption briefly stops and its inventory becomes reachable. Use Funnels, Chutes or other transport components to insert or extract items. A Redstone signal breaks the connection immediately."]
	quest.1FBA503950AAE24A.quest_subtitle: "Obtain Portable Storage Interface"
	quest.1FC180C359003B6E.quest_desc: ["Automates the smoker using items from the backpack."]
	quest.1FC180C359003B6E.quest_subtitle: "Obtain Auto Smoking Upgrade"
	quest.1FD78504D48D3F65.quest_desc: ["Applied Energistics 2 (AE2) introduces a unique approach to inventory management and automation. Its futuristic sci-fi theme centers around the concept of converting matter into energy and vice versa for instantaneous resource transportation."]
	quest.1FD78504D48D3F65.title: "Getting Started"
	quest.1FD8A7EE98DCF88B.quest_desc: ["Makes the spawner operate without its usual sound."]
	quest.1FD8A7EE98DCF88B.quest_subtitle: "Obtain Silent Spawner Rune"
	quest.1FD8A7EE98DCF88B.title: "Silent Spawner Rune"
	quest.200715E62F6ACBCC.quest_desc: ["You'll need Tallow to make proper occultist candles. Killing larger animals with any knife will harvest some."]
	quest.200715E62F6ACBCC.quest_subtitle: "Obtain Smart Filter"
	quest.200715E62F6ACBCC.title: "Knives"
	quest.20071FDDBB407198.quest_desc: ["Fire Clay is a mixture of plain river Clay and Brick Dust as a tempering agent, then re-fired to harden it to make it withstand extreme temperatures. To make the Brick Dust you can use your good ol' Forge Hammer and use it to crush plain Bricks. You can also use other machines like the Macerator to make this process more efficient."]
	quest.20071FDDBB407198.quest_subtitle: "Obtain 12x Fire Clay Brick"
	quest.20071FDDBB407198.title: "Fire Clay"
	quest.2016B1C6E0384703.quest_desc: ["Get hold of Rippling Willow Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.2016B1C6E0384703.quest_subtitle: "Obtain Rippling Willow Sapling"
	quest.2019219F3CEB6F63.quest_desc: ["Bring Smallmouth Bass into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2019219F3CEB6F63.quest_subtitle: "Obtain Smallmouth Bass"
	quest.201D00F8522691C6.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.201D00F8522691C6.quest_subtitle: "Obtain Elite Smelting Factory"
	quest.202FA9A77132A3EF.quest_desc: ["Use it to make fish fillets. The amount you get depends on the type of fish."]
	quest.202FA9A77132A3EF.quest_subtitle: "Obtain Iron Fillet Knife"
	quest.20324E3BEF8CB578.quest_desc: ["The terminal in Create’s new build-your-own-storage-system kit. It can link to multiple inventories, via Stock Links, and is operated by the mob of your choice."]
	quest.20324E3BEF8CB578.quest_subtitle: "Obtain Stock Ticker"
	quest.203DA9BF80552E06.quest_desc: ["Trees in Eternal Starlight are infused with lunar energy, and their logs are called Lunar Logs." "Collect enough of them for tools and building, since they are a basic resource in the dimension."]
	quest.203DA9BF80552E06.quest_subtitle: "Obtain 10x Lunar Log"
	quest.203DA9BF80552E06.title: "Lunar Wood"
	quest.20407B9AFD424A64.quest_desc: ["Eternal Nether adds further content and exploration to the Nether. Look for its distinctive additions as you travel through the dimension."]
	quest.20407B9AFD424A64.title: "Getting Started"
	quest.2044F95AC6BABC17.quest_desc: ["Relays rotating motion along a straight path: job done."]
	quest.2044F95AC6BABC17.quest_subtitle: "Obtain Shaft"
	quest.20625F9DB16F2E8F.quest_desc: ["Get hold of Chorus Staff. Hover over it in EMI and press R to see how it is made."]
	quest.20625F9DB16F2E8F.quest_subtitle: "Obtain Chorus Staff"
	quest.207255FA441FE0A6.quest_desc: ["Bring Nature Seeds into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.207255FA441FE0A6.quest_subtitle: "Obtain Nature Seeds"
	quest.20774E8A3CCC88ED.quest_desc: ["Multiplies the number of stacks that can fit in a slot by 4."]
	quest.20774E8A3CCC88ED.quest_subtitle: "Obtain Stack Upgrade Tier 2"
	quest.2079134F80E404E3.quest_desc: ["The Sculk Shrieker summons the Warden if it hears you too many times." "Mine it with a Silk Touch tool to take it with you. A player-placed one will never summon the Warden."]
	quest.2079134F80E404E3.quest_subtitle: "Obtain Sculk Shrieker"
	quest.207D39F607C6E3D8.quest_desc: ["Craft a Black Steel Axe from Cataclysm. It is durable and efficient at chopping wood, and belongs to the Black Steel set."]
	quest.207D39F607C6E3D8.quest_subtitle: "Obtain Black Steel Axe"
	quest.209976DE099D716A.quest_desc: ["This quest asks for Strider Rock. EMI shows the recipe if you press R while hovering over it."]
	quest.209976DE099D716A.quest_subtitle: "Obtain Strider Rock"
	quest.209FAF376A5B8BEC.quest_desc: ["The Compression Upgrade automatically turns compatible items into their compact forms, so they take less space." "It works well for materials that fill containers fast and keeps your slots better used."]
	quest.209FAF376A5B8BEC.quest_subtitle: "Obtain Compression Upgrade"
	quest.20ABBB37ABC4922E.quest_desc: ["Use it to make fish fillets. The amount you get depends on the type of fish."]
	quest.20ABBB37ABC4922E.quest_subtitle: "Obtain Wooden Fillet Knife"
	quest.20D9A6BE4049DE75.quest_desc: ["Yellow Chalk is marginally more powerful than the simple White. It is primarily used for Possession rituals."]
	quest.20D9A6BE4049DE75.quest_subtitle: "Obtain Chalk Yellow Impure"
	quest.20E9E4DB23F8BA2F.quest_desc: ["With the Orb of Prophecy in hand, you can activate the portal and step into the Eternal Starlight dimension." "Expect unknown dangers, strange biomes and powerful secrets, so prepare well before crossing."]
	quest.20E9E4DB23F8BA2F.quest_subtitle: "Travel to Starlight"
	quest.20E9E4DB23F8BA2F.title: "Into the Starlight"
	quest.20F805D44C988258.quest_desc: ["The Ancient Codex is the netherite-tier spellbook of Iron's Spells 'n Spellbooks. It gives 12 spell slots, +20% Cooldown Reduction and +200 Max Mana, making it one of the strongest general-purpose spellbooks."]
	quest.20F805D44C988258.quest_subtitle: "Obtain Netherite Spell Book"
	quest.20F9A5F14B342761.quest_desc: ["The Coral Bardiche is a Cataclysm weapon dropped by Deepling enemies. It is known for heavy attacks and a distinctive look." "Defeat Deeplings to get this rare ocean weapon."]
	quest.20F9A5F14B342761.quest_subtitle: "Obtain Coral Bardiche"
	quest.21046DD5D69EEDDA.quest_desc: ["This Table is used to compile Scrolls you have found and crafted into a Spellbook. To remove a Scroll, click on the spell you want to remove and click the Scroll from the Inscription on the Right Side."]
	quest.21046DD5D69EEDDA.quest_subtitle: "Obtain Inscription Table"
	quest.21119BCA97654F42.quest_desc: ["Universal Cables are Mekanism's way to transfer power. Capacity: 51.20 kFE/t."]
	quest.21119BCA97654F42.quest_subtitle: "Obtain Advanced Universal Cable"
	quest.21119BCA97654F42.title: "Advanced Universal Cable"
	quest.2123669F8025A966.quest_desc: ["This quest asks for Ribboncleaver. EMI shows the recipe if you press R while hovering over it."]
	quest.2123669F8025A966.quest_subtitle: "Obtain Ribboncleaver"
	quest.2149DCDEA5545B75.quest_desc: ["Get hold of Brass Funnel. Hover over it in EMI and press R to see how it is made."]
	quest.2149DCDEA5545B75.quest_subtitle: "Obtain Brass Funnel"
	quest.2155D16D6DBC5F92.quest_desc: ["The Starfire Crossbow is a late-game ranged weapon from Eternal Starlight in the Starfire tier." "It is built for powerful ranged combat."]
	quest.2155D16D6DBC5F92.quest_subtitle: "Obtain Starfire Crossbow"
	quest.217163D161F7670C.quest_desc: ["Steel Casing is a block used in the crafting recipe of most Mekanism machines."]
	quest.217163D161F7670C.quest_subtitle: "Obtain Steel Casing"
	quest.217F284AD776E16A.quest_desc: ["The Logistical Sorter is the brains of your item transportation network, letting you control exactly where your items go. Set up filters to match specific items, tags, or even entire categories of resources. Filtered items can then be directed to a chosen destination within the network. You can use the Dictionary to search for available item and block tags, making it much easier to create broad or highly specific filters. Combine Sorters with Restrictive and Diversion Transporters to create reliable, automated item routing throughout your factory."]
	quest.217F284AD776E16A.quest_subtitle: "Obtain Logistical Sorter"
	quest.217F284AD776E16A.title: "Logistical Sorter"
	quest.2182E8C050BC18FC.quest_desc: ["Output grows with the number of Sails attached, so fit all 8 for the best result."]
	quest.2182E8C050BC18FC.quest_subtitle: "Obtain Windmill"
	quest.218411D5E4987463.quest_desc: ["Be careful, piranhas bite."]
	quest.218411D5E4987463.quest_subtitle: "Obtain Piranha"
	quest.2189FEFCAE0C16FD.quest_desc: ["Cultist Leggings are part of the Cultist Armor set in Iron's Spells 'n Spellbooks. They give +6 Armor, +125 Max Mana, +10% Blood Spell Power and +5% Spell Power." "Craft them from Wizard Leggings, 1 Blood Rune and 1 Arcane Essence, or upgrade them at a Smithing Table in supported versions."]
	quest.2189FEFCAE0C16FD.quest_subtitle: "Obtain Cultist Leggings"
	quest.21A467F02AB070DC.quest_desc: ["ExtendedAE is a mod that can be used to speed up, and expand ae2 so its faster and bigger."]
	quest.21A467F02AB070DC.quest_subtitle: "Obtain Entro Seed"
	quest.21B571F216FB8904.quest_desc: ["Gotta start somewhere, and this will let you hand-power your first mechanical creations, or jump-start your self-pumping steam boiler engines."]
	quest.21B571F216FB8904.quest_subtitle: "Obtain Hand Crank"
	quest.21B9DE3FF594FA45.quest_desc: ["Bring Music Disc Blocks into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.21B9DE3FF594FA45.quest_subtitle: "Obtain Music Disc Blocks"
	quest.21C55C5A4B933CAF.quest_desc: ["This quest asks for Energy Cell Blazing. EMI shows the recipe if you press R while hovering over it."]
	quest.21C55C5A4B933CAF.quest_subtitle: "Obtain Energy Cell Blazing"
	quest.21D388E293A0BB58.quest_desc: ["Bring Amethyst Seeds into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.21D388E293A0BB58.quest_subtitle: "Obtain Amethyst Seeds"
	quest.21D8A54F15202BE8.quest_desc: ["This quest asks for Perch. EMI shows the recipe if you press R while hovering over it."]
	quest.21D8A54F15202BE8.quest_subtitle: "Obtain Perch"
	quest.21EE2FBD57F20239.quest_desc: ["Further enhances a spawner's core stats."]
	quest.21EE2FBD57F20239.quest_subtitle: "Obtain Summit Spawner Upgrade Rune"
	quest.21EE2FBD57F20239.title: "Summit Spawner Upgrade Rune"
	quest.21F5EB3F8F5D23F5.quest_desc: ["Works both as a shield and as a glider."]
	quest.21F5EB3F8F5D23F5.quest_subtitle: "Obtain Umbrella"
	quest.21FCD3C92ACB754D.quest_desc: ["Pressurized Tubes are a way of transporting types of gas, such as steam, hydrogen, and oxygen. Transfer rate: 750 mb/t."]
	quest.21FCD3C92ACB754D.quest_subtitle: "Obtain Basic Pressurized Tube"
	quest.22044F00AC22E39C.quest_desc: ["Bring Limited Copper Barrel 1 into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.22044F00AC22E39C.quest_subtitle: "Obtain Limited Copper Barrel 1"
	quest.2219D20D021194D0.quest_desc: ["Make the Resonarium Leggings in a Mechanical Crafter using a Diamond Leggings, Sturdy Sheets, a Resonarium Plate and a Resonarium Upgrade Template." "The template can be found in Ancient Cities, Trial Chambers and Strongholds."]
	quest.2219D20D021194D0.quest_subtitle: "Obtain Resonarium Leggings"
	quest.2226A5E598BA2684.quest_desc: ["Earn the advancement: Prevent Aechor Petal Spawning."]
	quest.2226A5E598BA2684.quest_subtitle: "Earn the advancement: Prevent Aechor Petal Spawning"
	quest.2228E1A971A32F06.quest_desc: ["Craft a full set of Leather Armor. It is made from leather gathered from animals and gives light, basic protection with full freedom of movement." "It is a good first step before moving to stronger equipment."]
	quest.2228E1A971A32F06.quest_subtitle: "Obtain Leather Helmet, Leather Chestplate, Leather Leggings and Leather Boots"
	quest.2228E1A971A32F06.title: "Leather Armor"
	quest.222DB2CA1F81B96B.quest_desc: ["This quest asks for Wickpiercer. EMI shows the recipe if you press R while hovering over it."]
	quest.222DB2CA1F81B96B.quest_subtitle: "Obtain Wickpiercer"
	quest.22364C78859FA367.quest_desc: ["Defeat 4 Ignited Berserkers from Cataclysm. They patrol the Burning Arena and serve Ignis." "Beating them prepares you for the fight against Ignis."]
	quest.22364C78859FA367.quest_subtitle: "Defeat Ignited Berserker"
	quest.22364C78859FA367.title: "Ignited Berserker"
	quest.2247E5459B5D4301.quest_desc: ["Pressure Tubes transfer air between Compressors and Machines, can be disguised to blend in with their environment. Additionally, Tube Modules can be attached to these Tubes to provide extra features or functionality."]
	quest.2247E5459B5D4301.quest_subtitle: "Obtain Pressure Tube"
	quest.224A1F6913108AA3.quest_desc: ["The Redstone Relay from Create Crafts and Additions lets a Redstone signal switch electrical power on or off in your network. It suits automated factories and Redstone-controlled machines."]
	quest.224A1F6913108AA3.quest_subtitle: "Obtain Redstone Relay"
	quest.22544EB8EE0604A0.quest_desc: ["Find the Amethyst Nest hidden in the Overworld." "Deep inside is the lair of the Amethyst Crab, so get ready for a fight."]
	quest.22544EB8EE0604A0.title: "Amethyst Nest"
	quest.22647EF2D9D42B5D.quest_desc: ["Get hold of Steeleaf Seeds. Hover over it in EMI and press R to see how it is made."]
	quest.22647EF2D9D42B5D.quest_subtitle: "Obtain Steeleaf Seeds"
	quest.226947DFFD9E50F1.quest_desc: ["Get hold of Slicer. Hover over it in EMI and press R to see how it is made."]
	quest.226947DFFD9E50F1.quest_subtitle: "Obtain Slicer"
	quest.226F89C92F5D504E.quest_desc: ["This quest asks for Copoazu Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.226F89C92F5D504E.quest_subtitle: "Obtain Copoazu Sapling"
	quest.2271BF34DE180569.quest_desc: ["The Pattern Encoding Terminal lets you encode patterns for crafting and processing. It is made by upgrading a Crafting Terminal with an Engineering Processor."]
	quest.22865F8986707CF0.quest_desc: ["Bring Spicy Hoglin Stew into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.22865F8986707CF0.quest_subtitle: "Obtain Spicy Hoglin Stew"
	quest.228895BFE6D8D545.quest_desc: ["The Thallasium Upgrade Smithing Template applies Thallasium-tier trims and recipes to compatible gear at a Smithing Table." "It is the first step of Better End's equipment progression."]
	quest.228895BFE6D8D545.quest_subtitle: "Obtain Thallasium Upgrade Smithing Template"
	quest.2289C9AAEC281148.quest_desc: ["Voids the items selected in its filter."]
	quest.2289C9AAEC281148.quest_subtitle: "Obtain Void Upgrade"
	quest.22A31024A138B0F7.quest_desc: ["Meka-Tool can be upgraded with Modules that are installed with the Modification Station."]
	quest.22A31024A138B0F7.quest_subtitle: "Obtain Meka Tool"
	quest.22A4BDA91482F77E.quest_desc: ["The chestplate of the Prudentium armor set. Together with the leggings, it unlocks the helmet."]
	quest.22AE205952E2DD8B.quest_desc: ["Get hold of Furnator Niotic. Hover over it in EMI and press R to see how it is made."]
	quest.22AE205952E2DD8B.quest_subtitle: "Obtain Furnator Niotic"
	quest.22B23DCCC5E5C225.quest_desc: ["Bring Ferricore Hoe into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.22B23DCCC5E5C225.quest_subtitle: "Obtain Ferricore Hoe"
	quest.22B4C8ECAD78BD45.quest_desc: ["Enriched Obsidian is used in the Metallurgic Infuser. Enriched Obsidian yields 80 units of obsidian in the Metallurgic Infuser, the same as 8 Refined Obsidian Dust."]
	quest.22B4C8ECAD78BD45.quest_subtitle: "Obtain Enriched Refined Obsidian"
	quest.22C064FC3CA2AA23.quest_desc: ["You also need 10 unique legendary fish for the Emerald Trophy."]
	quest.22C064FC3CA2AA23.quest_subtitle: "Catch 200 fish in total"
	quest.22CF92D9C0B1B43A.quest_desc: ["The Stalker drops Soul Crystals." "Grind one in a Millstone to get 3 Soul Dust, or save it for the Sonorous Staff and Soul Elytra."]
	quest.22CF92D9C0B1B43A.quest_subtitle: "Obtain Soul Crystal"
	quest.22D9F2309203B2E1.quest_desc: ["Get hold of Slime Seeds. Hover over it in EMI and press R to see how it is made."]
	quest.22D9F2309203B2E1.quest_subtitle: "Obtain Slime Seeds"
	quest.22DAC79D807D2F89.quest_desc: ["Tier 3 glyph. Craft it at the Scribe\'s Table."]
	quest.22DAC79D807D2F89.quest_subtitle: "Obtain Glyph Fangs"
	quest.22DCF5BE4DAC2742.quest_desc: ["The Silicon Press is used in an Inscriber to turn Silicon into Printed Silicon. Presses are found in meteorites, and the Inscriber can duplicate one with an Iron Block."]
	quest.22E6E27E339F6336.quest_desc: ["Get hold of Wrench. Hover over it in EMI and press R to see how it is made."]
	quest.22E6E27E339F6336.quest_subtitle: "Obtain Wrench"
	quest.22E8397A2E00F3F3.quest_desc: ["Bring Energizing Rod Niotic into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.22E8397A2E00F3F3.quest_subtitle: "Obtain Energizing Rod Niotic"
	quest.22F624120228DA3E.quest_desc: ["This quest asks for Bucket. EMI shows the recipe if you press R while hovering over it."]
	quest.22F624120228DA3E.quest_subtitle: "Obtain Bucket"
	quest.22FFE46A22C609E4.quest_desc: ["Abyssal Sacrifice is a rare Cataclysm item used to summon the Leviathan, the Ancient Remnant of the ocean depths." "Gather the required materials and prepare well for a tough underwater fight."]
	quest.22FFE46A22C609E4.quest_subtitle: "Obtain Abyssal Sacrifice"
	quest.22FFE46A22C609E4.title: "Abyssal Sacrifice"
	quest.230308CD365396D6.quest_desc: ["Get hold of Conjurers Talisman. Hover over it in EMI and press R to see how it is made."]
	quest.230308CD365396D6.quest_subtitle: "Obtain Conjurers Talisman"
	quest.230D36BF23D48568.quest_desc: ["The Handle Attachment Smithing Template lets you join a finished Better End tool head to its handle at a Smithing Table." "You need it for Thallasium and Terminite tools and weapons."]
	quest.230D36BF23D48568.quest_subtitle: "Obtain Handle Attachment Smithing Template"
	quest.2328F563FE287CB7.quest_desc: ["This quest asks for Bloody Voodoo Doll. EMI shows the recipe if you press R while hovering over it."]
	quest.2328F563FE287CB7.quest_subtitle: "Obtain Bloody Voodoo Doll"
	quest.232F056CF68F37C7.quest_desc: ["Bring Grandidiers Baobab Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.232F056CF68F37C7.quest_subtitle: "Obtain Grandidiers Baobab Sapling"
	quest.23452C7E33F043EA.quest_desc: ["Get hold of Evasion Elixir. Hover over it in EMI and press R to see how it is made."]
	quest.23452C7E33F043EA.quest_subtitle: "Obtain Evasion Elixir"
	quest.2348FCC1D9994BA5.quest_desc: ["This quest asks for Limited Copper Barrel 3. EMI shows the recipe if you press R while hovering over it."]
	quest.2348FCC1D9994BA5.quest_subtitle: "Obtain Limited Copper Barrel 3"
	quest.23542AE6ED642245.quest_desc: ["The Sandstorm in a Bottle from Cataclysm is a rare artifact holding the power of an ancient desert storm." "It is tied to the civilizations buried under the desert."]
	quest.23542AE6ED642245.quest_subtitle: "Obtain Sandstorm in a Bottle"
	quest.235CFE9AED85B1AB.quest_desc: ["Cleaning up Chalk can be somewhat of a chore by hand. Thankfully, this is a solved problem: use a Brush!"]
	quest.235CFE9AED85B1AB.quest_subtitle: "Obtain Brush"
	quest.2364038D77077F2F.quest_desc: ["Wadjet is a serpent-like mini-boss in Cataclysm's Cursed Pyramid. It guards the treasures with strong sand magic." "Defeating it drops Ancient Metal Ingots, the key material for ancient equipment."]
	quest.2364038D77077F2F.quest_subtitle: "Defeat Wadjet"
	quest.2364038D77077F2F.title: "Wadjet"
	quest.2369E85866998513.quest_desc: ["The Digital Miner is the scale mining machine of Mekanism. However, this machine is like no other as it \"magically-teleports\" mined blocks to its inventory."]
	quest.2369E85866998513.quest_subtitle: "Obtain Digital Miner"
	quest.236E10245B6308B5.quest_desc: ["Get hold of Slimy Nest. Hover over it in EMI and press R to see how it is made."]
	quest.236E10245B6308B5.quest_subtitle: "Obtain Slimy Nest"
	quest.23734E69D74BA281.quest_desc: ["The Salvaging Table breaks down unwanted Affix Gear into Rarity Materials, which you can use to improve your equipment and progress."]
	quest.23734E69D74BA281.quest_subtitle: "Obtain Salvaging Table and Smart Filter"
	quest.23734E69D74BA281.title: "Salvaging"
	quest.23752F087B6323F4.quest_desc: ["Will make the storage pick up items within its range. Has more filtering options."]
	quest.23752F087B6323F4.quest_subtitle: "Obtain Advanced Magnet Upgrade"
	quest.23977A87FEE832CC.quest_desc: ["This quest asks for Hot Wings Bucket. EMI shows the recipe if you press R while hovering over it."]
	quest.23977A87FEE832CC.quest_subtitle: "Obtain Hot Wings Bucket"
	quest.239B2A4AFDFA3312.quest_desc: ["Expands the inventory of the shulker box."]
	quest.239B2A4AFDFA3312.quest_subtitle: "Obtain Diamond Shulker Box"
	quest.239D9AC37AC5B8B2.quest_desc: ["Well, this is the time! It will not get you everything, but it will get you a lot of the main ores. Everything comes later. The Steam Quarry is a steam powered multiblock machine that uses different drills that you install onto it to dig deeper than bedrock and retrieves ores straight from the below, whatever might be under there. You can check which ores this method will provide by checking EMI."]
	quest.239D9AC37AC5B8B2.quest_subtitle: "Obtain 13x Steel Machine Casing, Steam Quarry, 4x Chain and 6x Steel Machine Casing Pipe"
	quest.239D9AC37AC5B8B2.title: "Infinite Resources?"
	quest.239E7F5403867385.quest_desc: ["The Starfire Sword is a high-tier weapon from Eternal Starlight." "It is made with smithing and needs Starfire-related materials from the mod's advanced content."]
	quest.239E7F5403867385.quest_subtitle: "Obtain Starfire Sword"
	quest.23A36856E4ECDEEF.quest_desc: ["The Cursed Bow is a powerful Cataclysm ranged weapon dropped by Maledictus in the Frosted Prison." "Its special attacks ignore normal damage protection."]
	quest.23A36856E4ECDEEF.quest_subtitle: "Obtain Cursed Bow"
	quest.23A36856E4ECDEEF.title: "Cursed Bow"
	quest.23ADF75576C7CFEF.quest_desc: ["This machine is used to (dis)charge items that operate on Pneumatic Power, such as Drones, Pneumatic Wrenches, and Vortex Cannons. It also manages upgrades for items that can accept them."]
	quest.23ADF75576C7CFEF.quest_subtitle: "Obtain Charging Station"
	quest.23B151AB16FF6FD0.quest_desc: ["The chestplate of the Obsidian armor set. Together with the leggings, it unlocks the helmet."]
	quest.23BE3D7400003857.quest_desc: ["Plastic blocks a good way of making a cool base. They are aesthetic only."]
	quest.23BE3D7400003857.quest_subtitle: "Obtain White Plastic"
	quest.23C553AD6AC611F8.quest_desc: ["Get hold of Neptunium Helmet, Neptunium Chestplate, Neptunium Leggings and Neptunium Boots. Hover over it in EMI and press R to see how it is made."]
	quest.23C553AD6AC611F8.quest_subtitle: "Obtain Neptunium Helmet, Neptunium Chestplate, Neptunium Leggings and Neptunium Boots"
	quest.23C553AD6AC611F8.title: "Neptunium Armor"
	quest.23C5DE3C94652080.quest_desc: ["Get hold of Printed Circuit Board. Hover over it in EMI and press R to see how it is made."]
	quest.23C5DE3C94652080.quest_subtitle: "Obtain Printed Circuit Board"
	quest.23CEE8175974CF6B.quest_desc: ["Tier 2 glyph. Craft it at the Scribe\'s Table."]
	quest.23CEE8175974CF6B.quest_subtitle: "Obtain Glyph Flare"
	quest.23D446FCE94FB7A4.quest_desc: ["The Assembler Matrix can craft hundreds, if not thousands of items per tick, depending on how you configure it."]
	quest.23D446FCE94FB7A4.quest_subtitle: "Obtain Assembler Matrix Wall, Assembler Matrix Pattern, Assembler Matrix Crafter and 2 more items"
	quest.23D446FCE94FB7A4.title: "Assembler Matrix"
	quest.23E56C60D6CA839B.quest_desc: ["Voids an item that is picked up which then provides a small amount of mana."]
	quest.23E56C60D6CA839B.quest_subtitle: "Obtain Void Jar"
	quest.23E98D096A1BFDC0.quest_desc: ["If an occult familiar dies, it will drop such a shard. You can use this to revive it, if you like."]
	quest.23E98D096A1BFDC0.quest_subtitle: "Obtain Soul Shard"
	quest.23F054B209A2F57E.quest_desc: ["A piece of equipment worn on the backpack (the chest armor slot) that provides underwater respiration when a Gas Mask is worn (on the helmet armor slot)."]
	quest.23F054B209A2F57E.quest_subtitle: "Obtain Scuba Tank"
	quest.23F1DD9F400D7972.quest_desc: ["The Incinerator from Cataclysm is a greataxe built from Ignis' power that sets enemies ablaze." "You can earn it by clearing the Burning Arena."]
	quest.23F1DD9F400D7972.quest_subtitle: "Obtain The Incinerator"
	quest.23F1DD9F400D7972.title: "The Incinerator"
	quest.23FC33F83ACFC5C0.quest_desc: ["A Tome of Scrapping removes enchantments from an item and gives them back as books. It only recovers half of them and destroys the item. Use a Tome of Extraction to keep the item, or Superior Scrapping to recover everything."]
	quest.23FC33F83ACFC5C0.quest_subtitle: "Obtain Scrap Tome"
	quest.24033D42E93DAEE5.quest_desc: ["A Neptunium Nugget is a rare fragment of a valuable ocean metal. You can only get one by fishing, so expect it to take some patience and luck." "Collecting enough of them lets you forge Neptunium equipment."]
	quest.24033D42E93DAEE5.quest_subtitle: "Obtain Neptunium Nugget"
	quest.24033D42E93DAEE5.title: "Neptunium Nugget"
	quest.2403627388601B82.quest_desc: ["This quest asks for Upgrade Diamond. EMI shows the recipe if you press R while hovering over it."]
	quest.2403627388601B82.quest_subtitle: "Obtain Upgrade Diamond"
	quest.240F20C12C771975.quest_desc: ["Expands the inventory and upgrade slots of the backpack."]
	quest.240F20C12C771975.quest_subtitle: "Obtain Gold Backpack"
	quest.241A984254DF5706.quest_desc: ["Using these Materials you'll be able to construct you first Pressure Chamber."]
	quest.241A984254DF5706.quest_subtitle: "Obtain 21x Pressure Chamber Wall, Pressure Chamber Valve, 2x Pressure Chamber Interface and 2x Pressure Chamber Glass"
	quest.241A984254DF5706.title: "Your First Pressure Chamber"
	quest.241D2F19426D33B4.quest_desc: ["Use it to make fish fillets. The amount you get depends on the type of fish."]
	quest.241D2F19426D33B4.quest_subtitle: "Obtain Gold Fillet Knife"
	quest.2422274375D47B8E.quest_desc: ["The leggings of the Imperium armor set. Together with the chestplate, they unlock the helmet."]
	quest.2422B7E51E491269.quest_desc: ["The shipping container for international shipping. The data packet for comunication networks. And now… the humble Cardboard Package packet-izes item transfer, underpinning Create’s new item requesting and delivery abilities."]
	quest.2422B7E51E491269.quest_subtitle: "Obtain Cardboard Package 12x12"
	quest.24389CE8F7E51A2F.quest_desc: ["Freezes targets. Slows them down and potentially encasing them in ice temporarily. Fire-resistant mobs are especially vulnerable to this ammo."]
	quest.24389CE8F7E51A2F.quest_subtitle: "Obtain Gun Ammo Freezing"
	quest.2444B671B3068D77.quest_desc: ["This quest asks for Bronze Composter. EMI shows the recipe if you press R while hovering over it."]
	quest.2444B671B3068D77.quest_subtitle: "Obtain Bronze Composter"
	quest.244CD83573C73850.quest_desc: ["There are 4 stages of growth, just like Certus Quartz Clusters. While in the first three stages you will get Entro Dust, But in the fourth stage you can get Entroized Crystals."]
	quest.244CD83573C73850.quest_subtitle: "Obtain Entro Dust"
	quest.245EBCE2A9181D65.quest_desc: ["Bring Energy Cable Niotic into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.245EBCE2A9181D65.quest_subtitle: "Obtain Energy Cable Niotic"
	quest.2474E042D5328107.quest_desc: ["The range upgrade will expand the area of operation by 1 block in all directions. Multiple range upgrades can be installed."]
	quest.2474E042D5328107.quest_subtitle: "Obtain Upgrade Range"
	quest.248EDD67A7CE50B9.quest_desc: ["Automatically uses potions, milk buckets and food that give effects."]
	quest.248EDD67A7CE50B9.quest_subtitle: "Obtain Alchemy Upgrade"
	quest.2494ADFB9F5BDF09.quest_desc: ["Ender Pearls are dropped from endermen and are used to create Ender Scrolls."]
	quest.2494ADFB9F5BDF09.quest_subtitle: "Obtain Ender Pearl"
	quest.2495F42B39D6C3EE.quest_desc: ["The Music Disc: The Leviathan is a rare Cataclysm trophy dropped by The Leviathan, with a 10% drop chance from the boss." "It marks your victory over one of the ocean's most fearsome creatures."]
	quest.2495F42B39D6C3EE.quest_subtitle: "Obtain Music Disc the Leviathan"
	quest.249948CE9F29AFA5.quest_desc: ["Get hold of Oak Sapling, Spruce Sapling, Birch Sapling and 6 more items. Hover over it in EMI and press R to see how it is made."]
	quest.249948CE9F29AFA5.quest_subtitle: "Obtain Oak Sapling, Spruce Sapling, Birch Sapling and 6 more items"
	quest.249948CE9F29AFA5.title: "Basic Saplings"
	quest.249BA0F38C7AD688.quest_desc: ["Obtained from the Distiller, this is Mercury in its rawest form."]
	quest.249BA0F38C7AD688.quest_subtitle: "Obtain 4x Mercury Shard"
	quest.249BA0F38C7AD688.title: "Crystallized Mercury"
	quest.24A34D2F6B9156E7.quest_desc: ["Tier 2 glyph. Craft it at the Scribe\'s Table."]
	quest.24A34D2F6B9156E7.quest_subtitle: "Obtain Glyph Exchange"
	quest.24A3C2870C5A607D.quest_desc: ["The leggings of the Steeleaf armor set. Together with the chestplate, they unlock the helmet."]
	quest.24AE372E79093B56.quest_desc: ["Get hold of Configurable Honeycomb. Hover over it in EMI and press R to see how it is made."]
	quest.24AE372E79093B56.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.24CC87C656AE85C1.quest_desc: ["This quest asks for Ender Cell Nitro. EMI shows the recipe if you press R while hovering over it."]
	quest.24CC87C656AE85C1.quest_subtitle: "Obtain Ender Cell Nitro"
	quest.24D4FBE7F6546E8A.quest_desc: ["Pufferfish's Skills provides a skill-tree progression system. Open its interface to review available paths and understand how skills can shape a character."]
	quest.24D4FBE7F6546E8A.title: "Getting Started"
	quest.24DAC871074CC69F.title: "Hydra"
	quest.24E1F72FD6958747.quest_desc: ["Get hold of Awakened Supremium Block. Hover over it in EMI and press R to see how it is made."]
	quest.24E1F72FD6958747.quest_subtitle: "Obtain Awakened Supremium Block"
	quest.24F78DA0E1A26044.quest_desc: ["Witherite Ingots are a rare alloy made from the Wither's power and ancient technology." "They are used for advanced equipment and the Mechanical Fusion Anvil."]
	quest.24F78DA0E1A26044.quest_subtitle: "Obtain Witherite Ingot"
	quest.251E00BBEC2EDCFA.quest_desc: ["The Ancient Remnant Music Disc from Cataclysm is a rare trophy tied to the Ancient Remnant." "Get it as proof that you beat the Cursed Pyramid's guardian."]
	quest.251E00BBEC2EDCFA.quest_subtitle: "Obtain Music Disc Ancient Remnant"
	quest.25356A67D756C072.quest_desc: ["The Dragonskin Spell Book is the legendary Ender spellbook. It gives 12 spell slots, +10% Ender Spell Power and +200 Max Mana." "It is crafted from Dragonskin, which you get from the Ender Dragon."]
	quest.25356A67D756C072.quest_subtitle: "Obtain Dragonskin Spell Book"
	quest.254B230173E70CD9.quest_desc: ["This quest asks for Dimension Key. EMI shows the recipe if you press R while hovering over it."]
	quest.254B230173E70CD9.quest_subtitle: "Obtain Dimension Key"
	quest.2553E9331113FD0A.quest_desc: ["Industrial Hemp Seeds drop from tall grass. Three Hemp Fibers craft into one String."]
	quest.2553E9331113FD0A.quest_subtitle: "Obtain Hemp Fiber and 4x Seed"
	quest.255CB19132A69AF6.quest_desc: ["The Gauntlet of Maelstrom from Cataclysm is a legendary gauntlet that releases strong wind attacks against enemies." "It is a rare treasure obtained from the ocean depths and the creatures that live there."]
	quest.255CB19132A69AF6.quest_subtitle: "Obtain Gauntlet of Maelstrom"
	quest.255CB19132A69AF6.title: "Gauntlet Of Maelstrom"
	quest.2566471D73D027C8.quest_desc: ["Make Crystalite Boots with an Infusion Ritual using Terminite Boots, an Amber Gem and Crystal Shards around an Infusion Pedestal." "They give permanent Speed I, which is handy for exploring the End."]
	quest.2566471D73D027C8.quest_subtitle: "Obtain Crystalite Boots"
	quest.2566471D73D027C8.title: "Crystalite Boots"
	quest.256FBFEF574E2952.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.256FBFEF574E2952.quest_subtitle: "Obtain Elite Crushing Factory"
	quest.2596249D0CC9CEE1.title: "Naga"
	quest.259C2D5026BA9FA8.quest_desc: ["Functional Storage focuses on compact, high-capacity drawers and storage controllers. Use it for bulk resources and explore how drawers connect into a larger storage setup."]
	quest.259C2D5026BA9FA8.title: "Getting Started"
	quest.25A3B35B337A45CB.quest_desc: ["The Crafting Terminal combines an ME Terminal with a crafting grid, letting you craft from items stored on the network."]
	quest.25A3B35B337A45CB.title: "Craft from the Network"
	quest.25A3C0F0E2768D27.quest_desc: ["The first piece of the Nano Quantum armor set. Get the boots to unlock the chestplate and leggings."]
	quest.25A5D615A1B73D04.quest_desc: ["Tip: even for contraptions not meant to travel on rails, Cart Assemblers are handy for placing contraptions into the world, or converting back to contraption form, and then picking them up again in item form with a Wrench."]
	quest.25A5D615A1B73D04.quest_subtitle: "Obtain Cart Assembler"
	quest.25A9152D76C456C9.quest_desc: ["Changes a Vanilla storage to a Sophisticated Storage version."]
	quest.25A9152D76C456C9.quest_subtitle: "Obtain Basic Tier Upgrade"
	quest.25A95728488E9D44.quest_desc: ["Obtain a Display Link from Create. It reads information from compatible blocks and shows it on Nixie Tubes, Display Boards, Signs, Hanging Signs and Lecterns." "It can display item names, inventory levels, train status, rotation speed, stress, fluid information and more. Its default range is 64 blocks."]
	quest.25A95728488E9D44.quest_subtitle: "Obtain Display Link"
	quest.25ABEB94E3FA8B8A.quest_desc: ["This quest asks for Avocado Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.25ABEB94E3FA8B8A.quest_subtitle: "Obtain Avocado Sapling"
	quest.25AD32BAD3D376AB.quest_desc: ["Bring Mechanical Mixer into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.25AD32BAD3D376AB.quest_subtitle: "Obtain Mechanical Mixer"
	quest.25B43F14C8AFB5BE.quest_desc: ["The Cooking for Blockheads I book lists the dishes you can make with the ingredients in your inventory."]
	quest.25B43F14C8AFB5BE.quest_subtitle: "See what you can cook right now"
	quest.25B95CC6282843E1.quest_desc: ["Starlight Crystal Blocks are dense formations of condensed crystal energy in Eternal Starlight." "They are not needed for progression or crafting, so collecting them is optional and mostly for display."]
	quest.25B95CC6282843E1.quest_subtitle: "Obtain 10x Red Starlight Crystal Block and 10x Blue Starlight Crystal Block"
	quest.25B95CC6282843E1.title: "Starlight Crystal Blocks"
	quest.25B9B8A5B2FCF4FC.quest_desc: ["Found in the Bronze Dungeon."]
	quest.25B9B8A5B2FCF4FC.quest_subtitle: "Get the Hammer of Kingbdogz"
	quest.25BB0F8CD8EDB2F4.quest_desc: ["This Bank has 27 slots and holds up to 4,096 items."]
	quest.25BB0F8CD8EDB2F4.quest_subtitle: "The third Bank tier"
	quest.25D175092F36F6E9.quest_desc: ["ME Packing Tape can pack in-world ME Devices into a packaged Device item. How? Sneak + Mouse Right Click on a Device with the tape, and you can get a packaged item from it. All settings and inventory of the device will be kept. It can be very useful when you're moving your ME setup."]
	quest.25D175092F36F6E9.quest_subtitle: "Obtain Me Packing Tape"
	quest.25D18AEB0F3247E5.quest_desc: ["Get hold of Screwdriver. Hover over it in EMI and press R to see how it is made."]
	quest.25D18AEB0F3247E5.quest_subtitle: "Obtain Screwdriver"
	quest.25E265B81518E939.quest_desc: ["Find a Trial Chamber hidden deep underground. These halls are built from tuff and copper and hold traps, Trial Spawners, Vaults and strong enemies." "A Journeyman Cartographer can sell you a Trial Explorer Map that leads to the nearest chamber."]
	quest.25E265B81518E939.title: "Trial Chambers"
	quest.25E29897EFBC2C48.quest_desc: ["Craft the Terminite Forged Plate from a Terminite Ingot at an Anvil with a Smith Hammer." "It is the base component for a full set of Terminite armor at the Smithing Table."]
	quest.25E29897EFBC2C48.quest_subtitle: "Obtain Terminite Forged Plate"
	quest.25E2D4C241857FA5.quest_desc: ["The Crystal Crossbow is a ranged weapon from Eternal Starlight." "It belongs to the advanced equipment tier and is tied to crystalline materials found in the dimension."]
	quest.25E2D4C241857FA5.quest_subtitle: "Obtain Crystal Crossbow"
	quest.25E2D4C241857FA5.title: "Crystal Crossbow"
	quest.25E6BA239766CA24.quest_desc: ["Fire Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, used for advanced Fire crafting such as Fire Upgrade Orbs. It is the Fire-school Runestone." "Combine a Blank Runestone with 8 Blaze Rods to make one. Blaze Rods are the Fire Focus."]
	quest.25E6BA239766CA24.quest_subtitle: "Obtain Fire Rune"
	quest.25F29894B20B4F91.quest_desc: ["The Powered Centrifuge takes FE to run at an increased processing speed."]
	quest.25F29894B20B4F91.quest_subtitle: "Obtain Powered Centrifuge"
	quest.25FA77113A39AC1A.quest_desc: ["The Hydra Chop is a rare meat dropped only by the Hydra. Cook it to get one of the most filling meals in the Twilight Forest." "It restores a large amount of hunger, which suits long expeditions."]
	quest.25FA77113A39AC1A.quest_subtitle: "Obtain Hydra Chop"
	quest.26077C7A671CCB3C.quest_desc: ["Place a Seashelf in the enchanting table and use Infusion. You need at least 45 Eterna, 15% Quanta and 10% Arcana." "It gives +5 Eterna (up to 60) and +5 Arcana, and is the base for every advanced Seashelf."]
	quest.26077C7A671CCB3C.quest_subtitle: "Obtain Infused Seashelf"
	quest.261F7779BF98276C.quest_desc: ["Craft it from Melons, Glistering Melon Slices and a bookshelf." "It gives -10 Quanta and -2 Eterna. Use it to reduce randomness and get more predictable enchantments."]
	quest.261F7779BF98276C.quest_subtitle: "Obtain Melonshelf"
	quest.263514F80166F55F.quest_desc: ["To find the Starlight Golem, hold the Seeking Eye in your main hand and one of these items in your off-hand: Redstone, Golem Steel Ingot or Oxidized Steel Ingot." "Without one of them the Eye will not lead you there."]
	quest.263514F80166F55F.quest_subtitle: "Obtain Smart Filter"
	quest.263514F80166F55F.title: "Find Boss"
	quest.263674C310D18958.quest_desc: ["Bring Arcanist Hood, Arcanist Robes, Arcanist Leggings and Arcanist Boots into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.263674C310D18958.quest_subtitle: "Obtain Arcanist Hood, Arcanist Robes, Arcanist Leggings and Arcanist Boots"
	quest.2643F5CF4596D650.quest_desc: ["Bring Druidic Spell Book into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2643F5CF4596D650.quest_subtitle: "Obtain Druidic Spell Book"
	quest.264D4CDC6A0D788B.quest_desc: ["Like the Pump Upgrade, but it also works with fluid containers in your hand and fluid blocks in the world. You can filter which fluid gets pumped."]
	quest.264D4CDC6A0D788B.quest_subtitle: "Obtain Advanced Pump Upgrade"
	quest.265190C39B930E70.quest_desc: ["Measure how much energy, in the form of Stress Units, your contraptions are generating and consuming, or how fast they are working."]
	quest.265190C39B930E70.quest_subtitle: "Obtain Stressometer and Speedometer"
	quest.26546192A8EB52F1.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.26546192A8EB52F1.quest_subtitle: "Obtain Glyph Pull"
	quest.266AEBC814987316.quest_desc: ["Bring Balsa Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.266AEBC814987316.quest_subtitle: "Obtain Balsa Sapling"
	quest.267EF67CCDE6D2C6.quest_desc: ["The Coke Oven works slowly, so build two or three early to keep your Coal Coke stocked. One piece of coal yields 500 mB of Creosote Oil, while a log yields only 250 mB."]
	quest.267EF67CCDE6D2C6.quest_subtitle: "Obtain 27x Cokebrick"
	quest.267EF67CCDE6D2C6.title: "Coke Oven"
	quest.2681E9502A687D30.quest_desc: ["Perform the Ritual of Binding near a creature to get its bound script. One ritual can convert several at once." "Familiars have HP, but you can resummon them from the book if they die. Each familiar has its own effects, so check the book for details." "A summoned familiar reserves part of your source bar until you dispel it."]
	quest.2681E9502A687D30.quest_subtitle: "Obtain Familiar Starbuncle, Familiar Wixie, Familiar Amethyst Golem and 3 more items"
	quest.2681E9502A687D30.title: "Familiars"
	quest.2692F67AA6DA0F0B.quest_desc: ["The Sculk Sensor detects nearby vibrations such as footsteps or dropped items and emits a redstone signal." "Sneaking or walking on wool keeps it from noticing you."]
	quest.2692F67AA6DA0F0B.quest_subtitle: "Obtain Sculk Sensor and Calibrated Sculk Sensor"
	quest.269349E72E941AEB.quest_desc: ["Get hold of Nether Brick Nest. Hover over it in EMI and press R to see how it is made."]
	quest.269349E72E941AEB.quest_subtitle: "Obtain Nether Brick Nest"
	quest.26B9A1BD247ACE9B.quest_desc: ["This quest asks for Teak Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.26B9A1BD247ACE9B.quest_subtitle: "Obtain Teak Sapling"
	quest.26D15AAA1E70943C.quest_desc: ["The Holy Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. Applied at the Arcane Anvil, it gives +5% Holy Spell Power." "Craft it from 1 Empty Upgrade Orb and 8 Holy Runes. By default, an applicable item can take up to 3 Upgrade Orbs."]
	quest.26D15AAA1E70943C.quest_subtitle: "Obtain Holy Upgrade Orb"
	quest.26D40F0FE4F4FF0B.quest_desc: ["Incendium overhauls Nether terrain and exploration with new regions and points of interest. Travel through the Nether to discover its custom generation."]
	quest.26D40F0FE4F4FF0B.title: "Getting Started"
	quest.26E25367420EC532.quest_desc: ["The Deepsilver Chestplate is crafted from Deepsilver Ingots in Eternal Starlight." "Deepsilver armor raises movement speed, attack speed and knockback resistance. The full set also grants immunity to several negative status effects."]
	quest.26E25367420EC532.quest_subtitle: "Obtain Deepsilver Chestplate"
	quest.26E7A376DAAB455E.quest_desc: ["The first piece of the Leather armor set. Get the boots to unlock the chestplate and leggings."]
	quest.26FC791720C2AC14.quest_desc: ["The highest World Tier. Equip a full set of Epic Affix Gear (helmet, chestplate, leggings, boots and weapon), then defeat the Ender Dragon."]
	quest.26FC791720C2AC14.quest_subtitle: "Reach World Tier: Pinnacle"
	quest.26FC791720C2AC14.title: "Pinnacle"
	quest.27065243D9D23777.quest_desc: ["This quest asks for Wand. EMI shows the recipe if you press R while hovering over it."]
	quest.27065243D9D23777.quest_subtitle: "Obtain Wand"
	quest.2711A6E34164DAE2.quest_desc: ["The Vitality Ankh from Cataclysm is an ancient accessory that makes the wearer harder to kill and helps in deadly situations." "It is made from rare materials."]
	quest.2711A6E34164DAE2.quest_subtitle: "Obtain Vitality Ankh"
	quest.271A7748E93D9DB5.quest_desc: ["Bring Shadow Claws into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.271A7748E93D9DB5.quest_subtitle: "Obtain Shadow Claws"
	quest.271AC2BEE48B4A85.quest_desc: ["To put a mob in the jar, run the Ritual of Containment with the jar within 3 blocks of the Ritual Brazier and the mob within 6 blocks. You can pause the ritual with a redstone signal." "To release it, sneak and right-click the jar with a Dispel spell." "Some mobs are blacklisted. Hold the jar with the mob to check, or enable advanced tooltips and look for the jar_blacklist tag on the spawn egg."]
	quest.271AC2BEE48B4A85.quest_subtitle: "Obtain Mob Jar"
	quest.272340E3885E2B29.quest_desc: ["Bring Magmator Niotic into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.272340E3885E2B29.quest_subtitle: "Obtain Magmator Niotic"
	quest.272D38871F3F739A.quest_desc: ["Look for a Ruined Portal in the End style."]
	quest.272D38871F3F739A.quest_subtitle: "Find an End-themed Ruined Portal"
	quest.2734EF1D692C320D.quest_desc: ["Generates a large amount of air from lightning strikes. Check the GUI for details."]
	quest.2734EF1D692C320D.quest_subtitle: "Obtain Electrostatic Compressor"
	quest.273E12E9CCDBBD6E.quest_desc: ["The Enchanted Spellbook has ten slots, for the more seasoned mage."]
	quest.273E12E9CCDBBD6E.quest_subtitle: "Obtain Diamond Spell Book"
	quest.27458EDF5F854368.quest_desc: ["This quest asks for Striderloaf. EMI shows the recipe if you press R while hovering over it."]
	quest.27458EDF5F854368.quest_subtitle: "Obtain Striderloaf"
	quest.275B4FC2986FE260.quest_desc: ["Grants immunity to knockback."]
	quest.275B4FC2986FE260.quest_subtitle: "Obtain Steadfast Spikes"
	quest.275D4238928C567C.quest_desc: ["Bring Carp into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.275D4238928C567C.quest_subtitle: "Obtain Carp"
	quest.275EE3BD321248D8.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.275EE3BD321248D8.quest_subtitle: "Obtain Elite Purifying Factory"
	quest.276A9581F27678C8.quest_desc: ["This quest asks for Soulium Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.276A9581F27678C8.quest_subtitle: "Obtain Soulium Seeds"
	quest.276B220CA49DBE53.quest_desc: ["Bring Riftmane into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.276B220CA49DBE53.quest_subtitle: "Obtain Riftmane"
	quest.2772596178EBED64.quest_desc: ["This quest asks for Blazing Crystal Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.2772596178EBED64.quest_subtitle: "Obtain Blazing Crystal Seeds"
	quest.277B64B85119DC38.quest_desc: ["Transfers energy."]
	quest.277B64B85119DC38.quest_subtitle: "Obtain Energy Cable Starter"
	quest.278066D4F5C2E248.quest_desc: ["The Portable Energy Interface from Create Crafts and Additions moves Forge Energy to and from moving Create contraptions. When two interfaces meet, the contraption connects to an outside power network, which works well for electric trains and other moving machines."]
	quest.278066D4F5C2E248.quest_subtitle: "Obtain Portable Energy Interface"
	quest.2787A61E2052E52B.quest_desc: ["A decorative block from Ars Nouveau to use if you want a little bit of glitz in your magical build."]
	quest.2787A61E2052E52B.quest_subtitle: "Obtain 8x Gilded Sourcestone Small Bricks"
	quest.278C7A854FA708EB.quest_desc: ["Ah, the humble Water Wheel. It's the simplest first step to generating free power for Create, while also embodying rotational motion, an essential feature of Create."]
	quest.278C7A854FA708EB.quest_subtitle: "Obtain Water Wheel and Large Water Wheel"
	quest.27946D911EAB2C01.quest_desc: ["Fill the Etching Tank with Etching Acid and insert Empty PCBs that have been exposed in a UV Light Box. Optionally, you can heat the tank to above 50 degrees Celsius to speed up the etching process, though this will cause the Etching Acid to be consumed more rapidly. Extract Unassembled PCBs from the sides and Failed PCBs from the top or bottom of the tank."]
	quest.27946D911EAB2C01.quest_subtitle: "Obtain Etching Tank"
	quest.27A213407DC5A9C1.quest_desc: ["The Refined Obsidian Ingot is an ingot created by placing Refined Obsidian Dust into an Osmium Compressor fueled with Liquid Osmium (from Osmium Ingots)."]
	quest.27A213407DC5A9C1.quest_subtitle: "Obtain Ingot Refined Obsidian"
	quest.27B6BEBD335F2FF5.quest_desc: ["The leggings of the Iron armor set. Together with the chestplate, they unlock the helmet."]
	quest.27BC33EE0CF97657.quest_desc: ["This quest asks for Sugar Apple Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.27BC33EE0CF97657.quest_subtitle: "Obtain Sugar Apple Sapling"
	quest.27C1A6C5B2BA3DD9.quest_desc: ["This is the ultimate generator. The Plasma Turbine uses Helium Plasma to produce energy, up to 1,048,576 EU/t. This is about 100,000 EU per millibucket of Helium Plasma, and a consumption rate of about 11 mb/t. As long as you know how to care for your factory, you will never need to worry about power ever again."]
	quest.27C1A6C5B2BA3DD9.quest_subtitle: "Obtain 18x Iridium Machine Casing Pipe, 17x Plasma Handling Iridium Machine Casing and Plasma Turbine"
	quest.27C1A6C5B2BA3DD9.title: "Plasma Turbine"
	quest.27D840D1ED7B4A09.quest_desc: ["Botany Pots provide compact, automated plant and crop growing. Check which soils and plants are supported and use the pots where passive production is useful."]
	quest.27D840D1ED7B4A09.title: "Getting Started"
	quest.27DAA4AFB43FACD8.quest_desc: ["Obtain a Desk Bell, Peculiar Bell and Haunted Bell from Create. The Desk Bell can emit a Redstone pulse." "The Peculiar Bell is a decorative brass bell that can be turned into a Haunted Bell, which reveals areas where hostile mobs may spawn."]
	quest.27DAA4AFB43FACD8.quest_subtitle: "Obtain Desk Bell, Peculiar Bell and Haunted Bell"
	quest.27DD33AE9F6D26B2.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.27DD33AE9F6D26B2.quest_subtitle: "Obtain Glyph Evaporate"
	quest.27EF30AD84A37B69.quest_desc: ["The Handheld Drill from Create: Dreams n' Desires is a portable mechanical drill. It suits material processing and construction around your factory without a stationary drill setup."]
	quest.27EF30AD84A37B69.quest_subtitle: "Obtain Handheld Drill"
	quest.27F746A43CE468A1.quest_desc: ["Tier 2 glyph. Craft it at the Scribe\'s Table."]
	quest.27F746A43CE468A1.quest_subtitle: "Obtain Glyph Accelerate"
	quest.27FE0D17D8F455FC.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.27FE0D17D8F455FC.quest_subtitle: "Obtain Elite Infusing Factory"
	quest.281BDD88E98AB6C4.quest_desc: ["Blazebloom goo will transform blocks of primal coal into raw blaze ember. 3–4 blaze embers will drop from it. Burns 9x more items than coal."]
	quest.281BDD88E98AB6C4.quest_subtitle: "Obtain Coal T2"
	quest.282D59A55A7CC317.quest_desc: ["Bring Carob Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.282D59A55A7CC317.quest_subtitle: "Obtain Carob Sapling"
	quest.2831583B930B6785.quest_desc: ["The Chargepad is a wireless electric charging station. Any rechargeable items you have in your inventory will be charged while standing on it."]
	quest.2831583B930B6785.quest_subtitle: "Obtain Chargepad"
	quest.284F0ABEFEBE4425.quest_desc: ["The Starlit Diamond Sword is a late-game weapon crafted from Starlit Diamond materials, added in version 0.5.0." "It is a big upgrade over Glacite and Springstone gear and gives steady high damage before true celestial weapons."]
	quest.284F0ABEFEBE4425.quest_subtitle: "Obtain Starlit Diamond Sword"
	quest.285A43D3899B024F.quest_desc: ["Get hold of Cell Component 1m. Hover over it in EMI and press R to see how it is made."]
	quest.285A43D3899B024F.quest_subtitle: "Obtain Cell Component 1m"
	quest.285A8EBB0EE1213C.quest_desc: ["This quest asks for Blazegold Shovel. EMI shows the recipe if you press R while hovering over it."]
	quest.285A8EBB0EE1213C.quest_subtitle: "Obtain Blazegold Shovel"
	quest.28660792B2E7DFA1.quest_desc: ["Get hold of Plasma Turbine. Hover over it in EMI and press R to see how it is made."]
	quest.28660792B2E7DFA1.quest_subtitle: "Obtain Plasma Turbine"
	quest.28660792B2E7DFA1.title: "Better than Nuclear Fission"
	quest.286803C3862A73DB.quest_desc: ["Starbuncle shards may be obtained in loot chests or by giving a starbuncle a gold nugget. Starbuncle shards are used to create starbuncle charms."]
	quest.286803C3862A73DB.quest_subtitle: "Obtain Starbuncle Shards"
	quest.286F45B6BBCDD643.quest_desc: ["Get hold of Awakened Supremium Watering Can. Hover over it in EMI and press R to see how it is made."]
	quest.286F45B6BBCDD643.quest_subtitle: "Obtain Awakened Supremium Watering Can"
	quest.2878FE5987B9D729.quest_desc: ["Bring Celestigem Shovel into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2878FE5987B9D729.quest_subtitle: "Obtain Celestigem Shovel"
	quest.28824A6D88394A59.quest_desc: ["Bring Electrum Seeds into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.28824A6D88394A59.quest_subtitle: "Obtain Electrum Seeds"
	quest.288948A50665C30C.quest_desc: ["Causes explosions on impact. Avoid using it at close range!"]
	quest.288948A50665C30C.quest_subtitle: "Obtain Gun Ammo Explosive"
	quest.289135A3C02884B6.quest_desc: ["Ignitium Ingots from Cataclysm mainly drop after defeating Ignis." "They are used to craft some of the mod's strongest weapons, armor and relics."]
	quest.289135A3C02884B6.quest_subtitle: "Obtain Ignitium Ingot"
	quest.28A030D3FB585CF0.quest_desc: ["The Laser Gatling from Cataclysm is a ranged weapon that fires the same laser technology as The Harbinger." "It uses Redstone as ammunition and can ignite blocks when fired."]
	quest.28A030D3FB585CF0.quest_subtitle: "Obtain Laser Gatling"
	quest.28A030D3FB585CF0.title: "Laser Gatling"
	quest.28A2EC44C6BDAB77.quest_desc: ["This quest asks for Netherite Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.28A2EC44C6BDAB77.quest_subtitle: "Obtain Netherite Seeds"
	quest.28B3E3D17FF3E0DD.quest_desc: ["The leggings of the Awakened Supremium armor set. Together with the chestplate, they unlock the helmet."]
	quest.28B83DF11CFA3A77.quest_desc: ["Like the Void Upgrade, with more filtering options."]
	quest.28B83DF11CFA3A77.quest_subtitle: "Obtain Advanced Void Upgrade"
	quest.28C4E37E68DAFAA9.quest_desc: ["The Nether Stove is a cooking station from My Nether's Delight made for dishes that use Nether ingredients." "It carries the cooking mechanics of Farmer's Delight into the Nether."]
	quest.28C4E37E68DAFAA9.quest_subtitle: "Obtain Nether Bricks Stove"
	quest.28CF75BB46B75616.quest_desc: ["Get hold of Alchemist Cauldron. Hover over it in EMI and press R to see how it is made."]
	quest.28CF75BB46B75616.quest_subtitle: "Obtain Alchemist Cauldron"
	quest.28D107C396ED1708.quest_desc: ["The Pyrium Staff is a powerful Fire staff in Iron's Spells 'n Spellbooks. In the main hand it gives 9 Attack Damage, 1.5 Attack Speed, +15% Fire Spell Power, +10% Cast Time Reduction and +5% Spell Power." "It is crafted from 2 Pyrium Ingots, 1 Arcane Cloth and 1 Netherite Ingot."]
	quest.28D107C396ED1708.quest_subtitle: "Obtain Pyrium Staff"
	quest.28DF24A859ECBF2A.quest_desc: ["This quest asks for Capacitor Mv. EMI shows the recipe if you press R while hovering over it."]
	quest.28DF24A859ECBF2A.quest_subtitle: "Obtain Capacitor Mv"
	quest.28E100D9327D6454.quest_desc: ["Get hold of Ballistarian Bracer. Hover over it in EMI and press R to see how it is made."]
	quest.28E100D9327D6454.quest_subtitle: "Obtain Ballistarian Bracer"
	quest.28E8F26DD82B73B8.quest_desc: ["Get hold of Egg Sandwich. Hover over it in EMI and press R to see how it is made."]
	quest.28E8F26DD82B73B8.quest_subtitle: "Obtain Egg Sandwich"
	quest.28F86392E0F9B71B.quest_desc: ["An Extend Time flask and the Wixie Thread each act as a multiplier on potion duration."]
	quest.28F86392E0F9B71B.quest_subtitle: "Obtain Potion Flask, Potion Flask Amplify and Potion Flask Extend Time"
	quest.2915EA2D06CCD0BA.quest_desc: ["This quest asks for Enigma. EMI shows the recipe if you press R while hovering over it."]
	quest.2915EA2D06CCD0BA.quest_subtitle: "Obtain Enigma"
	quest.29196147E5BD3ED7.quest_desc: ["Defeat a Shriek Worm." "Listen for its shriek, since it can strike from the ground."]
	quest.29196147E5BD3ED7.quest_subtitle: "Defeat Shriek Worm"
	quest.29196147E5BD3ED7.title: "Shriek Worm"
	quest.291C23C4D79B0B97.quest_desc: ["Craft Cursium Boots from Cataclysm by upgrading Netherite Boots with a Cursium Upgrade Smithing Template and a Cursium Ingot at a Smithing Table." "They belong to the Cursium armor set and grant the Ghostly Weightless ability, which reduces fall damage and allows a quick backdash."]
	quest.291C23C4D79B0B97.quest_subtitle: "Obtain Cursium Boots"
	quest.29259F3FA0002C4D.quest_desc: ["Get hold of Thread Heights. Hover over it in EMI and press R to see how it is made."]
	quest.29259F3FA0002C4D.quest_subtitle: "Obtain Thread Heights"
	quest.2928C01693842EA6.quest_desc: ["Provides a touch spell before damaging an entity."]
	quest.2928C01693842EA6.quest_subtitle: "Obtain Enchanters Sword"
	quest.29310AD0FC5238D1.quest_desc: ["Get hold of Echo Glove. Hover over it in EMI and press R to see how it is made."]
	quest.29310AD0FC5238D1.quest_subtitle: "Obtain Echo Glove"
	quest.29345E31ADD5A560.title: "Minoshroom"
	quest.2946A9ECB5F12A71.quest_desc: ["Item Pipes work just about the same as Fluid Pipes, aside from they will transport items and is much more configurable. Just like Fluid pipes, they will not connect to inventories by default, but you still can force a connection. If you right click a connection without a Wrench, you'll see a filter. This filter can be set to many different items at the same time and by default is set to whitelist. This means only items in the filter will be transported through the connection. Blacklist will disallow any items set to the filter to be transported through the connection. Item pipes will insert items into higher priorities first, and transfer 16 items every 3 seconds, but can be upgraded with Motors for higher thoughput."]
	quest.2946A9ECB5F12A71.quest_subtitle: "Obtain 16x Item Pipe"
	quest.2946A9ECB5F12A71.title: "Item Transportation"
	quest.29520A3ED368CCC6.quest_desc: ["The drill that will push you into the far bounds of technology. Made of that super light yet strong Titanium from before, you'll be able to power your reactors and enter the quantum age."]
	quest.29520A3ED368CCC6.quest_subtitle: "Obtain 4x Titanium Drill"
	quest.29520A3ED368CCC6.title: "Titanium Drill"
	quest.29524EEE5B7B2F09.quest_desc: ["A reactor needs 36 reactor blocks. Hold them and look at the ground to preview a 3x3 shape, which turns red if the reactor cannot be built there. The reactor is 4 blocks tall."]
	quest.29524EEE5B7B2F09.quest_subtitle: "Obtain 36x Reactor Starter"
	quest.29524EEE5B7B2F09.title: "Reactor (Starter)"
	quest.295BAEC05F73DFC8.quest_desc: ["Bring 36x Reactor Spirited into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.295BAEC05F73DFC8.quest_subtitle: "Obtain 36x Reactor Spirited"
	quest.2968FEE9CAE5ECFA.quest_desc: ["Explore Actually Additions, a technology and utility mod with generators, machines, farming tools, and automation. Use EMI to discover the recipes and available machines."]
	quest.2968FEE9CAE5ECFA.title: "Getting Started"
	quest.297F0BBC8526DAD2.quest_desc: ["The Advanced Portal Gun works like the Portal Gun and also lets you save locations to teleport to. Open the menu with V by default, and rebind it if it clashes with another key. It uses power and Portal Fluid."]
	quest.297F0BBC8526DAD2.quest_subtitle: "Obtain Portalgun V2"
	quest.2980D0B0EF7E81AD.quest_desc: ["The chestplate of the Leather armor set. Together with the leggings, it unlocks the helmet."]
	quest.2982CA9B69CC80D9.quest_desc: ["Doesn't support buses so you must first step down from Dense to a smaller cable (such as Fluix ME Glass Cable or Fluix ME Smart Cable) before using buses or panels. Shows load similarly to Fluix ME Smart Cable, with each line lit representing four channels in use."]
	quest.2982CA9B69CC80D9.quest_subtitle: "Obtain Fluix Smart Dense Cable"
	quest.2982CA9B69CC80D9.title: "Fluix Dense Smart Cable"
	quest.2982D24B3875C074.quest_desc: ["A Spawner is the base for automated mob spawning. Obtain one to start modifying how it behaves."]
	quest.2982D24B3875C074.quest_subtitle: "Obtain Spawner"
	quest.2982D24B3875C074.title: "Spawner"
	quest.298B31EEE9A6CA80.quest_desc: ["Blackthorn can mutate into a Purple Blackthorn when growing."]
	quest.298B31EEE9A6CA80.quest_subtitle: "Obtain Purple Blackthorn Sapling"
	quest.299704EAC96A5A9F.quest_desc: ["Rotational Chasis and Linear Chassis help build contraptions without superglue."]
	quest.299704EAC96A5A9F.quest_subtitle: "Obtain Radial Chassis"
	quest.299F3ADB39580F09.quest_desc: ["Bring Cherry Plum Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.299F3ADB39580F09.quest_subtitle: "Obtain Cherry Plum Sapling"
	quest.29A2417BC7C4CF22.quest_desc: ["This quest asks for Watcher Claymore. EMI shows the recipe if you press R while hovering over it."]
	quest.29A2417BC7C4CF22.quest_subtitle: "Obtain Watcher Claymore"
	quest.29AA5AF08298664E.quest_desc: ["This unit increases the amount of energy the device it's attached to can hold. It is stackable up to 8 times."]
	quest.29AA5AF08298664E.quest_subtitle: "Obtain Module Energy Unit"
	quest.29B11DA9B93E295F.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.29B11DA9B93E295F.quest_subtitle: "Obtain Glyph Toss"
	quest.29CB1AB88816993E.quest_desc: ["The Zoglin Trophy is a decorative block from My Nether's Delight. Place it to show off a Zoglin victory or your time in the Nether."]
	quest.29CB1AB88816993E.quest_subtitle: "Obtain Zoglin Trophy"
	quest.29CD44313F7C8890.quest_desc: ["After gathering enough Entro Crystal, you can finally craft your first Extended Machine frame. The foundation for Extended machines."]
	quest.29CD44313F7C8890.quest_subtitle: "Obtain Machine Frame"
	quest.29DBDBD72FFB3B0A.quest_desc: ["Crafting Storage combines a Crafting Unit with a Cell Component. It stores the ingredients needed for crafting jobs inside an ME Crafting CPU."]
	quest.29DBDBD72FFB3B0A.title: "Build a 1k Crafting Storage"
	quest.29DEE94E205B70FE.quest_desc: ["Get hold of Yellorium Seeds. Hover over it in EMI and press R to see how it is made."]
	quest.29DEE94E205B70FE.quest_subtitle: "Obtain Yellorium Seeds"
	quest.29E5A8912F28E362.quest_desc: ["Casts shorter."]
	quest.29E5A8912F28E362.quest_subtitle: "Obtain Heavy Hook"
	quest.29EE576A9AEB5847.quest_desc: ["This quest asks for 8x Windmill Blade. EMI shows the recipe if you press R while hovering over it."]
	quest.29EE576A9AEB5847.quest_subtitle: "Obtain 8x Windmill Blade"
	quest.29F87D3B2A3FE110.quest_desc: ["Koboletons often drop Ancient Metal Nuggets in Cataclysm, and you can also find them around the Desert Site and Cursed Pyramid." "Combine 9 nuggets to craft an Ancient Metal Ingot."]
	quest.29F87D3B2A3FE110.quest_subtitle: "Obtain Ancient Metal Nugget"
	quest.29FA5DF916F12B75.quest_desc: ["Earn the advancement: Gold Dungeon."]
	quest.29FA5DF916F12B75.quest_subtitle: "Defeat the Gold Dungeon boss"
	quest.2A02F235E7D16773.quest_desc: ["Bring Mega Energy Cell into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2A02F235E7D16773.quest_subtitle: "Obtain Mega Energy Cell"
	quest.2A181B2512B8B9E3.quest_desc: ["Bring Niotic Crystal Seeds into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2A181B2512B8B9E3.quest_subtitle: "Obtain Niotic Crystal Seeds"
	quest.2A1DE7DDC9F28A8A.quest_desc: ["This scroll helps with automation."]
	quest.2A1DE7DDC9F28A8A.quest_subtitle: "Obtain Mimic Scroll"
	quest.2A2B1C7AA042DD8C.quest_desc: ["This quest asks for Spellbreaker. EMI shows the recipe if you press R while hovering over it."]
	quest.2A2B1C7AA042DD8C.quest_subtitle: "Obtain Spellbreaker"
	quest.2A3625D28EB81F48.quest_desc: ["Allows other blocks to interact with your inventory, armor, or off-hand slots."]
	quest.2A3625D28EB81F48.quest_subtitle: "Obtain Playeraccessor"
	quest.2A3ED465EF751F73.quest_desc: ["The Electric Motor from Create Crafts and Additions is the counterpart of the Alternator. It turns Forge Energy (FE) into rotational power for Create machines." "You can set its RPM, and higher speeds cost more FE. It can output up to 2048 SU."]
	quest.2A3ED465EF751F73.quest_subtitle: "Obtain Electric Motor"
	quest.2A5282A6DA2EC003.quest_desc: ["The enchanting apparatus is to be used with arcane pedestals and an arcane core."]
	quest.2A5282A6DA2EC003.quest_subtitle: "Obtain Enchanting Apparatus"
	quest.2A542220C493CC66.quest_desc: ["The Thermal Springstone Boots are crafted from Thermal Springstone Ingots in Eternal Starlight." "Like the rest of the set, they ignite attackers and reduce fire damage, which suits hot, dangerous areas."]
	quest.2A542220C493CC66.quest_subtitle: "Obtain Thermal Springstone Boots"
	quest.2A546E1CBF76E314.quest_desc: ["Tier 2 glyph. Craft it at the Scribe\'s Table."]
	quest.2A546E1CBF76E314.quest_subtitle: "Obtain Glyph Conjure Water"
	quest.2A60F513EF50520E.quest_desc: ["A Fluix Pearl is made from Fluix, Fluix Dust, and an Ender Pearl. It is required for AE2 wireless components and the Quantum Link Chamber."]
	quest.2A68199F937A6738.quest_desc: ["L2 Archery expands ranged combat with additional bows and related equipment. Try different options to find a range and firing style that suits you."]
	quest.2A68199F937A6738.title: "Getting Started"
	quest.2A78072DE4A7BC4E.quest_desc: ["Lime Chalk is needed to summon spirits greater than Foliot. It certifies your mastery of the basics of occultism."]
	quest.2A78072DE4A7BC4E.quest_subtitle: "Obtain Chalk Lime Impure"
	quest.2A863F800ECF8FC0.quest_desc: ["This quest asks for Steel Honey Extractor. EMI shows the recipe if you press R while hovering over it."]
	quest.2A863F800ECF8FC0.quest_subtitle: "Obtain Steel Honey Extractor"
	quest.2A8AD3ECC97D43DF.quest_desc: ["Has a chance to not use durability."]
	quest.2A8AD3ECC97D43DF.quest_subtitle: "Obtain Diamond Hook"
	quest.2A9C6DF952D5C630.quest_desc: ["Bring Cardboard Helmet, Cardboard Chestplate, Cardboard Leggings and 2 more items into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2A9C6DF952D5C630.quest_subtitle: "Obtain Cardboard Helmet, Cardboard Chestplate, Cardboard Leggings and 2 more items"
	quest.2A9F72752BF5EE0D.quest_desc: ["Bring Beef Stew into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2A9F72752BF5EE0D.quest_subtitle: "Obtain Beef Stew"
	quest.2AA4A4F7E35FED0D.quest_desc: ["Crafting tables and similar blocks show extra buttons next to the grid. Use them to rotate a recipe, balance the items or clear the grid quickly."]
	quest.2AA4A4F7E35FED0D.quest_subtitle: "Rotate, balance and clear."
	quest.2AA4A4F7E35FED0D.title: "Crafting Helpers"
	quest.2AA73197149F232B.quest_desc: ["MekaSuit can be upgraded with Modules that are installed with the Modification Station."]
	quest.2AA73197149F232B.quest_subtitle: "Obtain Mekasuit Bodyarmor"
	quest.2AAA0F80DE60239D.quest_desc: ["Get hold of Configurable Honeycomb. Hover over it in EMI and press R to see how it is made."]
	quest.2AAA0F80DE60239D.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.2ADBD3B1767199CE.quest_desc: ["Shift-right-click a block of the same type as the nest you want to find. For example, use a sand nest or a sand block to find a sand nest."]
	quest.2ADBD3B1767199CE.quest_subtitle: "Obtain Nest Locator"
	quest.2AF2F3EC474594A0.quest_desc: ["This quest asks for Slumbering Lichblade. EMI shows the recipe if you press R while hovering over it."]
	quest.2AF2F3EC474594A0.quest_subtitle: "Obtain Slumbering Lichblade"
	quest.2AFA7666648A8747.quest_desc: ["Shrinks the wearer."]
	quest.2AFA7666648A8747.quest_subtitle: "Obtain Charm of Shrinking"
	quest.2B1C02522047CF1B.quest_desc: ["Get hold of Tertium Helmet, Tertium Chestplate, Tertium Leggings and Tertium Boots. Hover over it in EMI and press R to see how it is made."]
	quest.2B1C02522047CF1B.quest_subtitle: "Obtain Tertium Helmet, Tertium Chestplate, Tertium Leggings and Tertium Boots"
	quest.2B1C02522047CF1B.title: "Tertium Armor"
	quest.2B2A77CE16A02E47.quest_desc: ["Chain of Souls is a mysterious item from Eternal Starlight tied to higher-tier progression and dimensional entities."]
	quest.2B2A77CE16A02E47.quest_subtitle: "Obtain Chain of Souls"
	quest.2B2A77CE16A02E47.title: "Chain Of Souls"
	quest.2B2D9F3C796D1809.quest_desc: ["Bring Padauk Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2B2D9F3C796D1809.quest_subtitle: "Obtain Padauk Sapling"
	quest.2B31535D5A9B99C8.quest_desc: ["The final goal. Completing it earns the Trophy of the Older Angler."]
	quest.2B31535D5A9B99C8.quest_subtitle: "Catch all 131 fish"
	quest.2B3A54ACD04DE476.quest_desc: ["The Immolator from Cataclysm is a legendary weapon that sets enemies on fire with every hit." "You get it from the Burning Arena."]
	quest.2B3A54ACD04DE476.quest_subtitle: "Obtain The Immolator"
	quest.2B3A54ACD04DE476.title: "The Immolator"
	quest.2B41351F1A9D11A9.quest_desc: ["This is the electric version of the Steam Blast Furnace. The Electric Blast Furnace (aka EBF) uses induction heating to produce extreme temperatures, unlocking a plethora of new recipes. Plus, its overclock is bounded to 128 EU/t by default, just like other multi-block electric machines. The Electronic Blast Furnace or EBF is made out of purely Heatproof Machine Casings and Cupronickel Coils. Use your Wrench to see the mutliblock's shape and block placement. The controller is placed on the bottom layer and hatches and be placed on the top or bottom layer. Don't forget to add an Energy Input Hatch(es) or the EBF won't have any energy to run! Start with a LV Energy Input Hatch and you can upgrade to higher tier Energy Input Hatches when you have the appropriate power tiers. Remember, the LV Energy Input Hatch will only connect to LV cables. You'll also need item or fluid input hatches and item or fluid output hatches based off of the use case of the EBF. Check your EMI for it's new recipes and choose hatches based off your needs."]
	quest.2B41351F1A9D11A9.quest_subtitle: "Obtain 14x Heatproof Machine Casing, 16x Cupronickel Coil and Electric Blast Furnace"
	quest.2B41351F1A9D11A9.title: "Electric Blast Furnace"
	quest.2B46B184A6DCB459.quest_desc: ["Biomass is an organic fuel from Create Crafts and Additions. It can be processed into Biomass Pellets and burned as a renewable fuel for your factory. The mod also lets you process it further into Bioethanol."]
	quest.2B46B184A6DCB459.quest_subtitle: "Obtain Biomass"
	quest.2B4B4235D47A4111.quest_desc: ["The Toaster turns bread into toast."]
	quest.2B4B4235D47A4111.quest_subtitle: "Turns bread into toast"
	quest.2B4BE453E6F5DC6B.quest_desc: ["MekaSuit can be upgraded with Modules that are installed with the Modification Station."]
	quest.2B4BE453E6F5DC6B.quest_subtitle: "Obtain Mekasuit Helmet"
	quest.2B54DC789F7EA9B2.quest_desc: ["You can use the Heat Exchanger to, well, exchange heat. You can recover the High Pressure Water to be used for another cycle. Remember that pressurizing Water into High Pressure Water costs a lot of energy, but the turbine will not necessarily give it back."]
	quest.2B54DC789F7EA9B2.quest_subtitle: "Obtain Heat Exchanger, 9x Frostproof Machine Casing, 9x Heatproof Machine Casing and 19x Stainless Steel Machine Casing Pipe"
	quest.2B54DC789F7EA9B2.title: "Heat Exchanger"
	quest.2B5AACFAB8A0F145.quest_desc: ["The Rod o' Lightning gives you a +15% Spell Cooldown Reduction and Lightning Spell Power, it also gives a 5% scroll power to non-lighting Scrolls. Use this to help cast spells more efficiently."]
	quest.2B5AACFAB8A0F145.quest_subtitle: "Obtain Lightning Rod"
	quest.2B63B96C8B7EC0A5.quest_desc: ["Meef Stroganoff is made from Meef, a rare meat dropped by the Minoshroom. It restores a large amount of hunger." "It is a good meal to eat before heading deeper into the Twilight Forest."]
	quest.2B63B96C8B7EC0A5.quest_subtitle: "Obtain Meef Stroganoff"
	quest.2B67B8D212905618.quest_desc: ["The Annihilator is a powerful Cataclysm endgame weapon, part of the mod's strongest arsenal." "You can upgrade it using the Mechanical Fusion Anvil."]
	quest.2B67B8D212905618.quest_subtitle: "Obtain The Annihilator"
	quest.2B67B8D212905618.title: "The Annhilator"
	quest.2B6C634F9680C682.quest_desc: ["The Thermal Springstone Hammer is crafted from Thermal Springstone Ingots in Eternal Starlight." "Its strikes are slow but powerful with high knockback, which helps control crowds in mid-tier combat."]
	quest.2B6C634F9680C682.quest_subtitle: "Obtain Thermal Springstone Hammer"
	quest.2B748F6675CE603C.quest_desc: ["Used to heal or harm nearby entities. Also used to cure zombie villages."]
	quest.2B748F6675CE603C.quest_subtitle: "Obtain Ritual Restoration"
	quest.2B7662026F1ABA0F.quest_desc: ["Get hold of Hotdog. Hover over it in EMI and press R to see how it is made."]
	quest.2B7662026F1ABA0F.quest_subtitle: "Obtain Hotdog"
	quest.2B79B6DC990E011E.quest_desc: ["This quest asks for Sorcerer Hood, Sorcerer Robes, Sorcerer Leggings and Sorcerer Boots. EMI shows the recipe if you press R while hovering over it."]
	quest.2B79B6DC990E011E.quest_subtitle: "Obtain Sorcerer Hood, Sorcerer Robes, Sorcerer Leggings and Sorcerer Boots"
	quest.2B79B6DC990E011E.title: "Sorceror's Clothes"
	quest.2B7B18645BCAAC87.quest_desc: ["Starlit Diamonds are among the rarest treasures in Eternal Starlight." "They represent a higher material tier, and finding one means you are reaching the deeper, more dangerous parts of the dimension."]
	quest.2B7B18645BCAAC87.quest_subtitle: "Obtain Starlit Diamond"
	quest.2B7B18645BCAAC87.title: "Starlit Diamond"
	quest.2B83605219431758.quest_desc: ["Bring Smart Filter into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2B83605219431758.quest_subtitle: "Obtain Smart Filter"
	quest.2B83605219431758.title: "Boots"
	quest.2B8651AF164921EA.quest_desc: ["The Molecular Assembler crafts recipes automatically when supplied with ingredients by an ME network. It uses both core types and a crafting table."]
	quest.2B9EAD6614A7D8BE.quest_desc: ["Get hold of Battery Starter. Hover over it in EMI and press R to see how it is made."]
	quest.2B9EAD6614A7D8BE.quest_subtitle: "Obtain Battery Starter"
	quest.2BBE038357B06D7F.quest_desc: ["Crafted with an Iron Block in a Charger used to make the Energy Processor."]
	quest.2BBE038357B06D7F.quest_subtitle: "Obtain Energy Processor Press"
	quest.2BC324F66DC5F41E.quest_desc: ["Create is a mod of many talents. Mechanize parts and resources, farm, produce energy, add mechanical movement to your builds, build and schedule trains with a mail delivery network, move and store items and fluids, and build a smart factory. You can also copy and paste builds, and fill, drain or explore bodies of water or lava." "These quests are not a set path, so tackle them in any order."]
	quest.2BC324F66DC5F41E.quest_subtitle: "Obtain 64x Andesite and 64x Zinc Nugget"
	quest.2BC867860E656705.quest_desc: ["Bring Configurable Honeycomb into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2BC867860E656705.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.2BC96850FFA89420.quest_desc: ["Adding a Compression Card to your Bulk Storage Cell makes it automatically compress items/blocks to higher tiers of compression. Ex. Nuggets -> Ingots -> Blocks. You'll also want a Decompression Module somewhere on your network to also automatically de-compress items as needed. NOTE: Decompression Module NEEDS to be on the same network as your autocrafting, otherwise your autocrafters can't see those items."]
	quest.2BC96850FFA89420.quest_subtitle: "Obtain Decompression Module and Compression Card"
	quest.2BC96850FFA89420.title: "Bulk Cell Compression"
	quest.2BE6FA0EE7E3BBC7.quest_desc: ["Get hold of Ender Gate Basic. Hover over it in EMI and press R to see how it is made."]
	quest.2BE6FA0EE7E3BBC7.quest_subtitle: "Obtain Ender Gate Basic"
	quest.2BF7C8EEC063D3BA.quest_desc: ["Bring Redstone Seeds into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2BF7C8EEC063D3BA.quest_subtitle: "Obtain Redstone Seeds"
	quest.2C00296A5307B856.quest_desc: ["This quest asks for Lv Steam Turbine. EMI shows the recipe if you press R while hovering over it."]
	quest.2C00296A5307B856.quest_subtitle: "Obtain Lv Steam Turbine"
	quest.2C00296A5307B856.title: "Better Than Solar Panels"
	quest.2C041BAE70CBDF25.quest_desc: ["A pre-programmed Drone that harvests fully-grown crops within a 17x17x17 area centered on the position it's deployed from. This Drone has two basic modes depending on how it is deployed: Deploying on the ground will tell the drone to harvest any fully-grown crops within its area. Deploying on top of an inventory containing a Hoe will tell the drone to replant any crops it harvests within its area."]
	quest.2C041BAE70CBDF25.quest_subtitle: "Obtain Harvesting Drone"
	quest.2C118A714F627961.quest_desc: ["This is the most basic Spellbook, it can only hold five Spells."]
	quest.2C118A714F627961.quest_subtitle: "Obtain Copper Spell Book"
	quest.2C15DC88A479EF67.quest_desc: ["Andesite Alloy is key to starting out with Create. When mining early on, grab as much Andesite as you can, and gather Zinc too so your Iron is free for other uses."]
	quest.2C15DC88A479EF67.quest_subtitle: "Obtain 32x Andesite Alloy"
	quest.2C1A94A6E32598DE.quest_desc: ["With just some crushed osmium, you can reinforce a plastic block. This makes it blast proof."]
	quest.2C1A94A6E32598DE.quest_subtitle: "Obtain White Reinforced Plastic"
	quest.2C3882541DC61D09.quest_desc: ["Bring Magmator Basic into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2C3882541DC61D09.quest_subtitle: "Obtain Magmator Basic"
	quest.2C45BFF5C0057F93.quest_desc: ["Obtain a full set of Chainmail Armor. It cannot normally be crafted, so each piece has to come from exploration, combat or trading." "It is lighter than plate armor but still offers reliable protection."]
	quest.2C45BFF5C0057F93.quest_subtitle: "Obtain Chainmail Helmet, Chainmail Chestplate, Chainmail Leggings and Chainmail Boots"
	quest.2C45BFF5C0057F93.title: "Chainmail Armor"
	quest.2C4C72B18E9B63D8.quest_desc: ["Bring Battery Spirited into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2C4C72B18E9B63D8.quest_subtitle: "Obtain Battery Spirited"
	quest.2C719C70906A361F.quest_desc: ["The ME Canner automates the filling of buckets and tanks with Fluids, Mekanism Gases, and Powah. NOTE: Only the top and bottom side can link to the network and power."]
	quest.2C719C70906A361F.quest_subtitle: "Obtain Caner"
	quest.2C79B13131D2B4C9.quest_desc: ["The Malarite Spear is an early-game weapon in Eternal Starlight, crafted from Malarite found in swamp biomes." "It gives extra reach in melee combat."]
	quest.2C79B13131D2B4C9.quest_subtitle: "Obtain Malarite Spear"
	quest.2C98C57012256FC3.quest_desc: ["Bring Configurable Honeycomb into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2C98C57012256FC3.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.2CBD4A0732FC13F3.quest_desc: ["Pipez offers simple pipes for moving items, fluids, energy, and other resources. Check the pipe types and extraction settings to build straightforward transport networks."]
	quest.2CBD4A0732FC13F3.title: "Getting Started"
	quest.2CD15A00D4882907.quest_desc: ["Ceraunus from Cataclysm is a massive anchor with 16 Attack Damage that you can throw at enemies." "While sneaking, it releases waves in a fan shape. Craft it with 2 Essence of the Storm and 3 Lacrima."]
	quest.2CD15A00D4882907.quest_subtitle: "Obtain Ceraunus"
	quest.2CD15A00D4882907.title: "Ceraunus"
	quest.2CEE93E5F727C96D.quest_desc: ["Bring Steam Quarry into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2CEE93E5F727C96D.quest_subtitle: "Obtain Steam Quarry"
	quest.2CEE93E5F727C96D.title: "From Minecraft to Craft"
	quest.2CF23140C0FB9402.quest_desc: ["Upgrades a Diamond tier or below to Netherite tier."]
	quest.2CF23140C0FB9402.quest_subtitle: "Obtain Basic to Netherite Tier Upgrade, Copper to Netherite Tier Upgrade, Iron to Netherite Tier Upgrade and 2 more items"
	quest.2CF23140C0FB9402.title: "Netherite Tier Upgrade"
	quest.2D094F9F6979E457.quest_desc: ["The Electrolytic Separator sends controlled amounts of direct current into a fluid, causing the atoms in the fluid to break their bonds."]
	quest.2D094F9F6979E457.quest_subtitle: "Obtain Electrolytic Separator"
	quest.2D12317C92E58AEC.quest_desc: ["This substance can be processed in a Thermopneumatic Processing Plant to produce Gasoline, which is a high-quality liquid fuel. It can also be placed in a Furnace."]
	quest.2D12317C92E58AEC.quest_subtitle: "Obtain Kerosene Bucket"
	quest.2D12317C92E58AEC.title: "Kerosene"
	quest.2D12E9DA74DE5AEE.quest_desc: ["Craft a Soulium Dagger with 2 Soulium Ingots and 2 Soulium Dust, + a Gold Sword."]
	quest.2D12E9DA74DE5AEE.quest_subtitle: "Obtain Soulium Dagger"
	quest.2D2118635BD72D8A.quest_desc: ["Cannon your build plans right into the world, block by block."]
	quest.2D2118635BD72D8A.quest_subtitle: "Obtain Schematicannon"
	quest.2D256ACB9F5023CA.quest_desc: ["This quest asks for Music Disc Relic. EMI shows the recipe if you press R while hovering over it."]
	quest.2D256ACB9F5023CA.quest_subtitle: "Obtain Music Disc Relic"
	quest.2D3054CFE8DAABB7.quest_desc: ["It’s brass, it spins, and it looks fly. ‘Nuff said."]
	quest.2D3054CFE8DAABB7.quest_subtitle: "Obtain Flywheel"
	quest.2D367D77B2FCE2EC.quest_desc: ["Get hold of Dormant Relic. Hover over it in EMI and press R to see how it is made."]
	quest.2D367D77B2FCE2EC.quest_subtitle: "Obtain Dormant Relic"
	quest.2D4AC98F0BC97B9E.quest_desc: ["Halves the cook time of all smelting recipes, at the cost of double fuel use."]
	quest.2D4AC98F0BC97B9E.quest_subtitle: "Obtain Augment Speed"
	quest.2D52722717950481.quest_desc: ["Relay connectors work like the standard ones and are useful for extending a line. A right-click with Wire Cutters removes a wire."]
	quest.2D52722717950481.quest_subtitle: "Obtain Connector Lv Relay, Connector Mv Relay and Connector Hv Relay"
	quest.2D56054439A7F592.quest_desc: ["This quest asks for Honey Bottle. EMI shows the recipe if you press R while hovering over it."]
	quest.2D56054439A7F592.quest_subtitle: "Obtain Honey Bottle"
	quest.2D61722043555825.quest_desc: ["Scylla is a major Cataclysm boss who rules the Acropolis and uses powerful storm attacks." "Defeating the Storm Empress is a serious challenge."]
	quest.2D61722043555825.quest_subtitle: "Defeat Scylla"
	quest.2D61722043555825.title: "Scylla"
	quest.2D63780DCA9A1181.quest_desc: ["Bring Iroko Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2D63780DCA9A1181.quest_subtitle: "Obtain Iroko Sapling"
	quest.2D660DFFEBA60499.quest_desc: ["The Starlit Diamond Chestplate is crafted from Starlit Diamonds in Eternal Starlight." "Starlit Diamond armor gives protection comparable to Netherite, with higher armor toughness and knockback resistance."]
	quest.2D660DFFEBA60499.quest_subtitle: "Obtain Starlit Diamond Chestplate"
	quest.2D691C127237602C.quest_desc: ["This quest asks for Configurable Honeycomb. EMI shows the recipe if you press R while hovering over it."]
	quest.2D691C127237602C.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.2D694373D070BBB7.quest_desc: ["The Cutting Board from Farmer's Delight works with a knife to process and prepare ingredients. Use it to make components for various recipes and meals."]
	quest.2D694373D070BBB7.quest_subtitle: "Obtain Cutting Board"
	quest.2D6C3A0B84ED63DE.quest_desc: ["Get hold of Capitaine. Hover over it in EMI and press R to see how it is made."]
	quest.2D6C3A0B84ED63DE.quest_subtitle: "Obtain Capitaine"
	quest.2D70DDEDD235DAB2.quest_desc: ["This quest asks for Mutton Wrap. EMI shows the recipe if you press R while hovering over it."]
	quest.2D70DDEDD235DAB2.quest_subtitle: "Obtain Mutton Wrap"
	quest.2D76F03DC14DD75E.quest_desc: ["The Otherstone trader will make acquiring Otherstone a lot more convenient - and more efficient."]
	quest.2D76F03DC14DD75E.quest_subtitle: "Obtain Book of Binding Bound Foliot, Stone, Granite and 2 more items. Earn the advancement: Summon Foliot Otherstone Trader"
	quest.2D76F03DC14DD75E.title: "Ritual: Summon Otherstone Trader"
	quest.2D812EFE8E4D00CA.quest_desc: ["The Personal Barrel gives you a private storage space for keeping large quantities of items close at hand. Like the Personal Chest, its contents are tied to you, letting you access your stored items without needing to return to a specific location. Perfect for storing bulk resources while keeping your main storage system organized."]
	quest.2D812EFE8E4D00CA.quest_subtitle: "Obtain Personal Barrel"
	quest.2D8585DF9E458843.quest_desc: ["The QIO Importer imports items from external inventories into the QIO System. You just need to set the frequency and, if wanted, the filter."]
	quest.2D8585DF9E458843.quest_subtitle: "Obtain Qio Importer"
	quest.2D862C43FCD886D9.quest_desc: ["Bring Scroll into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2D862C43FCD886D9.quest_subtitle: "Obtain Scroll"
	quest.2D87B99EE5C6FA76.quest_desc: ["Has a chance to not use durability and increases luck."]
	quest.2D87B99EE5C6FA76.quest_subtitle: "Obtain Nether Star Hook"
	quest.2D899272A04E21C0.quest_desc: ["The Spice Rack stores spices and ingredients, and the Fruit Basket stores fruit for recipes."]
	quest.2D899272A04E21C0.quest_subtitle: "Storage for spices and fruit"
	quest.2D9C8B320D9792C1.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.2D9C8B320D9792C1.quest_subtitle: "Obtain Glyph Freeze"
	quest.2D9ECE4FFDD55C5C.quest_desc: ["The Wither Assault Shoulder Weapon from Cataclysm is a ranged weapon that fires Wither Missiles. They deal damage, explode and inflict Wither II." "While sneaking, it fires a Wither Grenade instead, which causes a damaging explosion and a cloud of Wither smoke."]
	quest.2D9ECE4FFDD55C5C.quest_subtitle: "Obtain Wither Assault Shoulder Weapon"
	quest.2D9ECE4FFDD55C5C.title: "Wither Assault Shoulder Weapon"
	quest.2DA0C2C268C6733F.quest_desc: ["A simple generator that makes power from fluid fuels: Blaze Ember, Voidflame and Eclipse Ember Fuel."]
	quest.2DA0C2C268C6733F.quest_subtitle: "Obtain Generatorfluidt1"
	quest.2DA23C0F18EE5DBA.quest_desc: ["FramedBlocks lets you create decorative blocks that can take on the appearance of other block types. Experiment with its framing tools to match your builds."]
	quest.2DA23C0F18EE5DBA.title: "Getting Started"
	quest.2DAAA8C550817CC3.quest_desc: ["This quest asks for Hotdog With Mixed Salad. EMI shows the recipe if you press R while hovering over it."]
	quest.2DAAA8C550817CC3.quest_subtitle: "Obtain Hotdog With Mixed Salad"
	quest.2DAF9989EF84E6A5.quest_desc: ["You can connect Tanks above and below using a Wrench, provided that either Tank is empty or both tanks contain the same fluid."]
	quest.2DAF9989EF84E6A5.quest_subtitle: "Obtain Small Tank"
	quest.2DB4A833BB76A0B8.quest_desc: ["A large container that combines your gene samples automatically. Fill it with genes and give it a redstone signal. It may not be the most efficient way, but it is automated."]
	quest.2DB4A833BB76A0B8.quest_subtitle: "Obtain Gene Indexer"
	quest.2DECE1CAF2767EAF.quest_desc: ["Bring Breadfruit Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2DECE1CAF2767EAF.quest_subtitle: "Obtain Breadfruit Sapling"
	quest.2E1CADF1DFAF3400.quest_desc: ["This quest asks for Energizing Rod Starter. EMI shows the recipe if you press R while hovering over it."]
	quest.2E1CADF1DFAF3400.quest_subtitle: "Obtain Energizing Rod Starter"
	quest.2E1D06AEA3264398.quest_desc: ["Get hold of Solar Panel Blazing. Hover over it in EMI and press R to see how it is made."]
	quest.2E1D06AEA3264398.quest_subtitle: "Obtain Solar Panel Blazing"
	quest.2E211A404D8FB0F6.quest_desc: ["Greedy Familiars collect items for you. When put in a Familiar Ring, they enhance your item collection range."]
	quest.2E211A404D8FB0F6.quest_subtitle: "Earn the advancement: Familiar Greedy"
	quest.2E2ED2FB6F533318.quest_desc: ["Bring Music Disc Mall into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2E2ED2FB6F533318.quest_subtitle: "Obtain Music Disc Mall"
	quest.2E30F446C2E7B9B8.quest_desc: ["The Artificer's Cane reduces cooldown and cast time and boosts your spell power. It costs more than the Graybeard Staff but is worth it for larger spells."]
	quest.2E30F446C2E7B9B8.quest_subtitle: "Obtain Artificer Cane"
	quest.2E324E6C4BE77CB8.quest_desc: ["Make the Crystalite Elytra with an Infusion Ritual using an Elytra, an Amber Gem, Enchanted Membranes and Crystal Shards around an Infusion Pedestal." "With the full Crystalite set, it grants permanent Regeneration I in addition to its own armor bonus."]
	quest.2E324E6C4BE77CB8.quest_subtitle: "Obtain Elytra Crystalite"
	quest.2E324E6C4BE77CB8.title: "Crystalite Elytra"
	quest.2E521EE279E6FC50.quest_desc: ["Bring Nether Star Seeds into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2E521EE279E6FC50.quest_subtitle: "Obtain Nether Star Seeds"
	quest.2E5691C67FA084DA.quest_desc: ["Bring Axolotl Bucket into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2E5691C67FA084DA.quest_subtitle: "Obtain Axolotl Bucket"
	quest.2E5EB499D7FE1C18.quest_desc: ["Wire Connectors link your network together. A right-click with Wire Cutters removes a wire."]
	quest.2E5EB499D7FE1C18.quest_subtitle: "Obtain Connector Lv, Connector Mv and Connector Hv"
	quest.2E5EB499D7FE1C18.title: "Wire Connectors"
	quest.2E60ADCA289E3971.quest_desc: ["Makes the storage pickup items. Has more filtering options."]
	quest.2E60ADCA289E3971.quest_subtitle: "Obtain Advanced Pickup Upgrade"
	quest.2E801E4A1F6C5E8B.quest_desc: ["This quest asks for Programming Puzzle. EMI shows the recipe if you press R while hovering over it."]
	quest.2E801E4A1F6C5E8B.quest_subtitle: "Obtain Programming Puzzle"
	quest.2E84C8F00822E8E7.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.2E84C8F00822E8E7.quest_subtitle: "Obtain Glyph Interact"
	quest.2E84DCEFDC88E416.quest_desc: ["This quest asks for Phantom Helmet and Phantom Chestplate. EMI shows the recipe if you press R while hovering over it."]
	quest.2E84DCEFDC88E416.quest_subtitle: "Get a full set of Phantom Armor"
	quest.2E84DCEFDC88E416.title: "Knight Armorer"
	quest.2E9DE83B6DD63E8F.quest_desc: ["Nightfall Spiders appear in Eternal Starlight when darkness falls." "They are fast and aggressive and attack when visibility is lowest, so stay alert while exploring at night."]
	quest.2E9DE83B6DD63E8F.quest_subtitle: "Defeat Nightfall Spider"
	quest.2E9DE83B6DD63E8F.title: "Nightfall Spiders"
	quest.2EC0B4A186F56CBE.quest_desc: ["The Atomic Disassembler is Mekanism's an all-in-one tool, essentially the ultimate, electronic version of the paxel."]
	quest.2EC0B4A186F56CBE.quest_subtitle: "Obtain Atomic Disassembler"
	quest.2EC1B3FDF5E38407.quest_desc: ["Obtain a Copper Sheet from Create by using a Mechanical Press on a Copper Ingot." "It is needed to craft Fluid Pipes, Copper Casings, Fluid Tanks, Hose Pulleys and other Create components."]
	quest.2EC1B3FDF5E38407.quest_subtitle: "Obtain 8x Copper Sheet"
	quest.2EC1B3FDF5E38407.title: "Copper Sheet"
	quest.2EE1C2797F3DB8CC.quest_desc: ["Bring Roasted Mutton Chops into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2EE1C2797F3DB8CC.quest_subtitle: "Obtain Roasted Mutton Chops"
	quest.2EEEA37B3E6377D5.quest_desc: ["The Aeternium Sword Handle is a component for assembling an Aeternium Sword at the Smithing Table." "You need it to finish Better End's strongest sword."]
	quest.2EEEA37B3E6377D5.quest_subtitle: "Obtain Aeternium Sword Handle"
	quest.2EF1323B1718D92A.quest_desc: ["This quest asks for Sphere of Self Sacrifice. EMI shows the recipe if you press R while hovering over it."]
	quest.2EF1323B1718D92A.quest_subtitle: "Obtain Sphere of Self Sacrifice"
	quest.2EF5B5BBFC3960D1.quest_desc: ["The Cursed Pyramid from Cataclysm is a large dungeon that rarely generates in Desert biomes and is the home of the Ancient Remnant. Expect traps, hidden chambers, Koboletons, Kobolediators, Wadjet and good loot." "Craft the Eye of Desert to point toward the nearest one."]
	quest.2EF5B5BBFC3960D1.title: "Cursed Pyramid"
	quest.2EFB7C0BB0992BCF.quest_desc: ["Transfers source from jars within 5 blocks that are not linked."]
	quest.2EFB7C0BB0992BCF.quest_subtitle: "Obtain Relay Collector"
	quest.2F0063EFF941FA8A.quest_desc: ["Bring Ghast Sourdough into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2F0063EFF941FA8A.quest_subtitle: "Obtain Ghast Sourdough"
	quest.2F02E4C86BE994F2.quest_desc: ["Parchments are used to create spells at the scribe's table."]
	quest.2F02E4C86BE994F2.quest_subtitle: "Obtain Blank Parchment"
	quest.2F03AA4B82241628.quest_desc: ["This quest asks for Coconut Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.2F03AA4B82241628.quest_subtitle: "Obtain Coconut Sapling"
	quest.2F070A65778E6176.quest_desc: ["Mage blooms are used to create source and magebloom fiber. They are also used in crafting potions of spell damage."]
	quest.2F070A65778E6176.quest_subtitle: "Obtain Magebloom Crop"
	quest.2F08028A906BF599.quest_desc: ["Changes the initial health of spawned mobs, for easier or tougher farms."]
	quest.2F08028A906BF599.quest_subtitle: "Obtain Initial Health Spawner Rune"
	quest.2F08028A906BF599.title: "Initial Health Spawner Rune"
	quest.2F0E2CECFB76D915.quest_desc: ["This quest asks for Ender Gate Nitro. EMI shows the recipe if you press R while hovering over it."]
	quest.2F0E2CECFB76D915.quest_subtitle: "Obtain Ender Gate Nitro"
	quest.2F10826047FC0333.quest_desc: ["Craft the Naga Scale Tunic from scales dropped by the Naga. It is light chest armor with solid protection for early exploration." "It is the first unique armor set in the Twilight Forest."]
	quest.2F10826047FC0333.quest_subtitle: "Obtain Naga Chestplate"
	quest.2F1946FD2029D1CE.quest_desc: ["This quest asks for Living Flesh. EMI shows the recipe if you press R while hovering over it."]
	quest.2F1946FD2029D1CE.quest_subtitle: "Obtain Living Flesh"
	quest.2F2B8F5566C164E7.quest_desc: ["Generates source from nearby mob deaths and animal breeding."]
	quest.2F2B8F5566C164E7.quest_subtitle: "Obtain Vitalic Sourcelink"
	quest.2F2E9022F2636786.quest_desc: ["The leggings of the Diamond armor set. Together with the chestplate, they unlock the helmet."]
	quest.2F3D85386518130B.quest_desc: ["Right-click a furnace to copy its settings, then shift right-click another one to paste them."]
	quest.2F3D85386518130B.quest_subtitle: "Obtain Item Copy"
	quest.2F4604D007BADC7E.quest_desc: ["It looks like cake, but it is not. Check the chests of a Dark Tower."]
	quest.2F4604D007BADC7E.quest_subtitle: "Find Experiment 115"
	quest.2F5488A8E6E13C45.quest_desc: ["The Blank Pattern is used to make crafting recipes automated. You must encode the Blank Pattern in the Pattern Encoder, then place it into a Pattern Provider."]
	quest.2F5488A8E6E13C45.quest_subtitle: "Obtain Blank Pattern"
	quest.2F59CE1A4C5472E9.quest_desc: ["Bring Silver Fir Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2F59CE1A4C5472E9.quest_subtitle: "Obtain Silver Fir Sapling"
	quest.2F5C45CE820FBB48.quest_desc: ["Using the Scroll Forge and a Divine Pearl to craft a Holy Scrolls which are good for healing and effects."]
	quest.2F5C45CE820FBB48.quest_subtitle: "Obtain Scroll"
	quest.2F62A706BD64D864.quest_desc: ["Generates power from coal at 80 FE/t."]
	quest.2F62A706BD64D864.quest_subtitle: "Obtain Furnator Basic"
	quest.2F6A5150A6659166.quest_desc: ["Get hold of Wild Cherry Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.2F6A5150A6659166.quest_subtitle: "Obtain Wild Cherry Sapling"
	quest.2F6D3F23A386C4A7.quest_desc: ["Bookwyrms can come to life by using your charm on a lectern. Bookwyrms can be dyed."]
	quest.2F6D3F23A386C4A7.quest_subtitle: "Obtain Bookwyrm Charm"
	quest.2F80AE3986AA6F1E.quest_desc: ["This quest asks for Rice Roll Medley Block. EMI shows the recipe if you press R while hovering over it."]
	quest.2F80AE3986AA6F1E.quest_subtitle: "Obtain Rice Roll Medley Block"
	quest.2F813EC1C3F612D3.quest_desc: ["A basic portable bank with 9 slots, holding up to 256 items."]
	quest.2F813EC1C3F612D3.quest_subtitle: "Your first Bank"
	quest.2F8863FE62B8F318.quest_desc: ["Bring Music Disc Creator Music Box into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2F8863FE62B8F318.quest_subtitle: "Obtain Music Disc Creator Music Box"
	quest.2F89C13D2217724A.quest_desc: ["Right-click a bee to add it to the filter, and put the filter in a crafting grid to clear it. Only the bees on the filter can enter the hive."]
	quest.2F89C13D2217724A.quest_subtitle: "Obtain Upgrade Entity Filter"
	quest.2F8E6FBA4F3E20E9.quest_desc: ["This quest asks for Network Tool. EMI shows the recipe if you press R while hovering over it."]
	quest.2F8E6FBA4F3E20E9.quest_subtitle: "Obtain Network Tool"
	quest.2F93E8EFEAF5F042.quest_desc: ["Bring Energy Cell Niotic into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.2F93E8EFEAF5F042.quest_subtitle: "Obtain Energy Cell Niotic"
	quest.2F98029090E48C1A.quest_desc: ["The first piece of the Imperium armor set. Get the boots to unlock the chestplate and leggings."]
	quest.2F9B0F159322A622.quest_desc: ["The first piece of the Knightmetal armor set. Get the boots to unlock the chestplate and leggings."]
	quest.2FB679F6448E58BB.quest_desc: ["Reach this goal to earn the Copper Trophy."]
	quest.2FB679F6448E58BB.quest_subtitle: "Catch 25 common fish"
	quest.2FCA4AF4F12BEAB4.quest_desc: ["The chestplate of the Knightmetal armor set. Together with the leggings, it unlocks the helmet."]
	quest.2FD1A4027A379DF3.quest_desc: ["The Terminite Hammer is a heavy tool and weapon forged from Terminite Ingots. It works at the Anvil and delivers strong knockback in combat." "Terminite is made by smelting a Thallasium Ingot with End Dust in an End Stone Smeltery."]
	quest.2FD1A4027A379DF3.quest_subtitle: "Obtain Terminite Hammer"
	quest.2FD643F010F6BE93.quest_desc: ["Get hold of Dye Seeds. Hover over it in EMI and press R to see how it is made."]
	quest.2FD643F010F6BE93.quest_subtitle: "Obtain Dye Seeds"
	quest.2FD6D67A89093511.quest_desc: ["Haunted pots in the Ancient Temple drop Gloomsherds. Collect any one of them." "They can be combined into a Decorated Pot as a keepsake from the Otherside."]
	quest.2FD6D67A89093511.quest_subtitle: "Obtain Smart Filter"
	quest.2FD6D67A89093511.title: "Gloomsherds"
	quest.2FE2CA7C9DACA357.quest_desc: ["Like Smart Observers can observe both whats in front of them or the contents of what’s in front of them, Train Observers can observe passing trains or even their cargo."]
	quest.2FE2CA7C9DACA357.quest_subtitle: "Obtain Track Observer"
	quest.2FEE2E40891D99EB.title: "Trade with the pope"
	quest.2FF0F7CB24BA2E89.quest_desc: ["The Deepshelf is an awakened Dormant Deepshelf, made through Infusion." "It gives +5 Eterna (up to 70), +5 Quanta and +5 Arcana, and is the base for the Echoing and Soul-Touched shelves."]
	quest.2FF0F7CB24BA2E89.quest_subtitle: "Obtain Deepshelf"
	quest.2FF811C77AC3A218.quest_desc: ["Brass is an alloy of Copper and Zinc, and you need to visit the Nether to prepare for it. Bring several empty Blaze Burners, which you can use on a Blaze Spawner to capture as many blazes as you have burners. With Brass you can craft the Deployer, which performs normal player actions, and smarter versions of the basic machines."]
	quest.2FF811C77AC3A218.quest_subtitle: "Obtain Brass Ingot"
	quest.301AB83CA2B4E3C6.quest_desc: ["Scarecrow Boots are part of the Scarecrow Armor set in Iron's Spells 'n Spellbooks. They give +3 Armor and +75 Max Mana." "They are crafted from Hay Bales."]
	quest.301AB83CA2B4E3C6.quest_subtitle: "Obtain Pumpkin Boots"
	quest.301D72ED46635A99.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.301D72ED46635A99.quest_subtitle: "Obtain Glyph Cut"
	quest.301F789B908303AE.quest_desc: ["The Stirling Engine from Create: Dreams n' Desires converts heat into rotational power. A temperature difference produces mechanical energy, giving your Create factory another power source."]
	quest.301F789B908303AE.quest_subtitle: "Obtain Stirling Engine"
	quest.302674153BDDF460.quest_desc: ["The core component of a Spawner. Insert into a Pressurized Spawner to generate mobs from the essence stored within. Spawner Cores taken from a Vanilla Spawner contain the pure essence of one specific creature."]
	quest.302674153BDDF460.quest_subtitle: "Obtain Spawner Core"
	quest.3036BFDABC136E2B.quest_desc: ["Get hold of Glowstone Nest. Hover over it in EMI and press R to see how it is made."]
	quest.3036BFDABC136E2B.quest_subtitle: "Obtain Glowstone Nest"
	quest.305698D91ED0F51B.quest_desc: ["Get hold of Player Transmitter Starter. Hover over it in EMI and press R to see how it is made."]
	quest.305698D91ED0F51B.quest_subtitle: "Obtain Player Transmitter Starter"
	quest.305B45830330885C.quest_desc: ["Get hold of Ender Gate Blazing. Hover over it in EMI and press R to see how it is made."]
	quest.305B45830330885C.quest_subtitle: "Obtain Ender Gate Blazing"
	quest.305EFC585DACDFAE.quest_desc: ["Bring Wraithfang into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.305EFC585DACDFAE.quest_subtitle: "Obtain Wraithfang"
	quest.306C2470CBF8206C.quest_desc: ["Get hold of Noodle Soup. Hover over it in EMI and press R to see how it is made."]
	quest.306C2470CBF8206C.quest_subtitle: "Obtain Noodle Soup"
	quest.307636D95097C040.quest_desc: ["Allows moving of source between source jars and source relays."]
	quest.307636D95097C040.quest_subtitle: "Obtain Relay"
	quest.307849B01B174A88.quest_desc: ["The Burner Stock from Create: Dreams n' Desires is a part used in heat-based machinery. Add it to your setup to support more advanced heating and processing systems."]
	quest.307849B01B174A88.quest_subtitle: "Obtain Burner"
	quest.30819B5772C4DF62.quest_desc: ["What it says on the tin: the way to link inventories to other specific Create compontents."]
	quest.30819B5772C4DF62.quest_subtitle: "Obtain Stock Link"
	quest.3085BC970DAA25B1.quest_desc: ["Deals significantly more damage than Standard Ammo. Its large mass results in a very short range and causes the Minigun to use air at an increased rate."]
	quest.3085BC970DAA25B1.quest_subtitle: "Obtain Gun Ammo Weighted"
	quest.308BEF9DEAC0126E.quest_desc: ["The Amethyst Crab from Cataclysm is a crystal-covered creature that fiercely guards its nest." "Defeat it to clear the Amethyst Nest."]
	quest.308BEF9DEAC0126E.quest_subtitle: "Defeat Amethyst Crab"
	quest.308BEF9DEAC0126E.title: "Amethyst Crab"
	quest.309428F9208349F2.quest_desc: ["The Cursed Garden is a maze-like, overgrown structure in Eternal Starlight where the Lunar Monstrosity hides." "To find it, hold the Seeking Eye with a natural item from the dimension in your off-hand."]
	quest.309428F9208349F2.title: "Cursed Garden"
	quest.30AFA497560FB721.quest_desc: ["This works like the Item Collector but it takes EXP instead which you can input and output manually with a button, you can also click it with a bucket to get Liquid EXP."]
	quest.30AFA497560FB721.quest_subtitle: "Obtain Experienceholder"
	quest.30B86F77CA5C2FFA.quest_desc: ["The Experience Hatch from Create: Enchantment Industry connects directly to fluid storage. You can store your own experience as Liquid Experience and take it back from the tank later." "It has a configurable filter and handles up to 1000 experience points per interaction."]
	quest.30B86F77CA5C2FFA.quest_subtitle: "Obtain Experience Hatch"
	quest.30BBA584619AF960.quest_desc: ["The Naga is the first major boss of the Twilight Forest and guards the Naga Courtyard. Beating it opens the way to tougher challenges, so do not underestimate it despite its easy reputation."]
	quest.30BBA584619AF960.quest_subtitle: "Defeat Naga"
	quest.30BBA584619AF960.title: "Naga"
	quest.30BF9815A29438B9.quest_desc: ["Well, this is your upgrade! You can choose how many layers you'd like to, up to 9, and it'll output one fluid per layer! To choose which size you want to have the Distillation Tower set to, use the selector in the top left of its screen."]
	quest.30BF9815A29438B9.quest_subtitle: "Obtain Distillation Tower, 14x Clean Stainless Steel Machine Casing and Stainless Steel Machine Casing Pipe"
	quest.30BF9815A29438B9.title: "Distillation Tower"
	quest.30C4511E584730CE.quest_desc: ["The Starlit Diamond Leggings is crafted from Starlit Diamonds in Eternal Starlight." "Starlit Diamond armor gives protection comparable to Netherite, with higher armor toughness and knockback resistance."]
	quest.30C4511E584730CE.quest_subtitle: "Obtain Starlit Diamond Leggings"
	quest.30CF6161090C4235.quest_desc: ["The Mechanical Fusion Anvil from Cataclysm is a crafting station that combines high-tier weapons, armor and rare materials into upgraded equipment." "Craft it with 6 Witherite Ingots, 2 Blocks of Redstone and an Anvil."]
	quest.30CF6161090C4235.quest_subtitle: "Obtain Mechanical Fusion Anvil"
	quest.30CF6161090C4235.title: "Mechanical Fusion Anvil"
	quest.30D4D2147884C2B4.quest_desc: ["Get hold of Solar Panel Hardened. Hover over it in EMI and press R to see how it is made."]
	quest.30D4D2147884C2B4.quest_subtitle: "Obtain Solar Panel Hardened"
	quest.30D6B1F91FB638C1.quest_desc: ["Get hold of Music Disc Chirp. Hover over it in EMI and press R to see how it is made."]
	quest.30D6B1F91FB638C1.quest_subtitle: "Obtain Music Disc Chirp"
	quest.30DB1AB65A76F0CB.quest_desc: ["The Shattered drops Sculk Bones." "They are needed for the Sonorous Staff and the Soul Elytra."]
	quest.30DB1AB65A76F0CB.quest_subtitle: "Obtain Sculk Bone"
	quest.30E377E1346D2C28.quest_desc: ["This quest asks for Ferricore Sword. EMI shows the recipe if you press R while hovering over it."]
	quest.30E377E1346D2C28.quest_subtitle: "Obtain Ferricore Sword"
	quest.30F62E1EACE6F8DE.quest_desc: ["Get hold of Lens of Ender. Hover over it in EMI and press R to see how it is made."]
	quest.30F62E1EACE6F8DE.quest_subtitle: "Obtain Lens of Ender"
	quest.30FBC8E1D2BC86DC.quest_desc: ["Forge the Aeternium Ingot in an End Stone Smeltery from a Terminite Ingot and a Netherite Ingot. You may also find it as rare loot in structures such as the End Village." "It is Better End's strongest material and makes gear better than Netherite."]
	quest.30FBC8E1D2BC86DC.quest_subtitle: "Obtain Aeternium Ingot"
	quest.3101B52EA9E2145C.quest_desc: ["A Pattern Provider supplies encoded patterns to adjacent inventories or machines. It is a key part of connecting external processing to ME autocrafting."]
	quest.31030170FC80FA6F.quest_desc: ["Remember, keep your drygmy happy."]
	quest.31030170FC80FA6F.quest_subtitle: "Obtain Drygmy Charm"
	quest.3103720E88BE03C9.quest_desc: ["This quest asks for Cyanite Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.3103720E88BE03C9.quest_subtitle: "Obtain Cyanite Seeds"
	quest.31155A6522F0DC95.quest_desc: ["Earn the advancement: Electric Blast Furnace."]
	quest.31155A6522F0DC95.quest_subtitle: "Earn the advancement: Electric Blast Furnace"
	quest.3120166ED1297774.quest_desc: ["The Nugget of Experience is a compact form of experience from Create: Enchantment Industry. You can get it through Create's automated processing and convert it into Liquid Experience." "It is useful for storing and transporting experience in your factory, and it appears in recipes that need concentrated experience."]
	quest.3120166ED1297774.quest_subtitle: "Obtain Experience Nugget"
	quest.3122DA2A0A19B66B.quest_desc: ["Bring Whisperwind into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3122DA2A0A19B66B.quest_subtitle: "Obtain Whisperwind"
	quest.31296273903A43C5.quest_desc: ["Darker and cooler than Iron.. Plus about 1000 times stronger. It's time to make some Steel! Use that coal coke you produced earlier and crush it down to a pile of dust. Then, combine that with iron dust to get your Uncooked Steel Dust. Remember, using the Mixer will increase your output. Now, remember the finest steel has to go through the hottest fire; so we'll be using the Steam Blast Furnace to reach the extreme temperatures required to melt down the powdered mixture and fuse them together. Now that you have obtained steel, you can upgrade your bronze machines with Steel Machine Upgrades. Steel machines can process recipes up to 4 EU/t and will process recipes at twice the speed than normal as long as the energy usage doesn't go above 4 EU/t. With this higher roof of energy usage, you might be able to make new things now."]
	quest.31296273903A43C5.quest_subtitle: "Obtain Steel Ingot"
	quest.31296273903A43C5.title: "Your First Steel!"
	quest.312EC5131F64186F.quest_desc: ["Enchanter's tools can be given a spell at the Scribe's Table. The Bow benefits from Endless Quiver, and the Crossbow works well for mining when paired with Split arrow."]
	quest.312EC5131F64186F.quest_subtitle: "Obtain Spell Bow and Spell Crossbow"
	quest.31336C51580290B8.quest_desc: ["The Aeternium Shovel is a top-tier digging tool with the best durability in Better End's tool line." "Craft it with an Aeternium Anvil and a Netherite or Aeternium Smith Hammer."]
	quest.31336C51580290B8.quest_subtitle: "Obtain Aeternium Shovel"
	quest.313AC630F7B7BCAA.quest_desc: ["This quest asks for Sword on a Stick. EMI shows the recipe if you press R while hovering over it."]
	quest.313AC630F7B7BCAA.quest_subtitle: "Obtain Sword on a Stick"
	quest.313D8C953BAF5B2E.quest_desc: ["The Modification Station is used for applying modular upgrades to the Meka-Suit in exchange for energy."]
	quest.313D8C953BAF5B2E.quest_subtitle: "Obtain Modification Station"
	quest.313E5D7958A2BC77.quest_desc: ["The Engineer's Hammer is the most useful tool in this chapter. Use it to assemble multiblocks such as the Coke Oven and Blast Furnace."]
	quest.313E5D7958A2BC77.quest_subtitle: "Obtain Hammer"
	quest.313E91CFDF8ADF39.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.313E91CFDF8ADF39.quest_subtitle: "Obtain Glyph Place Block"
	quest.314673C5F21DB29B.quest_desc: ["Make the Enchanted Membrane with an Infusion Ritual: place a Phantom Membrane and four Crystal Shards around an Infusion Pedestal." "You need it to infuse a regular Elytra into the Crystalite Elytra."]
	quest.314673C5F21DB29B.quest_subtitle: "Obtain Enchanted Membrane"
	quest.314673C5F21DB29B.title: "Enchanted Membrane"
	quest.3159641C57C3F661.quest_desc: ["This is the top insulated tier, since there is no insulated HV wire."]
	quest.3159641C57C3F661.quest_subtitle: "Obtain 4x Wirecoil Electrum Ins"
	quest.316639E7D35449CF.quest_desc: ["Main component used for crafting FE Storage Cells, which you can use to store FE in your ME system."]
	quest.316639E7D35449CF.quest_subtitle: "Obtain Core 1k"
	quest.3166FB4E96BD4B34.quest_desc: ["It is in the troll caves and lets you burn away the thorn barriers."]
	quest.3166FB4E96BD4B34.quest_subtitle: "Find the Lamp of Cinders"
	quest.31678122A7EAF3CE.quest_desc: ["This quest asks for Chilidog. EMI shows the recipe if you press R while hovering over it."]
	quest.31678122A7EAF3CE.quest_subtitle: "Obtain Chilidog"
	quest.31692F3E64CDC0F3.quest_desc: ["The Alternator is a key machine in Create Crafts and Additions. It turns Create's rotational power into Forge Energy (FE), so your kinetic machinery can generate electricity." "It needs at least 32 RPM and has a 5 kFE internal buffer. In version 1.6.0 for NeoForge 1.21.1, it has shaft connections on both sides, which makes it easier to fit into a setup."]
	quest.31692F3E64CDC0F3.quest_subtitle: "Obtain Alternator"
	quest.31762B3FF40814C2.title: "The Walking Dead"
	quest.317BA35A84E61CEB.quest_desc: ["To begin spell casting, you will need to first obtain a spellbook. A spellbook will allow you to create, store, and cast spells using spell mana. You can also dye your spell book by placing dye next to the spell book in the crafting grid."]
	quest.317BA35A84E61CEB.quest_subtitle: "Obtain Novice Spell Book"
	quest.317BA35A84E61CEB.title: "Novice Spell Book"
	quest.317BB6EF9816D31B.quest_desc: ["The Speed Upgrade will decrease the time a bee spends inside the hive."]
	quest.317BB6EF9816D31B.quest_subtitle: "Obtain Upgrade Time"
	quest.317C21DFF6448046.quest_desc: ["Craft with FE Storage Components to store power."]
	quest.317C21DFF6448046.quest_subtitle: "Obtain Fe Cell Housing"
	quest.3187473363009CC3.quest_desc: ["Fluid flow from mechanical rotation! Can work in parallel to increase fluid flow, or spaced out in series to push flows over long pipe runs."]
	quest.3187473363009CC3.quest_subtitle: "Obtain Mechanical Pump"
	quest.3187B46018DB409A.quest_desc: ["The Productivity upgrade will increase the number of combs a bee produces per trip. Multiple productivity upgrades can be installed."]
	quest.3187B46018DB409A.quest_subtitle: "Obtain Upgrade Productivity"
	quest.3190B245725F2518.quest_desc: ["Get hold of Spawn Egg Configurable Bee. Hover over it in EMI and press R to see how it is made."]
	quest.3190B245725F2518.quest_subtitle: "Obtain Spawn Egg Configurable Bee"
	quest.3191B05E172A7ED6.quest_desc: ["This quest asks for Pressurizer. EMI shows the recipe if you press R while hovering over it."]
	quest.3191B05E172A7ED6.quest_subtitle: "Obtain Pressurizer"
	quest.3191B05E172A7ED6.title: "Under Pressure"
	quest.3192E33EC2F3001B.quest_desc: ["Earn the advancement: Aether Sleep."]
	quest.3192E33EC2F3001B.quest_subtitle: "Earn the advancement: Aether Sleep"
	quest.3194F0186360E5DC.quest_desc: ["Thermodynamic Conductors are a way of transporting heat. Insulation: 8,000."]
	quest.3194F0186360E5DC.quest_subtitle: "Obtain Elite Thermodynamic Conductor"
	quest.31A0C98EA03E4641.quest_desc: ["The Advanced Card is a crafting component used to craft Upgrades."]
	quest.31A0C98EA03E4641.quest_subtitle: "Obtain Advanced Card"
	quest.31A0C98EA03E4641.title: "Advanced Upgrades"
	quest.31A2BA9F565C32E3.quest_desc: ["This machine allows heat to purify matter into Alchemical Mercury. Place a Pyromantic Brazier below the Distiller and fuel it with furnace fuel to provide heat. Fuels last twice as long as in a Furnace."]
	quest.31A2BA9F565C32E3.quest_subtitle: "Obtain Distiller and Pyromantic Brazier"
	quest.31A75C935A136873.quest_desc: ["Better than you model train tracks: straights, curves (two kinds), and slopes, works across Nether portals and unloaded chunks too!"]
	quest.31A75C935A136873.quest_subtitle: "Obtain Track"
	quest.31B09F8305099DAD.quest_desc: ["L2 Weaponry adds additional weapons and combat options. Explore its weapon range and compare their strengths with the other gear available in the pack."]
	quest.31B09F8305099DAD.title: "Getting Started"
	quest.31B4BD2DEDFB9DDC.quest_desc: ["The Tesla Coil is an advanced machine from Create Crafts and Additions. It uses Forge Energy to charge compatible electrical items and can shock Players and Mobs." "In version 1.6.0 for NeoForge 1.21.1, it gives off light while active and shows its remaining run time correctly when energy runs low."]
	quest.31B4BD2DEDFB9DDC.quest_subtitle: "Obtain Tesla Coil"
	quest.31C37E1C303C56D5.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.31C37E1C303C56D5.quest_subtitle: "Obtain Advanced Infusing Factory"
	quest.31C886EEA4BF364B.quest_desc: ["The Golem Steel Greatsword is a heavy weapon crafted from Golem Steel Ingots in Eternal Starlight." "The ingots come from the Starlight Golem fight, and the weapon belongs to the mod's advanced tier."]
	quest.31C886EEA4BF364B.quest_subtitle: "Obtain Golem Steel Greatsword"
	quest.31C886EEA4BF364B.title: "Golem Steal Greatsword"
	quest.31D65AD46BB61FCC.quest_desc: ["The Solar Generator harnesses sunlight to create power."]
	quest.31D65AD46BB61FCC.quest_subtitle: "Obtain Solar Generator"
	quest.31D82BC4F5B81732.quest_desc: ["Unusual End adds new discoveries and content to End exploration. Travel beyond the main island and look for its unusual additions."]
	quest.31D82BC4F5B81732.title: "Getting Started"
	quest.31D98C2CF9F82426.quest_desc: ["A Wind Turbine's giant blades harness the force of the wind to generate power. Each Wind Turbine requires a fairly large 1x1x5 area. The machine will generate power day and night, in sun or rain, but the turbine must have a clear view of the sky (over the rotor housing at the top of the tower)."]
	quest.31D98C2CF9F82426.quest_subtitle: "Obtain Wind Generator"
	quest.31E3A018A97F5817.quest_desc: ["Get hold of Sunfire. Hover over it in EMI and press R to see how it is made."]
	quest.31E3A018A97F5817.quest_subtitle: "Obtain Sunfire"
	quest.31E82CD01EAD4B67.quest_desc: ["Get hold of Energy Cable Spirited. Hover over it in EMI and press R to see how it is made."]
	quest.31E82CD01EAD4B67.quest_subtitle: "Obtain Energy Cable Spirited"
	quest.31EA548BE2CEA33C.quest_desc: ["Blocks of blaze ember can be transformed into raw voidflame coal. 3–4 voidflame coals will drop. Burns 27x more items than coal."]
	quest.31EA548BE2CEA33C.quest_subtitle: "Obtain Coal T3"
	quest.31EBB7995663A627.quest_desc: ["Fills vanilla fluid containers and applies fluids to items in sequenced recipes."]
	quest.31EBB7995663A627.quest_subtitle: "Obtain Spout"
	quest.31F03335093C0F41.quest_desc: ["It drops from the Snow Queen. It shoots three arrows at once but uses only one arrow and one point of durability."]
	quest.31F03335093C0F41.quest_subtitle: "Get the Tri-Bow"
	quest.31F03335093C0F41.title: "The Tri-Bow"
	quest.31FC442BAEF7FE35.quest_desc: ["Earn the advancement: Obtain Egg."]
	quest.31FC442BAEF7FE35.quest_subtitle: "Earn the advancement: Obtain Egg"
	quest.31FC442BAEF7FE35.title: "Don't Count Your Moas..."
	quest.3215E5C6BAB9BA51.quest_desc: ["The Actuator's storage space is limited by default. Stabilizers strengthen its link to the storage dimension so it can store more."]
	quest.3215E5C6BAB9BA51.quest_subtitle: "Obtain Storage Stabilizer Tier1"
	quest.321FA1030481627D.quest_desc: ["Bring Energizing Rod Basic into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.321FA1030481627D.quest_subtitle: "Obtain Energizing Rod Basic"
	quest.32272E9BD1620B62.quest_desc: ["Bring Player Transmitter Spirited into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.32272E9BD1620B62.quest_subtitle: "Obtain Player Transmitter Spirited"
	quest.32289832E2276DEE.quest_desc: ["This quest asks for Cabbage Rolls. EMI shows the recipe if you press R while hovering over it."]
	quest.32289832E2276DEE.quest_subtitle: "Obtain Cabbage Rolls"
	quest.322BD88DD2CCDB7D.quest_desc: ["Use this to download saved Schematics into a new Schematic ready for use in the Schematicannon."]
	quest.322BD88DD2CCDB7D.quest_subtitle: "Obtain Schematic Table"
	quest.323DC671CF4F16C8.quest_desc: ["This quest asks for Cell Component 256m. EMI shows the recipe if you press R while hovering over it."]
	quest.323DC671CF4F16C8.quest_subtitle: "Obtain Cell Component 256m"
	quest.323F4F419BF296EB.quest_desc: ["The Electromancer Robe is the chestpiece of the Electromancer Armor set in Iron's Spells 'n Spellbooks. It gives +8 Armor, +125 Max Mana, +10% Lightning Spell Power and +5% Spell Power, and can hold 1 imbued spell." "Craft it from 8 Arcane Cloth and 1 Lightning Rune, or upgrade Wizard Robes with 1 Lightning Rune at a Smithing Table in supported versions."]
	quest.323F4F419BF296EB.quest_subtitle: "Obtain Electromancer Chestplate"
	quest.3243ADA9881FFFBA.quest_desc: ["Use it to make fish fillets. The amount you get depends on the type of fish."]
	quest.3243ADA9881FFFBA.quest_subtitle: "Obtain Stone Fillet Knife"
	quest.32530CEA82AB0E41.quest_desc: ["When a Diamond is thrown into Spiritfire, it becomes a Spirit Attuned Gem. You may need several."]
	quest.32530CEA82AB0E41.quest_subtitle: "Obtain Spirit Attuned Gem"
	quest.325684F0DECF5279.quest_desc: ["Get hold of Ant. Hover over it in EMI and press R to see how it is made."]
	quest.325684F0DECF5279.quest_subtitle: "Obtain Ant"
	quest.325B68626F132E68.quest_desc: ["Bring Furnace Heater into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.325B68626F132E68.quest_subtitle: "Obtain Furnace Heater"
	quest.325B68626F132E68.title: "Heater"
	quest.325E280DC8B94661.quest_desc: ["This quest asks for Netherite Diving Helmet, Netherite Diving Boots and Netherite Backtank. EMI shows the recipe if you press R while hovering over it."]
	quest.325E280DC8B94661.quest_subtitle: "Obtain Netherite Diving Helmet, Netherite Diving Boots and Netherite Backtank"
	quest.3261FFB968EAC0BE.quest_desc: ["Bring Source Berry Roll into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3261FFB968EAC0BE.quest_subtitle: "Obtain Source Berry Roll"
	quest.326C6166A14D641E.quest_desc: ["Flux Cores are the main crafting ingredient for Flux Networks blocks and items. The mod's GitHub wiki explains the rest of the system."]
	quest.326C6166A14D641E.quest_subtitle: "The core ingredient for Flux Networks parts"
	quest.326C6166A14D641E.title: "Flux Core"
	quest.3278039B863183CA.quest_desc: ["This especially pure variant of gold is used to alter the tier of a Sulfur."]
	quest.3278039B863183CA.quest_subtitle: "Obtain Purified Gold"
	quest.328C0C155E200159.quest_desc: ["Used in the creation of some glyphs."]
	quest.328C0C155E200159.quest_subtitle: "Obtain Air Essence"
	quest.3292947ABEE0A4E1.quest_desc: ["This quest asks for Leafy Mantle. EMI shows the recipe if you press R while hovering over it."]
	quest.3292947ABEE0A4E1.quest_subtitle: "Obtain Leafy Mantle"
	quest.3294B8900265CCA9.quest_desc: ["Bring Giant Isopod Bucket into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3294B8900265CCA9.quest_subtitle: "Obtain Giant Isopod Bucket"
	quest.329F1E681C42CFB1.quest_desc: ["The Malarite Sword is an early-game weapon in Eternal Starlight, crafted from Malarite found in the Dark Swamp." "It uses a simple crafting table recipe and belongs to the basic tier."]
	quest.329F1E681C42CFB1.quest_subtitle: "Obtain Malarite Sword"
	quest.32A04231A48EA796.quest_desc: ["The Thermal Evaporation Plant turns fluids into other fluids, like water into brine, using heat. Heat can be provided by nature, solar generators, or pumped in via thermodynamic conductors."]
	quest.32A04231A48EA796.quest_subtitle: "Obtain Thermal Evaporation Controller, 37x Thermal Evaporation Block, 2x Thermal Evaporation Valve and Reactor Glass"
	quest.32A5E703872CCE2B.quest_desc: ["Variants to find: Grassy, Mangrove, Mushroom and Stone."]
	quest.32A5E703872CCE2B.quest_subtitle: "Find all 4 Igloo variants"
	quest.32A9B3832AEDC785.quest_desc: ["Increases Lure and Luck of the Sea by 1 level."]
	quest.32A9B3832AEDC785.quest_subtitle: "Obtain Anglers Hat"
	quest.32AF9959AFE16F01.quest_desc: ["Tier 3 glyph. Craft it at the Scribe\'s Table."]
	quest.32AF9959AFE16F01.quest_subtitle: "Obtain Glyph Wither"
	quest.32E04CBF495BBE0A.quest_desc: ["This Bank has 18 slots and holds up to 1,024 items."]
	quest.32E04CBF495BBE0A.quest_subtitle: "The second Bank tier"
	quest.32E47300F57547A6.quest_desc: ["This wand is used to interface with Mercurial Logistics."]
	quest.32E47300F57547A6.quest_subtitle: "Obtain Mercurial Wand"
	quest.32E515DC69DE77AB.quest_desc: ["The Flowglaze Scythe is a melee weapon from Eternal Starlight in the Flowglaze tier." "It makes sweeping attacks with extra reach and fits mid-to-late game."]
	quest.32E515DC69DE77AB.quest_subtitle: "Obtain Flowglaze Scythe"
	quest.32EE703372CE14AD.quest_desc: ["Get hold of Aspen Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.32EE703372CE14AD.quest_subtitle: "Obtain Aspen Sapling"
	quest.32F0C7917056519D.quest_desc: ["Bring Galaxy Devourer Diadem into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.32F0C7917056519D.quest_subtitle: "Obtain Galaxy Devourer Diadem"
	quest.32F20E0D4E865922.quest_desc: ["Bring Star Fruit Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.32F20E0D4E865922.quest_subtitle: "Obtain Star Fruit Sapling"
	quest.32FB208C1A8B5BA4.quest_desc: ["Get hold of Silver Seeds. Hover over it in EMI and press R to see how it is made."]
	quest.32FB208C1A8B5BA4.quest_subtitle: "Obtain Silver Seeds"
	quest.32FDFD36413FDB85.quest_desc: ["This quest asks for Honey Glazed Ham. EMI shows the recipe if you press R while hovering over it."]
	quest.32FDFD36413FDB85.quest_subtitle: "Obtain Honey Glazed Ham"
	quest.33017E6DA1051C41.quest_desc: ["Flux Blocks are another core crafting ingredient for Flux Networks parts."]
	quest.33017E6DA1051C41.quest_subtitle: "Another key ingredient for Flux Networks"
	quest.33025F7860C4A4F5.quest_desc: ["Like the Restock Upgrade, with more filtering options."]
	quest.33025F7860C4A4F5.quest_subtitle: "Obtain Advanced Restock Upgrade"
	quest.3310337281D0370D.quest_desc: ["MekaSuit can be upgraded with Modules that are installed with the Modification Station."]
	quest.3310337281D0370D.quest_subtitle: "Obtain Mekasuit Pants"
	quest.3317612046F44147.quest_desc: ["This chapter lists bosses found across the pack. Prepare your gear and food before each fight."]
	quest.3317612046F44147.title: "Getting Started"
	quest.331A6E771DAB1B22.quest_desc: ["The most basic item which most Mekanism machines and generators use. Crafted in the Metallurgic Infuser by infusing an Iron Ingot with Redstone, Redstone Blocks, or Compressed Redstone."]
	quest.331A6E771DAB1B22.quest_subtitle: "Obtain Alloy Infused"
	quest.331AD1C039607798.quest_desc: ["The Infusion Pedestal is the core block of Better End's Infusion Ritual system." "Arrange several around a central pedestal to craft items like the Enchanted Membrane, Eternal Crystal and Crystalite armor."]
	quest.331AD1C039607798.quest_subtitle: "Obtain Infusion Pedestal"
	quest.33204911A3C82A1D.quest_desc: ["Bring Prudentium Essence into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.33204911A3C82A1D.quest_subtitle: "Obtain Prudentium Essence"
	quest.332788293220EB42.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.332788293220EB42.quest_subtitle: "Obtain Advanced Enriching Factory"
	quest.332ED2065BDCF54F.quest_desc: ["Refills the backpack from an inventory you sneak and right-click."]
	quest.332ED2065BDCF54F.quest_subtitle: "Obtain Restock Upgrade"
	quest.332FD1AAE25ADA32.quest_desc: ["Defeat 10 Watchers from Cataclysm." "Hunt these mysterious creatures down one by one."]
	quest.332FD1AAE25ADA32.quest_subtitle: "Defeat The Watcher"
	quest.332FD1AAE25ADA32.title: "The Watcher"
	quest.3330F696C0664DAC.quest_desc: ["Use it to make fish fillets. The amount you get depends on the type of fish."]
	quest.3330F696C0664DAC.quest_subtitle: "Obtain Neptunium Fillet Knife"
	quest.3336D404FA43FE6E.quest_desc: ["The Thermal Springstone Sword is crafted from Thermal Springstone Ingots in Eternal Starlight." "It deals moderate damage and sets targets on fire, which works well against mobs in early to mid progression."]
	quest.3336D404FA43FE6E.quest_subtitle: "Obtain Thermal Springstone Sword"
	quest.333A6DE41D79D6D5.quest_desc: ["Multiplies the number of stacks that can fit in a slot by 16."]
	quest.333A6DE41D79D6D5.quest_subtitle: "Obtain Stack Upgrade Tier 4"
	quest.3340C174C6E33DE1.quest_desc: ["One of the top furnace tiers, with excellent speed and fuel efficiency."]
	quest.3340C174C6E33DE1.quest_subtitle: "Obtain Netherite Furnace"
	quest.33456E5CF0F18E39.quest_desc: ["Shriving Stone is a crafting material in Iron's Spells 'n Spellbooks. Use it in an Anvil or Arcane Anvil to remove Imbuements and Upgrades from gear. In newer versions, using it in the Arcane Anvil also returns the Upgrade Orbs spent on the item." "It is crafted from 1 Raw Iron and 1 Amethyst Shard."]
	quest.33456E5CF0F18E39.quest_subtitle: "Obtain Shriving Stone"
	quest.33576890BD821142.quest_desc: ["Get hold of Roast Chicken. Hover over it in EMI and press R to see how it is made."]
	quest.33576890BD821142.quest_subtitle: "Obtain Roast Chicken"
	quest.336A11862BFBEB66.quest_desc: ["Increases movement speed and step height while sprinting."]
	quest.336A11862BFBEB66.quest_subtitle: "Obtain Running Shoes"
	quest.336DD356AC4AEA0B.quest_desc: ["The Limited Oak Barrel II has more capacity than the previous tier while keeping the compact barrel design." "It is a good next step before moving on to larger containers."]
	quest.336DD356AC4AEA0B.quest_subtitle: "Obtain Limited Barrel 2"
	quest.337A07751D9BDBD3.quest_desc: ["Get hold of Magiblade. Hover over it in EMI and press R to see how it is made."]
	quest.337A07751D9BDBD3.quest_subtitle: "Obtain Magiblade"
	quest.3382EC0219E6261C.quest_desc: ["Bring Blazegold Axe into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3382EC0219E6261C.quest_subtitle: "Obtain Blazegold Axe"
	quest.33830257648B33A3.quest_desc: ["4 vessels are needed to use the Awakening Altar."]
	quest.33830257648B33A3.quest_subtitle: "Obtain 4x Essence Vessel"
	quest.33830257648B33A3.title: "Essence Vessel"
	quest.33862C4845D28C06.quest_desc: ["Spell parchment is used to write specific spells."]
	quest.33862C4845D28C06.quest_subtitle: "Obtain Spell Parchment"
	quest.338C7768B4D676D3.quest_desc: ["Up until now, you've only used Drives that held two dimensional data, in the form of zeros and ones. Now, let's hold three dimensional data, in the form of raw matter. This is a far more complex drive type, so it'll be expensive and you will not be able to store much at the start."]
	quest.338C7768B4D676D3.quest_subtitle: "Obtain Spatial Cell Component 2"
	quest.338C7768B4D676D3.title: "Small Spatial Component"
	quest.33927409CD82B688.quest_desc: ["This quest asks for Eclipsealloy Sword. EMI shows the recipe if you press R while hovering over it."]
	quest.33927409CD82B688.quest_subtitle: "Obtain Eclipsealloy Sword"
	quest.33B436FF8B860782.quest_desc: ["Get hold of Glowstone Seeds. Hover over it in EMI and press R to see how it is made."]
	quest.33B436FF8B860782.quest_subtitle: "Obtain Glowstone Seeds"
	quest.33B6251CF0B25772.quest_desc: ["Variants to find: Basalt, Birch, Crimson, Dark Forest, Desert, End, Icy, Jungle, Nether, Ocean, Savanna, Soul, Stone, Swamp, Taiga and Warped."]
	quest.33B6251CF0B25772.quest_subtitle: "Find all 16 Mineshaft variants"
	quest.33E096F228450088.quest_desc: ["Feathers, Books, and Black Dye can be transformed in Spiritfire to obtain versions more receptive to working with Spirits."]
	quest.33E096F228450088.quest_subtitle: "Obtain Taboo Book, Purified Ink and Awakened Feather"
	quest.33E096F228450088.title: "Occult Writing Materials"
	quest.33EE47ECF71BC99F.quest_desc: ["Check out the netherite versions of these and the Backtank too."]
	quest.33EE47ECF71BC99F.quest_subtitle: "Obtain Copper Diving Helmet and Copper Diving Boots"
	quest.33F1CFF65C16C509.quest_desc: ["Expands the inventory of the barrel."]
	quest.33F1CFF65C16C509.quest_subtitle: "Obtain Gold Barrel"
	quest.33F1CFF65C16C509.title: "Gold Barrel"
	quest.33FBA075A4628C59.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.33FBA075A4628C59.quest_subtitle: "Obtain Ultimate Enriching Factory"
	quest.33FCCF03F08E02B9.quest_desc: ["The Deepsilver Leggings is crafted from Deepsilver Ingots in Eternal Starlight." "Deepsilver armor raises movement speed, attack speed and knockback resistance. The full set also grants immunity to several negative status effects."]
	quest.33FCCF03F08E02B9.quest_subtitle: "Obtain Deepsilver Leggings"
	quest.33FE4F12360F4227.quest_desc: ["A glass container that displays a bee from your collection. Insert a bee cage with a hopper or pipe."]
	quest.33FE4F12360F4227.quest_subtitle: "Obtain Jar Oak"
	quest.340066CD010A55B5.quest_desc: ["Automates the smoker using items from the storage."]
	quest.340066CD010A55B5.quest_subtitle: "Obtain Auto Smoking Upgrade"
	quest.34162303439CCAC0.quest_desc: ["Priest Boots are part of the Priest Armor set in Iron's Spells 'n Spellbooks. They give +3 Armor, +125 Max Mana, +10% Holy Spell Power and +5% Spell Power." "Craft them from 4 Arcane Cloth and 1 Holy Rune, or upgrade Wizard Boots with 1 Holy Rune at a Smithing Table."]
	quest.34162303439CCAC0.quest_subtitle: "Obtain Priest Boots"
	quest.3417F7FC6DF546A5.quest_desc: ["Get hold of Large Steam Turbine. Hover over it in EMI and press R to see how it is made."]
	quest.3417F7FC6DF546A5.quest_subtitle: "Obtain Large Steam Turbine"
	quest.3417F7FC6DF546A5.title: "Enslaved Hurricane"
	quest.34185B3B860DE4E1.quest_desc: ["Make The Whispers in a Mechanical Crafter using a Warden Stick, Echo Ingot, Echo Shards, a Sculk Catalyst, a Reinforced Echo Shard and Weapon Parts." "It carries the Sonic Boom spell."]
	quest.34185B3B860DE4E1.quest_subtitle: "Obtain Whisper Staff"
	quest.34199BE9217C384D.quest_desc: ["Used to cast a spell upon yourself."]
	quest.34199BE9217C384D.quest_subtitle: "Obtain Enchanters Mirror"
	quest.3441B1B867AFBED3.quest_desc: ["Get hold of Spirited Crystal Seeds. Hover over it in EMI and press R to see how it is made."]
	quest.3441B1B867AFBED3.quest_subtitle: "Obtain Spirited Crystal Seeds"
	quest.3445CC7147DCF47E.quest_desc: ["The Harbinger from Cataclysm is a powerful ancient machine hidden deep beneath the Overworld with a devastating arsenal." "Destroy it to show you can face Cataclysm's greatest threats."]
	quest.3445CC7147DCF47E.quest_subtitle: "Defeat The Harbinger"
	quest.3445CC7147DCF47E.title: "The Harbinger"
	quest.3449A1A3E860FAF3.quest_desc: ["Bring Fuzzy Card, Speed Card, Inverter Card and Equal Distribution Card into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3449A1A3E860FAF3.quest_subtitle: "Obtain Fuzzy Card, Speed Card, Inverter Card and Equal Distribution Card"
	quest.3449A1A3E860FAF3.title: "Advanced Upgrades"
	quest.344ADE2180F485EA.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.344ADE2180F485EA.quest_subtitle: "Obtain Glyph Snare"
	quest.344EBBBE464E0E8F.quest_desc: ["A variety of Sulfur types exist, split across many tiers."]
	quest.344EBBBE464E0E8F.quest_subtitle: "Obtain Smart Filter"
	quest.344EBBBE464E0E8F.title: "Sulfurs"
	quest.3457495C63E13C2E.quest_desc: ["The Thermal Springstone Helmet is crafted from Thermal Springstone Ingots in Eternal Starlight." "Each piece of this armor ignites attackers and reduces fire damage, which suits hot, dangerous areas."]
	quest.3457495C63E13C2E.quest_subtitle: "Obtain Thermal Springstone Helmet"
	quest.345AF78BF31E5DF8.quest_desc: ["Upgrade an Infused Hellshelf with Glowstone." "It gives +5 Eterna (up to 60), +5 Quanta and a little Arcana. A solid all-round shelf."]
	quest.345AF78BF31E5DF8.quest_subtitle: "Obtain Glowing Hellshelf"
	quest.346AC6D1EC7D9BBB.quest_desc: ["This quest asks for Grilled Salmon. EMI shows the recipe if you press R while hovering over it."]
	quest.346AC6D1EC7D9BBB.quest_subtitle: "Obtain Grilled Salmon"
	quest.346F8ACE0AE44FBC.quest_desc: ["Get hold of Coil Lv. Hover over it in EMI and press R to see how it is made."]
	quest.346F8ACE0AE44FBC.quest_subtitle: "Obtain Coil Lv"
	quest.3473EB7AD69E5C5A.quest_desc: ["Steel Hatches have double the capacity of bronze hatches, increasing one inventory slot to 2, and increasing a multi-block's max steam usage rate from 2 EU/t to 4 EU/t. As long as there is a single steel fluid input hatch receiving steam, your entire multi-block is upgraded to a \"steel tier.\". Allowing multiblocks to use 4 EU/t means exactly what you think it does, it doubles the top speed of the processes. A Steel Boiler will produce twice as much steam as a bronze one. That means it will max out at 16 EU/t instead of 8. The Steel Water Pump will also produce twice as much Water as it's bronze counterpart, so a max of 250mb of Water fro every adjacent water source for up to 2000mb of Water every 5 seconds."]
	quest.3473EB7AD69E5C5A.quest_subtitle: "Obtain Steel Item Output Hatch, Steel Item Input Hatch and Steel Fluid Input Hatch"
	quest.3473EB7AD69E5C5A.title: "Steel Hatches"
	quest.3477ACB71980D035.quest_desc: ["Bring Apricot Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3477ACB71980D035.quest_subtitle: "Obtain Apricot Sapling"
	quest.34784AD607BB3907.quest_desc: ["Craft the Azure Sea Shield from Cataclysm using Lacrima and gold." "Blocking an attack can trigger a counter that knocks the attacker back, gives them Slowness II and grants you Strength II."]
	quest.34784AD607BB3907.quest_subtitle: "Obtain Azure Sea Shield"
	quest.34784AD607BB3907.title: "Azure Sea Shield"
	quest.34A2B6273E3DE229.quest_desc: ["The Chemical Washer turns Slurry into Clean Slurry using Water. The clean slurry then needs to be further refined by pumping it into a Chemical Crystallizer. Note that unlike most Mekanism machines this one has fixed \"in\" and \"out\" sides for the mineral flow. \"In\" will be on the left when first placed and \"out\" is on the right."]
	quest.34A2B6273E3DE229.quest_subtitle: "Obtain Chemical Washer"
	quest.34AE8138669FD50A.quest_desc: ["The Wizard Hat and Wizard Hood are two variants of the same Wizard Armor headpiece in Iron's Spells 'n Spellbooks. Both give +3 Armor, +125 Max Mana and +5% Spell Power." "Either one is crafted from Arcane Cloth."]
	quest.34AE8138669FD50A.quest_subtitle: "Obtain Wizard Helmet and Wizard Hat"
	quest.34C60ADD15C339EB.quest_desc: ["The chestplate of the Diamond armor set. Together with the leggings, it unlocks the helmet."]
	quest.34C78427A24B86E3.quest_desc: ["Bring Iron Fishing Rod into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.34C78427A24B86E3.quest_subtitle: "Obtain Iron Fishing Rod"
	quest.34CC359F82940541.quest_desc: ["This quest asks for Dawnquiver. EMI shows the recipe if you press R while hovering over it."]
	quest.34CC359F82940541.quest_subtitle: "Obtain Dawnquiver"
	quest.34D04E583B63CD5F.quest_desc: ["Tier 3 glyph. Craft it at the Scribe\'s Table."]
	quest.34D04E583B63CD5F.quest_subtitle: "Obtain Glyph Summon Vex"
	quest.34DDE44E60BB8B29.quest_desc: ["Collect different kinds of bait. The right bait improves your chances of catching rare and valuable fish."]
	quest.34DDE44E60BB8B29.quest_subtitle: "Obtain Smart Filter"
	quest.34DDE44E60BB8B29.title: "Baits"
	quest.34EDB874318340F6.quest_desc: ["Get hold of Hogskin. Hover over it in EMI and press R to see how it is made."]
	quest.34EDB874318340F6.quest_subtitle: "Obtain Hogskin"
	quest.34F04E98312B4F33.quest_desc: ["A handy tool that shows the fish in your surroundings."]
	quest.34F04E98312B4F33.quest_subtitle: "Craft a Fish Radar"
	quest.34F9077D00F4549F.quest_desc: ["Get hold of Celestigem Leggings. Hover over it in EMI and press R to see how it is made."]
	quest.34F9077D00F4549F.quest_subtitle: "Obtain Celestigem Leggings"
	quest.350F711BF77781A0.quest_desc: ["This quest asks for Tin Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.350F711BF77781A0.quest_subtitle: "Obtain Tin Seeds"
	quest.351240185EE70EA5.quest_desc: ["The Actuator's storage space is limited by default. Stabilizers strengthen its link to the storage dimension so it can store more."]
	quest.351240185EE70EA5.quest_subtitle: "Obtain Storage Stabilizer Tier2"
	quest.3542746A9C52E09C.quest_desc: ["Tier 3 glyph. Craft it at the Scribe\'s Table."]
	quest.3542746A9C52E09C.quest_subtitle: "Obtain Glyph Hex"
	quest.3549221506BDE70C.quest_desc: ["The Netherite Hammer is a heavy tool and weapon you need, along with the Aeternium Anvil, to forge Aeternium equipment." "Without it you cannot turn raw Aeternium into plates and tool heads."]
	quest.3549221506BDE70C.quest_subtitle: "Obtain Netherite Hammer"
	quest.356CA5DB72734326.quest_desc: ["The Second tier of Spellbook only holding 6 Spells."]
	quest.356CA5DB72734326.quest_subtitle: "Obtain Iron Spell Book"
	quest.3570964B2399D29D.quest_desc: ["Source is an important part of Ars Nouveau."]
	quest.3570964B2399D29D.quest_subtitle: "Obtain Source Jar"
	quest.357CF9A61FD926BC.quest_desc: ["Smelt Raw Ironwood, which is crafted shapeless from 1 Liveroot, 1 Iron Ingot and 1 Gold Nugget."]
	quest.357CF9A61FD926BC.quest_subtitle: "Get an Ironwood Ingot"
	quest.3581D598234958A5.quest_desc: ["Adds a stonecutter to the storage."]
	quest.3581D598234958A5.quest_subtitle: "Obtain Stonecutter Upgrade"
	quest.359970E5B5A94E26.quest_desc: ["Make the Warden Mage Chestplate in a Mechanical Crafter using a Netherite Mage Chestplate from Iron's Spells, Echo Ingots, Warden Carapace, a Reinforced Echo Shard and a Warden Upgrade Template." "Spell power and upgrades from the netherite piece are not kept."]
	quest.359970E5B5A94E26.quest_subtitle: "Obtain Warden Mage Chestplate"
	quest.35A6AB035CFF965E.quest_desc: ["The pedestal is in the Dark Forest ruins. Claim your title there."]
	quest.35A6AB035CFF965E.quest_subtitle: "Place a trophy on the pedestal"
	quest.35A6B43CE99A7691.quest_desc: ["Bring Core 64k into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.35A6B43CE99A7691.quest_subtitle: "Obtain Core 64k"
	quest.35BBD78000100029.quest_desc: ["You will need 59 more Reactor Glass blocks for a total of 123 glass blocks. The frame of the Supercritical Phase Shifter must consist of SPS Casings. The sides, bottom and top can consist of either SPS Casings, Reactor Glass or SPS Ports. In order to insert energy through a port, a Supercharged Coil has to be attached to the SPS Port on the inside of the multiblock. There are other ways of building a SPS, so be sure to look different ways up. Be warned, the more production you want, the resources and power you'll need."]
	quest.35BBD78000100029.quest_subtitle: "Obtain 60x Sps Casing, 3x Sps Port, 59x Reactor Glass and Supercharged Coil"
	quest.35C2A3FE88732660.quest_desc: ["Bring Controls into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.35C2A3FE88732660.quest_subtitle: "Obtain Controls"
	quest.35C6B2C60242EDA2.quest_desc: ["A pre-programmed Drone that collects items within a 17x17x17 area (before range upgrades) centered on the position it's deployed from. This Drone has two basic modes depending on where it is deployed in relation to its deposit inventory: Deploying on top of an inventory will filter what the Drone collects to only match items inside the inventory at the time of deployment. Deploying on the ground next to an inventory will tell the Drone to collect any items within its area."]
	quest.35C6B2C60242EDA2.quest_subtitle: "Obtain Collector Drone"
	quest.35D6F66E836AD148.quest_desc: ["The Actuator's storage space is limited by default. Stabilizers strengthen its link to the storage dimension so it can store more."]
	quest.35D6F66E836AD148.quest_subtitle: "Obtain Storage Stabilizer Tier3"
	quest.35DA27939FD74C2A.quest_desc: ["The LV Energy Input Hatch is like a giant electrical inlet. Do remember that you can upgrade the multiblock machine by replacing the Energy Input Hatch with an upgraded tier, increasing the maximum power rate for recipes and increasing overall overclocking capabilities."]
	quest.35DA27939FD74C2A.quest_subtitle: "Obtain Lv Energy Input Hatch"
	quest.35DA27939FD74C2A.title: "LV Energy Input Hatch"
	quest.35DBE69283017194.quest_desc: ["Get hold of Configurable Honeycomb. Hover over it in EMI and press R to see how it is made."]
	quest.35DBE69283017194.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.35E288DBD1B1381B.quest_desc: ["The Fluid Hatch from Create: Dreams n' Desires makes it easy to insert and extract fluids from fluid tanks, which helps in automated setups." "It was introduced alongside the Fluid Gauge in the 2.2a-BETA update for Minecraft 1.21 to 1.21.1."]
	quest.35E288DBD1B1381B.quest_subtitle: "Obtain Fluid Hatch"
	quest.35E6404B7ABD257A.quest_desc: ["This quest asks for Arcane Ingot. EMI shows the recipe if you press R while hovering over it."]
	quest.35E6404B7ABD257A.quest_subtitle: "Obtain Arcane Ingot"
	quest.35E769858BBA9F88.quest_desc: ["Upgrade a Deepshelf with a Soul Lantern and Sculk." "It gives +5 Eterna (up to 75) and +15 Quanta. Good if you want wild, high-roll enchantments."]
	quest.35E769858BBA9F88.quest_subtitle: "Obtain Soul Touched Deepshelf"
	quest.35FB1B9F7DE2B724.quest_desc: ["Makes the storage pickup items."]
	quest.35FB1B9F7DE2B724.quest_subtitle: "Obtain Pickup Upgrade"
	quest.360E2467D78EC55E.quest_desc: ["The leggings of the Prudentium armor set. Together with the chestplate, they unlock the helmet."]
	quest.361C0D7B160F5779.quest_desc: ["Bring Lime Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.361C0D7B160F5779.quest_subtitle: "Obtain Lime Sapling"
	quest.361CEF92D5D53467.quest_desc: ["Multiplies the number of items that fit in each slot by 16."]
	quest.361CEF92D5D53467.quest_subtitle: "Obtain Stack Upgrade Tier 4"
	quest.362649F35397D659.quest_desc: ["Bring Raw Stuffed Hoglin into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.362649F35397D659.quest_subtitle: "Obtain Raw Stuffed Hoglin"
	quest.362A10F8805913EE.quest_desc: ["Tier 3 glyph. Craft it at the Scribe\'s Table."]
	quest.362A10F8805913EE.quest_subtitle: "Obtain Glyph Orbit"
	quest.362CDD23E712D82C.quest_desc: ["Get hold of Black Locust Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.362CDD23E712D82C.quest_subtitle: "Obtain Black Locust Sapling"
	quest.3631E1EB82EA9014.quest_desc: ["Used with the Vacuum Trap, this machine will suck up any mobs near it and put them in a Spawner Core, for that too work you must first craft a Spawner Core and insert into the a Vacuum Trap."]
	quest.3631E1EB82EA9014.quest_subtitle: "Obtain Vacuum Trap"
	quest.363A614691A42198.quest_desc: ["Look for an Ancient City in the Deep Dark, far below the surface. Its chests can hold Echo Shards, Warden Carapace and the Warden Upgrade Template." "Be careful around Sculk Shriekers. Three shrieks will summon the Warden."]
	quest.363A614691A42198.title: "Ancient City"
	quest.36400D26EEABD70C.quest_desc: ["Variants to find: Hot Biome Land Ruin (desert), Warm Biome Land Ruin (plains), Cold Biome Land Ruin (taiga), Snowy Biome Land Ruin (snowy plains) and the Nether Ruin."]
	quest.36400D26EEABD70C.quest_subtitle: "Find all 5 ruin variants"
	quest.365016FE986E446F.quest_desc: ["Shulkers in End Cities drop Shulker Shells." "They are the ingredient for Shulker Boxes."]
	quest.365016FE986E446F.quest_subtitle: "Obtain 8x Shulker Shell"
	quest.365016FE986E446F.title: "Shulker Shell"
	quest.3651542FFED54E7A.quest_desc: ["Cultist Boots are part of the Cultist Armor set in Iron's Spells 'n Spellbooks. They give +3 Armor, +125 Max Mana, +10% Blood Spell Power and +5% Spell Power." "Craft them from 4 Arcane Cloth and 1 Blood Rune, or upgrade Wizard Boots with 1 Blood Rune at a Smithing Table in supported versions."]
	quest.3651542FFED54E7A.quest_subtitle: "Obtain Cultist Boots"
	quest.365250D4F5B19F71.quest_desc: ["Ars Nouveau provides spell crafting, magical devices, powerful trinkets, and magical entity automation."]
	quest.365250D4F5B19F71.quest_subtitle: "Obtain Worn Notebook"
	quest.36530CC20B0D2324.quest_desc: ["The upgraded Tome of Scrapping. It extracts all of an item's enchantments onto books, but still destroys the item."]
	quest.36530CC20B0D2324.quest_subtitle: "Obtain Improved Scrap Tome"
	quest.36530CC20B0D2324.title: "Superior Scrapping"
	quest.365770482E8AB3B3.quest_desc: ["Bring Fried Hoglin Chop into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.365770482E8AB3B3.quest_subtitle: "Obtain Fried Hoglin Chop"
	quest.36756F0900ABA5E4.quest_desc: ["Press Right Click on Still Water or Flowing Water to fill. Place Fuel inside the Chainsaw using Right Click. Toggle Silk Touch with Left Shift + Right Click."]
	quest.36756F0900ABA5E4.quest_subtitle: "Obtain Steam Chainsaw"
	quest.36794E2B8C235CED.quest_desc: ["Bring Ender Core into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.36794E2B8C235CED.quest_subtitle: "Obtain Ender Core"
	quest.367FFB447D28B83B.quest_desc: ["[ { \"text\": \"Join the NeoTech Reborn Discord!\", \"underlined\": true, \"clickEvent\": { \"action\": \"open_url\", \"value\": \"https://discord.gg/8Hz9qTjJaB\" }, \"color\": \"aqua\" } ]"]
	quest.367FFB447D28B83B.quest_subtitle: "Meet other players, find the community, and join the conversation."
	quest.367FFB447D28B83B.title: "Join the NeoTech Reborn Discord"
	quest.368ED8B4B5670143.quest_desc: ["Need a steamy upgrade? The Large Steam Boiler is an upgraded version of the smaller bronze and steel boilers. It uses fuel 8 times faster than the Furnace, but it produces 256 mb/t of steam when at max temperature. Make sure you don't forget to provide it Water! The main block you'll need is Bronze Plated Bricks, but you'll also need other blocks shown in your EMI. The Large Steam Boiler is comprised of one layer of Heatproof Machine Casings with layers of Bronze Plated Bricks and Pipe Machine Casings. The Controller is on the second layer, on top of the Heatproof Machine Casings. Don't forget you can use your Wrench to show the shape of the multiblock and placement of the blocks needed for it. The required hatches must be placed on the bottom layer. You'll need a way to input water and a solid fuel, as well as a way to extract Steam."]
	quest.368ED8B4B5670143.quest_subtitle: "Obtain 24x Bronze Plated Bricks, 6x Heatproof Machine Casing, Large Steam Boiler and 2x Bronze Machine Casing Pipe"
	quest.368ED8B4B5670143.title: "Large Steam Boiler"
	quest.36938B0CCC8BAAC2.quest_desc: ["Portal Fluid Catalyst plus Polymorphic Fluid makes Unstable Portal Fluid, which can only exist in the End. Unstable Portal Fluid plus a goo of tier 3 or higher makes Stable Portal Fluid."]
	quest.36938B0CCC8BAAC2.quest_subtitle: "Obtain Portal Fluid Catalyst, Unstable Portal Fluid Bucket and Portal Fluid Bucket"
	quest.3694E18A5BECA7CB.quest_desc: ["Get hold of Music Disc Mellohi. Hover over it in EMI and press R to see how it is made."]
	quest.3694E18A5BECA7CB.quest_subtitle: "Obtain Music Disc Mellohi"
	quest.369D75AC83F07817.quest_desc: ["The Glacite Leggings is crafted from Glacite materials in Eternal Starlight." "Glacite armor protects against freezing environments and slows enemies that attack you."]
	quest.369D75AC83F07817.quest_subtitle: "Obtain Glacite Leggings"
	quest.36A5438EABF3E9B1.quest_desc: ["Compacts items into their compressed versions. Only 2x2 recipes."]
	quest.36A5438EABF3E9B1.quest_subtitle: "Obtain Compacting Upgrade"
	quest.36A6D528027829C4.quest_desc: ["Get hold of Pyrolyse Oven. Hover over it in EMI and press R to see how it is made."]
	quest.36A6D528027829C4.quest_subtitle: "Obtain Pyrolyse Oven"
	quest.36ACC12F1A2913CD.quest_desc: ["Get hold of 4x Waterwheel Segment. Hover over it in EMI and press R to see how it is made."]
	quest.36ACC12F1A2913CD.quest_subtitle: "Obtain 4x Waterwheel Segment"
	quest.36B231BC87B41E01.quest_desc: ["This quest asks for Bacon Wrapped Sausage on a Stick. EMI shows the recipe if you press R while hovering over it."]
	quest.36B231BC87B41E01.quest_subtitle: "Obtain Bacon Wrapped Sausage on a Stick"
	quest.36C2663C56364BE9.quest_desc: ["Use your whirlisprig charm on a flower to bring a whirlisprig to life. You can also use dye on your whirlisprig."]
	quest.36C2663C56364BE9.quest_subtitle: "Obtain Whirlisprig Charm"
	quest.36CAF348B61E20EC.quest_desc: ["Automates the blast furnace using items from the backpack."]
	quest.36CAF348B61E20EC.quest_subtitle: "Obtain Auto Blasting Upgrade"
	quest.36DACD876BAB96A8.quest_desc: ["The Enchanting Template from Create: Enchantment Industry is used in the mod's automated enchanting system together with the Blaze Enchanter." "In newer versions, an unenchanted template has no enchantment glint, which makes it easy to tell apart from an enchanted one."]
	quest.36DACD876BAB96A8.quest_subtitle: "Obtain Enchanting Template"
	quest.36F00C19255A6B37.quest_desc: ["Get hold of Peach Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.36F00C19255A6B37.quest_subtitle: "Obtain Peach Sapling"
	quest.36F7C25EC5BD5047.quest_desc: ["This quest asks for Energy Cell Hardened. EMI shows the recipe if you press R while hovering over it."]
	quest.36F7C25EC5BD5047.quest_subtitle: "Obtain Energy Cell Hardened"
	quest.370D31482EC483FF.quest_desc: ["Earn the advancement: Hedge."]
	quest.370D31482EC483FF.quest_subtitle: "Defeat a spider in a Hedge Maze"
	quest.37136D3A987DA7C6.quest_desc: ["Get hold of Music Disc 13. Hover over it in EMI and press R to see how it is made."]
	quest.37136D3A987DA7C6.quest_subtitle: "Obtain Music Disc 13"
	quest.3713B3863DB767EA.quest_desc: ["The Terminite Upgrade Smithing Template applies Terminite-tier upgrades to compatible tools and armor at a Smithing Table." "Terminite sits between Thallasium and Aeternium and is made from Thallasium Ingots and End Dust."]
	quest.3713B3863DB767EA.quest_subtitle: "Obtain Terminite Upgrade Smithing Template"
	quest.37169E306FB35C13.quest_desc: ["Tier 2 glyph. Craft it at the Scribe\'s Table."]
	quest.37169E306FB35C13.quest_subtitle: "Obtain Glyph Heal"
	quest.371BE75622BA661A.quest_desc: ["The Block of Experience from Create: Enchantment Industry is a compact form of Liquid Experience. It works as a concentrated experience source in advanced enchanting and is part of Super Enchanting progression." "In newer versions, lightning can transform Experience Blocks as part of that progression."]
	quest.371BE75622BA661A.quest_subtitle: "Obtain Experience Block"
	quest.372F90BF0928F68D.quest_desc: ["Earn the advancement: Prevent Swet Spawning."]
	quest.372F90BF0928F68D.quest_subtitle: "Earn the advancement: Prevent Swet Spawning"
	quest.37467D6A306DD448.quest_desc: ["The Lunar Monstrosity waits at the heart of the Cursed Garden in Eternal Starlight." "It cannot be damaged normally. Its body must be ignited first, which makes it vulnerable."]
	quest.37467D6A306DD448.quest_subtitle: "Defeat Lunar Monstrosity"
	quest.37467D6A306DD448.title: "Lunar Monstrosity"
	quest.374C0B3319A67D26.quest_desc: ["Bring Advanced Upgrade into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.374C0B3319A67D26.quest_subtitle: "Obtain Advanced Upgrade"
	quest.374C0B3319A67D26.title: "Machine Speedup-Speedup"
	quest.376F5EE5E3C32048.quest_desc: ["The Omni Speed Controller from Create: Dreams n' Desires is an in-line speed controller that lets you set the rotational speed of a mechanical system precisely. It is especially handy in compact, advanced Create contraptions."]
	quest.376F5EE5E3C32048.quest_subtitle: "Obtain Omni Speed Controller"
	quest.3788D925B3F165E6.quest_desc: ["Obtain a Pulse Extender from Create. It lengthens a Redstone pulse by a configurable time so short signals can control machines and automation." "The duration ranges from 2 ticks to 60 minutes. It can also be inverted to stay powered by default and give a temporary shutdown pulse."]
	quest.3788D925B3F165E6.quest_subtitle: "Obtain Pulse Repeater"
	quest.378C1E8A428D2B58.quest_desc: ["This quest asks for Elm Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.378C1E8A428D2B58.quest_subtitle: "Obtain Elm Sapling"
	quest.37A823113CFA0238.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.37A823113CFA0238.quest_subtitle: "Obtain Basic Crushing Factory"
	quest.37C1777A017654F8.quest_desc: ["This substance can be processed in a Refinery to create various fuels, which can eventually be used to produce Plastic."]
	quest.37C1777A017654F8.quest_subtitle: "Obtain Oil Bucket"
	quest.37C4277D80E37F2A.quest_desc: ["Building Gadgets 2 provides tools for placing, copying, and modifying larger groups of blocks. Learn its gadget modes and settings before using them on a large build."]
	quest.37C4277D80E37F2A.title: "Getting Started"
	quest.37CB97FB7071E157.quest_desc: ["This quest asks for Limited Copper Barrel 2. EMI shows the recipe if you press R while hovering over it."]
	quest.37CB97FB7071E157.quest_subtitle: "Obtain Limited Copper Barrel 2"
	quest.37D84E2E11ACA2D6.quest_desc: ["Lone Star Skeletons roam Eternal Starlight and attack from range." "They can overwhelm unprepared explorers quickly, so defeating one is a good test of your readiness."]
	quest.37D84E2E11ACA2D6.quest_subtitle: "Defeat Lonestar Skeleton"
	quest.37D84E2E11ACA2D6.title: "LoneStar Skeletons"
	quest.37DB0AD3F33D5CAD.quest_desc: ["Type '@mysticalagriculture augment' into the EMI/EMI search field to bring up all the augments at your disposal."]
	quest.37DB0AD3F33D5CAD.quest_subtitle: "Obtain Unattuned Augment"
	quest.37E1F4C12703F6E6.quest_desc: ["The End Crystal heals the Ender Dragon and sits on the obsidian pillars around the arena." "It is also the base ingredient for Better End's Eternal Crystal in an Infusion Ritual."]
	quest.37E1F4C12703F6E6.quest_subtitle: "Obtain End Crystal"
	quest.37E7D3C4A742FB81.quest_desc: ["Essential for drill contraptions: a set of Mechanical Drills arranged on a horizontal plane drills down into the world."]
	quest.37E7D3C4A742FB81.quest_subtitle: "Obtain Rope Pulley"
	quest.37E8DD20B7F8288A.quest_desc: ["Adds a smoker to the backpack."]
	quest.37E8DD20B7F8288A.quest_subtitle: "Obtain Smoking Upgrade"
	quest.37F32EEFA9330F95.quest_desc: ["Increases the wearer's flatulence."]
	quest.37F32EEFA9330F95.quest_subtitle: "Obtain Whoopee Cushion"
	quest.3803DF864FB67E36.quest_desc: ["Stay clear of bare wires, because they hurt. Insulated wires solve that. This coil handles up to 2048 FE/t, so move to MV wire for anything higher."]
	quest.3803DF864FB67E36.quest_subtitle: "Obtain Wirecoil Copper"
	quest.382F5D589320AF78.quest_desc: ["Raw Amaramber is a rare material infused with starlight energy and hidden in the terrain of Eternal Starlight." "It is used for advanced crafting, so gather enough to start working with it."]
	quest.382F5D589320AF78.quest_subtitle: "Obtain 5x Raw Amaramber"
	quest.382F5D589320AF78.title: "Raw Amaramber"
	quest.383971F46FE9934E.quest_desc: ["Craft the Terminite Chestplate from Terminite Plating at a Smithing Table." "You can later upgrade it into Crystalite or Aeternium armor."]
	quest.383971F46FE9934E.quest_subtitle: "Obtain Terminite Chestplate"
	quest.383CF3C7858B7CA6.quest_desc: ["Any type of barrel counts, not just oak. Expands the inventory of the barrel."]
	quest.383CF3C7858B7CA6.quest_subtitle: "Obtain Iron Barrel"
	quest.383CF3C7858B7CA6.title: "Iron Barrel"
	quest.384A595713F8175C.quest_desc: ["Get hold of Configurable Honeycomb. Hover over it in EMI and press R to see how it is made."]
	quest.384A595713F8175C.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.3873C8BF436FA4DE.quest_desc: ["This Rod is pre-attuned to locate a Rare material."]
	quest.3873C8BF436FA4DE.quest_subtitle: "Obtain Sulfur Attuned Divination Rod Rare"
	quest.38853BDD58F19B1F.quest_desc: ["Get hold of Cell Component 64m. Hover over it in EMI and press R to see how it is made."]
	quest.38853BDD58F19B1F.quest_subtitle: "Obtain Cell Component 64m"
	quest.3889600717425DB6.quest_desc: ["Make the Warden Hoe in a Mechanical Crafter using a Netherite Hoe, Echo Ingots, a Reinforced Echo Shard and a Warden Upgrade Template."]
	quest.3889600717425DB6.quest_subtitle: "Obtain Warden Hoe"
	quest.3895C493392514BF.quest_desc: ["Bring Configurable Honeycomb into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3895C493392514BF.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.38B1659299CB5B71.quest_desc: ["The Block and Chain is a heavy weapon once used by Goblin Knights, made of an iron block on a chain. It is slow but hits with great impact." "It takes practice to use, and it works especially well against heavily armored foes and groups."]
	quest.38B1659299CB5B71.quest_subtitle: "Obtain Block and Chain"
	quest.38BDA4C04CE69387.quest_desc: ["Bring Ender Cell Basic into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.38BDA4C04CE69387.quest_subtitle: "Obtain Ender Cell Basic"
	quest.38BE233EA9E17B73.quest_desc: ["The Evocation Upgrade Orb is an upgrade material in Iron's Spells 'n Spellbooks. Applied at the Arcane Anvil, it gives +5% Evocation Spell Power." "Craft it from 1 Empty Upgrade Orb and 8 Evocation Runes."]
	quest.38BE233EA9E17B73.quest_subtitle: "Obtain Evocation Upgrade Orb"
	quest.38C3B0E3023E725B.quest_desc: ["Confluence Otherworld adds a separate world of exploration and content. Look for its route into the dimension and discover its unique environments and resources."]
	quest.38C3B0E3023E725B.title: "Getting Started"
	quest.38CDC415197910DB.quest_desc: ["The Thallasium Axe chops wood and fights. Forge it from Thallasium Ingots at an Anvil with a Smith Hammer." "It belongs to the first tier of Better End's equipment."]
	quest.38CDC415197910DB.quest_subtitle: "Obtain Thallasium Axe"
	quest.38D9A7614CB6FBF0.quest_desc: ["Foliot are the first type of spirit you will work with, and the least dangerous."]
	quest.38D9A7614CB6FBF0.quest_subtitle: "Obtain Book of Binding Foliot"
	quest.38EB9DA8E9F8A742.quest_desc: ["Bring Pie Crust into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.38EB9DA8E9F8A742.quest_subtitle: "Obtain Pie Crust"
	quest.38EDB8263D6AB5BE.quest_desc: ["This quest asks for Capacitor Nitro. EMI shows the recipe if you press R while hovering over it."]
	quest.38EDB8263D6AB5BE.quest_subtitle: "Obtain Capacitor Nitro"
	quest.38EF1D2C873C34B3.quest_desc: ["This quest asks for Wood Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.38EF1D2C873C34B3.quest_subtitle: "Obtain Wood Seeds"
	quest.390A1E2CE9B27C69.quest_desc: ["Get hold of Thread Starbuncle. Hover over it in EMI and press R to see how it is made."]
	quest.390A1E2CE9B27C69.quest_subtitle: "Obtain Thread Starbuncle"
	quest.390C6837EC35BEA1.quest_desc: ["Create a party with /ftbteams party create <name> and invite friends with /ftbteams party invite <player>. Members of a party share quest progress."]
	quest.390C6837EC35BEA1.quest_subtitle: "Parties share progress."
	quest.390C6837EC35BEA1.title: "Play with Friends"
	quest.39116B943AB5A383.quest_desc: ["Claim the rewards of this quest to get started. You receive an Eccentric Tome with the guidebooks of many mods already inside, and a Prefab House item that builds a small starting home." "If you lose the tome, you can craft it again."]
	quest.39116B943AB5A383.quest_subtitle: "Everything you need to begin."
	quest.39116B943AB5A383.title: "Starter Kit"
	quest.3922AC1B156532D3.quest_desc: ["Lets you put backpacks inside another backpack."]
	quest.3922AC1B156532D3.quest_subtitle: "Obtain Inception Upgrade"
	quest.392460E022982817.quest_desc: ["Craft the Ancient Spear from Cataclysm using Ancient Metal Ingots." "Its special ability throws a sandstorm projectile that damages enemies and applies Curse of the Desert II."]
	quest.392460E022982817.quest_subtitle: "Obtain Ancient Spear"
	quest.3942D5CA461FF632.quest_desc: ["Time to plumb the depths of Create's.. plumbing."]
	quest.3942D5CA461FF632.quest_subtitle: "Obtain Copper Ingot"
	quest.394456986E472364.quest_desc: ["Allows you to see a certain block for a period of time."]
	quest.394456986E472364.quest_subtitle: "Obtain Ritual Scrying"
	quest.39528772CF17CC45.quest_desc: ["Make the Resonarium Pickaxe in a Mechanical Crafter using a Diamond Pickaxe, Sturdy Sheets, a Resonarium Plate and a Resonarium Upgrade Template." "The template can be found in Ancient Cities, Trial Chambers and Strongholds."]
	quest.39528772CF17CC45.quest_subtitle: "Obtain Resonarium Pickaxe"
	quest.39584D8D8FF6C258.quest_desc: ["Get hold of Flamewind. Hover over it in EMI and press R to see how it is made."]
	quest.39584D8D8FF6C258.quest_subtitle: "Obtain Flamewind"
	quest.39594206DFA1F746.quest_desc: ["Consuming this fruit will open your Third Eye, allowing you to see things you otherwise could not."]
	quest.39594206DFA1F746.quest_subtitle: "Obtain Datura"
	quest.3959498A55970754.quest_desc: ["This quest asks for Processing Unit. EMI shows the recipe if you press R while hovering over it."]
	quest.3959498A55970754.quest_subtitle: "Obtain Processing Unit"
	quest.3959498A55970754.title: "Bitcoin Miner"
	quest.395A0D7134FE9513.quest_desc: ["Rotate components precisely. Open and close Fluid Valves. Dye-able."]
	quest.395A0D7134FE9513.quest_subtitle: "Obtain Smart Filter"
	quest.395EE225F6E1DB59.quest_desc: ["Earn the advancement: Naga Armors."]
	quest.395EE225F6E1DB59.quest_subtitle: "Craft Naga Scale chest and leg armor"
	quest.396366F1E72A8155.quest_desc: ["The Energizing Orb crafts the materials for the higher-end machines."]
	quest.396366F1E72A8155.quest_subtitle: "Obtain Energizing Orb"
	quest.3976EFF2C816F2DC.quest_desc: ["In addtion to being a crafting ingredient, Andesite Casing can be used to encase Shafts and Belts, and also Large and Small Cogwheels. The later use is handy for keeping compact as possible a gear train meant to raise the rpms from early power sources."]
	quest.3976EFF2C816F2DC.quest_subtitle: "Obtain Andesite Casing"
	quest.39856E4272E859D3.quest_desc: ["An upgraded Advanced Control Circuit, used in many tier 3 machines and items."]
	quest.39856E4272E859D3.quest_subtitle: "Obtain Elite Control Circuit"
	quest.39A3E80396491DE6.quest_desc: ["Your AntiMatter can be pumped out via pressurized tube and into a chemical crystalliser. There, it gets turned into pellets."]
	quest.39A3E80396491DE6.quest_subtitle: "Obtain Pellet Antimatter"
	quest.39B6DC70970412F2.quest_desc: ["Get hold of Compressed Iron Seeds. Hover over it in EMI and press R to see how it is made."]
	quest.39B6DC70970412F2.quest_subtitle: "Obtain Compressed Iron Seeds"
	quest.39B9711A2CE68FF6.quest_desc: ["Defeat a Sludge, a slime-like creature of the Otherside." "It drops Resonarium, the material for Resonarium gear."]
	quest.39B9711A2CE68FF6.quest_subtitle: "Defeat Sludge"
	quest.39B9711A2CE68FF6.title: "Sludge"
	quest.39C414E363FED29F.quest_desc: ["Get hold of Sweetgum Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.39C414E363FED29F.quest_subtitle: "Obtain Sweetgum Sapling"
	quest.39C96A0C6B300BE7.quest_desc: ["Bring Thread Life Drain into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.39C96A0C6B300BE7.quest_subtitle: "Obtain Thread Life Drain"
	quest.39E08B6E69041551.quest_desc: ["This quest asks for Sizzling Pudding. EMI shows the recipe if you press R while hovering over it."]
	quest.39E08B6E69041551.quest_subtitle: "Obtain Sizzling Pudding"
	quest.39E75FE928CCE4D1.quest_desc: ["Make a Strawberry Milkshake and fill a bucket with it. It is a sweet, refreshing drink to add to your Create: Dreams n' Desires milkshake collection."]
	quest.39E75FE928CCE4D1.quest_subtitle: "Obtain Strawberry Milkshake Bucket"
	quest.39F8E52708A4BF39.quest_desc: ["Obtain a Brass Hand from Create. It is crafted from Andesite Alloy and Brass Sheets." "It is used to make the Deployer and Extendo Grip, so it is an important step toward advanced Create machinery."]
	quest.39F8E52708A4BF39.quest_subtitle: "Obtain Brass Hand"
	quest.3A210290AA459D13.quest_desc: ["Trial Chambers are structures found deep underground, where trial spawners summon powerful mobs." "Survive the trial to earn a Trial Key. It opens special vaults in the chambers for valuable rewards."]
	quest.3A210290AA459D13.quest_subtitle: "Obtain Ominous Trial Key and Trial Key"
	quest.3A210290AA459D13.title: "Trial Keys"
	quest.3A2B6439D1C6FF2F.quest_desc: ["Makes fermentation more efficient. You may want to automate it."]
	quest.3A2B6439D1C6FF2F.quest_subtitle: "Obtain Fermentation Starter"
	quest.3A458BD4B5490D95.quest_desc: ["The Armored Elytra is an Elytra reinforced with Better End materials for better durability while gliding." "Repair it with an Aeternium Ingot at an Anvil, or with the Mending enchantment."]
	quest.3A458BD4B5490D95.quest_subtitle: "Obtain Elytra Armored"
	quest.3A46C094CF063210.quest_desc: ["The leggings of the Tertium armor set. Together with the chestplate, they unlock the helmet."]
	quest.3A52B2E17355ED8C.quest_desc: ["Bring Item Storage Cell 64m into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3A52B2E17355ED8C.quest_subtitle: "Obtain Item Storage Cell 64m"
	quest.3A636EC59F62BCAE.quest_desc: ["This quest asks for Digital Circuit. EMI shows the recipe if you press R while hovering over it."]
	quest.3A636EC59F62BCAE.quest_subtitle: "Obtain Digital Circuit"
	quest.3A636EC59F62BCAE.title: "No need for Sodium anymore!"
	quest.3A654D389F1BE286.quest_desc: ["Induction Provides make up the transfer rate of the battery, both input and output. Transfer Rate: 102.40 kFE/t."]
	quest.3A654D389F1BE286.quest_subtitle: "Obtain Basic Induction Provider"
	quest.3A87C3D492AAC15B.quest_desc: ["Craft it in a Smithing Table from an Iron Ingot and a vial of Fiery Blood or Fiery Tears."]
	quest.3A87C3D492AAC15B.quest_subtitle: "Get a Fiery Ingot"
	quest.3A8867FDA77C2ECB.quest_desc: ["Bring Battery Blazing into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3A8867FDA77C2ECB.quest_subtitle: "Obtain Battery Blazing"
	quest.3A9A280E0A3EF818.quest_desc: ["Bring Twisted Blade into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3A9A280E0A3EF818.quest_subtitle: "Obtain Twisted Blade"
	quest.3AA4B3BA0698AD26.quest_desc: ["Get hold of Frostfall. Hover over it in EMI and press R to see how it is made."]
	quest.3AA4B3BA0698AD26.quest_subtitle: "Obtain Frostfall"
	quest.3AA523E360B4151E.quest_desc: ["The Orb of Prophecy is a rare artifact tied to the Gatekeeper in Eternal Starlight." "It unlocks the portal to the dimension, and you cannot advance without it."]
	quest.3AA523E360B4151E.quest_subtitle: "Obtain Orb of Prophecy"
	quest.3AA523E360B4151E.title: "Orb Of Prophecy"
	quest.3AAAB9DF50064EA9.quest_desc: ["This quest asks for Sand Pear Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.3AAAB9DF50064EA9.quest_subtitle: "Obtain Sand Pear Sapling"
	quest.3AB5DFC45E943980.quest_desc: ["A parrot familiar."]
	quest.3AB5DFC45E943980.quest_subtitle: "Earn the advancement: Familiar Parrot"
	quest.3AB5EEEFFE75F921.quest_desc: ["Get hold of Melon Popsicle. Hover over it in EMI and press R to see how it is made."]
	quest.3AB5EEEFFE75F921.quest_subtitle: "Obtain Melon Popsicle"
	quest.3AC89BD7683ED8D1.quest_desc: ["This machine breaks Blocks in the world. Configurable."]
	quest.3AC89BD7683ED8D1.quest_subtitle: "Obtain Blockbreakert1"
	quest.3AC95C4FF910D68A.quest_desc: ["Use this tablet to create magical helpers to include the weald walker and amethyst golem."]
	quest.3AC95C4FF910D68A.quest_subtitle: "Obtain Ritual Awakening"
	quest.3ACF0EAC5C5CEAB0.quest_desc: ["Divination Rods locate valuable blocks from afar. Sneak-use the rod on a block to attune it, then charge it up to send a particle toward the nearest matching block, which uses durability. Use it normally to ping that location again. The gem turns more purple the closer you get." "The Glass Rod is the cheapest and only locates Abundant and Common blocks."]
	quest.3ACF0EAC5C5CEAB0.quest_subtitle: "Obtain Divination Rod T1"
	quest.3AF7DF414C900EED.quest_desc: ["Cryomancer Boots are part of the Cryomancer Armor set in Iron's Spells 'n Spellbooks. They give +3 Armor, +125 Max Mana, +10% Ice Spell Power and +5% Spell Power." "Craft them from 4 Arcane Cloth and 1 Ice Rune, or upgrade Wizard Boots with 1 Ice Rune and 1 Arcane Essence."]
	quest.3AF7DF414C900EED.quest_subtitle: "Obtain Cryomancer Boots"
	quest.3B0687AFEC997D89.quest_desc: ["This quest asks for Relic Experience Bottle. EMI shows the recipe if you press R while hovering over it."]
	quest.3B0687AFEC997D89.quest_subtitle: "Obtain Relic Experience Bottle"
	quest.3B15519D9BD74AA6.quest_desc: ["Bring Whirling Broom into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3B15519D9BD74AA6.quest_subtitle: "Obtain Whirling Broom"
	quest.3B38F61AE414D03B.quest_desc: ["Obtain a Brass Sheet from Create by pressing a Brass Ingot with a Mechanical Press." "It is used for advanced components such as Brass Casings, Brass Hands, Brass Tunnels, Mechanical Arms and Redstone Links."]
	quest.3B38F61AE414D03B.quest_subtitle: "Obtain Brass Sheet"
	quest.3B400A10672B862B.quest_desc: ["This machine exposes Empty PCBs to UV Light, preparing them for processing in an Etching Tank. A longer exposure time improves the likelihood of successful etching, though the process slows down over time. You can set a threshold to determine when a PCB is considered finished; a lower threshold speeds up processing but increases the risk of failed etching. Failed PCBs can be recycled in a Blast Furnace for another attempt."]
	quest.3B400A10672B862B.quest_subtitle: "Obtain Uv Light Box"
	quest.3B52675F0BFBB74C.quest_desc: ["Defeat Citadel Keeper."]
	quest.3B52675F0BFBB74C.quest_subtitle: "Defeat Citadel Keeper"
	quest.3B5646F6FDF402EB.quest_desc: ["Gateways to Eternity introduces challenge encounters through gateways. Learn how to activate a gateway, prepare for the waves, and claim its rewards."]
	quest.3B5646F6FDF402EB.title: "Getting Started"
	quest.3B58C219ECDAC0D7.quest_desc: ["Super Factory Manager lets you control complex automation with programmable factory logic. Start with a simple input-to-output setup and expand its rules as needed."]
	quest.3B58C219ECDAC0D7.title: "Getting Started"
	quest.3B58DEC4ED0F1BB6.quest_desc: ["The first piece of the Diamond armor set. Get the boots to unlock the chestplate and leggings."]
	quest.3B5D09F2B541F129.quest_desc: ["The pack includes several furniture mods with decorative and functional pieces. Browse their blocks and recipes to furnish a base in your preferred style."]
	quest.3B5D09F2B541F129.title: "Getting Started"
	quest.3B671CC375F06724.quest_desc: ["The Undergarden is a dark underground dimension with its own biomes, creatures, and resources. Prepare for its conditions before setting out to explore."]
	quest.3B671CC375F06724.title: "Getting Started"
	quest.3B6DCB07631D1121.quest_desc: ["The Deepsilver Shovel is crafted from Deepsilver Ingots in Eternal Starlight." "It is used for digging in swamp and Nightfall regions and lasts longer than iron tools."]
	quest.3B6DCB07631D1121.quest_subtitle: "Obtain Deepsilver Shovel"
	quest.3B6E3BB402776419.quest_desc: ["The Block of Super Experience from Create: Enchantment Industry is made when lightning strikes a Block of Experience." "It can be used for Super Enchanting or compacted into Nuggets of Super Experience. Unlike normal experience, Super Experience has no liquid form."]
	quest.3B6E3BB402776419.quest_subtitle: "Obtain Super Experience Block"
	quest.3B77FE09990A44A5.quest_desc: ["The Fairy heals and supports other familiars while draining your enemies' life."]
	quest.3B77FE09990A44A5.quest_subtitle: "Earn the advancement: Familiar Fairy"
	quest.3B8BC6CC1B02ED7E.quest_desc: ["Vials of Blood are obtained by standing in an Alchemist Cauldron or by Standing in a normal Cauldron with a fire under it. Once it fills up with some blood you can Right-Click with an empty bottle to collect the blood."]
	quest.3B8BC6CC1B02ED7E.quest_subtitle: "Obtain Blood Vial"
	quest.3BACCC6A2CAA9818.quest_desc: ["Get hold of Lesser Spell Slot Upgrade. Hover over it in EMI and press R to see how it is made."]
	quest.3BACCC6A2CAA9818.quest_subtitle: "Obtain Lesser Spell Slot Upgrade"
	quest.3BB1B7935FADD720.quest_desc: ["The Portable QIO Dashboard is just a portable version of the dashboard."]
	quest.3BB1B7935FADD720.quest_subtitle: "Obtain Portable Qio Dashboard"
	quest.3BCAFB9C3CCD9515.quest_desc: ["Fuel heats the furnace twice as fast, but all cooking recipes run a quarter slower."]
	quest.3BCAFB9C3CCD9515.quest_subtitle: "Obtain Augment Fuel"
	quest.3BD25483DB5F53BE.quest_desc: ["This quest asks for Steel Packer. EMI shows the recipe if you press R while hovering over it."]
	quest.3BD25483DB5F53BE.quest_subtitle: "Obtain Steel Packer"
	quest.3BD25483DB5F53BE.title: "To Pack Or Not To Pack"
	quest.3BE1A07D7DCA6C81.quest_desc: ["Using the Scroll Forge and a Blood Vial to craft a Blood Scrolls."]
	quest.3BE1A07D7DCA6C81.quest_subtitle: "Obtain Scroll"
	quest.3BEB56F2EFDF553C.quest_desc: ["The Toggle Bus is the same as a Glass Cable, but is used to temporarily disable the section of a system downstream from it when unpowered. Powering it will allow data and power to pass once again."]
	quest.3BEB56F2EFDF553C.quest_subtitle: "Obtain Toggle Bus"
	quest.3BEB56F2EFDF553C.title: "Toggle Bus"
	quest.3BF23B530B3EB7B1.quest_desc: ["This quest asks for Toxic Longsword. EMI shows the recipe if you press R while hovering over it."]
	quest.3BF23B530B3EB7B1.quest_subtitle: "Obtain Toxic Longsword"
	quest.3BF474BA8E696316.quest_desc: ["You will need a combination of these different blocks to build the turbine. It is a complicated machine, so it is recommended to research it first. There are a ton of different tutorials on YouTube."]
	quest.3BF474BA8E696316.quest_subtitle: "Obtain Turbine Valve, Turbine Vent, Turbine Blade and 5 more items"
	quest.3BF62E66A9B81D75.quest_desc: ["Andesite, Copper and Brass Bogie Steps give you a practical way to climb aboard and add an industrial touch to your train." "It is worth collecting all three variants."]
	quest.3BF62E66A9B81D75.quest_subtitle: "Obtain Andesite Bogie Steps, Brass Bogie Steps and Copper Bogie Steps"
	quest.3BF7B61BB0D724C6.quest_desc: ["Bring Crystal Niotic into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3BF7B61BB0D724C6.quest_subtitle: "Obtain Crystal Niotic"
	quest.3C02C4A077E07896.quest_desc: ["Get hold of Soulium Seed Base. Hover over it in EMI and press R to see how it is made."]
	quest.3C02C4A077E07896.quest_subtitle: "Obtain Soulium Seed Base"
	quest.3C05948D3A02D4BA.quest_desc: ["Get hold of Thunder Bolt Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.3C05948D3A02D4BA.quest_subtitle: "Obtain Thunder Bolt Sapling"
	quest.3C0850C41E780C48.quest_desc: ["Equip a full set of Rare Affix Gear (helmet, chestplate, leggings, boots and weapon), then defeat the Wither."]
	quest.3C0850C41E780C48.quest_subtitle: "Reach World Tier: Summit"
	quest.3C0850C41E780C48.title: "The Summit"
	quest.3C3AEFEE03F702F2.quest_desc: ["Get hold of Myrtle Ebony Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.3C3AEFEE03F702F2.quest_subtitle: "Obtain Myrtle Ebony Sapling"
	quest.3C3F8AF9841A1D11.quest_desc: ["Get hold of 2x Formation Core and 2x Annihilation Core. Hover over it in EMI and press R to see how it is made."]
	quest.3C3F8AF9841A1D11.quest_subtitle: "Obtain 2x Formation Core and 2x Annihilation Core"
	quest.3C3F8AF9841A1D11.title: "The two Cores"
	quest.3C4D234ED85FC063.quest_desc: ["Upgrades a Basic or Copper storage to Iron tier."]
	quest.3C4D234ED85FC063.quest_subtitle: "Obtain Basic to Iron Tier Upgrade and Copper to Iron Tier Upgrade"
	quest.3C4D234ED85FC063.title: "Iron Tier Upgrade"
	quest.3C4F9711592D2278.quest_desc: ["Upgrades can be put into machines and hives to increase their functionality or improve the performance."]
	quest.3C4F9711592D2278.quest_subtitle: "Obtain Upgrade Base"
	quest.3C681A8671313F41.quest_desc: ["This quest asks for Stainless Steel Ingot. EMI shows the recipe if you press R while hovering over it."]
	quest.3C681A8671313F41.quest_subtitle: "Obtain Stainless Steel Ingot"
	quest.3C681A8671313F41.title: "Invar with Slot Locking"
	quest.3C6CC2168711B897.quest_desc: ["This quest asks for Foggy Blast Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.3C6CC2168711B897.quest_subtitle: "Obtain Foggy Blast Sapling"
	quest.3C74CE1EA5F15362.quest_desc: ["A wrench that rotates blocks. Try it on your favorite tech blocks that have wrench interactions."]
	quest.3C74CE1EA5F15362.quest_subtitle: "Obtain Ferricore Wrench"
	quest.3C80BA4CD4E3205B.quest_desc: ["Bulk Storage Cells can hold an infinite amount of 1 singular item."]
	quest.3C80BA4CD4E3205B.quest_subtitle: "Obtain Bulk Item Cell"
	quest.3C8ADEBAEC36DE06.quest_desc: ["Armor-piercing ammo."]
	quest.3C8ADEBAEC36DE06.quest_subtitle: "Obtain Gun Ammo Ap"
	quest.3C8DC1B65F027AAD.quest_desc: ["The Wireless Terminal is a regular Terminal that can be used to access an ME System wirelessly. Use an Access Point to connect up your Terminal and use Booster Cards to increase the total distance from that Access Point you want to be able to use your system. Using multiple Access Points on the same network in different locations can help you cover a larger footprint."]
	quest.3C8DC1B65F027AAD.quest_subtitle: "Obtain Wireless Terminal"
	quest.3C8DC1B65F027AAD.title: "Wireless Terminal"
	quest.3C9F95FEDD54A449.quest_desc: ["The leggings of the Nano armor set. Together with the chestplate, they unlock the helmet."]
	quest.3CB1879E6E46D1A6.quest_desc: ["The first piece of the Inferium armor set. Get the boots to unlock the chestplate and leggings."]
	quest.3CB1EA7659B5A4A7.quest_desc: ["This quest asks for Logwood Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.3CB1EA7659B5A4A7.quest_subtitle: "Obtain Logwood Sapling"
	quest.3CEF188D9C59CF25.quest_desc: ["Craft Thallasium Leggings from Thallasium Plating at a Smithing Table." "They give the entry-level protection of Better End's armor line."]
	quest.3CEF188D9C59CF25.quest_subtitle: "Obtain Thallasium Leggings"
	quest.3D01D4524B4043D2.quest_desc: ["Make the Volume of the Deep in a Mechanical Crafter using a Netherite Spell Book, Echo Ingots, a Reinforced Echo Shard and a Warden Upgrade Template." "Spells from the old book are not kept, so empty it first."]
	quest.3D01D4524B4043D2.quest_subtitle: "Obtain Volume of the Deep"
	quest.3D0DD00DB1602DB1.quest_desc: ["You can upgrade a basic Sophisticated Storage container to the Copper Tier. It boosts the container and opens the way to more advanced storage options."]
	quest.3D0DD00DB1602DB1.quest_subtitle: "Obtain Basic to Copper Tier Upgrade"
	quest.3D2524909A2B138A.quest_desc: ["Place a Hellshelf in the enchanting table and use Infusion. The option appears once the table has at least 45 Eterna and 30% Quanta." "It gives +5 Eterna (up to 60) and +5 Quanta, and is the base for every advanced Hellshelf."]
	quest.3D2524909A2B138A.quest_subtitle: "Obtain Infused Hellshelf"
	quest.3D30505F0C58F0ED.quest_desc: ["Makes melee attacks deal fire damage."]
	quest.3D30505F0C58F0ED.quest_subtitle: "Obtain Fire Gauntlet"
	quest.3D30DE240B488D3A.quest_desc: ["This quest asks for Goldfish. EMI shows the recipe if you press R while hovering over it."]
	quest.3D30DE240B488D3A.quest_subtitle: "Obtain Goldfish"
	quest.3D4390F743BB5126.quest_desc: ["Bosses'Rise turns boss fights into real encounters. Each boss has its own arena, its own moveset and phases that change how you have to play, so winning comes from reading the fight instead of tanking it. "]
	quest.3D4390F743BB5126.title: "Getting Started"
	quest.3D46CE667582329F.quest_desc: ["Drygmy shards can be found in loot chests. Drygmy shards are used to create drygmy charms."]
	quest.3D46CE667582329F.quest_subtitle: "Obtain Drygmy Shard"
	quest.3D6066ED0346CE06.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.3D6066ED0346CE06.quest_subtitle: "Obtain Glyph Leap"
	quest.3D611D08691AF5FF.quest_desc: ["Allows you to move items from your Storage Drives into other Storage drives. Useful if you want to compress items in Drives or empty Drives to make bigger ones."]
	quest.3D611D08691AF5FF.quest_subtitle: "Obtain Io Port"
	quest.3D61DBC728EC482D.quest_desc: ["Flux Storage keeps excess energy and only fills once every Flux Point has received enough. Stored energy can only leave through a Flux Point. This tier has a transfer limit of 20,000. Networks do not need storage to work."]
	quest.3D61DBC728EC482D.quest_subtitle: "Stores surplus energy in your network"
	quest.3D629369D4381551.quest_desc: ["Use the starbuncle charm on the ground to create a starbuncle."]
	quest.3D629369D4381551.quest_subtitle: "Obtain Starbuncle Charm"
	quest.3D63CB521550EC46.quest_desc: ["A one-time warp to a specified location."]
	quest.3D63CB521550EC46.quest_subtitle: "Obtain Ritual Warping"
	quest.3D6B672BA124961F.quest_desc: ["Get hold of Chicken Soup. Hover over it in EMI and press R to see how it is made."]
	quest.3D6B672BA124961F.quest_subtitle: "Obtain Chicken Soup"
	quest.3D7D5A7F91C9B7D5.quest_desc: ["Simple version: collects fluids, with speed and orientation controls and optional redstone sensitivity. Advanced version: adds filtering and offset AOE, and needs power."]
	quest.3D7D5A7F91C9B7D5.quest_subtitle: "Obtain Smart Filter"
	quest.3D7FFDF4548AE546.quest_desc: ["This quest asks for Waxweaver. EMI shows the recipe if you press R while hovering over it."]
	quest.3D7FFDF4548AE546.quest_subtitle: "Obtain Waxweaver"
	quest.3D8FE3E0F08AF1E6.quest_desc: ["Earn the advancement: Hill1."]
	quest.3D8FE3E0F08AF1E6.quest_subtitle: "Defeat a Redcap Goblin in a small Hollow Hill"
	quest.3DA0B5970547DA41.quest_desc: ["Multiplies the number of stacks that can fit in a slot by 8."]
	quest.3DA0B5970547DA41.quest_subtitle: "Obtain Stack Upgrade Tier 3"
	quest.3DA2A4662C54DD98.quest_desc: ["Energy Cells store up to 200,000 AE. They do not accept power directly but are used to add additional power storage to an already existing ME Network."]
	quest.3DA2A4662C54DD98.quest_subtitle: "Obtain Energy Cell"
	quest.3DAB2EA1053E0DAA.quest_desc: ["The Devil provides resistance to fire."]
	quest.3DAB2EA1053E0DAA.quest_subtitle: "Earn the advancement: Familiar Devil"
	quest.3DBEC2403FEA3077.quest_desc: ["Earn the advancement: Zanite."]
	quest.3DBEC2403FEA3077.quest_subtitle: "Get a Zanite Gemstone"
	quest.3DD32E24F8A24FAD.quest_desc: ["Obtained from ore found commonly around sea level, Sal Ammoniac is a crystal brimming with useful properties. You will want a decent supply of it."]
	quest.3DD32E24F8A24FAD.quest_subtitle: "Obtain Sal Ammoniac Crystal"
	quest.3DE1B4FF6A24FE7B.quest_desc: ["Comes in several colors to match any decor."]
	quest.3DE1B4FF6A24FE7B.quest_subtitle: "Obtain Smart Filter"
	quest.3DE941A927F6D58F.quest_desc: ["Adds a stonecutter to the backpack."]
	quest.3DE941A927F6D58F.quest_subtitle: "Obtain Stonecutter Upgrade"
	quest.3DF3D2A4A8A736C8.quest_desc: ["Blood Rune is a crafting ingredient in Iron's Spells 'n Spellbooks, used for advanced Blood crafting such as Blood Upgrade Orbs. It is the Blood-school Runestone." "Combine a Blank Runestone with 8 Blood Vials to make one. Blood Vials are the Blood Focus."]
	quest.3DF3D2A4A8A736C8.quest_subtitle: "Obtain Blood Rune"
	quest.3E0BDA5AE487EECA.quest_desc: ["Get hold of Arctic Helmet, Arctic Chestplate, Arctic Leggings and Arctic Boots. Hover over it in EMI and press R to see how it is made."]
	quest.3E0BDA5AE487EECA.quest_subtitle: "Craft a full set of Arctic Armor"
	quest.3E0BDA5AE487EECA.title: "Arctic Armorer"
	quest.3E0F594055E7944F.quest_desc: ["Use a Schematic and Quil to save a build or a piece of your world. Use an Empty Schematic in a Schematic Table to put your schemes in motion."]
	quest.3E0F594055E7944F.quest_subtitle: "Obtain Schematic and Quill and Empty Schematic"
	quest.3E188DFCAF1277B3.quest_desc: ["Get hold of Thermo Generator Starter. Hover over it in EMI and press R to see how it is made."]
	quest.3E188DFCAF1277B3.quest_subtitle: "Obtain Thermo Generator Starter"
	quest.3E1D3B3F78067D3F.quest_desc: ["Get hold of Western Hemlock Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.3E1D3B3F78067D3F.quest_subtitle: "Obtain Western Hemlock Sapling"
	quest.3E43003D1193AD5A.quest_desc: ["The Aeternium Hoe is a top-tier farming tool forged from Aeternium, the strongest material in Better End." "It finishes the mod's tool progression along with the rest of the Aeternium set."]
	quest.3E43003D1193AD5A.quest_subtitle: "Obtain Aeternium Hoe"
	quest.3E4A7158F4BBBFEB.quest_desc: ["Compressed Steel is crafted with an Iron Ingot thrown on the ground and blown up by TNT, but you will not always get your return on it. Expected loss is 25% of your Iron thrown. Needs Casing for cable tier to convert to (LV by default). Note: By holding SHIFT over any PNC item will give a description of the item."]
	quest.3E4A7158F4BBBFEB.quest_subtitle: "Obtain 64x Ingot Iron Compressed"
	quest.3E4A7158F4BBBFEB.title: "Welcome to PNC"
	quest.3E6CF9EE620AB242.quest_desc: ["The Blast Furnace also outputs Slag. Crush it for Sand, or use it in Concrete and a few other building blocks."]
	quest.3E6CF9EE620AB242.quest_subtitle: "Obtain 27x Blastbrick"
	quest.3E6CF9EE620AB242.title: "Blast Furnace"
	quest.3E6D77B5161E00B4.quest_desc: ["This quest asks for Righteous Relic. EMI shows the recipe if you press R while hovering over it."]
	quest.3E6D77B5161E00B4.quest_subtitle: "Obtain Righteous Relic"
	quest.3E6E4ABA17AE83C6.quest_desc: ["Get hold of Thermo Generator Basic. Hover over it in EMI and press R to see how it is made."]
	quest.3E6E4ABA17AE83C6.quest_subtitle: "Obtain Thermo Generator Basic"
	quest.3E7028558A5513C6.quest_desc: ["Bring Cultivated Pear Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3E7028558A5513C6.quest_subtitle: "Obtain Cultivated Pear Sapling"
	quest.3E7619BBBA700412.quest_desc: ["The Chemical Crystallizer turns Clean Slurry into Crystals and lithium into lithium dust. This is one of the select many machines in Mekanism to have dedicated, unchangeable sides for input and output."]
	quest.3E7619BBBA700412.quest_subtitle: "Obtain Chemical Crystallizer"
	quest.3E77595FE3410515.quest_desc: ["This quest asks for Bow Blazegold. EMI shows the recipe if you press R while hovering over it."]
	quest.3E77595FE3410515.quest_subtitle: "Obtain Bow Blazegold"
	quest.3E7DAF1A83243373.quest_desc: ["Get hold of Nutmeg Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.3E7DAF1A83243373.quest_subtitle: "Obtain Nutmeg Sapling"
	quest.3E8C2D813E7AF7A6.quest_desc: ["Modern Dynamics adds configurable transport for items and other resources. Explore its network components and filters as another option for automating a base."]
	quest.3E8C2D813E7AF7A6.title: "Getting Started"
	quest.3E92DC0B9D6AB427.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.3E92DC0B9D6AB427.quest_subtitle: "Obtain Ultimate Sawing Factory"
	quest.3E9B1C4C5D01971E.quest_desc: ["You need the focus from the labyrinth first."]
	quest.3E9B1C4C5D01971E.quest_subtitle: "Craft and open the Maze Map"
	quest.3E9B1C4C5D01971E.title: "And Now, to Find the Exit."
	quest.3E9E1A26BCE91AF4.quest_desc: ["Expands the inventory of the barrel."]
	quest.3E9E1A26BCE91AF4.quest_subtitle: "Obtain Netherite Barrel"
	quest.3E9E1A26BCE91AF4.title: "Netherite Barrel"
	quest.3EACD434A13F0A9C.quest_desc: ["Get hold of Book of Binding Afrit. Hover over it in EMI and press R to see how it is made."]
	quest.3EACD434A13F0A9C.quest_subtitle: "Obtain Book of Binding Afrit"
	quest.3EAF5695FAEB6E80.quest_desc: ["Get hold of Thread Magic Capacity. Hover over it in EMI and press R to see how it is made."]
	quest.3EAF5695FAEB6E80.quest_subtitle: "Obtain Thread Magic Capacity"
	quest.3EBA52D8E254A7D8.quest_desc: ["Applies an extra level of Fortune to mined blocks."]
	quest.3EBA52D8E254A7D8.quest_subtitle: "Obtain Lucky Scarf"
	quest.3EBC5FA0600539F7.quest_desc: ["A Fission Reactor is a complicated multiblock structure. Therefore, it is recommended to research some common designs. Fission Reactors require constant attention unless you have a large amount of fail safes. Even if you do, it is still good practice to place it far away from your base, or in another dimension. In the event of a meltdown, it will blanket a very large radius in lethal radiation that will last for quite a few ingame weeks."]
	quest.3EBC5FA0600539F7.quest_subtitle: "Obtain 4x Fission Reactor Port, Fission Fuel Assembly, Control Rod Assembly and 2 more items"
	quest.3EE23EFF33BD6FD3.quest_desc: ["This quest asks for Cow Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.3EE23EFF33BD6FD3.quest_subtitle: "Obtain Cow Seeds"
	quest.3EFF6E83AE509F6B.quest_desc: ["Counters give your kitchen more working space and let you extend the layout."]
	quest.3EFF6E83AE509F6B.quest_subtitle: "Extra space for your kitchen"
	quest.3F0FBA9B295C00F7.quest_desc: ["This Rod can locate Rare materials."]
	quest.3F0FBA9B295C00F7.quest_subtitle: "Obtain Divination Rod T2"
	quest.3F1B5FD368DA75AF.quest_desc: ["Stable Wormholes are placeable access points to the Storage Actuator. Items can be piped in and out, but a transporter spirit is recommended for extraction to avoid lag." "The Storage Remote lets you reach your storage from far away with no range or dimension limit, as long as the actuator's chunk is loaded."]
	quest.3F1B5FD368DA75AF.quest_subtitle: "Obtain Stable Wormhole and Storage Remote"
	quest.3F1B5FD368DA75AF.title: "Storage Access"
	quest.3F1CCB36D5B017CE.quest_desc: ["Universal Cables are Mekanism's way to transfer power. Capacity: 3.20 kFE/t."]
	quest.3F1CCB36D5B017CE.quest_subtitle: "Obtain Basic Universal Cable"
	quest.3F1CCB36D5B017CE.title: "Basic Universal Cable"
	quest.3F2021A5A184DB17.quest_desc: ["This magical bow can be inscribed with a spell."]
	quest.3F2021A5A184DB17.quest_subtitle: "Obtain Spell Bow"
	quest.3F3FB417B1559B1B.quest_desc: ["This quest asks for Rosewood Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.3F3FB417B1559B1B.quest_subtitle: "Obtain Rosewood Sapling"
	quest.3F5689FFD66B4B4D.quest_desc: ["Tier 3 glyph. Craft it at the Scribe\'s Table."]
	quest.3F5689FFD66B4B4D.quest_subtitle: "Obtain Glyph Lightning"
	quest.3F6064916ED91F2E.quest_desc: ["This is used for decoration or rituals."]
	quest.3F6064916ED91F2E.quest_subtitle: "Obtain Ritual Brazier"
	quest.3F66E1BE7E440FF6.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.3F66E1BE7E440FF6.quest_subtitle: "Obtain Ultimate Crushing Factory"
	quest.3F9305C8DF6F929A.quest_desc: ["Blaze Rods are used to craft Fire Scrolls."]
	quest.3F9305C8DF6F929A.quest_subtitle: "Obtain Blaze Rod"
	quest.3F93A3134DEBD500.quest_desc: ["Bring Bull Pine Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3F93A3134DEBD500.quest_subtitle: "Obtain Bull Pine Sapling"
	quest.3FA07C689D211D45.quest_desc: ["Make the Resonarium Shovel in a Mechanical Crafter using a Diamond Shovel, Sturdy Sheets, a Resonarium Plate and a Resonarium Upgrade Template." "The template can be found in Ancient Cities, Trial Chambers and Strongholds."]
	quest.3FA07C689D211D45.quest_subtitle: "Obtain Resonarium Shovel"
	quest.3FA7DEFE4DDBB86C.quest_desc: ["Adds a blasting furnace to the storage."]
	quest.3FA7DEFE4DDBB86C.quest_subtitle: "Obtain Blasting Upgrade"
	quest.3FBD660E5BB9E1C6.quest_desc: ["Get hold of Celestigem Helmet. Hover over it in EMI and press R to see how it is made."]
	quest.3FBD660E5BB9E1C6.quest_subtitle: "Obtain Celestigem Helmet"
	quest.3FBEE43365F45CE9.quest_desc: ["Wandering Magician Shoes are part of the basic Wandering Magician Armor set in Iron's Spells 'n Spellbooks. They give +2 Armor and +25 Max Mana." "Craft them by combining Leather Boots with Arcane Essence, an accessible early-game option."]
	quest.3FBEE43365F45CE9.quest_subtitle: "Obtain Wandering Magician Boots"
	quest.3FBF48639C49EE18.quest_desc: ["Bring Grains of Infinity Seeds into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3FBF48639C49EE18.quest_subtitle: "Obtain Grains of Infinity Seeds"
	quest.3FC4AE282D470051.quest_desc: ["Bring Dog Food into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.3FC4AE282D470051.quest_subtitle: "Obtain Dog Food"
	quest.3FC4C3958F159E39.quest_desc: ["The Alchemist Robe is an equipment item from Eternal Starlight tied to alchemy progression." "It belongs to the alchemist gear set and, depending on the version, enhances exploration or alchemy mechanics."]
	quest.3FC4C3958F159E39.quest_subtitle: "Obtain Alchemist Robe"
	quest.3FC5130B6B318364.quest_desc: ["This quest asks for Copper Seeds. EMI shows the recipe if you press R while hovering over it."]
	quest.3FC5130B6B318364.quest_subtitle: "Obtain Copper Seeds"
	quest.3FC8112EC8BB1F0B.quest_desc: ["Magehunter is a strong sword in Iron's Spells 'n Spellbooks, carried by the Vindicator on the second floor of an Archevoker Fort. It can drop when you defeat that Vindicator." "In the main hand it gives 7 Attack Damage, 1.6 Attack Speed, 2.5 Attack Range and +15% Spell Resistance."]
	quest.3FC8112EC8BB1F0B.quest_subtitle: "Obtain Magehunter"
	quest.3FD83E71D2C6C707.quest_desc: ["Enriched Carbon is used in the Metallurgic Infuser. Enriched Carbon yields 80 units of carbon in the infuser, the same as 8 coal or 4 charcoal."]
	quest.3FD83E71D2C6C707.quest_subtitle: "Obtain Enriched Carbon"
	quest.3FF3B795E82E89A2.quest_desc: ["Pressurized Tubes are a way of transporting types of gas, such as steam, hydrogen, and oxygen. Transfer Rate: 256,000 mb/t."]
	quest.3FF3B795E82E89A2.quest_subtitle: "Obtain Ultimate Pressurized Tube"
	quest.3FFCACDBC7FDA173.quest_desc: ["Tier 1 glyph. Craft it at the Scribe\'s Table."]
	quest.3FFCACDBC7FDA173.quest_subtitle: "Obtain Glyph Touch"
	quest.40057BD424CD6D99.quest_desc: ["This Catalyst slowly turns Mercury into Mercury Flux, a source of Energy for alchemical devices."]
	quest.40057BD424CD6D99.quest_subtitle: "Obtain Mercury Catalyst"
	quest.4013CCD51F9B6DEE.quest_desc: ["This quest asks for Crystal Blazing. EMI shows the recipe if you press R while hovering over it."]
	quest.4013CCD51F9B6DEE.quest_subtitle: "Obtain Crystal Blazing"
	quest.4026D3EC9728CD99.quest_desc: ["The Quantum Entangloporter is a machine that allows liquids/items/energy/gas to be sent from one Quantum Entangloporter to another through a channel."]
	quest.4026D3EC9728CD99.quest_subtitle: "Obtain Quantum Entangloporter"
	quest.4028177E437736A7.quest_desc: ["Get hold of Ender Cell Starter. Hover over it in EMI and press R to see how it is made."]
