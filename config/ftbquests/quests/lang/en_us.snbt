	quest.1B02005FF74832B0.quest_desc: ["The leggings of the Nano Quantum armor set. Together with the chestplate, they unlock the helmet."]
	quest.1B06483B9213DAE1.quest_desc: ["Bring Obsidian Nest into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1B06483B9213DAE1.quest_subtitle: "Obtain Obsidian Nest"
	quest.1B1083EE0C7C685D.quest_desc: ["Feeds you from the food stored in the backpack."]
