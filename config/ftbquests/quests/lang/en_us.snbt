	quest.6AD21696A3A815C9.quest_subtitle: "Obtain Concurrent Processor"
	quest.6ADFB35DB13126FF.quest_desc: ["This unit allows you to fly. The controls are the same compared to creative mode."]
	quest.6ADFB35DB13126FF.quest_subtitle: "Obtain Module Gravitational Modulating Unit"
