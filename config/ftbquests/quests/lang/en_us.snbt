	quest.1B64462F0212E519.quest_desc: ["Variants to find: Taiga, &#00D9FFOcean&r, &#00D9FFNether Basalt&r, &#00D9FFNether Crimson&r, &#00D9FFNether Soul&r, &#00D9FFNether Warped and Nether Wasteland&r."]
	quest.1B64462F0212E519.quest_subtitle: "Find all 7 Temple variants"
	quest.1B6C5D2012EA15A4.quest_desc: ["Like &#00D9FFthe Alchemy Upgrade&r, with more control over when potions, milk buckets and effect foods get used."]
	quest.1B6C5D2012EA15A4.quest_subtitle: "Obtain Advanced Alchemy Upgrade"
	quest.1B6D8DC930F8EF54.quest_desc: ["Bring &#00D9FFArapaima&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1B6D8DC930F8EF54.quest_subtitle: "Obtain Arapaima"
	quest.1B7466F91B76FA7D.quest_desc: ["Smelts 48 items."]
	quest.1B7466F91B76FA7D.quest_subtitle: "Obtain Tertium Coal"
	quest.1B78CA6F81096E28.quest_desc: ["&#00D9FFWeapon Parts&r are a &#00D9FFRare&r crafting material in &#FFA500Iron's Spells 'n Spellbooks&r. They are crafted from 3 &#00D9FFMithril Ingots&r and 2 &#00D9FFArcane Ingots&r." "They go into powerful magical weapons such as the &#00D9FFSpellbreaker and Amethyst Rapier&r."]
	quest.1B78CA6F81096E28.quest_subtitle: "Obtain Weapon Parts"
	quest.1B80EFB16C1D818E.quest_desc: ["Get hold of &#00D9FFOre Map&r. Hover over it in EMI and press R to see how it is made."]
	quest.1B80EFB16C1D818E.quest_subtitle: "Craft and open the Ore Map"
	quest.1B860A210FF856FC.quest_desc: ["Bring &#00D9FFRed Grouper&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1B860A210FF856FC.quest_subtitle: "Obtain Red Grouper"
	quest.1B90497496F0CBA0.quest_desc: ["Using a &#00D9FFScroll Forge&r and an &#00D9FFEnder Pearl&r craft an &#00D9FFEnder Scrolls&r."]
	quest.1B90497496F0CBA0.quest_subtitle: "Obtain Scroll"
	quest.1B941B974BB60F63.quest_desc: ["Increases mining speed and base mining level."]
	quest.1B941B974BB60F63.quest_subtitle: "Obtain Digging Claws"
	quest.1BA66437D2BECCDB.quest_desc: ["&#00D9FFNeeds Casing&r for cable tier to convert from (LV by default)."]
	quest.1BA66437D2BECCDB.quest_subtitle: "Obtain Universal Transformer"
	quest.1BB74BEE471D3B07.quest_desc: ["This quest asks for &#00D9FFEnder Gate Spirited&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1BB74BEE471D3B07.quest_subtitle: "Obtain Ender Gate Spirited"
	quest.1BC4FEDA94C02D7D.quest_desc: ["&#00D9FFBrass Rod and Electrum Rod&r are metal parts used to craft advanced equipment and electrical components in &#FFA500Create Crafts and Additions&r. Having both ready prepares you for more advanced electrical builds."]
	quest.1BC4FEDA94C02D7D.quest_subtitle: "Obtain Brass Rod and Electrum Rod"
	quest.1BD9B2B42C2A76A1.quest_desc: ["Equip a full set of &#00D9FFUncommon Affix Gear&r (helmet, chestplate, leggings, boots and weapon), then defeat an &#00D9FFApothic Invader&r."]
