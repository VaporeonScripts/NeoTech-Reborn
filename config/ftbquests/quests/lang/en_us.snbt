	quest.0736642369D2FA70.quest_subtitle: "Obtain Entro Crystal"
	quest.0743A6CF68A44E7C.quest_desc: ["Get hold of Hazmat Mask, Hazmat Gown, Hazmat Pants and Hazmat Boots. Hover over it in EMI and press R to see how it is made."]
	quest.0743A6CF68A44E7C.quest_subtitle: "Obtain Hazmat Mask, Hazmat Gown, Hazmat Pants and Hazmat Boots"
	quest.074B1638C84A8B76.quest_desc: ["Get hold of Celestigem Axe. Hover over it in EMI and press R to see how it is made."]
	quest.074B1638C84A8B76.quest_subtitle: "Obtain Celestigem Axe"
