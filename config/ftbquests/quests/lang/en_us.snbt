	quest.3C681A8671313F41.quest_desc: ["This quest asks for Stainless Steel Ingot. EMI shows the recipe if you press R while hovering over it."]
	quest.3C681A8671313F41.quest_subtitle: "Obtain Stainless Steel Ingot"
	quest.3C681A8671313F41.title: "Invar with Slot Locking"
