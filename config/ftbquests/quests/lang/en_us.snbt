	quest.4DE54F88918EC37B.quest_subtitle: "Obtain Apple Pie"
	quest.4DEA189D0E8FA603.quest_desc: ["The Capture Net from Naturalist lets you catch animals and carry them somewhere else. It is a handy way to relocate creatures safely."]
