	quest.4255579365AD7B81.quest_desc: ["Simple version: clicks the facing target with left, right or hold clicks, with sneak-click toggle, selectable target category and orientation, and redstone sensitivity options. Advanced version: adds filtering and offset AOE, can charge inserted equipment, and needs power."]
	quest.4255579365AD7B81.quest_subtitle: "Obtain Smart Filter"
	quest.425CEAA9CA5DA690.quest_desc: ["Variants to find: Birch, Desert, Jungle, Mangrove, Oak, Savanna, Snowy and Taiga."]
	quest.425CEAA9CA5DA690.quest_subtitle: "Find all 8 Mansion variants"
	quest.4262215922348149.quest_desc: ["This quest asks for Atlantic Herring. EMI shows the recipe if you press R while hovering over it."]
	quest.4262215922348149.quest_subtitle: "Obtain Atlantic Herring"
	quest.426281CA792DE329.quest_desc: ["This quest asks for Pumpkin Soup. EMI shows the recipe if you press R while hovering over it."]
	quest.426281CA792DE329.quest_subtitle: "Obtain Pumpkin Soup"
	quest.42661369E4C2C36A.quest_desc: ["To find the Lunar Monstrosity, hold the Seeking Eye in your main hand and a matching item in your off-hand. The Eye will then point to the Cursed Garden where the boss lives." "Valid items: Vines, Lunar Berries, Cave Moss (block or carpet), Red or Blue Crystal Moss (block or carpet), and Red or Blue Crystal Roots."]
	quest.42661369E4C2C36A.quest_subtitle: "Obtain Smart Filter"
