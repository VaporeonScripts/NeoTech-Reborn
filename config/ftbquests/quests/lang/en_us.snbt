	quest.0B77A338C8A47274.quest_subtitle: "Obtain Awakened Supremium Gemstone"
	quest.0B78F74BFFA4E46E.quest_desc: ["This quest asks for Bacon and Eggs. EMI shows the recipe if you press R while hovering over it."]
	quest.0B78F74BFFA4E46E.quest_subtitle: "Obtain Bacon and Eggs"
	quest.0BAB71CC13B3829B.quest_desc: ["Stores hooks, bait, bobbers and fishing lines."]
	quest.0BAB71CC13B3829B.quest_subtitle: "Obtain Tackle Box"
	quest.0BC36833E71A47C1.quest_desc: ["Get hold of Scroll. Hover over it in EMI and press R to see how it is made."]
	quest.0BC36833E71A47C1.quest_subtitle: "Obtain Scroll"
	quest.0BCC913B06D84BE6.quest_desc: ["Get hold of Mv Lv Transformer. Hover over it in EMI and press R to see how it is made."]
	quest.0BCC913B06D84BE6.quest_subtitle: "Obtain Mv Lv Transformer"
	quest.0BCC913B06D84BE6.title: "Optimus Prime!"
	quest.0BCEBFD219A3F217.quest_desc: ["Craft the Terminite Helmet from Terminite Plating at a Smithing Table. It protects better than Thallasium." "It is also the base for the stronger Crystalite and Aeternium helmets."]
	quest.0BCEBFD219A3F217.quest_subtitle: "Obtain Terminite Helmet"
	quest.0BD209565833C2E2.quest_desc: ["Bring Music Disc Precipice into your inventory. Check EMI with R on the item if you are unsure how to get it."]
