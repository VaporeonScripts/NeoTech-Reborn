	quest.51AFFE2D8BA060F1.quest_desc: ["Tier 2 glyph. Craft it at the Scribe\'s Table."]
	quest.51AFFE2D8BA060F1.quest_subtitle: "Obtain Glyph Grow"
	quest.51B4ED362FAEA90C.quest_desc: ["Bring Mirror of Transgression into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.51B4ED362FAEA90C.quest_subtitle: "Obtain Mirror of Transgression"
	quest.51D1ABEB17EE7C28.quest_desc: ["Bring Kumquat Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
