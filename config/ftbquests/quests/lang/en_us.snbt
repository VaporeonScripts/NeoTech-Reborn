	quest.5C294A87FDAD8206.quest_desc: ["This quest asks for Disk Drive 1k. EMI shows the recipe if you press R while hovering over it."]
	quest.5C294A87FDAD8206.quest_subtitle: "Obtain Disk Drive 1k"
