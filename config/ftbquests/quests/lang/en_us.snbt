	quest.1B64462F0212E519.quest_desc: ["Variants to find: Taiga, Ocean, Nether Basalt, Nether Crimson, Nether Soul, Nether Warped and Nether Wasteland."]
	quest.1B64462F0212E519.quest_subtitle: "Find all 7 Temple variants"
