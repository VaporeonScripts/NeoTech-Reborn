	quest.1A690C193864B04B.title: "Thermal Springstone Ingot"
	quest.1A6BED71742FA711.quest_desc: ["The chestplate of the Awakened Supremium armor set. Together with the leggings, it unlocks the helmet."]
	quest.1A6DFD28DBB7A316.quest_desc: ["The Thermal Springstone Leggings are crafted from Thermal Springstone Ingots in Eternal Starlight." "Each piece of this armor ignites attackers and reduces fire damage, which helps in hot, dangerous areas."]
	quest.1A6DFD28DBB7A316.quest_subtitle: "Obtain Thermal Springstone Leggings"
	quest.1A76FB12559E2D14.quest_desc: ["Connect/Chain up to a max of 64 machines of choice together."]
