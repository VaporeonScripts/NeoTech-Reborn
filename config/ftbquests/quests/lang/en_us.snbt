	quest.5BFBBB1442CA38A3.quest_subtitle: "Obtain Clot of Time"
	quest.5C0234DC4B2D451C.quest_desc: ["Source gems can be found in loot chests or created in a crystallizer. Source gems are required for many ars nouveau crafting recipes."]
	quest.5C0234DC4B2D451C.quest_subtitle: "Obtain Source Gem"
	quest.5C05D1074390A539.quest_desc: ["Bring Eclipsealloy Boots into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5C05D1074390A539.quest_subtitle: "Obtain Eclipsealloy Boots"
	quest.5C16B8E0C3AC4D6D.quest_desc: ["Expands the inventory and upgrade slots of the backpack."]
	quest.5C16B8E0C3AC4D6D.quest_subtitle: "Obtain Diamond Backpack"
