	quest.333A6DE41D79D6D5.quest_desc: ["Multiplies the number of stacks that can fit in a slot by 16."]
	quest.333A6DE41D79D6D5.quest_subtitle: "Obtain Stack Upgrade Tier 4"
	quest.3340C174C6E33DE1.quest_desc: ["One of the top furnace tiers, with excellent speed and fuel efficiency."]
	quest.3340C174C6E33DE1.quest_subtitle: "Obtain Netherite Furnace"
	quest.33456E5CF0F18E39.quest_desc: ["&#00D9FFShriving Stone&r is a crafting material in &#FFA500Iron's Spells 'n Spellbooks&r. Use it in an &#00D9FFAnvil&r or &#00D9FFArcane Anvil&r to remove &#00D9FFImbuements and Upgrades&r from gear. In newer versions, using it in the &#00D9FFArcane Anvil&r also returns the &#00D9FFUpgrade Orbs&r spent on the item." "It is crafted from 1 &#00D9FFRaw Iron&r and 1 &#00D9FFAmethyst Shard&r."]
	quest.33456E5CF0F18E39.quest_subtitle: "Obtain Shriving Stone"
