	quest.41192657317E9491.quest_desc: ["&#00D9FFGolem Steel&r is an advanced material in &#FFA500Eternal Starlight&r, made by refining &#00D9FFOxidized Golem Steel Ingots&r dropped by the &#00D9FFStarlight Golem&r." "The refined ingot is used for stronger equipment, weapons, tools and other recipes."]
	quest.41192657317E9491.quest_subtitle: "Obtain Golem Steel Ingot"
