	quest.23D446FCE94FB7A4.title: "Assembler Matrix"
	quest.23E56C60D6CA839B.quest_desc: ["Voids an item that is picked up which then provides a small amount of mana."]
	quest.23E56C60D6CA839B.quest_subtitle: "Obtain Void Jar"
	quest.23E98D096A1BFDC0.quest_desc: ["If an occult familiar dies, it will drop such a shard. You can use this to revive it, if you like."]
	quest.23E98D096A1BFDC0.quest_subtitle: "Obtain Soul Shard"
	quest.23F054B209A2F57E.quest_desc: ["A piece of equipment worn on the backpack (the chest armor slot) that provides underwater respiration when a Gas Mask is worn (on the helmet armor slot)."]
	quest.23F054B209A2F57E.quest_subtitle: "Obtain Scuba Tank"
	quest.23FC33F83ACFC5C0.quest_desc: ["A Tome of Scrapping removes enchantments from an item and gives them back as books. It only recovers half of them and destroys the item. Use a Tome of Extraction to keep the item, or Superior Scrapping to recover everything."]
	quest.23FC33F83ACFC5C0.quest_subtitle: "Obtain Scrap Tome"
	quest.240F20C12C771975.quest_desc: ["Expands the inventory and upgrade slots of the backpack."]
	quest.240F20C12C771975.quest_subtitle: "Obtain Gold Backpack"
	quest.241A984254DF5706.quest_desc: ["Using these Materials you'll be able to construct you first Pressure Chamber."]
	quest.241A984254DF5706.quest_subtitle: "Obtain 21x Pressure Chamber Wall, Pressure Chamber Valve, 2x Pressure Chamber Interface and 2x Pressure Chamber Glass"
	quest.241A984254DF5706.title: "Your First Pressure Chamber"
	quest.241D2F19426D33B4.quest_desc: ["Use it to make fish fillets. The amount you get depends on the type of fish."]
	quest.241D2F19426D33B4.quest_subtitle: "Obtain Gold Fillet Knife"
	quest.2422B7E51E491269.quest_desc: ["The shipping container for international shipping. The data packet for comunication networks. And now… the humble Cardboard Package packet-izes item transfer, underpinning Create’s new item requesting and delivery abilities."]
	quest.2422B7E51E491269.quest_subtitle: "Obtain Cardboard Package 12x12"
	quest.24389CE8F7E51A2F.quest_desc: ["Freezes targets. Slows them down and potentially encasing them in ice temporarily. Fire-resistant mobs are especially vulnerable to this ammo."]
	quest.24389CE8F7E51A2F.quest_subtitle: "Obtain Gun Ammo Freezing"
	quest.2444B671B3068D77.quest_desc: ["This quest asks for Bronze Composter. EMI shows the recipe if you press R while hovering over it."]
	quest.2444B671B3068D77.quest_subtitle: "Obtain Bronze Composter"
	quest.244CD83573C73850.quest_desc: ["There are 4 stages of growth, just like Certus Quartz Clusters. While in the first three stages you will get Entro Dust, But in the fourth stage you can get Entroized Crystals."]
	quest.244CD83573C73850.quest_subtitle: "Obtain Entro Dust"
	quest.245EBCE2A9181D65.quest_desc: ["Bring Energy Cable Niotic into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.245EBCE2A9181D65.quest_subtitle: "Obtain Energy Cable Niotic"
	quest.2474E042D5328107.quest_desc: ["The range upgrade will expand the area of operation by 1 block in all directions. Multiple range upgrades can be installed."]
