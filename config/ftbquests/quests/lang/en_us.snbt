	quest.0240EC7580B07F06.quest_desc: ["Get hold of &#00D9FFBronze Macerator&r. Hover over it in EMI and press R to see how it is made."]
	quest.0240EC7580B07F06.quest_subtitle: "Obtain Bronze Macerator"
	quest.0240EC7580B07F06.title: "Ore Hemiquadrupling"
	quest.0249793B5D44AFE6.quest_desc: ["Get hold of &#00D9FFHot Cream&r. Hover over it in EMI and press R to see how it is made."]
	quest.0249793B5D44AFE6.quest_subtitle: "Obtain Hot Cream"
	quest.024A43414233EB55.quest_desc: ["Tier 1 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.024A43414233EB55.quest_subtitle: "Obtain Glyph Underfoot"
	quest.025053E9D3F1B773.quest_desc: ["Tier 2 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.025053E9D3F1B773.quest_subtitle: "Obtain Glyph Fortune"
	quest.025B156068AD8570.quest_desc: ["The &#00D9FFWaxed Hoglin Trophy&r is a preserved version of the &#00D9FFHoglin Trophy&r from &#FFA500My Nether's Delight&r. The wax protects it, so it makes a lasting decoration for your base."]
	quest.025B156068AD8570.quest_subtitle: "Obtain Waxed Hoglin Trophy"
	quest.025B973C8F1C68E1.quest_desc: ["Get hold of &#00D9FFUnassembled Pcb&r. Hover over it in EMI and press R to see how it is made."]
	quest.025B973C8F1C68E1.quest_subtitle: "Obtain Unassembled Pcb"
	quest.025E6B68BB357C2A.quest_desc: ["Bring Shadowsting into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.025E6B68BB357C2A.quest_subtitle: "Obtain Shadowsting"
	quest.02674667B7D47E42.quest_desc: ["The &#00D9FFRunic Tablet&r is a mysterious item tied to the ancient runes of &#FFA500Simply Swords&r. Its purpose connects to the mod's unique weapons and magic."]
	quest.02674667B7D47E42.quest_subtitle: "Obtain Runic Tablet"
	quest.026FC31ABA2CD5DA.quest_desc: ["&#FFA500Chipped&r greatly expands decorative variants for many block families. Use its workstations to browse the available styles and personalize your builds."]
	quest.026FC31ABA2CD5DA.title: "Getting Started"
	quest.027479F050E443BF.quest_desc: ["Get hold of &#00D9FFForge Hammer&r. Hover over it in EMI and press R to see how it is made."]
	quest.027479F050E443BF.quest_subtitle: "Obtain Forge Hammer"
	quest.027479F050E443BF.title: "Forged!"
	quest.027A197AF3241F85.quest_desc: ["This Rod can locate &#00D9FFPrecious&r materials, and has far superior durability."]
	quest.027A197AF3241F85.quest_subtitle: "Obtain Divination Rod T4"
	quest.027B0CC766DB4A9C.quest_desc: ["These are pylons designed to outline the volume you wish to store into spatial drives. You must use these to outline 3 edges to an imaginary box surrounding the build. Each line of them uses 1 channel and each line needs to be at at least 2 pylons long. Try experimenting with the number of lines and how much power it uses! You might be able to optimize your digitizing."]
	quest.027B0CC766DB4A9C.quest_subtitle: "Obtain Spatial Pylon"
	quest.027B0CC766DB4A9C.title: "Spatial Pylon"
	quest.02963979BBAA3050.quest_desc: ["Get hold of &#00D9FFFerricore Boots&r. Hover over it in EMI and press R to see how it is made."]
	quest.02963979BBAA3050.quest_subtitle: "Obtain Ferricore Boots"
	quest.029E8FC235C1117E.quest_desc: ["Get hold of &#00D9FFKnightmetal Sword&r, &#00D9FFKnightmetal Pickaxe and Knightmetal Axe&r. Hover over it in EMI and press R to see how it is made."]
	quest.029E8FC235C1117E.quest_subtitle: "Craft Knightmetal tools"
	quest.02CAC3E0CBFF241E.quest_desc: ["&#00D9FFRaw Amaramber&r can be refined into ingots in &#FFA500Eternal Starlight&r." "These hold concentrated starlight energy and go into stronger equipment and advanced crafting, so your first &#00D9FFAmaramber Ingot&r is a big step."]
	quest.02CAC3E0CBFF241E.quest_subtitle: "Obtain Amaramber Ingot"
	quest.02CAC3E0CBFF241E.title: "Amaramber Ingot"
	quest.02CE3C394159EDF4.quest_desc: ["The vanilla &#00D9FFNetherite Upgrade Smithing Template&r is also needed for several late-game &#00D9FFBetter End&r recipes." "You will use it together with &#00D9FFAeternium&r materials for some of the mod's strongest tools and weapons."]
	quest.02CE3C394159EDF4.quest_subtitle: "Obtain Netherite Upgrade Smithing Template"
	quest.02DC100ACB25CBA8.quest_desc: ["The &#00D9FFIgnis Music Disc&r from &#FFA500Cataclysm&r is a rare disc dropped by &#00D9FFIgnis&r, the ruler of the &#00D9FFBurning Arena&r." "Keep it as proof of your victory."]
	quest.02DC100ACB25CBA8.quest_subtitle: "Obtain Music Disc Ignis"
	quest.02E5089FC1A73285.quest_desc: ["The &#00D9FFEnergy Sword&r is a special late-game weapon from &#FFA500Eternal Starlight&r." "Its blade is infused with concentrated dimensional energy, making it one of the stronger weapons in the mod."]
	quest.02E5089FC1A73285.quest_subtitle: "Obtain Energy Sword"
	quest.02E5089FC1A73285.title: "Energy Sword"
	quest.02E810A2D58CBEC3.quest_desc: ["This quest asks for &#00D9FFSkeleton Seeds&r. EMI shows the recipe if you press R while hovering over it."]
	quest.02E810A2D58CBEC3.quest_subtitle: "Obtain Skeleton Seeds"
	quest.02E991CBB6AB992B.quest_desc: ["Bring &#00D9FFDragon Blood Vial&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.02E991CBB6AB992B.quest_subtitle: "Obtain Dragon Blood Vial"
	quest.02EB96EA4A64DA01.quest_desc: ["Crafted with 4 &#00D9FFFluix Crystals&r in a 2x2 pattern you will obtain a &#00D9FFFluix Block&r."]
	quest.02EB96EA4A64DA01.quest_subtitle: "Obtain Fluix Block"
	quest.03002257490538C8.quest_desc: ["Bring &#00D9FFConfigurable Honeycomb&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.03002257490538C8.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.0305F6BC214119CF.quest_desc: ["Tier 1 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.0305F6BC214119CF.quest_subtitle: "Obtain Glyph Projectile"
	quest.03111EB3457F9F75.quest_desc: ["Get hold of &#00D9FFBlank Card&r. Hover over it in EMI and press R to see how it is made."]
	quest.03111EB3457F9F75.quest_subtitle: "Obtain Blank Card"
	quest.0312FBF9DE73FB5B.quest_desc: ["The leggings of the &#00D9FFIronwood&r armor set. Together with the chestplate, they unlock the helmet."]
	quest.03259AC69C0167C8.quest_desc: ["&#FFA500Monster Plus&r adds new hostile creatures and encounters. Stay alert while exploring and adapt your equipment to the threats you meet."]
	quest.03259AC69C0167C8.title: "Getting Started"
	quest.0337113F58D9ED70.quest_desc: ["Induction Cells provide the bulk storage of the battery. Capacity: 204.80 GFE."]
	quest.0337113F58D9ED70.quest_subtitle: "Obtain Elite Induction Cell"
	quest.033FDEA602740088.quest_desc: ["This quest asks for &#00D9FFOsage Orange Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.033FDEA602740088.quest_subtitle: "Obtain Osage Orange Sapling"
	quest.035DAAC67D4337B8.quest_desc: ["The &#00D9FFThallasium Hoe&r is a farming tool forged from &#00D9FFThallasium Ingots&r for tilling farmland." "It is part of &#00D9FFBetter End's&r earliest tool tier."]
	quest.035DAAC67D4337B8.quest_subtitle: "Obtain Thallasium Hoe"
	quest.036692B9714892B7.quest_desc: ["A crafting component for the &#00D9FFRainbow Furnace&r."]
	quest.036692B9714892B7.quest_subtitle: "Obtain Rainbow Plating"
	quest.0367109A7050BA27.quest_desc: ["By simply placing down the &#00D9FFAltar&r it will display how you need to place the pedestals."]
	quest.0367109A7050BA27.quest_subtitle: "Obtain Infusion Altar and 8x Infusion Pedestal"
	quest.0367109A7050BA27.title: "Infusion Altar and Pedestals"
	quest.0372F307B2B6D926.quest_desc: ["Simple redstone control for drive &#00D9FFShafts&r or &#00D9FFCogwheels&r."]
	quest.0372F307B2B6D926.quest_subtitle: "Obtain Clutch"
	quest.03739A6021AC1FC2.quest_desc: ["The &#00D9FFJukebox Upgrade&r lets you play music discs straight from your storage, so you do not need a separate jukebox." "The &#00D9FFAdvanced Jukebox Upgrade&r adds more control over your discs and playback."]
	quest.03739A6021AC1FC2.quest_subtitle: "Obtain Jukebox Upgrade and Advanced Jukebox Upgrade"
	quest.03739A6021AC1FC2.title: "Jukebox and Advanced Jukebox Upgrade"
	quest.03820542940AABD6.quest_desc: ["Make a &#00D9FFVanilla Milkshake&r and fill a bucket with it. It is one of the milkshakes in &#FFA500Create: Dreams n' Desires&r and also appears in some of the mod's more elaborate fluid recipes."]
	quest.03820542940AABD6.quest_subtitle: "Obtain Vanilla Milkshake Bucket"
	quest.03A378D31005B99D.quest_desc: ["&#00D9FFArchwood&r trees generate in every biome, most commonly in the &#00D9FFArchwood Forest&r. The base mod has 4 archwood types."]
	quest.03A378D31005B99D.quest_subtitle: "Obtain Smart Filter"
	quest.03A378D31005B99D.title: "Archwood Logs"
	quest.03A91D89E7C4153D.quest_desc: ["You can use substrate, water, and liquid ethylene in a &#00D9FFPressurized Reaction Chamber&r to make an &#00D9FFHDPE Pellet&r. These pellets are used to make sheets and rods, which make various blocks, machines, and upgrades."]
	quest.03A91D89E7C4153D.quest_subtitle: "Obtain Hdpe Pellet"
	quest.03AFD7996A27511C.quest_desc: ["Craft a &#00D9FFBlack Steel Sword&r from &#FFA500Cataclysm&r. It deals heavy damage against dangerous enemies and belongs to the &#00D9FFBlack Steel&r equipment set."]
	quest.03AFD7996A27511C.quest_subtitle: "Obtain Black Steel Sword"
	quest.03B6ED82B0291F4D.quest_desc: ["The soft fur keeps you safe from the &#00D9FFGlacier's&r cold."]
	quest.03B6ED82B0291F4D.quest_subtitle: "Line your gear with Alpha Yeti Fur"
	quest.03B6F3FCD19E2413.quest_desc: ["Bring &#00D9FFThread Chilling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.03B6F3FCD19E2413.quest_subtitle: "Obtain Thread Chilling"
	quest.03CB77A6DA0228B2.quest_desc: ["This quest asks for &#00D9FFHot Cream Cone&r. EMI shows the recipe if you press R while hovering over it."]
	quest.03CB77A6DA0228B2.quest_subtitle: "Obtain Hot Cream Cone"
	quest.03D230EA5473B03F.quest_desc: ["Get hold of &#00D9FFMusic Disc Wait&r. Hover over it in EMI and press R to see how it is made."]
	quest.03D230EA5473B03F.quest_subtitle: "Obtain Music Disc Wait"
	quest.03DA423C597944B9.quest_desc: ["Bring &#00D9FFRoller Skate&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.03DA423C597944B9.quest_subtitle: "Obtain Roller Skate"
	quest.03DA5DD590484294.quest_desc: ["Induction Cells provide the bulk storage of the battery. Capacity: 3.2 GRF."]
	quest.03DA5DD590484294.quest_subtitle: "Obtain Basic Induction Cell"
	quest.03DACD9B79FA1E57.quest_desc: ["For only a measly 8EU/t, the &#00D9FFSteam Farmer&r can perform the following things: Tilling: When enabled, dirt blocks will be turned into farmland. This will not work unless water is supplied. Hydrating: When supplied with water, tilled soil will be hydrated. Harvesting: When there is enough output space provided, it will harvest fully grown crops and trees. &#00D9FFPlating&r: When supplied with crops or saplings, it will plant them on valid soil. Using different plating modes will plant them in different arrangements."]
	quest.03DACD9B79FA1E57.quest_subtitle: "Obtain Steam Farmer, 7x Bronze Machine Casing Pipe and 26x Bronze Plated Bricks"
	quest.03E0202A37564A13.quest_desc: ["This quest asks for &#00D9FFTertium Farmland&r. EMI shows the recipe if you press R while hovering over it."]
	quest.03E0202A37564A13.quest_subtitle: "Obtain Tertium Farmland"
	quest.03E882FF1F52E0F5.quest_desc: ["Get hold of &#00D9FFUpgrade Gold&r2. Hover over it in EMI and press R to see how it is made."]
	quest.03E882FF1F52E0F5.quest_subtitle: "Obtain Upgrade Gold2"
	quest.03EB5B8E01725CEE.quest_desc: ["Bring &#00D9FFLarge Steam Boiler&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.03EB5B8E01725CEE.quest_subtitle: "Obtain Large Steam Boiler"
	quest.03EB5B8E01725CEE.title: "Kiss Your Fuel Goodbye!"
	quest.040631F1D08D19EA.quest_desc: ["Brassy on the edges, but classy-not-brassy all over."]
	quest.040631F1D08D19EA.quest_subtitle: "Obtain Brass Casing"
	quest.041C6B1A87A4492E.quest_desc: ["This quest asks for &#00D9FFPiranha Bucket&r. EMI shows the recipe if you press R while hovering over it."]
	quest.041C6B1A87A4492E.quest_subtitle: "Obtain Piranha Bucket"
	quest.042E1D71D486A576.quest_desc: ["The &#00D9FFStarlit Diamond Pickaxe&r is a late-game mining tool made from &#00D9FFStarlit Diamond&r materials." "It mines much more efficiently than &#00D9FFGlacite and Springstone&r tools and is the last step before celestial weapon progression."]
	quest.042E1D71D486A576.quest_subtitle: "Obtain Starlit Diamond Pickaxe"
	quest.0439891C7681967A.quest_desc: ["Automates the furnace using items from the storage."]
	quest.0439891C7681967A.quest_subtitle: "Obtain Auto Smelting Upgrade"
	quest.044C58AB635DD2B8.quest_desc: ["Gives more control over when to use potions, milk buckets, or food with effects."]
	quest.044C58AB635DD2B8.quest_subtitle: "Obtain Advanced Alchemy Upgrade"
	quest.044E89EDFE34FE6C.quest_desc: ["&#00D9FFSulfur&r can be obtained by mining the ore underground, or by processing gunpowder with oxygen in a chemical injection chamber. You will need to make &#00D9FFSulfuric Acid&r with this sulfur."]
	quest.044E89EDFE34FE6C.quest_subtitle: "Obtain Dust Sulfur"
	quest.044FAE6E9C0D85A4.quest_desc: ["This quest asks for &#00D9FFCoral Seeds&r. EMI shows the recipe if you press R while hovering over it."]
	quest.044FAE6E9C0D85A4.quest_subtitle: "Obtain Coral Seeds"
	quest.04546DD184DA76B1.quest_desc: ["The &#00D9FFElite Fluid Tank&r is an upgraded version of the &#00D9FFAdvanced Fluid Tank&r that can hold &#00D9AA56000 mB&r of liquid. You can toggle its &#00D9FFBucket Mode&r on and off by shift-right clicking while holding it. When &#00D9FFBucket Mode&r is on it can collect water and lava like a bucket. When &#00D9FFBucket Mode&r is off it can be placed like a block so you can attach &#00D9FFMechanical Pipe&r to it."]
	quest.04546DD184DA76B1.quest_subtitle: "Obtain Elite Fluid Tank"
	quest.04680DFFB36F4C48.quest_desc: ["Tier 2 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.04680DFFB36F4C48.quest_subtitle: "Obtain Glyph Dampen"
	quest.046BAD21D9397B5C.quest_desc: ["The &#00D9FFAnnihilation Plane&r will break blocks and pick up items directly in front of it."]
	quest.046BAD21D9397B5C.quest_subtitle: "Obtain Annihilation Plane and Formation Plane"
	quest.046BAD21D9397B5C.title: "ME Planes"
	quest.0479BA53DFA3BCD2.quest_desc: ["Common resources are somewhat scarcer than their &#00D9FFAbundant&r counterparts, but are still relatively easy to find."]
	quest.0479BA53DFA3BCD2.quest_subtitle: "Obtain Alchemical Sulfur Osmium, Alchemical Sulfur Nickel, Alchemical Sulfur Lead and 6 more items"
	quest.0479BA53DFA3BCD2.title: "Common Sulfurs"
	quest.0480A2ACBE05260F.quest_desc: ["The Accumulator from &#FFA500Create Crafts and Additions&r is an energy storage block for &#00D9FFForge Energy&r (FE). Connect it to your network to save power for later, which is handy for buffering between generators and machines with uneven demand. The current &#00D9FFNeoForge&r 1.21.1 release of the mod is 1.6.0."]
	quest.0480A2ACBE05260F.quest_subtitle: "Obtain Modular Accumulator"
	quest.0483D05FCF6C526D.quest_desc: ["Adds a crafting grid to the storage."]
	quest.0483D05FCF6C526D.quest_subtitle: "Obtain Crafting Upgrade"
	quest.04A2E1F7B34D5290.quest_desc: ["&#00D9FFRare Ink&r is the third tier of magical ink in &#FFA500Iron's Spells 'n Spellbooks&r. It is used in the &#00D9FFScroll Forge&r to make &#00D9FFRare&r-rarity spell scrolls, and in the &#00D9FFArcane Anvil&r to upgrade scrolls that need &#00D9FFRare Ink&r." "You can find it in magic structures or get it from powerful magical creatures."]
	quest.04A2E1F7B34D5290.quest_subtitle: "Obtain Rare Ink"
	quest.04A2E1F7B34D5290.title: "Rare Ink"
	quest.04A8C232EA825D63.quest_desc: ["Get hold of &#00D9FFBattlemage Hood&r, &#00D9FFBattlemage Robes&r, &#00D9FFBattlemage Leggings and Battlemage Boots&r. Hover over it in EMI and press R to see how it is made."]
	quest.04A8C232EA825D63.quest_subtitle: "Obtain Battlemage Hood, Battlemage Robes, Battlemage Leggings and Battlemage Boots"
	quest.04C442B1564F13F7.quest_desc: ["Craft a &#00D9FFLightning Rod&r. It protects your structures from lightning strikes."]
	quest.04C442B1564F13F7.quest_subtitle: "Obtain Lightning Rod"
	quest.04C442B1564F13F7.title: "Catch the Lightning"
	quest.04CCFA4A76886726.quest_desc: ["Tier 1 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.04CCFA4A76886726.quest_subtitle: "Obtain Glyph Amplify"
	quest.04D17D4625DA1C77.quest_desc: ["A &#FFA500Mekanism&r machine upgrade to make them process items faster each &#FFA500Mekanism&r machine can store 8 of these upgrades."]
	quest.04D17D4625DA1C77.quest_subtitle: "Obtain Upgrade Speed"
	quest.04DD255BCC082736.quest_desc: ["Bring &#00D9FFBrown Shrooma&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.04DD255BCC082736.quest_subtitle: "Obtain Brown Shrooma"
	quest.04E52A67D5351CFD.quest_desc: ["Bring &#00D9FFMusic Disc&r 5 into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.04E52A67D5351CFD.quest_subtitle: "Obtain Music Disc 5"
	quest.04F28F76877D5CBB.quest_desc: ["Bring &#00D9FFMandarin Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.04F28F76877D5CBB.quest_subtitle: "Obtain Mandarin Sapling"
	quest.04F6758F8F06F5B0.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.04F6758F8F06F5B0.quest_subtitle: "Obtain Elite Injecting Factory"
	quest.04F8E790B6B969C1.quest_desc: ["The &#00D9FFCalculation Processor&r is made in an &#00D9FFInscriber&r from a &#00D9FFPrinted Calculation Circuit&r, &#00D9FFPrinted Silicon and Redstone&r. It is used for storage cells, crafting storage and more."]
	quest.04FBB7D8C2789148.quest_desc: ["The &#00D9FFAdvanced Solar Generator&r is a highly upgraded version of the basic &#00D9FFSolar Generator&r. Construction of an &#00D9FFAdvanced Solar Generator&r requires four &#00D9FFSolar Generators&r, but it produces six times the power of its smaller cousin. It also requires an area of 3x3x3 &#00D9FFBlocks&r in order to be placed."]
	quest.04FBB7D8C2789148.quest_subtitle: "Obtain Advanced Solar Generator"
	quest.04FCE3DA39375B25.quest_desc: ["Compacts items into their compressed variants. Only 2x2 recipes."]
	quest.04FCE3DA39375B25.quest_subtitle: "Obtain Compacting Upgrade"
	quest.050589083FF5E743.quest_desc: ["Get hold of &#00D9FFAnglerfish Bucket&r. Hover over it in EMI and press R to see how it is made."]
	quest.050589083FF5E743.quest_subtitle: "Obtain Anglerfish Bucket"
	quest.05169AACAFD296C7.quest_desc: ["These &#00D9FFExport Buses&r have more advanced functionality compared to the regular &#00D9FFExport Bus&r. &#00D9FFTag Export Bus&r exports items from filtered tags. &#00D9FFMod Export Bus&r exports items from filtered mods. &#00D9FFPrecise Export Bus&r exports the exact amount of items you set, no less, no more. &#00D9FFThreshold Export Bus&r exports items when the amount of items is above/below the set threshold."]
	quest.05169AACAFD296C7.quest_subtitle: "Obtain Tag Export Bus, Mod Export Bus, Precise Export Bus and Threshold Export Bus"
	quest.05169AACAFD296C7.title: "Advanced Export Buses"
	quest.052BA8035DDE0E09.quest_desc: ["Don’t be fooled… it may appear similar to the humble cauldron, but is flexible enough to work with &#00D9FFBelts&r, &#00D9FFFluid Pipes&r, and &#00D9FFMechanical Mixers and Presses&r, enabling the automation of many recipes."]
	quest.052BA8035DDE0E09.quest_subtitle: "Obtain Basin"
	quest.05334CEDD6D1FF3A.quest_desc: ["&#00D9FFArmor Tomes&r limit their stored enchantments to the matching armor category, which keeps gear progression focused."]
	quest.05334CEDD6D1FF3A.quest_subtitle: "Obtain Smart Filter"
	quest.05334CEDD6D1FF3A.title: "Tomes of Armor"
	quest.053443DA1DDBC511.quest_desc: ["&#00D9FFUraninite&r is the reactor fuel."]
	quest.053443DA1DDBC511.quest_subtitle: "Obtain Uraninite"
	quest.054B83A174D0427F.quest_desc: ["The leggings of the &#00D9FFNeptunium&r armor set. Together with the chestplate, they unlock the helmet."]
	quest.054D2D26D71D140A.quest_desc: ["You have reached the final step to invincibility. Armor infused with &#00D9FFQuantum Technology&r to repel all physical and magical attacks. You cannot die, not even by a &#00D9FFGod's Smite&r. You can now fly freely without the need of electricity. This set of armor interacts directly with the quantum realm to alter space and time surrounding you. Theoretically, you sitll be stationary, and space will just be moving relative to you. --This-- is the power you wield. This sword can and will slice through anything in it's path. The edge of it's blade has the ability to cleave through time and erase any entity you choose from existence. Use this power responsibly."]
	quest.054D2D26D71D140A.quest_subtitle: "Obtain Quantum Sword, Quantum Helmet, Quantum Leggings and 2 more items"
	quest.054D2D26D71D140A.title: "Quantum Armory"
	quest.055085FE22FDA8CB.quest_desc: ["This quest asks for &#00D9FFWing&r of the &#00D9FFWild Stalker&r. EMI shows the recipe if you press R while hovering over it."]
	quest.055085FE22FDA8CB.quest_subtitle: "Obtain Wing of the Wild Stalker"
	quest.0550AA9B785EB30E.quest_desc: ["The &#00D9FFArchevoker Hat&r is the headpiece of the &#00D9FFArchevoker Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. It gives &#00D9AA+3&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFEvocation Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "Craft it from 5 &#00D9FFArcane Cloth&r and 1 &#00D9FFEvocation Rune&r, or upgrade a &#00D9FFWizard Helmet&r with 1 &#00D9FFEvocation Rune&r at a &#00D9FFSmithing Table&r."]
	quest.0550AA9B785EB30E.quest_subtitle: "Obtain Archevoker Helmet"
	quest.05544D209000FDC6.quest_desc: ["&#00D9FFScarecrow Leggings&r are part of the &#00D9FFScarecrow Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. They give &#00D9AA+6&r &#00D9FFArmor&r and &#00D9AA+75&r &#00D9FFMax Mana&r." "Craft them from &#00D9FFHay Bales and Leather&r."]
	quest.05544D209000FDC6.quest_subtitle: "Obtain Pumpkin Leggings"
	quest.0561F734BC053E72.quest_desc: ["Bring &#00D9FFCreosote Bucket&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0561F734BC053E72.quest_subtitle: "Obtain Creosote Bucket"
	quest.05675F46ECA3A99A.quest_desc: ["Adds a jukebox to the storage."]
	quest.05675F46ECA3A99A.quest_subtitle: "Obtain Jukebox Upgrade"
	quest.0568907D9675E7BA.quest_desc: ["The Productivity upgrade will increase the number of combs a bee produces per trip."]
	quest.0568907D9675E7BA.quest_subtitle: "Obtain Upgrade Productivity 3"
	quest.05779A1233579600.quest_desc: ["The &#00D9FFStarlit Diamond Boots&r is crafted from &#00D9FFStarlit Diamonds&r in &#FFA500Eternal Starlight&r." "&#00D9FFStarlit Diamond&r armor gives protection comparable to &#00D9FFNetherite&r, with higher armor toughness and knockback resistance."]
	quest.05779A1233579600.quest_subtitle: "Obtain Starlit Diamond Boots"
	quest.057C87CCBAC1E6F0.quest_desc: ["Bring &#00D9FFTurbo Upgrade&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.057C87CCBAC1E6F0.quest_subtitle: "Obtain Turbo Upgrade"
	quest.057C87CCBAC1E6F0.title: "Gotta Go Fast"
	quest.05850E439ABECC5C.quest_desc: ["Get hold of &#00D9FFMenril Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.05850E439ABECC5C.quest_subtitle: "Obtain Menril Seeds"
	quest.0590CC808954BB66.quest_desc: ["Extracts a small sample from each pollinating bee on every visit, without hurting them."]
	quest.0590CC808954BB66.quest_subtitle: "Obtain Upgrade Gene Sampler"
	quest.059B625288CE656A.quest_desc: ["Craft &#00D9FFthe Apothic Enchanting Table&r and use &#00D9FFEterna&r, &#00D9FFQuanta and Arcana&r to push enchanting beyond vanilla limits, up to level 100."]
	quest.059B625288CE656A.quest_subtitle: "Obtain Smart Filter"
	quest.059B625288CE656A.title: "The Secrets of Enchanting"
	quest.059D260B8D391003.quest_desc: ["The &#00D9FFStarfire Smithing Template&r is a smithing item added by &#FFA500Eternal Starlight&r." "Use it at a smithing table to apply &#00D9FFStarfire&r-style armor trims. In newer versions it is also needed for some &#00D9FFStarfire&r weapons and gear."]
	quest.059D260B8D391003.quest_subtitle: "Obtain Starfire Upgrade Smithing Template"
	quest.059D260B8D391003.title: "Starfire Smithing Template"
	quest.05A3F4A64EC4B268.quest_desc: ["Makes the backpack pick up items within its range."]
	quest.05A3F4A64EC4B268.quest_subtitle: "Obtain Magnet Upgrade"
	quest.05A6199C5BDEE5EE.quest_desc: ["Used in &#00D9FFPattern Provides&r or &#00D9FFInterfaces&r, which allows them to provide power to touching blocks/cables."]
	quest.05A6199C5BDEE5EE.quest_subtitle: "Obtain Induction Card"
	quest.05A8D9F7FFB49788.quest_desc: ["This quest asks for &#00D9FFProsperity Seed Base&r. EMI shows the recipe if you press R while hovering over it."]
	quest.05A8D9F7FFB49788.quest_subtitle: "Obtain Prosperity Seed Base"
	quest.05B01CBA4E4FF697.quest_desc: ["Abundant resources tend to be everywhere and in great quantities."]
	quest.05B01CBA4E4FF697.quest_subtitle: "Obtain Alchemical Sulfur Fluorite, Alchemical Sulfur Copper, Alchemical Sulfur Coals and 2 more items"
	quest.05B01CBA4E4FF697.title: "Abundant Sulfurs"
	quest.05BA3D6173F0EE61.quest_desc: ["Increases movement speed after taking damage."]
	quest.05BA3D6173F0EE61.quest_subtitle: "Obtain Panic Necklace"
	quest.05C116FCF3DE3E89.quest_desc: ["&#00D9FFRed Chalk&r attracts and binds &#00D9FFAfrit&r, allowing them to do your bidding."]
	quest.05C116FCF3DE3E89.quest_subtitle: "Obtain Chalk Red Impure"
	quest.05ED85843DEE1F69.quest_desc: ["Not consumed when eaten."]
	quest.05ED85843DEE1F69.quest_subtitle: "Obtain Eternal Steak"
	quest.05F9C11582D88995.quest_desc: ["This unit attracts drops to you. It is stackable up to 4."]
	quest.05F9C11582D88995.quest_subtitle: "Obtain Module Magnetic Attraction Unit"
	quest.05FB39328B47F225.quest_desc: ["Bring Scroll into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.05FB39328B47F225.quest_subtitle: "Obtain Scroll"
	quest.05FD010B07B3C6C4.quest_desc: ["Bring &#00D9FFWirecutter&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.05FD010B07B3C6C4.quest_subtitle: "Obtain Wirecutter"
	quest.05FD801F0D4202FD.quest_desc: ["Get hold of &#00D9AA2x&r &#00D9FFCapacitor Hardened&r. Hover over it in EMI and press R to see how it is made."]
	quest.05FD801F0D4202FD.quest_subtitle: "Obtain 2x Capacitor Hardened"
	quest.05FD801F0D4202FD.title: "Hardened Capacitor"
	quest.0601E6F777AF3E03.quest_desc: ["The first piece of the &#00D9FFNeptunium&r armor set. Get the boots to unlock the chestplate and leggings."]
	quest.06020F92ADD95F9A.quest_desc: ["The core element for a molecular assembler of &#FFA500Create&r, basically. Tip: use a &#00D9FFRedstone&r signal next to an array of these to close all unused spots when crafting a smaller recipe."]
	quest.06020F92ADD95F9A.quest_subtitle: "Obtain Mechanical Crafter"
	quest.0611328B9AA27828.quest_desc: ["The &#00D9FFFlowglaze Shovel&r is a digging tool from &#FFA500Eternal Starlight&r in the &#00D9FFFlowglaze&r tier." "It is used for excavation and terrain clearing in mid-to-late game."]
	quest.0611328B9AA27828.quest_subtitle: "Obtain Flowglaze Shovel"
	quest.062312CBEC07CEA4.quest_desc: ["This quest asks for &#00D9FFIronwood Seeds&r. EMI shows the recipe if you press R while hovering over it."]
	quest.062312CBEC07CEA4.quest_subtitle: "Obtain Ironwood Seeds"
	quest.062557BB3627030F.quest_desc: ["&#00D9FFRobotic Arms&r are ways to automatically move things around within a machine. These can be very complex components and thus are made of &#00D9FFSteel&r to stay strong and prevent internal damage. You should automate these."]
	quest.062557BB3627030F.quest_subtitle: "Obtain Robot Arm"
	quest.062557BB3627030F.title: "Robotic Arms"
	quest.062990FC54A64086.quest_desc: ["Finish your &#00D9FFSteeleaf&r tool set by crafting the &#00D9FFSteeleaf Hoe and Steeleaf Shovel&r from &#00D9FFSteeleaf&r." "They combine the toughness of steel with &#FFA500Twilight Forest&r magic and make farming and clearing dirt and gravel quicker."]
	quest.062990FC54A64086.quest_subtitle: "Obtain Steeleaf Shovel and Steeleaf Hoe"
	quest.062990FC54A64086.title: "Steeleaf Farming Tools"
	quest.0646E9C66008AEC7.quest_desc: ["An &#00D9FFEnergy Cube&r is an advanced type of battery that is compatible with multiple energy systems. An upgraded version of the &#00D9FFElite Energy Cube&r."]
	quest.0646E9C66008AEC7.quest_subtitle: "Obtain Ultimate Energy Cube"
	quest.0650B75F3E47F798.quest_desc: ["Has a chance to not use durability."]
	quest.0650B75F3E47F798.quest_subtitle: "Obtain Iron Hook"
	quest.065E318C78569F9D.quest_desc: ["&#00D9FFPurple Chalk&r is common in rituals that bind spirits into objects."]
	quest.065E318C78569F9D.quest_subtitle: "Obtain Chalk Purple Impure"
	quest.066CC09B798DD4F8.quest_desc: ["The &#00D9FFWand of Teleportation&r is a utility item from &#FFA500Eternal Starlight&r that lets you change your position within the dimension."]
	quest.066CC09B798DD4F8.quest_subtitle: "Obtain Wand of Teleportation"
	quest.066CC09B798DD4F8.title: "Wand Of Teleportation"
	quest.0670493BA51AD712.quest_desc: ["This Rod is pre-attuned to locate a &#00D9FFPrecious&r material."]
	quest.0670493BA51AD712.quest_subtitle: "Obtain Sulfur Attuned Divination Rod Precious"
	quest.067482EBD1396F5D.quest_desc: ["Get hold of &#00D9FFPasta With Mutton Chop&r. Hover over it in EMI and press R to see how it is made."]
	quest.067482EBD1396F5D.quest_subtitle: "Obtain Pasta With Mutton Chop"
	quest.0685BB9C32DADAEB.quest_desc: ["Bring &#00D9FFThread Spellpower&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0685BB9C32DADAEB.quest_subtitle: "Obtain Thread Spellpower"
	quest.06975678373ECB6F.quest_desc: ["The gas upgrade allows you to increase the gas usage efficiency of a &#FFA500Mekanism&r machine which allows it."]
	quest.06975678373ECB6F.quest_subtitle: "Obtain Upgrade Chemical"
	quest.06AFF5AA8D301CAF.quest_desc: ["Tier 1 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.06AFF5AA8D301CAF.quest_subtitle: "Obtain Glyph Harm"
	quest.06B1240564793C36.quest_desc: ["Get hold of &#00D9FFHearthflame&r. Hover over it in EMI and press R to see how it is made."]
	quest.06B1240564793C36.quest_subtitle: "Obtain Hearthflame"
	quest.06B71EE7F817538C.quest_desc: ["The chestplate of the &#00D9FFSupremium&r armor set. Together with the leggings, it unlocks the helmet."]
	quest.06BA5A44D6F83E79.quest_desc: ["The &#00D9FFSpud Sentry&r is a potato-powered defensive contraption from &#FFA500Create: Dreams n' Desires&r, an unusual way to deal with unwanted visitors. It was added in version 2.3a-BETA for &#00D9FFMinecraft&r 1.21.1."]
	quest.06BA5A44D6F83E79.quest_subtitle: "Obtain Spud Sentry"
	quest.06CF2064C1A7E199.quest_desc: ["This quest asks for &#00D9FFBlazegold Sword&r. EMI shows the recipe if you press R while hovering over it."]
	quest.06CF2064C1A7E199.quest_subtitle: "Obtain Blazegold Sword"
	quest.06D651E9534EE05C.quest_desc: ["Bring Ratatouille into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.06D651E9534EE05C.quest_subtitle: "Obtain Ratatouille"
	quest.06D98BEC4C8EDFA3.quest_desc: ["Potion jars store up to 100 potions and may be used to create source when near an alchemical source link."]
	quest.06D98BEC4C8EDFA3.quest_subtitle: "Obtain Potion Jar"
	quest.06E649C796F00D82.quest_desc: ["The &#00D9FFModule Base&r is the basic component used in crafting modules and upgrades for your &#00D9FFMekaSuit&r."]
	quest.06E649C796F00D82.quest_subtitle: "Obtain Module Base"
	quest.06E6B0D3C8820A30.quest_desc: ["Get hold of &#00D9FFBlaze Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.06E6B0D3C8820A30.quest_subtitle: "Obtain Blaze Seeds"
	quest.06E87EA3BF94C5A1.quest_desc: ["Bring &#00D9FFCork Oak Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.06E87EA3BF94C5A1.quest_subtitle: "Obtain Cork Oak Sapling"
	quest.06EC1E8F4CECF079.quest_desc: ["Get hold of &#00D9FFStone Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.06EC1E8F4CECF079.quest_subtitle: "Obtain Stone Seeds"
	quest.06EC63FBB2B7E53D.quest_desc: ["Facilitates having multiple fluids flowing in your pipe networks."]
	quest.06EC63FBB2B7E53D.quest_subtitle: "Obtain Smart Fluid Pipe"
	quest.06EF894CFBEF92A7.quest_desc: ["&#00D9FFDoor Steps&r are compact, practical steps for your train entrances. The &#00D9FFAndesite&r, &#00D9FFCopper and Brass&r variants let you match your train's style." "It is worth collecting all three."]
	quest.06EF894CFBEF92A7.quest_subtitle: "Obtain Andesite Door Step, Brass Door Step and Copper Door Step"
	quest.06F13E1509E696C9.quest_desc: ["Scylla drops &#00D9FFEssence&r of the &#00D9FFStorm&r in &#FFA500Cataclysm&r, 3 to 4 per defeat." "This rare material is used to craft &#00D9FFAcropolis&r weapons such as &#00D9FFAstrape and Ceraunus&r."]
	quest.06F13E1509E696C9.quest_subtitle: "Obtain Essence of the Storm"
	quest.06FF6BA5768C6714.quest_desc: ["Tier 2 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.06FF6BA5768C6714.quest_subtitle: "Obtain Glyph Gravity"
	quest.0700F02340DDEA28.quest_desc: ["Adds a crafting grid to the backpack."]
	quest.0700F02340DDEA28.quest_subtitle: "Obtain Crafting Upgrade"
	quest.0715D941E2F684C1.quest_desc: ["Bring &#00D9FFSnail&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0715D941E2F684C1.quest_subtitle: "Obtain Snail"
	quest.071F381F40CB480E.quest_desc: ["&#00D9FFFusion Reactors&r are an amazing generator for &#FFA500Mekanism&r. Virtually running off of water, they can generate a massive amount of power. They, also, can be used to generate a metric ton of heat and steam. However, you will need &#00D9FFPolonium&r from &#00D9FFFission Reactors&r to create the casings."]
	quest.071F381F40CB480E.quest_subtitle: "Obtain Fusion Reactor Controller"
	quest.072E3000C6E5FF4D.quest_desc: ["Used in the creation of some glyphs."]
	quest.072E3000C6E5FF4D.quest_subtitle: "Obtain Water Essence"
	quest.0736642369D2FA70.quest_desc: ["Obtained when you let your &#00D9FFEntroized Clusters&r grow to the max stage."]
	quest.0736642369D2FA70.quest_subtitle: "Obtain Entro Crystal"
	quest.0743A6CF68A44E7C.quest_desc: ["Get hold of &#00D9FFHazmat Mask&r, &#00D9FFHazmat Gown&r, &#00D9FFHazmat Pants and Hazmat Boots&r. Hover over it in EMI and press R to see how it is made."]
	quest.0743A6CF68A44E7C.quest_subtitle: "Obtain Hazmat Mask, Hazmat Gown, Hazmat Pants and Hazmat Boots"
	quest.074B1638C84A8B76.quest_desc: ["Get hold of &#00D9FFCelestigem Axe&r. Hover over it in EMI and press R to see how it is made."]
	quest.074B1638C84A8B76.quest_subtitle: "Obtain Celestigem Axe"
	quest.074ECC9A8B55CD7A.quest_desc: ["Gives the spawner additional spawning behavior, making a productive spawner even more productive."]
	quest.074ECC9A8B55CD7A.quest_subtitle: "Obtain Echoing Spawner Rune"
	quest.074ECC9A8B55CD7A.title: "Echoing Spawner Rune"
	quest.07540AFB82511BD0.quest_desc: ["Get hold of &#00D9FFFireward Ring&r. Hover over it in EMI and press R to see how it is made."]
	quest.07540AFB82511BD0.quest_subtitle: "Obtain Fireward Ring"
	quest.075E928BF17CFB99.quest_desc: ["&#00D9FFTenacious Petals&r are plants found across &#FFA500Eternal Starlight&r." "They are mainly used in recipes involving natural resources and progression items from the mod."]
	quest.075E928BF17CFB99.quest_subtitle: "Obtain Tenacious Petal"
	quest.075E928BF17CFB99.title: "Tenacious Petal"
	quest.075ECACCF45B7B90.quest_desc: ["Fires up your &#00D9FFBlaze Burners&r to new highs."]
	quest.075ECACCF45B7B90.quest_subtitle: "Obtain Blaze Cake"
	quest.076855CC603B3A6F.quest_desc: ["This quest asks for &#00D9FFBeliy Naliv Apple Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.076855CC603B3A6F.quest_subtitle: "Obtain Beliy Naliv Apple Sapling"
	quest.07A65D26D8CFC905.quest_desc: ["Used as a housing to hold &#00D9FFMEGA Storage Component&r."]
	quest.07A65D26D8CFC905.quest_subtitle: "Obtain Mega Item Cell Housing, Mega Fluid Cell Housing and Mega Chemical Cell Housing"
	quest.07AE92951CA0EA97.quest_desc: ["Redirects spell projectiles. Place an &#00D9FFObserver&r next to it to detect when a spell hits the prism."]
	quest.07AE92951CA0EA97.quest_subtitle: "Obtain Spell Prism"
	quest.07B2A60C5B87A36D.quest_desc: ["The &#00D9FFAmaramber Shovel&r was added in version 0.4.2 as part of the &#00D9FFAmaramber&r set in &#FFA500Eternal Starlight&r." "It digs terrain and soft blocks."]
	quest.07B2A60C5B87A36D.quest_subtitle: "Obtain Amaramber Shovel"
	quest.07BE5BDA66B8ED52.quest_desc: ["The &#00D9FFPrinter&r from &#FFA500Create: Enchantment Industry&r automatically copies written books, enchanted books, name tags, train schedules and other supported items." "It uses the matching blank item as material and can use &#00D9FFLiquid Experience&r when copying enchanted books. It can also copy package patterns or addresses for &#FFA500Create&r logistics."]
	quest.07BE5BDA66B8ED52.quest_subtitle: "Obtain Printer"
	quest.07D0F4B51DC6A59F.quest_desc: ["This quest asks for &#00D9FFPoisonward Ring&r. EMI shows the recipe if you press R while hovering over it."]
	quest.07D0F4B51DC6A59F.quest_subtitle: "Obtain Poisonward Ring"
	quest.07DFC9127AFA1571.quest_desc: ["Allows short-term creative flight."]
	quest.07DFC9127AFA1571.quest_subtitle: "Obtain Ritual Flight"
	quest.07F0E5F57BA7A176.quest_desc: ["A ProsperiBee is obtained by right-clicking a &#00D9FFCrystalline Bee&r with a block of prosperity."]
	quest.07F0E5F57BA7A176.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.07F160582D132F6E.quest_desc: ["This quest asks for &#00D9FFLimited Diamond Barrel&r 4. EMI shows the recipe if you press R while hovering over it."]
	quest.07F160582D132F6E.quest_subtitle: "Obtain Limited Diamond Barrel 4"
	quest.0803F488F9A8EAB8.quest_desc: ["Used in the creation of some glyphs."]
	quest.0803F488F9A8EAB8.quest_subtitle: "Obtain Conjuration Essence"
	quest.08092F782620EAC0.quest_desc: ["Get hold of &#00D9FFConfigurable Honeycomb&r. Hover over it in EMI and press R to see how it is made."]
	quest.08092F782620EAC0.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.0809BCE3D2AB5D67.quest_desc: ["Give this scroll to a starbuncle, and it will help keep you further organized."]
	quest.0809BCE3D2AB5D67.quest_subtitle: "Obtain Allow Scroll"
	quest.080F6B0890632E1A.quest_desc: ["The &#00D9FFAeternium Hammer&r is a heavy tool and weapon forged from &#00D9FFAeternium&r, &#00D9FFBetter End's&r strongest material." "You need an &#00D9FFAeternium Anvil&r and a &#00D9FFNetherite&r or &#00D9FFAeternium Smith Hammer&r to make it."]
	quest.080F6B0890632E1A.quest_subtitle: "Obtain Aeternium Hammer"
	quest.08117AF342EE6F73.quest_desc: ["Defeat a &#00D9FFStalker&r, among the most dangerous hunters in the &#00D9FFOtherside&r." "It drops &#00D9FFSoul Crystals&r."]
	quest.08117AF342EE6F73.quest_subtitle: "Defeat Stalker"
	quest.08117AF342EE6F73.title: "Stalker"
	quest.0812F7EC36AC22C1.quest_desc: ["Bring &#00D9FFDisk Drive&r 256k into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0812F7EC36AC22C1.quest_subtitle: "Obtain Disk Drive 256k"
	quest.081455DC4E76C402.quest_desc: ["Ah, the &#00D9FFWindmill Bearing&r. Good for self-powered small contraptions (often for farming). The common step between &#00D9FFWater Wheels and Steam Engines&r, in the &#FFA500Create&r-or's quest for &#00D9FFMOAR POWAH&r."]
	quest.081455DC4E76C402.quest_subtitle: "Obtain Windmill Bearing and White Sail"
	quest.08209E06C4B63BB9.quest_desc: ["Get hold of &#00D9FFVegetable Noodles&r. Hover over it in EMI and press R to see how it is made."]
	quest.08209E06C4B63BB9.quest_subtitle: "Obtain Vegetable Noodles"
	quest.08366828C21BF8E2.quest_desc: ["It ejects.. this, that, cows, creepers, sheep, or even players."]
	quest.08366828C21BF8E2.quest_subtitle: "Obtain Weighted Ejector"
	quest.0837DA117207DBF1.quest_desc: ["Make &#00D9FFthe Warden Chestplate&r in a &#00D9FFMechanical Crafter&r using a &#00D9FFNetherite Chestplate&r, &#00D9FFEcho Ingots&r, &#00D9FFWarden Carapace&r, a &#00D9FFReinforced Echo Shard&r and a &#00D9FFWarden Upgrade Template&r. The Heart of the &#00D9FFDeep&r is needed too." "Enchantments on the netherite piece are not kept, so enchant the result afterwards."]
	quest.0837DA117207DBF1.quest_subtitle: "Obtain Warden Chestplate"
	quest.083DAFDC37FAFA90.quest_desc: ["&#00D9FFContraption Controls&r let you enable or disable specific &#00D9FFContraption Actors&r while a contraption is assembled. Right-click them to toggle actors such as &#00D9FFMechanical Drills&r, &#00D9FFSaws&r, &#00D9FFDeployers&r, &#00D9FFHarvesters&r, &#00D9FFRollers&r, &#00D9FFFunnels&r, &#00D9FFPortable Storage Interfaces and Redstone Contacts&r." "You can apply a &#00D9FFFilter&r while the block is stationary to affect only one actor type. If &#00D9FFthe Controls&r receive a &#00D9FFRedstone&r signal before and during assembly, the selected actors start disabled."]
	quest.083DAFDC37FAFA90.quest_subtitle: "Obtain Contraption Controls"
	quest.08464DBA29C215D1.quest_desc: ["Lowers the trading prices of &#00D9FFVillagers&r."]
	quest.08464DBA29C215D1.quest_subtitle: "Obtain Villager Hat"
	quest.08491BDBC4418A41.quest_desc: ["It is found in &#00D9FFAurora Palaces&r and cannot be crafted. It inflicts &#00D9FFFrosted III&r for &#00D9AA10 seconds&r. Its damage is slightly above a diamond sword, but its durability is low."]
	quest.08491BDBC4418A41.quest_subtitle: "Find the Ice Sword"
	quest.08491BDBC4418A41.title: "The Ice Sword"
	quest.08499F9D4B1D1554.quest_desc: ["These are the highest level spellbooks an experienced mage can Obtain."]
	quest.08499F9D4B1D1554.quest_subtitle: "Obtain Smart Filter"
	quest.08499F9D4B1D1554.title: "Magelike Spellbooks"
	quest.08509EC82C282FBC.quest_desc: ["Use this tablet to summon familiars."]
	quest.08509EC82C282FBC.quest_subtitle: "Obtain Ritual Binding"
	quest.08532DB1F9710D23.quest_desc: ["The &#00D9FFBlaze Jet Wand&r has &#00D9FFLava Repair&r, like other Tier 2 equipment, and &#00D9FFAir Burst&r, which blasts you into the air. &#FFA500Just Dire Things&r wand abilities are built in, and holding one in your hand prevents fall damage."]
	quest.08532DB1F9710D23.quest_subtitle: "Obtain Blazejet Wand"
	quest.0854F496E96C0268.quest_desc: ["Bring &#00D9FFBlazegold Helmet&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0854F496E96C0268.quest_subtitle: "Obtain Blazegold Helmet"
	quest.08561D0E65A2A072.quest_desc: ["Bring &#00D9FFEnergy Discharger Hardened&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.08561D0E65A2A072.quest_subtitle: "Obtain Energy Discharger Hardened"
	quest.0859DD1482ADD6A8.quest_desc: ["Grants a temporary &#00D9FFHaste&r effect after eating."]
	quest.0859DD1482ADD6A8.quest_subtitle: "Obtain Onion Ring"
	quest.085D807883DA768C.quest_desc: ["Upgrades an &#00D9FFIron&r tier or below to &#00D9FFGold&r tier."]
	quest.085D807883DA768C.quest_subtitle: "Obtain Basic to Gold Tier Upgrade, Copper to Gold Tier Upgrade and Iron to Gold Tier Upgrade"
	quest.085D807883DA768C.title: "Gold Tier Upgrade"
	quest.0865F7360306A4FB.quest_desc: ["&#FFA500Illager Invasion&r adds new illager enemies and combat encounters. Learn their attack patterns and choose equipment that suits each fight."]
	quest.0865F7360306A4FB.title: "Getting Started"
	quest.086818AFF19AC2F4.quest_desc: ["Bring &#00D9FFBinding Card Dim&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.086818AFF19AC2F4.quest_subtitle: "Obtain Binding Card Dim"
	quest.086DF56E0F338DBB.quest_desc: ["The &#00D9FFGlacite Boots&r is crafted from &#00D9FFGlacite&r materials in &#FFA500Eternal Starlight&r." "Glacite armor protects against freezing environments and slows enemies that attack you."]
	quest.086DF56E0F338DBB.quest_subtitle: "Obtain Glacite Boots"
	quest.08710F87B744144D.quest_desc: ["Heals you for a share of the melee damage you deal. As it ranks up it gains kill streaks, a heal on kills and &#00D9FFAbsorption&r hearts."]
	quest.08710F87B744144D.quest_subtitle: "Obtain Vampiric Glove"
	quest.088518E226474E58.quest_desc: ["Makes the spawner ignore normal spawning conditions."]
	quest.088518E226474E58.quest_subtitle: "Obtain Ignore Conditions Spawner Rune"
	quest.088518E226474E58.title: "Ignore Conditions Spawner Rune"
	quest.0889C2C61B1B19D7.quest_desc: ["A fatal hit teleports the wearer somewhere else instead."]
	quest.0889C2C61B1B19D7.quest_subtitle: "Obtain Chorus Totem"
	quest.089C7A7F4A5E70D4.quest_desc: ["Upgrade a &#00D9FFDeepshelf&r with an &#00D9FFEcho Shard&r and candles." "It gives &#00D9AA+5&r &#00D9FFEterna&r (up to 75) and &#00D9AA+15&r &#00D9FFArcana&r. A great pick for rare enchantments."]
	quest.089C7A7F4A5E70D4.quest_subtitle: "Obtain Echoing Deepshelf"
	quest.08A9E5F3D5AC7FA5.quest_desc: ["The &#00D9FFThallasium Ingot&r is the base metal of &#00D9FFBetter End's&r tool and armor progression." "&#00D9FFSmelt Thallasium&r ore from across the End, then forge the ingots into plating and tool heads with an &#00D9FFAnvil and Smith Hammer&r."]
	quest.08A9E5F3D5AC7FA5.quest_subtitle: "Obtain Thallasium Ingot"
	quest.08ACE44CB5705E73.quest_desc: ["&#00D9FFPriest Robes&r are the chestpiece of the &#00D9FFPriest Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. They give &#00D9AA+8&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFHoly Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r, and can hold 1 imbued spell." "Craft them from 8 &#00D9FFArcane Cloth&r and 1 &#00D9FFHoly Rune&r, or upgrade &#00D9FFWizard Robes&r with 1 &#00D9FFHoly Rune&r at a &#00D9FFSmithing Table&r in &#00D9FFMinecraft&r 1.20+."]
	quest.08ACE44CB5705E73.quest_subtitle: "Obtain Priest Chestplate"
	quest.08BDF067A6F94F07.quest_desc: ["Get hold of &#00D9FFPlate of Stuffed Hoglin&r. Hover over it in EMI and press R to see how it is made."]
	quest.08BDF067A6F94F07.quest_subtitle: "Obtain Plate of Stuffed Hoglin"
	quest.08C5ED76A219F76B.quest_desc: ["This quest asks for &#00D9FFFusion Reactor&r. EMI shows the recipe if you press R while hovering over it."]
	quest.08C5ED76A219F76B.quest_subtitle: "Obtain Fusion Reactor"
	quest.08C5ED76A219F76B.title: "Enslaved Star Core"
	quest.08C641685AD272A7.quest_desc: ["Your right-hand man, in brass mechanical form. Does things normally only a player can."]
	quest.08C641685AD272A7.quest_subtitle: "Obtain Deployer"
	quest.08CBA700A535DB64.quest_desc: ["This quest asks for &#00D9FFSalak Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.08CBA700A535DB64.quest_subtitle: "Obtain Salak Sapling"
	quest.08CCF826B64D4443.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.08CCF826B64D4443.quest_subtitle: "Obtain Ultimate Compressing Factory"
	quest.08CEB6C65260A671.quest_desc: ["The &#00D9FFExtended Charger&r can charge 4 items at the same time."]
	quest.08CEB6C65260A671.quest_subtitle: "Obtain Ex Charger"
	quest.08DC7CF608B52338.quest_desc: ["This quest asks for &#00D9FFBone Broth&r. EMI shows the recipe if you press R while hovering over it."]
	quest.08DC7CF608B52338.quest_subtitle: "Obtain Bone Broth"
	quest.08E13926AE218017.quest_desc: ["This device, when placed on a &#00D9FFMercury Catalyst&r, can power the &#00D9FFReformation Array&r."]
	quest.08E13926AE218017.quest_subtitle: "Obtain Sulfuric Flux Emitter"
	quest.0900475B11A6E92F.quest_desc: ["Bring &#00D9FFItem Storage Cell&r 1m into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0900475B11A6E92F.quest_subtitle: "Obtain Item Storage Cell 1m"
	quest.09101C58F5EA5242.quest_desc: ["This substance can be processed in a &#00D9FFThermopneumatic Processing Plant&r to produce LPG, which is an excellent liquid fuel."]
	quest.09101C58F5EA5242.quest_subtitle: "Obtain Gasoline Bucket"
	quest.09101C58F5EA5242.title: "Gasoline"
	quest.0910DDDD5C55F0B3.quest_desc: ["Craft it from &#00D9FFBeehives&r, &#00D9FFHoneycomb&r, &#00D9FFHoney Blocks&r and a bookshelf." "It gives &#00D9AA+100&r &#00D9FFQuanta&r but &#00D9AA-30&r &#00D9FFEterna&r. Use it when you want maximum randomness, such as in &#00D9FFInfusion&r recipes that need very high &#00D9FFQuanta&r."]
	quest.0910DDDD5C55F0B3.quest_subtitle: "Obtain Beeshelf"
	quest.0914A0697C92659E.quest_desc: ["A Beech tree can mutate into a &#00D9FFCopper Beech&r when growing."]
	quest.0914A0697C92659E.quest_subtitle: "Obtain Copper Beech Sapling"
	quest.0918ED0F9DD8A282.quest_desc: ["This quest asks for &#00D9FFThermo Generator Nitro&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0918ED0F9DD8A282.quest_subtitle: "Obtain Thermo Generator Nitro"
	quest.091D5EC66A61F451.quest_desc: ["Each Preheater needs at least &#00D9AA32 FE&r/t to run."]
	quest.091D5EC66A61F451.quest_subtitle: "Obtain 2x Blastfurnace Preheater"
	quest.091D5EC66A61F451.title: "Blast Furnace Preheaters"
	quest.091F769995DFC257.quest_desc: ["The &#00D9FFGraybeard Staff&r helps you regenerate mana and boosts your scroll power. It is one of the easier staffs to craft."]
	quest.091F769995DFC257.quest_subtitle: "Obtain Graybeard Staff"
	quest.092E3543805AC6E8.quest_desc: ["This quest asks for &#00D9FFGlitchy Mantle&r. EMI shows the recipe if you press R while hovering over it."]
	quest.092E3543805AC6E8.quest_subtitle: "Obtain Glitchy Mantle"
	quest.093A8504FB43DC72.quest_desc: ["Some say, the best looking fluid pipes in the game, they even sport windows to show fluid flowing within them."]
	quest.093A8504FB43DC72.quest_subtitle: "Obtain Fluid Pipe"
	quest.0945C7B89329C657.quest_desc: ["Gems have different levels of &#00D9FFPurity&r: Cracked, &#FFA500Chipped&r, &#00D9FFFlawed&r, &#00D9FFNormal&r, &#00D9FFFlawless and Perfect&r. The &#00D9FFGem Cutting Table&r can raise a &#00D9FFGem's Purity&r. &#FFA500Create&r a &#00D9FFFlawless Gem&r."]
	quest.0945C7B89329C657.quest_subtitle: "Obtain Smart Filter"
	quest.0945C7B89329C657.title: "Flawless"
	quest.09520D3AE7761258.quest_desc: ["Adds some speed control to &#00D9FFChain Drives&r."]
	quest.09520D3AE7761258.quest_subtitle: "Obtain Adjustable Chain Gearshift"
	quest.09710B73E2544DB9.quest_desc: ["Make &#00D9FFthe Resonarium Sword&r in a &#00D9FFMechanical Crafter&r using a &#00D9FFDiamond Sword&r, &#00D9FFSturdy Sheets&r, a &#00D9FFResonarium Plate&r and a &#00D9FFResonarium Upgrade Template&r." "The template can be found in &#00D9FFAncient Cities&r, &#00D9FFTrial Chambers and Strongholds&r."]
	quest.09710B73E2544DB9.quest_subtitle: "Obtain Resonarium Sword"
	quest.097404D1662B6D1F.quest_desc: ["Automatically smelts mined ores."]
	quest.097404D1662B6D1F.quest_subtitle: "Obtain Pickaxe Heater"
	quest.0979C3068C40FCF3.quest_desc: ["The &#00D9FFBlaze Enchanter&r from &#FFA500Create: Enchantment Industry&r uses &#00D9FFBlaze&r power to enchant automatically." "Set the enchantment with its filter, supply the required &#00D9FFLiquid Experience&r, and it enchants compatible items for you. It is a core machine for automated enchanting."]
	quest.0979C3068C40FCF3.quest_subtitle: "Obtain Blaze Enchanter"
	quest.0991A158078981DA.quest_desc: ["This quest asks for &#00D9FFFirecracker Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0991A158078981DA.quest_subtitle: "Obtain Firecracker Sapling"
	quest.0993EFBA59B7CE81.quest_desc: ["This quest asks for &#00D9FFHornbeam Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0993EFBA59B7CE81.quest_subtitle: "Obtain Hornbeam Sapling"
	quest.09A029581978900D.quest_desc: ["Bring &#00D9FFBronze Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.09A029581978900D.quest_subtitle: "Obtain Bronze Seeds"
	quest.09A787FE6D3DD7D6.quest_desc: ["&#00D9FFLiner Chasis and Rotational Chassis&r help build contraptions without superglue."]
	quest.09A787FE6D3DD7D6.quest_subtitle: "Obtain Linear Chassis"
	quest.09AA5E135B3F3B24.quest_desc: ["This Machine is an autoclicker it does what it says clicks on stuff, Can be configured."]
	quest.09AA5E135B3F3B24.quest_subtitle: "Obtain Clickert1"
	quest.09B6FCE53B301FD5.quest_desc: ["Obtain a &#00D9FFRadial Chassis&r, &#00D9FFLinear Chassis and Secondary Linear Chassis&r from &#FFA500Create&r. They are essential for building moving contraptions." "The &#00D9FFRadial Chassis&r connects blocks within a radius and the &#00D9FFLinear Chassis&r connects them along a line. The &#00D9FFSecondary Linear Chassis&r does not connect to regular &#00D9FFLinear Chassis&r, so separate sections can move independently."]
	quest.09B6FCE53B301FD5.quest_subtitle: "Obtain Linear Chassis, Secondary Linear Chassis and Radial Chassis"
	quest.09B6FCE53B301FD5.title: "All Chassis"
	quest.09B93532C67F6F93.title: "Alpha Yeti"
	quest.09D1591109655EDE.quest_desc: ["Make a &#00D9FFChocolate Milkshake&r and fill a bucket with it. It is a sweet addition from &#FFA500Create: Dreams n' Desires&r for your factory."]
	quest.09D1591109655EDE.quest_subtitle: "Obtain Chocolate Milkshake Bucket"
	quest.09D690F4DD1D4EF9.quest_desc: ["Take a little nether quartz, combine with redstone, then sand it all nicely, and bam!.."]
	quest.09D690F4DD1D4EF9.quest_subtitle: "Obtain Polished Rose Quartz"
	quest.09DB1F5FAE8A6BEA.quest_desc: ["The &#00D9FFWaste Barrel&r is the only way to safely store nuclear waste. The top and bottom of the barrel are the only locations you can input and output from. You can NOT move the barrel by ANY means. If you do, the barrel will dump the waste into the area, and much like a meltdown, blanket a large radius in radiation. Waste barrels delete their contents by 1 mb/&#00D9AA20 ticks&r. So, it is a good idea to have several of these. You can, however, use nuclear waste for late &#FFA500Mekanism&r things."]
	quest.09DB1F5FAE8A6BEA.quest_subtitle: "Obtain Radioactive Waste Barrel"
	quest.09DCEDB89818C313.quest_desc: ["Get hold of &#00D9FFSweet Crabapple Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.09DCEDB89818C313.quest_subtitle: "Obtain Sweet Crabapple Sapling"
	quest.09DDEF1CDDC09939.quest_desc: ["&#00D9FFAndesite Tunnels&r are pretty basic, providing cover for &#00D9FFBelts&r and introduce basic item apportioning of items transported on them. You'll want to see the &#00D9FFBrass Tunnels&r for some useful expansions of tunnel's capabilities."]
	quest.09DDEF1CDDC09939.quest_subtitle: "Obtain Andesite Tunnel"
	quest.09E26B54D7355DE0.quest_desc: ["This quest asks for &#00D9FFGreater Healing Potion&r. EMI shows the recipe if you press R while hovering over it."]
	quest.09E26B54D7355DE0.quest_subtitle: "Obtain Greater Healing Potion"
	quest.09E4F80176CD315B.quest_desc: ["Get hold of &#00D9FFElectrolyzer&r. Hover over it in EMI and press R to see how it is made."]
	quest.09E4F80176CD315B.quest_subtitle: "Obtain Electrolyzer"
	quest.09E4F80176CD315B.title: "It's Got What Plants Crave"
	quest.09EDB43447A28FA4.quest_desc: ["Bring &#00D9FFCacao Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.09EDB43447A28FA4.quest_subtitle: "Obtain Cacao Sapling"
	quest.09EE008BC420EF8A.quest_desc: ["This quest asks for &#00D9FFHarden Insulating Resin&r. EMI shows the recipe if you press R while hovering over it."]
	quest.09EE008BC420EF8A.quest_subtitle: "Obtain Harden Insulating Resin"
	quest.09F2BDF757E5CE6C.quest_desc: ["Get hold of &#00D9FFConfigurable Honeycomb&r. Hover over it in EMI and press R to see how it is made."]
	quest.09F2BDF757E5CE6C.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.0A02669DEC32DB3B.quest_desc: ["Tier 1 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.0A02669DEC32DB3B.quest_subtitle: "Obtain Glyph Light"
	quest.0A03E0AF2483DC7F.quest_desc: ["The &#00D9FFAethersent Boots&r is crafted from &#00D9FFAethersent Ingots&r in &#FFA500Eternal Starlight&r." "It is part of the &#00D9FFAethersent&r armor set, tied to meteors and celestial materials found in the dimension."]
	quest.0A03E0AF2483DC7F.quest_subtitle: "Obtain Aethersent Boots"
	quest.0A047C9350F91338.quest_desc: ["Filters the items going in and out of the backpack through pipes."]
	quest.0A047C9350F91338.quest_subtitle: "Obtain Filter Upgrade"
	quest.0A229A0E21A22447.quest_desc: ["Bring &#00D9FFLimited Diamond Barrel&r 1 into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0A229A0E21A22447.quest_subtitle: "Obtain Limited Diamond Barrel 1"
	quest.0A2948B16FA2D8C8.quest_desc: ["Bring &#00D9FFBattery Niotic&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0A2948B16FA2D8C8.quest_subtitle: "Obtain Battery Niotic"
	quest.0A2B06A778D64612.quest_desc: ["&#00D9FFSculk Snappers and Sculk Leeches&r drop &#00D9FFSoul Dust&r. You can also get it by milling &#00D9FFSoul Crystals&r." "It is required for the &#00D9FFSoul Elytra&r."]
	quest.0A2B06A778D64612.quest_subtitle: "Obtain Soul Dust"
	quest.0A40A667BCA84840.quest_desc: ["The Bat allows you to see in the dark."]
	quest.0A40A667BCA84840.quest_subtitle: "Earn the advancement: Familiar Bat"
	quest.0A4600B1656C8E50.quest_desc: ["Bring &#00D9FFInferium Sword&r, &#00D9FFInferium Pickaxe&r, &#00D9FFInferium Shovel&r and 2 more items into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0A4600B1656C8E50.quest_subtitle: "Obtain Inferium Sword, Inferium Pickaxe, Inferium Shovel and 2 more items"
	quest.0A4600B1656C8E50.title: "Inferium Tools and Weaponry"
	quest.0A533AED133E1E5F.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.0A533AED133E1E5F.quest_subtitle: "Obtain Elite Sawing Factory"
	quest.0A5A6C7955C9062F.quest_desc: ["Bring &#00D9FFSalmon Roll&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0A5A6C7955C9062F.quest_subtitle: "Obtain Salmon Roll"
	quest.0A5D9A846FAFF859.quest_desc: ["Combine &#00D9FFCharged Certus Quartz&r with &#00D9FFNether Quartz and Redstone&r using AE2 crystal transformation. &#00D9FFFluix&r is used throughout the network."]
	quest.0A5D9A846FAFF859.title: "Create Fluix Crystals"
	quest.0A75CF2C7F7DB327.quest_desc: ["Occasionally causes nearby animals to breed."]
	quest.0A75CF2C7F7DB327.quest_subtitle: "Obtain Ritual Fertility"
	quest.0A7BB5598B89599C.quest_desc: ["&#00D9FFScarlet Trees&r in &#FFA500Eternal Starlight&r are known for their deep red color." "Harvest enough &#00D9FFScarlet Logs&r for crafting and building to widen your material options."]
	quest.0A7BB5598B89599C.quest_subtitle: "Obtain 10x Scarlet Log"
	quest.0A7BB5598B89599C.title: "Scarlet Wood"
	quest.0A8134FBEF8971F1.quest_desc: ["Get hold of &#00D9FFBluegill&r. Hover over it in EMI and press R to see how it is made."]
	quest.0A8134FBEF8971F1.quest_subtitle: "Obtain Bluegill"
	quest.0A992EB0FFAB38A8.quest_desc: ["The &#00D9FFScarecrow Hat&r is part of the &#00D9FFScarecrow Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. It gives &#00D9AA+3&r &#00D9FFArmor&r and &#00D9AA+75&r &#00D9FFMax Mana&r." "Craft it from a &#00D9FFLeather Cap&r and a &#00D9FFCarved Pumpkin&r."]
	quest.0A992EB0FFAB38A8.quest_subtitle: "Obtain Pumpkin Helmet"
	quest.0A9D18EBE7871834.quest_desc: ["&#00D9FFDivine Soulshard&r is a rare crafting material tied to the &#00D9FFHoly&r school in &#FFA500Iron's Spells 'n Spellbooks&r. It is used in advanced recipes for &#00D9FFHoly&r equipment and magical items." "Look for it from powerful holy enemies and in magical structures."]
	quest.0A9D18EBE7871834.quest_subtitle: "Obtain Divine Soulshard"
	quest.0AA333DE81E04FF9.quest_desc: ["Obtain a &#00D9FFPulse Timer&r from &#FFA500Create&r. It works as a compact &#00D9FFRedstone&r clock that repeatedly emits short pulses at an interval you set, from &#00D9AA2 ticks&r to &#00D9AA60 minutes&r." "It suits machines, farms, doors and other timed contraptions, and can be inverted to stay powered and emit short off-pulses."]
	quest.0AA333DE81E04FF9.quest_subtitle: "Obtain Pulse Timer"
	quest.0AA4F6566BC66B8A.quest_desc: ["When installed, bees that can teleport will no longer teleport when living in the hive with the upgrade."]
	quest.0AA4F6566BC66B8A.quest_subtitle: "Obtain Upgrade Anti Teleport"
	quest.0AB9F427B4CBC993.quest_desc: ["This quest asks for &#00D9FFConfigurable Honeycomb&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0AB9F427B4CBC993.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.0ABA1FAC1F4EE209.quest_desc: ["Tier 3 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.0ABA1FAC1F4EE209.quest_subtitle: "Obtain Glyph Split"
	quest.0AC2A7AA731943B6.quest_desc: ["&#00D9FFConveyor Belts&r are used to move items around within your machines. They use &#00D9FFMotors&r to turn and &#00D9FFRubber Sheets&r as a platform to move. You should automate these."]
	quest.0AC2A7AA731943B6.quest_subtitle: "Obtain Conveyor"
	quest.0AC2A7AA731943B6.title: "Conveyor Belts"
	quest.0AC7A53B0608B805.quest_desc: ["&#00D9FFArchevoker Leggings&r are part of the &#00D9FFArchevoker Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. They give &#00D9AA+6&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFEvocation Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "Craft them from 7 &#00D9FFArcane Cloth&r and 1 &#00D9FFEvocation Rune&r, or upgrade &#00D9FFWizard Leggings&r with 1 &#00D9FFEvocation Rune&r at a &#00D9FFSmithing Table&r."]
	quest.0AC7A53B0608B805.quest_subtitle: "Obtain Archevoker Leggings"
	quest.0AC98ACE5483FE90.quest_desc: ["Mine iron ore underground to get &#00D9FFRaw Iron&r. Iron is one of the most important materials in &#00D9FFMinecraft&r, used for durable tools, armor and many other items."]
	quest.0AC98ACE5483FE90.quest_subtitle: "Obtain 16x Raw Iron"
	quest.0AC98ACE5483FE90.title: "&#A9A9A9Raw &#E7E7E7Iron"
	quest.0ACFCA35DE306525.quest_desc: ["Get hold of &#00D9FFBlobfish Bucket&r. Hover over it in EMI and press R to see how it is made."]
	quest.0ACFCA35DE306525.quest_subtitle: "Obtain Blobfish Bucket"
	quest.0AE44306585B936A.quest_desc: ["With these &#00D9FFGoggles&r over your eyes, you will see as if you had the &#00D9FFThird Eye&r. You'll still be unable to harvest blocks though, without a specialized tool...."]
	quest.0AE44306585B936A.quest_subtitle: "Obtain Otherworld Goggles"
	quest.0AE5A5160961B9CE.quest_desc: ["The most robust type of &#00D9FFPressure Tube&r. These Tubes can be camouflaged and have the capability to accommodate &#00D9FFTube Modules&r, allowing for additional functionality."]
	quest.0AE5A5160961B9CE.quest_subtitle: "Obtain Advanced Pressure Tube"
	quest.0AFCF2AFDB70B423.quest_desc: ["Bring &#00D9FFEnderman Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0AFCF2AFDB70B423.quest_subtitle: "Obtain Enderman Seeds"
	quest.0B29B0FDBBFAB408.quest_desc: ["The &#00D9FFME Extended Pattern Access Terminal&r provides 2 extra features: First of all it adds a search bar and will highlight whatever is being searched in the &#00D9FFPattern Terminal&r. Secondly it will provide an In-&#00D9FFWorld Highlight&r of which &#00D9FFPattern Provider&r is stuck when doing large crafting jobs."]
	quest.0B29B0FDBBFAB408.quest_subtitle: "Obtain Ex Pattern Access Part and Wireless Ex Pat"
	quest.0B38D94672907F38.quest_desc: ["Amber bees can be found in the suspicious sand and gravel of &#00D9FFCold Ocean Ruins&r."]
	quest.0B38D94672907F38.quest_subtitle: "Get an Amber Bee spawn egg"
	quest.0B38D94672907F38.title: "Amber Bee"
	quest.0B49557F1950E99C.quest_desc: ["Baits attract fish that only live in certain biomes."]
	quest.0B49557F1950E99C.quest_subtitle: "Use baits for biome-specific fish"
	quest.0B49557F1950E99C.title: "Baits"
	quest.0B4BB6E8738DD48A.quest_desc: ["Get hold of &#00D9FFEclipsealloy Hoe&r. Hover over it in EMI and press R to see how it is made."]
	quest.0B4BB6E8738DD48A.quest_subtitle: "Obtain Eclipsealloy Hoe"
	quest.0B4D39DF4C83CF3B.quest_desc: ["Generates source from nearby potion jars."]
	quest.0B4D39DF4C83CF3B.quest_subtitle: "Obtain Alchemical Sourcelink"
	quest.0B504F45157D612C.quest_desc: ["Obtain a &#00D9FFThreshold Switch&r from &#FFA500Create&r. It monitors how full an inventory or fluid container is and emits a &#00D9FFRedstone&r signal at configurable thresholds." "It also supports filtering to track specific items, which is useful for stopping or starting machines when storage hits a chosen level."]
	quest.0B504F45157D612C.quest_subtitle: "Obtain Stockpile Switch"
	quest.0B56104ADC34D802.quest_desc: ["Get hold of &#00D9FFConfigurable Honeycomb&r. Hover over it in EMI and press R to see how it is made."]
	quest.0B56104ADC34D802.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.0B56489F768493CB.quest_desc: ["The &#00D9FFFlowglaze Shield&r is a defensive item from &#FFA500Eternal Starlight&r in the &#00D9FFFlowglaze&r tier." "It blocks incoming damage and fits mid-to-late game."]
	quest.0B56489F768493CB.quest_subtitle: "Obtain Flowglaze Shield"
	quest.0B60A0D49278215F.quest_desc: ["This quest asks for &#00D9FFFiery Sword and Fiery Pickaxe&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0B60A0D49278215F.quest_subtitle: "Craft Fiery tools"
	quest.0B60A0D49278215F.title: "Fiery Tools"
	quest.0B68D00CDAA58D3E.quest_desc: ["This quest asks for &#00D9FFBow Eclipsealloy&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0B68D00CDAA58D3E.quest_subtitle: "Obtain Bow Eclipsealloy"
	quest.0B76E8E2FCABF11A.quest_desc: ["Bring &#00D9FFSky Stone Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0B76E8E2FCABF11A.quest_subtitle: "Obtain Sky Stone Seeds"
	quest.0B77A338C8A47274.quest_desc: ["Bring &#00D9FFAwakened Supremium Gemstone&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0B77A338C8A47274.quest_subtitle: "Obtain Awakened Supremium Gemstone"
	quest.0B78F74BFFA4E46E.quest_desc: ["This quest asks for &#00D9FFBacon and Eggs&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0B78F74BFFA4E46E.quest_subtitle: "Obtain Bacon and Eggs"
	quest.0BAB71CC13B3829B.quest_desc: ["Stores hooks, bait, bobbers and fishing lines."]
	quest.0BAB71CC13B3829B.quest_subtitle: "Obtain Tackle Box"
	quest.0BC36833E71A47C1.quest_desc: ["Get hold of &#00D9FFScroll&r. Hover over it in EMI and press R to see how it is made."]
	quest.0BC36833E71A47C1.quest_subtitle: "Obtain Scroll"
	quest.0BCC913B06D84BE6.quest_desc: ["Get hold of &#00D9FFMv Lv Transformer&r. Hover over it in EMI and press R to see how it is made."]
	quest.0BCC913B06D84BE6.quest_subtitle: "Obtain Mv Lv Transformer"
	quest.0BCC913B06D84BE6.title: "Optimus Prime!"
	quest.0BCEBFD219A3F217.quest_desc: ["Craft &#00D9FFthe Terminite Helmet&r from &#00D9FFTerminite Plating&r at a &#00D9FFSmithing Table&r. It protects better than &#00D9FFThallasium&r." "It is also the base for the stronger &#00D9FFCrystalite and Aeternium&r helmets."]
	quest.0BCEBFD219A3F217.quest_subtitle: "Obtain Terminite Helmet"
	quest.0BD209565833C2E2.quest_desc: ["Bring &#00D9FFMusic Disc Precipice&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0BD209565833C2E2.quest_subtitle: "Obtain Music Disc Precipice"
	quest.0BFFD8BB50CDF55F.quest_desc: ["Get hold of &#00D9FFSoulstealer&r. Hover over it in EMI and press R to see how it is made."]
	quest.0BFFD8BB50CDF55F.quest_subtitle: "Obtain Soulstealer"
	quest.0C115D3DCD720CAE.quest_desc: ["&#FFA500Nullscape&r reworks End terrain and adds new landscapes beyond the central island. Explore the outer End to find its changed generation."]
	quest.0C115D3DCD720CAE.title: "Getting Started"
	quest.0C1CE44B24A01F1E.quest_desc: ["Awarded for defeating the &#00D9FFSilver Dungeon&r."]
	quest.0C1CE44B24A01F1E.quest_subtitle: "Earn the Valkyrie Hoe advancement"
	quest.0C268FA69D61657D.quest_desc: ["&#00D9FFBloody Vellum&r is a crafting ingredient in &#FFA500Iron's Spells 'n Spellbooks&r. It is made from &#00D9FFHogskin and Blood&r in the &#00D9FFAlchemist Cauldron&r." "It is used in recipes for strong &#00D9FFBlood&r equipment, including the &#00D9FFVampiric Spell Book&r."]
	quest.0C268FA69D61657D.quest_subtitle: "Obtain Bloody Vellum"
	quest.0C2A5D0BBAF40738.quest_desc: ["Get hold of &#00D9FFUpgrade Copper&r. Hover over it in EMI and press R to see how it is made."]
	quest.0C2A5D0BBAF40738.quest_subtitle: "Obtain Upgrade Copper"
	quest.0C30CBCAA3AD594A.quest_desc: ["The first piece of the &#00D9FFFiery&r armor set. Get the boots to unlock the chestplate and leggings."]
	quest.0C32521273868A44.quest_desc: ["Get hold of &#00D9FFPig Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.0C32521273868A44.quest_subtitle: "Obtain Pig Seeds"
	quest.0C351818B8A849B9.quest_desc: ["Make &#00D9FFthe Aeternium Forged Plate&r from an &#00D9FFAeternium Ingot&r at an &#00D9FFAnvil&r with a &#00D9FFSmith Hammer&r." "At a &#00D9FFSmithing Table&r, combine it with a piece of &#00D9FFTerminite&r armor and the &#00D9FFAeternium Upgrade Template&r to get &#00D9FFAeternium&r armor."]
	quest.0C351818B8A849B9.quest_subtitle: "Obtain Aeternium Forged Plate"
	quest.0C45D9FE812612A1.quest_desc: ["Voids items selected in its filter."]
	quest.0C45D9FE812612A1.quest_subtitle: "Obtain Void Upgrade"
	quest.0C491B59A9A1DB63.quest_desc: ["Place a Jar under a Cow, then drop an anvil onto it so the anvil falls on the Cow and the Jar."]
	quest.0C491B59A9A1DB63.quest_subtitle: "Catch a cow in a jar"
	quest.0C5DBFFFB2F59CB1.quest_desc: ["This quest asks for &#00D9FFStar Anise Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0C5DBFFFB2F59CB1.quest_subtitle: "Obtain Star Anise Sapling"
	quest.0C69305B569FFD74.quest_desc: ["Changes the area around the spawner where mobs can appear."]
	quest.0C69305B569FFD74.quest_subtitle: "Obtain Spawn Range Spawner Rune"
	quest.0C69305B569FFD74.title: "Spawn Range Spawner Rune"
	quest.0C6DFBDDBF8E3E7F.quest_desc: ["This quest asks for &#00D9FFAsai Palm Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0C6DFBDDBF8E3E7F.quest_subtitle: "Obtain Asai Palm Sapling"
	quest.0C71C0B3BBA32AE1.quest_desc: ["The &#00D9FFThermal Springstone Scythe&r is crafted from &#00D9FFThermal Springstone Ingots&r in &#FFA500Eternal Starlight&r." "It is a hybrid tool for wide melee attacks and efficient harvesting, and it also sets enemies on fire."]
	quest.0C71C0B3BBA32AE1.quest_subtitle: "Obtain Thermal Springstone Scythe"
	quest.0C723CB0ABBD7F44.quest_desc: ["This tool can be attuned (by sneak right-clicking) to certain blocks, to find their counterparts in the &#00D9FFOther Place&r. Such blocks must be harvested while under the &#00D9FFThird Eye&r. The available blocks you can search for are listed: &#00D9FFAndesite&r searches for &#00D9FFOtherstone&r. &#00D9FFOak Log&r searches for &#00D9FFOtherworld Wood&r. &#00D9FFNetherrack&r searches for &#00D9FFIesnium Ore&r."]
	quest.0C723CB0ABBD7F44.quest_subtitle: "Obtain Divination Rod"
	quest.0C7BA37AA45384F3.quest_desc: ["Prevents collisions and controls the flow of scheduled trains."]
	quest.0C7BA37AA45384F3.quest_subtitle: "Obtain Track Signal"
	quest.0C7F75FA3DD3A2CD.quest_desc: ["Earn the advancement: Explore &#FFA500Aether&r."]
	quest.0C7F75FA3DD3A2CD.quest_subtitle: "Earn the advancement: Explore Aether"
	quest.0C818F3CE5252447.quest_desc: ["The &#00D9FFFlowglaze Hoe&r is a farming tool from &#FFA500Eternal Starlight&r in the &#00D9FFFlowglaze&r tier." "It creates farmland and fits mid-to-late game."]
	quest.0C818F3CE5252447.quest_subtitle: "Obtain Flowglaze Hoe"
	quest.0C8FEAF343FC9CF5.quest_desc: ["The &#00D9FFPressurized Reaction Chamber&r (PRC) is used primarily to create &#00D9FFSubstrate&r (to create &#00D9FFHDPE Pellets&r), &#00D9FFHDPE Pellets&r (to create &#00D9FFHDPE Sheets&r), and &#00D9FFEthylene&r (an efficient source of fuel used in the Gas-&#00D9FFBurning Generator&r). It has a variable speed and energy usage dependent on the materials/gasses it is creating."]
	quest.0C8FEAF343FC9CF5.quest_subtitle: "Obtain Pressurized Reaction Chamber"
	quest.0C99C6407AC3FA74.quest_desc: ["Get hold of &#00D9FFPlastic&r. Hover over it in EMI and press R to see how it is made."]
	quest.0C99C6407AC3FA74.quest_subtitle: "Obtain Plastic"
	quest.0CA153DAC3A0965F.quest_desc: ["Blocks of primogel goo will also transform blocks of coal into raw primal coal. 3 to 4 &#00D9FFPrimal&r coal will drop from that raw primal coal. Has enough energy to burn &#00D9AA3x&r more items than normal coal."]
	quest.0CA153DAC3A0965F.quest_subtitle: "Obtain 7x Coal T1"
	quest.0CB9B52AAB455175.quest_desc: ["The &#00D9FFHighest Tiered Storage Cell&r in normal AE2, which can contain 262,144 bytes of storage. 262,144 bytes of storage can hold 32,512 &#00D9FFStacks&r of a single item. or 16,640 &#00D9FFStacks&r, while holding 63 &#00D9FFDifferent&r items."]
	quest.0CB9B52AAB455175.quest_subtitle: "Obtain Item Storage Cell 256k"
	quest.0CBFCABF985FA535.quest_desc: ["Used to levitate a moderate distance above the ground."]
	quest.0CBFCABF985FA535.quest_subtitle: "Obtain Belt of Levitation"
	quest.0CC20E08F04D3DD8.quest_desc: ["Obtain &#00D9FFPowdered Obsidian&r from &#FFA500Create&r. It is a special material used in more advanced &#FFA500Create&r crafting and processing."]
	quest.0CC20E08F04D3DD8.quest_subtitle: "Obtain Powdered Obsidian"
	quest.0CD9A1DD8A01F57A.quest_desc: ["Used in the creation of some glyphs."]
	quest.0CD9A1DD8A01F57A.quest_subtitle: "Obtain Abjuration Essence"
	quest.0CECCE39F937B483.quest_desc: ["Bring &#00D9AA36x&r &#00D9FFReactor Nitro&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0CECCE39F937B483.quest_subtitle: "Obtain 36x Reactor Nitro"
	quest.0CF12313811922D0.quest_desc: ["Use &#00D9FFthe Aeternium Upgrade Smithing Template&r at a &#00D9FFSmithing Table&r to upgrade a full piece of &#00D9FFTerminite&r armor into &#00D9FFAeternium&r." "Aeternium is the strongest material in &#00D9FFBetter End&r, better than &#00D9FFNetherite&r."]
	quest.0CF12313811922D0.quest_subtitle: "Obtain Aeternium Upgrade Smithing Template"
	quest.0CF1A4AE069898A3.quest_desc: ["&#00D9FFWarp Scrolls&r teleport you or create a portal. Use the scroll in your main hand to teleport yourself, or cast a spell with the &#00D9FFBlink&r glyph while holding it in your offhand to teleport a mob." "A &#00D9FFWarp Scroll&r is single use and cannot cross dimensions. A &#00D9FFStable Warp Scroll&r opens a temporary portal, can be used unlimited times and works across dimensions." "Right-click a blank scroll to set its location, and craft it shapeless to reset it."]
	quest.0CF1A4AE069898A3.quest_subtitle: "Obtain Warp Scroll and Stable Warp Scroll"
	quest.0CF1A4AE069898A3.title: "Warp Scrolls"
	quest.0D002CB70EC6DA83.quest_desc: ["Bring &#00D9FFPulsating Alloy Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0D002CB70EC6DA83.quest_subtitle: "Obtain Pulsating Alloy Seeds"
	quest.0D0B8C907AD9D56F.quest_desc: ["&#FFA500Doggy Talents Next&r lets you train and customize a companion dog. Explore its talents and care features to build a companion suited to your adventures."]
	quest.0D0B8C907AD9D56F.title: "Getting Started"
	quest.0D1428F25BFDCB7E.quest_desc: ["The &#00D9FFBucket of Experience&r holds &#00D9FFLiquid Experience&r from &#FFA500Create: Enchantment Industry&r, so you can store and carry experience as a fluid." "It can feed machines such as the &#00D9FFBlaze Forger&r and other experience-processing equipment, and the mod supports using it with automation."]
	quest.0D1428F25BFDCB7E.quest_subtitle: "Obtain Xp Bucket"
	quest.0D15454A97D2AF9B.quest_desc: ["This quest asks for &#00D9FFMagmator Blazing&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0D15454A97D2AF9B.quest_subtitle: "Obtain Magmator Blazing"
	quest.0D16D625FDD4AF58.quest_desc: ["This quest asks for &#00D9FFSoul Tree Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0D16D625FDD4AF58.quest_subtitle: "Obtain Soul Tree Sapling"
	quest.0D1B5D1B966FD627.quest_desc: ["Bring &#00D9FFInferium Watering Can&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0D1B5D1B966FD627.quest_subtitle: "Obtain Inferium Watering Can"
	quest.0D24246C9B7E4ED7.quest_desc: ["Bring &#00D9FFSmart Filter&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0D24246C9B7E4ED7.quest_subtitle: "Obtain Smart Filter"
	quest.0D2A68A5814A38DA.quest_desc: ["Pumps experience between the tank upgrade and the player."]
	quest.0D2A68A5814A38DA.quest_subtitle: "Obtain Xp Pump Upgrade"
	quest.0D2F98AF749809D6.quest_desc: ["&#00D9FFEnriched Redstone&r is used in the &#00D9FFMetallurgic Infuser&r. &#00D9FFEnriched Redstone&r yields 80 units of redstone in the &#00D9FFMetallurgic Infuser&r, the same as 8 redstone."]
	quest.0D2F98AF749809D6.quest_subtitle: "Obtain Enriched Redstone"
	quest.0D30EF2224604075.quest_desc: ["Bring &#00D9FFThread Repairing&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0D30EF2224604075.quest_subtitle: "Obtain Thread Repairing"
	quest.0D3542F369F1981A.quest_desc: ["Bring &#00D9FFIron Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0D3542F369F1981A.quest_subtitle: "Obtain Iron Seeds"
	quest.0D46DC992A7CDB10.quest_desc: ["Get hold of &#00D9FFMagmator Hardened&r. Hover over it in EMI and press R to see how it is made."]
	quest.0D46DC992A7CDB10.quest_subtitle: "Obtain Magmator Hardened"
	quest.0D48055EA367859C.quest_desc: ["Induction Provides make up the transfer rate of the battery, both input and output. Transfer Rate: 52.42 MFE/t."]
	quest.0D48055EA367859C.quest_subtitle: "Obtain Ultimate Induction Provider"
	quest.0D7977925697B42D.quest_desc: ["Your reactor can produce an incredible amount of steam, but there's no point making all that steam if you can't put it to work. The &#00D9FFIndustrial Turbine&r converts steam into FE by spinning its internal rotor and generating power. Build the central turbine components and surround them with the required multiblock structure. Connect the turbine to your reactor's steam output and watch the power roll in. Larger turbines can process more steam and generate more FE, making them an essential part of a serious power-generation setup."]
	quest.0D7977925697B42D.quest_subtitle: "Obtain 8x Turbine Blade, 4x Turbine Rotor, 64x Turbine Casing and 5 more items"
	quest.0D7977925697B42D.title: "Turbine Time"
	quest.0D810AA42ADD0560.quest_desc: ["Place it in a furnace's fuel slot. It works with &#00D9FFIron&r tier furnaces and above."]
	quest.0D810AA42ADD0560.quest_subtitle: "Obtain Item Heater"
	quest.0D81F9CC548BA96F.quest_desc: ["This Vat allows you to convert your &#00D9FFAlchemical Niter&r from one tier to another."]
	quest.0D81F9CC548BA96F.quest_subtitle: "Obtain Digestion Vat"
	quest.0D881960DADD1D33.quest_desc: ["This quest asks for &#00D9FFStone Pickaxe&r, &#00D9FFStone Sword and Stone Axe&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0D881960DADD1D33.quest_subtitle: "Obtain Stone Pickaxe, Stone Sword and Stone Axe"
	quest.0D920853F0AE1284.quest_desc: ["Bring &#00D9AA4x&r &#00D9FFMagebloom Fiber&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0D920853F0AE1284.quest_subtitle: "Obtain 4x Magebloom Fiber"
	quest.0D92EC868F35B232.quest_desc: ["Bring &#00D9FFHighly Advanced Upgrade&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0D92EC868F35B232.quest_subtitle: "Obtain Highly Advanced Upgrade"
	quest.0D92EC868F35B232.title: "I'm Speed"
	quest.0D948089E0519A10.quest_desc: ["Get hold of &#00D9FFDisk Drive&r 16k. Hover over it in EMI and press R to see how it is made."]
	quest.0D948089E0519A10.quest_subtitle: "Obtain Disk Drive 16k"
	quest.0D9B278A76570549.quest_desc: ["&#00D9FFSlay the Carminite Ghastlings&r around the trap, then activate it to pull the Ur-&#00D9FFGhast&r from the sky."]
	quest.0D9B278A76570549.quest_subtitle: "Defeat the Ur-Ghast with a Ghast Trap"
	quest.0DB11BF6A99F7F6C.quest_desc: ["The &#00D9FFSmart Hopper&r from &#FFA500Create: Dreams n' Desires&r is an advanced logistics block that gives you finer control over how items move through your factory." "It arrived in the 2.2a-BETA update and later got fixes for item voiding and filter updates."]
	quest.0DB11BF6A99F7F6C.quest_subtitle: "Obtain Smart Hopper"
	quest.0DB7157867C16591.quest_desc: ["Like &#00D9FFthe Andesite Tunnel&r, but with filtering and distribution modes."]
	quest.0DB7157867C16591.quest_subtitle: "Obtain Brass Tunnel"
	quest.0DBE8182B0394DE1.quest_desc: ["This quest asks for &#00D9FFNuke&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0DBE8182B0394DE1.quest_subtitle: "Obtain Nuke"
	quest.0DBE8182B0394DE1.title: "I've become Death, Destroyer of Worlds"
	quest.0DD09AA0EA35850D.quest_desc: ["Bring &#00D9FFPlayer Aerial Pearl&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0DD09AA0EA35850D.quest_subtitle: "Obtain Player Aerial Pearl"
	quest.0DDDDA3A335E2EC2.quest_desc: ["This quest asks for &#00D9FFCut Glass Boot&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0DDDDA3A335E2EC2.quest_subtitle: "Obtain Cut Glass Boot"
	quest.0DDF09DAE9244925.quest_desc: ["The first piece of the &#00D9FFSupremium&r armor set. Get the boots to unlock the chestplate and leggings."]
	quest.0DEBDE44543FAEFB.quest_desc: ["Bring &#00D9FFNecronomicon Spell Book and Blood Staff&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0DEBDE44543FAEFB.quest_subtitle: "Obtain Necronomicon Spell Book and Blood Staff"
	quest.0DF9E4FC7641D7EC.quest_desc: ["This quest asks for Bee. EMI shows the recipe if you press R while hovering over it."]
	quest.0DF9E4FC7641D7EC.quest_subtitle: "Obtain Bee"
	quest.0DFDCA0075F07205.quest_desc: ["This quest asks for &#00D9FFEnergy Hopper Basic&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0DFDCA0075F07205.quest_subtitle: "Obtain Energy Hopper Basic"
	quest.0E0119E5EC6E3B42.quest_desc: ["This quest asks for &#00D9AA36x&r &#00D9FFReactor Niotic&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0E0119E5EC6E3B42.quest_subtitle: "Obtain 36x Reactor Niotic"
	quest.0E016264AC71BD8C.quest_desc: ["Bring &#00D9FFIpe Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0E016264AC71BD8C.quest_subtitle: "Obtain Ipe Sapling"
	quest.0E06644FC1B0D341.quest_desc: ["Used to create &#00D9FFME Storage Cells&r."]
	quest.0E06644FC1B0D341.quest_subtitle: "Obtain Cell Component 256k"
	quest.0E19F5FF76E6BE19.quest_desc: ["Get hold of &#00D9FFGinkgo Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.0E19F5FF76E6BE19.quest_subtitle: "Obtain Ginkgo Sapling"
	quest.0E1C4F238B67F07D.quest_desc: ["Bring &#00D9FFSinner Crown&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0E1C4F238B67F07D.quest_subtitle: "Obtain Sinner Crown"
	quest.0E1CF52CD717F600.quest_desc: ["Get hold of &#00D9FFSupremium Farmland&r. Hover over it in EMI and press R to see how it is made."]
	quest.0E1CF52CD717F600.quest_subtitle: "Obtain Supremium Farmland"
	quest.0E1DE23AB140B7D4.quest_desc: ["Used to create &#00D9FFME Storage Cells&r."]
	quest.0E1DE23AB140B7D4.quest_subtitle: "Obtain Cell Component 4k"
	quest.0E1E6E585850C224.quest_desc: ["This quest asks for &#00D9FFMetallurgic Infuser and Gauge Dropper&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0E1E6E585850C224.quest_subtitle: "Obtain Metallurgic Infuser and Gauge Dropper"
	quest.0E1E7687D2B4C6BD.quest_desc: ["A &#00D9FFSentry Turret&r is an autonomous defensive weapon that fires at any living entity within a 16-block range when equipped with &#00D9FFGun Ammo&r. The range can be extended with &#00D9FFRange Upgrades&r. You can specify which entities to attack by setting filters in the ‘&#00D9FFTarget Filter&r’ field. Additionally, if the &#00D9FFSentry Turret&r is covered by a &#00D9FFSecurity Station&r, players permitted by the &#00D9FFSecurity Station&r will not be targeted."]
	quest.0E1E7687D2B4C6BD.quest_subtitle: "Obtain Sentry Turret"
	quest.0E23272AB9E52EDA.quest_desc: ["The &#00D9FFPetal Scythe&r is a melee weapon from &#FFA500Eternal Starlight&r, linked to plant-based materials and mid-to-advanced progression."]
	quest.0E23272AB9E52EDA.quest_subtitle: "Obtain Petal Scythe"
	quest.0E23272AB9E52EDA.title: "Petal Scythe"
	quest.0E31782692E3D3F0.quest_desc: ["Destroys nearby monsters providing you with twice as much experience."]
	quest.0E31782692E3D3F0.quest_subtitle: "Obtain Ritual Disintegration"
	quest.0E36306ACCB3D643.quest_desc: ["Variants to find: Badlands, End, &#00D9FFFlower Forest&r, &#00D9FFGiant Tree Taiga&r, Icy, &#00D9FFJungle&r, &#00D9FFMushroom&r, &#00D9FFNether&r, &#00D9FFOcean&r, &#00D9FFSnowy and Dark Forest&r."]
	quest.0E36306ACCB3D643.quest_subtitle: "Find all 11 Pyramid variants"
	quest.0E41832F0A0A4027.quest_desc: ["Breaks blocks, 'nuff said."]
	quest.0E41832F0A0A4027.quest_subtitle: "Obtain Mechanical Drill"
	quest.0E47CFE857CBE5E4.quest_desc: ["Seekers hunt anything that moves in &#FFA500Eternal Starlight&r." "They are fast and relentless, and escaping is hard once they spot you, so learn to fight them before going deeper."]
	quest.0E47CFE857CBE5E4.quest_subtitle: "Defeat Seeker"
	quest.0E47CFE857CBE5E4.title: "Seeker"
	quest.0E58B2B9F248760E.quest_desc: ["Knightmetal is a rare alloy found in the &#00D9FFGoblin Stronghold&r. It is very durable and sharp, which makes it great for weapons, armor and tools." "Getting it gives you access to stronger equipment."]
	quest.0E58B2B9F248760E.quest_subtitle: "Obtain Knightmetal Ingot"
	quest.0E5FC8E3D917C59E.quest_desc: ["This quest asks for &#00D9FFAltar&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0E5FC8E3D917C59E.quest_subtitle: "Obtain Altar"
	quest.0E5FC8E3D917C59E.title: "Do You Believe in Magic?"
	quest.0E681418CD88F42B.quest_desc: ["&#00D9FFLogistical Transporters&r are &#FFA500Mekanism&r's way of transporting items. They are smarter compared to other item pipes and can be highly configured with the &#00D9FFConfigurator&r. Transfer Rate: 32 items/2 m/s."]
	quest.0E681418CD88F42B.quest_subtitle: "Obtain Advanced Logistical Transporter"
	quest.0E68A729E03D8D38.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.0E68A729E03D8D38.quest_subtitle: "Obtain Basic Smelting Factory"
	quest.0E6A77563BFCDAB3.quest_desc: ["The &#00D9FFSal Ammoniac Tank&r must be placed below the &#00D9FFSal Ammoniac Accumulator&r. In tandem, these two devices will create &#00D9FFSal Ammoniac&r solvent from &#00D9FFWater&r. If you wish for solvent faster, you can provide the &#00D9FFAccumulator&r with &#00D9FFSal Ammoniac&r crystals to greatly expedite the process."]
	quest.0E6A77563BFCDAB3.quest_subtitle: "Obtain Sal Ammoniac Accumulator and Sal Ammoniac Tank"
	quest.0E6A77563BFCDAB3.title: "Sal Ammoniac Accumulator"
	quest.0E6D711132E6E3F2.quest_desc: ["The &#00D9FFTerminite Pickaxe&r is a mining tool forged from &#00D9FFTerminite Ingots&r and is stronger than the &#00D9FFThallasium&r one." "Terminite connects &#00D9FFThallasium&r to the much stronger &#00D9FFAeternium and Crystalite&r tiers."]
	quest.0E6D711132E6E3F2.quest_subtitle: "Obtain Terminite Pickaxe"
	quest.0E792CA135B5492F.quest_desc: ["&#FFA500BetterNether&r expands the &#00D9FFNether&r with new biomes, plants, structures, and materials. Venture out prepared and explore the changed environment."]
	quest.0E792CA135B5492F.title: "Getting Started"
	quest.0E80099434B1617C.quest_desc: ["Get hold of &#00D9FFEmberlash&r. Hover over it in EMI and press R to see how it is made."]
	quest.0E80099434B1617C.quest_subtitle: "Obtain Emberlash"
	quest.0E87A8D0950F27A7.quest_desc: ["Gantrys: movement and power transmission: noice! Do check out the cascaded gantries, explained in the ponder."]
	quest.0E87A8D0950F27A7.quest_subtitle: "Obtain Gantry Carriage and Gantry Shaft"
	quest.0E88C241E6006C36.quest_desc: ["Earn the advancement: &#00D9FFBronze Dungeon&r."]
	quest.0E88C241E6006C36.quest_subtitle: "Defeat the Bronze Dungeon boss"
	quest.0E8EB18C341F2601.quest_desc: ["Portable, stored power for some &#FFA500Create&r stuff."]
	quest.0E8EB18C341F2601.quest_subtitle: "Obtain Copper Backtank"
	quest.0E95B07D274A75B3.quest_desc: ["&#00D9FFElectromancer Leggings&r are part of the &#00D9FFElectromancer Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. They give &#00D9AA+6&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFLightning Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "Craft them from 7 &#00D9FFArcane Cloth&r and 1 &#00D9FFLightning Rune&r, or upgrade &#00D9FFWizard Leggings&r with 1 &#00D9FFLightning Rune&r and 1 &#00D9FFArcane Essence&r."]
	quest.0E95B07D274A75B3.quest_subtitle: "Obtain Electromancer Leggings"
	quest.0E99C24B57F91B69.quest_desc: ["Lets the wearer stand on lava while sneaking and protects against hot floor damage."]
	quest.0E99C24B57F91B69.quest_subtitle: "Obtain Strider Shoes"
	quest.0E9FABC6EDE15FF1.quest_desc: ["Your inventory has a trash slot. An item stays in it until you place another one, so you can still take it back if you made a mistake."]
	quest.0E9FABC6EDE15FF1.quest_subtitle: "Safe item disposal."
	quest.0E9FABC6EDE15FF1.title: "Trash Slot"
	quest.0EAC8217FD7CD143.quest_desc: ["Holds plenty of up to eight different things, color-able, and all nearby &#00D9FFToolboxes&r can be accessed with one keybind, handy for keeping your eyes on your work, not your tools."]
	quest.0EAC8217FD7CD143.quest_subtitle: "Obtain Smart Filter"
	quest.0EAD40117889E884.quest_desc: ["The &#00D9FFMalarite Sickle&r is an early-game harvesting tool in &#FFA500Eternal Starlight&r, crafted from &#00D9FFMalarite&r found in swamp biomes." "It gathers plants and vegetation more efficiently."]
	quest.0EAD40117889E884.quest_subtitle: "Obtain Malarite Sickle"
	quest.0EB6EBD41654B7E0.quest_desc: ["This quest asks for &#00D9FFMana Ring&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0EB6EBD41654B7E0.quest_subtitle: "Obtain Mana Ring"
	quest.0EB84C6DFB1A060C.quest_desc: ["This quest asks for &#00D9FFSlices of Bread&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0EB84C6DFB1A060C.quest_subtitle: "Obtain Slices of Bread"
	quest.0EBA3BA55AC3A5C9.quest_desc: ["A new machine, the little sibling to the &#00D9FFPacker&r! This one can only be made in steel; it really needs that extra strength. The unpacker can perform simple crafts for you, such as converting dusts into tiny dusts. Check your EMI for more recipes."]
	quest.0EBA3BA55AC3A5C9.quest_subtitle: "Obtain Steel Unpacker"
	quest.0EBA3BA55AC3A5C9.title: "Steel Unpacker"
	quest.0EC8A5814C7616EB.quest_desc: ["This quest asks for &#00D9FFLimited Diamond Barrel&r 2. EMI shows the recipe if you press R while hovering over it."]
	quest.0EC8A5814C7616EB.quest_subtitle: "Obtain Limited Diamond Barrel 2"
	quest.0ED9396AE64CDA50.quest_desc: ["&#00D9FFActivate the Ancient City&r portal with the &#00D9FFHeart&r of the &#00D9FFDeep&r to enter the &#00D9FFOtherside&r." "Mobs here track you by sound, so walk slowly, stay away from sculk sensors and keep a route back."]
	quest.0ED9396AE64CDA50.quest_subtitle: "Travel to Otherside"
	quest.0ED9396AE64CDA50.title: "Otherside"
	quest.0EDA00447F4598FD.quest_desc: ["The &#00D9FFWicked Bone Ring&r gives &#00D9AA+1&r &#00D9FFSpell Projectile Ricochet&r, so compatible spell projectiles can bounce one more time between targets." "It is a rare reward from the &#00D9FFOminous Dead King&r."]
	quest.0EDA00447F4598FD.quest_subtitle: "Obtain Wicked Bone Ring"
	quest.0EEA93644B17C281.quest_desc: ["This quest asks for &#00D9FFBleeding Tartar&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0EEA93644B17C281.quest_subtitle: "Obtain Bleeding Tartar"
	quest.0EFD61E82206E78E.quest_desc: ["The gold charm keeps your entire inventory on death."]
	quest.0EFD61E82206E78E.quest_subtitle: "Craft a Charm of Keeping III"
	quest.0EFEB33A89BBD57D.quest_desc: ["Used to craft &#00D9FFME Energy Storage Components&r and other accessories."]
	quest.0EFEB33A89BBD57D.quest_subtitle: "Obtain Energy Processor"
	quest.0F04D1DAEC2B69E7.quest_desc: ["Like &#00D9FFthe Pickup Upgrade&r, with more filtering options."]
	quest.0F04D1DAEC2B69E7.quest_subtitle: "Obtain Advanced Pickup Upgrade"
	quest.0F0C3A0B887FA889.quest_desc: ["This quest asks for &#00D9FFChemical Reactor&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0F0C3A0B887FA889.quest_subtitle: "Obtain Chemical Reactor"
	quest.0F0C3A0B887FA889.title: "Walter White Approves"
	quest.0F12698FA391FDAE.quest_desc: ["&#00D9FFGold Wire&r from &#FFA500Create Crafts and Additions&r is made by running a &#00D9FFGold Sheet&r through the &#00D9FFRolling Mill&r, which gives 2 wires. It is used in parts like the &#00D9FFGold Spool&r and can replace &#00D9FFElectrum Wire&r in some recipes."]
	quest.0F12698FA391FDAE.quest_subtitle: "Obtain Gold Wire"
	quest.0F176FA615AEAE23.quest_desc: ["Craft a crafting table. It lets you combine resources into new items and tools, and it is the base for most of your early progress."]
	quest.0F176FA615AEAE23.quest_subtitle: "Obtain Smart Filter"
	quest.0F176FA615AEAE23.title: "&#A56701Crafting Table"
	quest.0F181CD4B23375D1.quest_desc: ["The &#00D9FFAugmenting Table&r lets you upgrade or reroll a single &#00D9FFAffix&r with &#00D9FFSigils of Enhancement&r, without replacing the whole set like reforging does."]
	quest.0F181CD4B23375D1.quest_subtitle: "Obtain Augmenting Table and Sigil of Enhancement"
	quest.0F181CD4B23375D1.title: "Perfect the Affix"
	quest.0F18F1AD892DFBD5.quest_desc: ["The &#00D9FFStarfire Axe&r is a weapon from &#FFA500Eternal Starlight&r in the &#00D9FFStarfire&r equipment tier." "It is crafted from &#00D9FFStarfire&r materials found in late-game content."]
	quest.0F18F1AD892DFBD5.quest_subtitle: "Obtain Starfire Axe"
	quest.0F1F1B7AD0337C08.quest_desc: ["This quest asks for &#00D9FFOakskin Elixir&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0F1F1B7AD0337C08.quest_subtitle: "Obtain Oakskin Elixir"
	quest.0F222D07634017A9.quest_desc: ["The &#00D9FFWireless Crafting Terminal&r combines wireless item access with a crafting grid. Keep it charged and stay within range of a linked &#00D9FFWireless Access Point&r."]
	quest.0F222D07634017A9.title: "Craft Wirelessly"
	quest.0F2C5FAFE4FFD8E0.quest_desc: ["The Backpack gives you extra storage to carry around. You can wear it, open it from your inventory, or place it in the world as a regular container." "Upgrading it raises its capacity and unlocks more upgrades."]
	quest.0F2C5FAFE4FFD8E0.quest_subtitle: "Obtain Backpack"
	quest.0F48B06DB4108F29.quest_desc: ["Defeat &#00D9FFDead King&r."]
	quest.0F48B06DB4108F29.quest_subtitle: "Defeat Dead King"
	quest.0F49506A405F7E56.quest_desc: ["A dynamic tank is a multiblock structure that can hold a large amount of fluids, including gases. It is a rather simple structure, and it is cheap, compared to other &#FFA500Mekanism&r multiblocks."]
	quest.0F49506A405F7E56.quest_subtitle: "Obtain Dynamic Tank"
	quest.0F4F8377906C86C4.quest_desc: ["The &#00D9FFCapacity Card&r increases the amount of filter slots in &#00D9FFBuses&r."]
	quest.0F4F8377906C86C4.quest_subtitle: "Obtain Capacity Card, Redstone Card, Void Card and Crafting Card"
	quest.0F4F8377906C86C4.title: "Basic Upgrades"
	quest.0F58E19440A090F0.quest_desc: ["Did you have fun with &#00D9FFNuclear Fission&r? Well, it's time for &#00D9FFNuclear Fusion&r! Instead of splitting a heavy, unstable nucleus into two lighter nuclei, fusion will combine together two light nuclei which in turn releases vast amounts of energy. This energy can be contained and used to produce &#00D9FFHelium Plasma&r, an extremely energy dense fluid that can be used as the best power source in the world. You can combine gaseous fuels such as &#00D9FFDeuterium&r, &#00D9FFTritium&r and/or &#00D9FFHelium&r-3 to produce various combinations of &#00D9FFHelium Plasma&r, &#00D9FFTritium&r, &#00D9FFDeuterium&r, and &#00D9FFHydrogen&r. Keep in mind, this fusion takes a lot of energy to start going, but can produce much more as a result."]
	quest.0F58E19440A090F0.quest_subtitle: "Obtain Fusion Reactor, 203x Highly Advanced Machine Hull and 40x Fusion Chamber"
	quest.0F58E19440A090F0.title: "Fusion Reactor"
	quest.0F7140102C7C27EC.quest_desc: ["The &#00D9FFStarfire Shovel&r is a late-game digging tool from &#FFA500Eternal Starlight&r in the &#00D9FFStarfire&r tier." "It handles excavation and terrain clearing better than lower-tier tools."]
	quest.0F7140102C7C27EC.quest_subtitle: "Obtain Starfire Shovel"
	quest.0F783D00FB16DB45.quest_desc: ["Craft an anvil to combine and repair tools and armor. It also lets you rename items and apply enchanted books for extra power."]
	quest.0F783D00FB16DB45.quest_subtitle: "Obtain Anvil"
	quest.0F838133F0BAB941.quest_desc: ["This quest asks for &#00D9FFPurple Ipe Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0F838133F0BAB941.quest_subtitle: "Obtain Purple Ipe Sapling"
	quest.0F90C6ADE1B5887B.quest_desc: ["Bring Livyatan into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0F90C6ADE1B5887B.quest_subtitle: "Obtain Livyatan"
	quest.0F98517792836FCF.quest_desc: ["The &#00D9FFIgnitium Upgrade Smithing Template&r from &#FFA500Cataclysm&r is a rare template." "Use it to upgrade &#00D9FFNetherite&r equipment into &#00D9FFIgnitium&r gear."]
	quest.0F98517792836FCF.quest_subtitle: "Obtain Ignitium Upgrade Smithing Template"
	quest.0F9CD95D4BC2364A.quest_desc: ["Get hold of &#00D9FFHamburger&r. Hover over it in EMI and press R to see how it is made."]
	quest.0F9CD95D4BC2364A.quest_subtitle: "Obtain Hamburger"
	quest.0F9F3967CD459DA6.quest_desc: ["&#00D9FFWeapon and Bow Tomes&r focus on combat enchantments."]
	quest.0F9F3967CD459DA6.quest_subtitle: "Obtain Weapon Tome and Bow Tome"
	quest.0F9F3967CD459DA6.title: "Tomes of Combat"
	quest.0FB0368599AD2547.quest_desc: ["Bring &#00D9FFEmblem of Devotion&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0FB0368599AD2547.quest_subtitle: "Obtain Emblem of Devotion"
	quest.0FB253477D57A798.quest_desc: ["Increases your maximum mana a little."]
	quest.0FB253477D57A798.quest_subtitle: "Obtain Amulet of Mana Boost"
	quest.0FB941C49B31912E.quest_desc: ["Welcome to &#FFA500NeoTech Reborn&r! This NeoForge 1.21.1 modpack brings together 700+ carefully selected mods for beginners and veterans alike. Explore tech, magic, combat, dungeons, building, and new worlds at your own pace. This questbook is an optional guide, not a required gameplay path."]
	quest.0FB941C49B31912E.quest_subtitle: "700+ mods. Play your way."
	quest.0FB941C49B31912E.title: "Welcome to NeoTech Reborn"
	quest.0FC4C7068F5F080F.quest_desc: ["This unit provides protection against heat sources, such as lava, while using the heat to generate power for the suit. It is stackable to 8."]
	quest.0FC4C7068F5F080F.quest_subtitle: "Obtain Module Geothermal Generator Unit"
	quest.0FC7628B588EBA35.quest_desc: ["Get hold of &#00D9FFHoney Glazed Ham Block&r. Hover over it in EMI and press R to see how it is made."]
	quest.0FC7628B588EBA35.quest_subtitle: "Obtain Honey Glazed Ham Block"
	quest.0FCEC659E90ECBDA.quest_desc: ["Get hold of &#00D9FFShepherds Pie&r. Hover over it in EMI and press R to see how it is made."]
	quest.0FCEC659E90ECBDA.quest_subtitle: "Obtain Shepherds Pie"
	quest.0FD1FC62D1EFEDF9.quest_desc: ["Expands the inventory of the chest."]
	quest.0FD1FC62D1EFEDF9.quest_subtitle: "Obtain Gold Chest"
	quest.0FD1FC62D1EFEDF9.title: "Gold Chest"
	quest.0FD2F55B7A81EC49.quest_desc: ["This quest asks for &#00D9FFSweet Berry Cookie&r. EMI shows the recipe if you press R while hovering over it."]
	quest.0FD2F55B7A81EC49.quest_subtitle: "Obtain Sweet Berry Cookie"
	quest.0FDCF1413D3A3CAF.quest_desc: ["Bring &#00D9FFLimited Netherite Barrel&r 2 into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0FDCF1413D3A3CAF.quest_subtitle: "Obtain Limited Netherite Barrel 2"
	quest.0FEE3A403384225F.quest_desc: ["&#00D9FFLogistical Transporters&r are &#FFA500Mekanism&r's way of transporting items. They are smarter compared to other item pipes and can be highly configured with the &#00D9FFConfigurator&r. Transfer Rate: 64 items/4 m/s."]
	quest.0FEE3A403384225F.quest_subtitle: "Obtain Elite Logistical Transporter"
	quest.0FFC0E9BDF81FA87.quest_desc: ["Get hold of &#00D9FFTurtle Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.0FFC0E9BDF81FA87.quest_subtitle: "Obtain Turtle Seeds"
	quest.0FFFFDC92B535E26.quest_desc: ["Bring &#00D9FFArctic Fur&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.0FFFFDC92B535E26.quest_subtitle: "Obtain Arctic Fur"
	quest.1016E0CB31EB4B73.quest_desc: ["This quest asks for &#00D9FFEnergy Cell Basic&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1016E0CB31EB4B73.quest_subtitle: "Obtain Energy Cell Basic"
	quest.102263463081F75B.quest_desc: ["Bring &#00D9FFMagic Cloth&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.102263463081F75B.quest_subtitle: "Obtain Magic Cloth"
	quest.1025DE4B1FA4A63A.quest_desc: ["Make a &#00D9FFGlowberry Milkshake&r and fill a bucket with it. This glowing variant uses the flavor of &#00D9FFGlow Berries&r and adds a magical touch to the milkshakes from &#FFA500Create: Dreams n' Desires&r."]
	quest.1025DE4B1FA4A63A.quest_subtitle: "Obtain Glowberry Milkshake Bucket"
	quest.1034B17A3F27594E.quest_desc: ["The &#00D9FFAmaramber Mask&r is a helmet in &#FFA500Eternal Starlight&r crafted from &#00D9FFAmaramber&r materials." "It belongs to the &#00D9FFAmaramber&r armor set."]
	quest.1034B17A3F27594E.quest_subtitle: "Obtain Amaramber Mask"
	quest.103E2E29CB58E2CF.quest_desc: ["Bring &#00D9FFRuby Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.103E2E29CB58E2CF.quest_subtitle: "Obtain Ruby Seeds"
	quest.103FDB77D19D1F46.quest_desc: ["The &#00D9FFAeternium Anvil&r, together with a &#00D9FFNetherite&r or &#00D9FFAeternium Smith Hammer&r, is required to work &#00D9FFAeternium Ingots&r into plates and tool heads." "It is the last crafting station you need for &#00D9FFBetter End's&r strongest equipment."]
	quest.103FDB77D19D1F46.quest_subtitle: "Obtain Aeternium Anvil"
	quest.1043151931133131.quest_desc: ["Get hold of &#00D9FFCake Slice&r. Hover over it in EMI and press R to see how it is made."]
	quest.1043151931133131.quest_subtitle: "Obtain Cake Slice"
	quest.1062434C1259F73F.quest_desc: ["Earn the advancement: &#00D9FFLich Scepters&r."]
	quest.1062434C1259F73F.quest_subtitle: "Collect all four Lich scepters"
	quest.106C09B67CC6618F.quest_desc: ["Reduces the time it takes to drink and eat."]
	quest.106C09B67CC6618F.quest_subtitle: "Obtain Plastic Drinking Hat"
	quest.107216F4C5D9A5D7.quest_desc: ["Get hold of &#00D9FFMagmator Spirited&r. Hover over it in EMI and press R to see how it is made."]
	quest.107216F4C5D9A5D7.quest_subtitle: "Obtain Magmator Spirited"
	quest.10753FFC625F9579.quest_desc: ["Get hold of &#00D9FFGreat Sallow Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.10753FFC625F9579.quest_subtitle: "Obtain Great Sallow Sapling"
	quest.10839CE815AEA6F8.quest_desc: ["&#00D9FFUndead&r roam the world after dark. Defeat 20 zombies and 20 skeletons to show you can survive the night and handle basic threats."]
	quest.10839CE815AEA6F8.quest_subtitle: "Defeat Zombie. Defeat Skeleton"
	quest.10839CE815AEA6F8.title: "Night Hunt"
	quest.1092136AE6A7B97E.quest_desc: ["The Chimera will grow as it is fed. This increases its strength, and, when grown enough, you can ride it."]
	quest.1092136AE6A7B97E.quest_subtitle: "Earn the advancement: Familiar Chimera"
	quest.1095316AEE959DA6.quest_desc: ["The Guardian prevents your death, at the cost of one of its limbs."]
	quest.1095316AEE959DA6.quest_subtitle: "Earn the advancement: Familiar Guardian"
	quest.10AC5C7D01EC121A.quest_desc: ["The &#00D9FFMalarite Axe&r is an early-game tool in &#FFA500Eternal Starlight&r, crafted from &#00D9FFMalarite&r found in swamp biomes." "It works for woodcutting and early combat."]
	quest.10AC5C7D01EC121A.quest_subtitle: "Obtain Malarite Axe"
	quest.10AF192DD964CB39.quest_desc: ["Bring &#00D9FFTainted Relic&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.10AF192DD964CB39.quest_subtitle: "Obtain Tainted Relic"
	quest.10B634C299A4F208.quest_desc: ["Allows storages to pull from or push to any configured side. Has more filtering options."]
	quest.10B634C299A4F208.quest_subtitle: "Obtain Advanced Hopper Upgrade"
	quest.10C10E2989C4C5FF.quest_desc: ["This quest asks for &#00D9FFEnergy Hopper Starter&r. EMI shows the recipe if you press R while hovering over it."]
	quest.10C10E2989C4C5FF.quest_subtitle: "Obtain Energy Hopper Starter"
	quest.10D1A7179FA77CB0.quest_desc: ["Make &#00D9FFthe Warden Mage Boots&r in a &#00D9FFMechanical Crafter&r using a &#00D9FFNetherite Mage Boots&r from &#00D9FFIron's Spells&r, &#00D9FFEcho Ingots&r, &#00D9FFWarden Carapace&r, a &#00D9FFReinforced Echo Shard&r and a &#00D9FFWarden Upgrade Template&r." "Spell power and upgrades from the netherite piece are not kept."]
	quest.10D1A7179FA77CB0.quest_subtitle: "Obtain Warden Mage Boots"
	quest.10D21208CD5D09FF.quest_desc: ["Sets the max stack size to 2.1 billion. You only need one per storage."]
	quest.10D21208CD5D09FF.quest_subtitle: "Obtain Stack Upgrade Omega Tier"
	quest.10D455C699781523.quest_desc: ["This quest asks for &#00D9FFBattery Hardened&r. EMI shows the recipe if you press R while hovering over it."]
	quest.10D455C699781523.quest_subtitle: "Obtain Battery Hardened"
	quest.10DC8A96463562CF.quest_desc: ["Bring &#00D9FFUpgrade Obsidian&r2 into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.10DC8A96463562CF.quest_subtitle: "Obtain Upgrade Obsidian2"
	quest.10E4D936326EB38E.quest_desc: ["&#00D9FFCrafting Co&r-processor are used to speed up and to allow for more than one item to craft while crafting more complex recipe."]
	quest.10E4D936326EB38E.quest_subtitle: "Obtain Crafting Accelerator"
	quest.10E4D936326EB38E.title: "Crafting Processors"
	quest.10F880BDA9F7883B.quest_desc: ["The &#00D9FFReformation Array&r is a set of machines that are able to effectively produce endless amounts of a given &#00D9FFSulfur&r, using other kinds of &#00D9FFSulfur&r of the given tier and type."]
	quest.10F880BDA9F7883B.quest_subtitle: "Obtain Reformation Result Pedestal, Reformation Target Pedestal and Reformation Source Pedestal"
	quest.10F880BDA9F7883B.title: "Reformation Array"
	quest.11027A6400B8689E.quest_desc: ["Make &#00D9FFCrystalite Leggings&r with an &#00D9FFInfusion Ritual&r using &#00D9FFTerminite Leggings&r, an &#00D9FFAmber Gem and Crystal Shards&r around an &#00D9FFInfusion Pedestal&r." "They add &#00D9AA2 hearts&r of max health on top of solid armor and toughness."]
	quest.11027A6400B8689E.quest_subtitle: "Obtain Crystalite Leggings"
	quest.11027A6400B8689E.title: "Crystalite Leggings"
	quest.110C4B04BABAD5CB.quest_desc: ["Attach the &#FFA500Starcatcher&r &#00D9FFBobber&r to your rod. It marks your fishing spot and improves your catch chances."]
	quest.110C4B04BABAD5CB.quest_subtitle: "Obtain Smart Filter"
	quest.110C4B04BABAD5CB.title: "Starcatcher Bobber"
	quest.111DFE40731A6528.quest_desc: ["Earn the advancement: &#00D9FFValkyrie Loot&r."]
	quest.111DFE40731A6528.quest_subtitle: "Earn the advancement: Valkyrie Loot"
	quest.11291600CBFADF25.quest_desc: ["Bring &#00D9FFPurple Crepe Myrtle Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.11291600CBFADF25.quest_subtitle: "Obtain Purple Crepe Myrtle Sapling"
	quest.113A3FE6F78AA6BA.quest_desc: ["The &#00D9FFDictionary&r lets you look up the tags assigned to any item or block. Tags group similar items together, making them especially useful when setting up filters for your &#00D9FFLogistical Sorters&r. Instead of adding every item individually, you can filter entire groups of items using their shared tags. When you're unsure which tag to use, check the &#00D9FFDictionary&r first."]
	quest.113A3FE6F78AA6BA.quest_subtitle: "Obtain Dictionary"
	quest.1143A0D8D52E0C64.quest_desc: ["&#00D9FFEnslave the Winter&r season in a supercooled aluminum frame. How does removing air cool something down?"]
	quest.1143A0D8D52E0C64.quest_subtitle: "Obtain Vacuum Freezer and 30x Frostproof Machine Casing"
	quest.1143A0D8D52E0C64.title: "Vacuum Freezer"
	quest.1144838E22D53228.quest_desc: ["The &#00D9FFGlacite Pickaxe&r is crafted from &#00D9FFGlacite Ingots&r in &#FFA500Eternal Starlight&r." "It is a mid-tier mining tool for cold biomes, more efficient than &#00D9FFDeepsilver and Amaramber&r tools."]
	quest.1144838E22D53228.quest_subtitle: "Obtain Glacite Pickaxe"
	quest.1157B929B36134F5.quest_desc: ["This quest asks for &#00D9FFDiesel Mining Drill&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1157B929B36134F5.quest_subtitle: "Obtain Diesel Mining Drill"
	quest.1157B929B36134F5.title: "Through The Walls Of Ba Sing Se"
	quest.115B4B757C8A3E56.quest_desc: ["Bees in advanced beehives produce resource combs, which a centrifuge turns into resources. Combs can also be compressed into comb blocks for easier storage."]
	quest.115B4B757C8A3E56.quest_subtitle: "Obtain Honeycomb"
	quest.11623ED176490ABB.quest_desc: ["Bring &#00D9FFSolar Panel Spirited&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.11623ED176490ABB.quest_subtitle: "Obtain Solar Panel Spirited"
	quest.11686E5051042A55.quest_desc: ["Craft &#00D9FFthe Thallasium Helmet&r from &#00D9FFThallasium Plating&r at a &#00D9FFSmithing Table&r." "It starts &#00D9FFBetter End's&r armor progression and protects better than iron."]
	quest.11686E5051042A55.quest_subtitle: "Obtain Thallasium Helmet"
	quest.11728F841A6AB82B.quest_desc: ["The &#00D9FFCrusher&r crushes, among other things, clumps into &#00D9FFDirty Dusts&r, &#00D9FFIngots&r into dusts and &#00D9FFBiomatter&r into &#00D9FFBio Fuel&r."]
	quest.11728F841A6AB82B.quest_subtitle: "Obtain Crusher"
	quest.117871E3A7530B41.quest_desc: ["The &#00D9FFPrecision Sawmill&r is used for reclaiming wood from wooden items and turn logs into planks with a &#00D9AA50%&r better yield (6 instead of 4). Also makes sawdust for use in making &#00D9FFCardboard Box&r."]
	quest.117871E3A7530B41.quest_subtitle: "Obtain Precision Sawmill"
	quest.117F757D5D09D747.quest_desc: ["Used to pull energy from the &#00D9FFNetwork&r."]
	quest.117F757D5D09D747.quest_subtitle: "Obtain Flux Accessor"
	quest.117FA53543D5A467.quest_desc: ["Get hold of &#00D9FFCapacitor Lv&r. Hover over it in EMI and press R to see how it is made."]
	quest.117FA53543D5A467.quest_subtitle: "Obtain Capacitor Lv"
	quest.118598E0C12F5E86.quest_desc: ["&#00D9FFAncient Metal Ingots&r from &#FFA500Cataclysm&r drop from &#00D9FFKoboletons&r, &#00D9FFKobolediators and Wadjet&r in the &#00D9FFDesert Site and Cursed Pyramid&r, or from the &#00D9FFAncient Remnant&r." "They are used for the &#00D9FFAncient Spear&r, &#00D9FFBone Reptile Armor&r and other ancient equipment."]
	quest.118598E0C12F5E86.quest_subtitle: "Obtain Ancient Metal Ingot"
	quest.1192FD14507AA7E4.quest_desc: ["Multiplies the number of stacks that can fit in a slot by 32."]
	quest.1192FD14507AA7E4.quest_subtitle: "Obtain Stack Upgrade Tier 5"
	quest.119843CF554CA06A.quest_desc: ["Upgraded version of the &#00D9FFReinforced Alloy&r which some &#FFA500Mekanism&r machines and items use. Crafted in the &#00D9FFMetallurgic Infuser&r by infusing a &#00D9FFReinforced Alloy&r with &#00D9FFRefined Obsidian Dust&r or &#00D9FFCompressed Obsidian&r."]
	quest.119843CF554CA06A.quest_subtitle: "Obtain Alloy Atomic"
	quest.11B3C21FE1A67A50.quest_desc: ["The &#00D9FFSoul Render&r is a powerful &#00D9FFCursium&r weapon from &#FFA500Cataclysm&r and part of its endgame arsenal." "It strikes enemies with special soul-based attacks."]
	quest.11B3C21FE1A67A50.quest_subtitle: "Obtain Soul Render"
	quest.11B3C21FE1A67A50.title: "Soul Render"
	quest.11C082A2B85F7F4E.quest_desc: ["Bring Magispear into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.11C082A2B85F7F4E.quest_subtitle: "Obtain Magispear"
	quest.11D642BE1E7D4815.quest_desc: ["This quest asks for &#00D9FFPhotoelectric Pane&r. EMI shows the recipe if you press R while hovering over it."]
	quest.11D642BE1E7D4815.quest_subtitle: "Obtain Photoelectric Pane"
	quest.11DC66CFEF894DAD.quest_desc: ["Defeat 15 &#00D9FFKoboletons&r from &#FFA500Cataclysm&r. These skeletal reptile warriors live in the &#00D9FFDesert Site&r and guard its chambers and treasures." "Clearing them makes the ruins safer to explore."]
	quest.11DC66CFEF894DAD.quest_subtitle: "Defeat Koboleton"
	quest.11DC66CFEF894DAD.title: "Koboleton"
	quest.11E03734F1E47AB9.quest_desc: ["Find &#00D9FFthe Burning Arena&r from &#FFA500Cataclysm&r, a large fortress hidden deep in the &#00D9FFNether&r where &#00D9FFIgnis&r lives." "Prepare thoroughly before going in, since its halls are very dangerous."]
	quest.11E03734F1E47AB9.title: "Burning Arena"
	quest.11E773F7B05CC248.quest_desc: ["This quest asks for &#00D9FFTambaqui&r. EMI shows the recipe if you press R while hovering over it."]
	quest.11E773F7B05CC248.quest_subtitle: "Obtain Tambaqui"
	quest.11F398086B33D1E4.quest_desc: ["Induction Cells provide the bulk storage of the battery. Capacity: 1.6 TFE."]
	quest.11F398086B33D1E4.quest_subtitle: "Obtain Ultimate Induction Cell"
	quest.11F58E0A81561235.quest_desc: ["This quest asks for &#00D9FFLimited Gold Barrel&r 1. EMI shows the recipe if you press R while hovering over it."]
	quest.11F58E0A81561235.quest_subtitle: "Obtain Limited Gold Barrel 1"
	quest.11FFE3E5924F91B9.quest_desc: ["Can't tolerate the slow speed of the inscribers? Use &#00D9FFthe Circuit Slicer&r! It will slice block material(s) into processor prints directly. So it's &#00D9AA9x&r faster than an inscriber most of the time."]
	quest.11FFE3E5924F91B9.quest_subtitle: "Obtain Circuit Cutter"
	quest.1208B9E5426E4CD2.quest_desc: ["This quest asks for &#00D9FFConfigurable Honeycomb&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1208B9E5426E4CD2.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.120B2B4C849C015E.quest_desc: ["Get hold of &#00D9FFFried Rice&r. Hover over it in EMI and press R to see how it is made."]
	quest.120B2B4C849C015E.quest_subtitle: "Obtain Fried Rice"
	quest.120B34060A04D8CD.quest_desc: ["Get hold of &#00D9FFPrismarine Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.120B34060A04D8CD.quest_subtitle: "Obtain Prismarine Seeds"
	quest.121696161A51E8E2.quest_desc: ["The chestplate of the &#00D9FFIron&r armor set. Together with the leggings, it unlocks the helmet."]
	quest.121FCAED80755032.quest_desc: ["Get hold of &#00D9FFPcb Blueprint&r. Hover over it in EMI and press R to see how it is made."]
	quest.121FCAED80755032.quest_subtitle: "Obtain Pcb Blueprint"
	quest.122B94203B3C597F.quest_desc: ["Get hold of &#00D9FFRed Maple Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.122B94203B3C597F.quest_subtitle: "Obtain Red Maple Sapling"
	quest.1242AB88EE5C2CA8.quest_desc: ["&#00D9FFCryomancer Leggings&r are part of the &#00D9FFCryomancer Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. They give &#00D9AA+6&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFIce Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "Craft them from 7 &#00D9FFArcane Cloth&r and 1 &#00D9FFIce Rune&r, or upgrade &#00D9FFWizard Leggings&r with 1 &#00D9FFIce Rune&r and 1 &#00D9FFArcane Essence&r."]
	quest.1242AB88EE5C2CA8.quest_subtitle: "Obtain Cryomancer Leggings"
	quest.125799AC40C3BB52.quest_desc: ["Get hold of &#00D9FFLead Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.125799AC40C3BB52.quest_subtitle: "Obtain Lead Seeds"
	quest.125B0D21999D0FA3.quest_desc: ["Bring &#00D9FFSteel Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.125B0D21999D0FA3.quest_subtitle: "Obtain Steel Seeds"
	quest.126A68CB4B66EB3D.quest_desc: ["A much more capable &#00D9FFObserver&r."]
	quest.126A68CB4B66EB3D.quest_subtitle: "Obtain Content Observer"
	quest.12757606F45EACB2.quest_desc: ["The unassuming &#00D9FFEncased Fan&r.. the not-so-secret weapon of &#FFA500Create&r. Check out bulk-blasting (omg!) and pushing stuff around."]
	quest.12757606F45EACB2.quest_subtitle: "Obtain Encased Fan"
	quest.1278B0737F77F2C2.quest_desc: ["This quest asks for &#00D9FFNether Salad&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1278B0737F77F2C2.quest_subtitle: "Obtain Nether Salad"
	quest.128A03AD4C248AC9.quest_desc: ["Used to create the &#00D9FFSeed Reprocessor Machine&r."]
	quest.128A03AD4C248AC9.quest_subtitle: "Obtain Machine Frame"
	quest.1294E3322EFF5223.quest_desc: ["Pickaxe, &#00D9FFFishing and Other Tomes&r cover specialized item categories. The &#00D9FFOther Tome&r handles enchantments that fit nowhere else."]
	quest.1294E3322EFF5223.quest_subtitle: "Obtain Pickaxe Tome, Other Tome and Fishing Tome"
	quest.1294E3322EFF5223.title: "Tomes of Utility"
	quest.12AEF58F80F8EAE7.quest_desc: ["Gives an audible alert when a fish is approaching."]
	quest.12AEF58F80F8EAE7.quest_subtitle: "Obtain Note Hook"
	quest.12B66D2B6AA2CBEC.quest_desc: ["&#FFA500Creeper Overhaul&r adds biome-themed creeper variants with different appearances and behaviors. Pay attention to your surroundings and identify the variant before it gets close."]
	quest.12B66D2B6AA2CBEC.title: "Getting Started"
	quest.12BFB3A0042443C4.quest_desc: ["Bring &#00D9FFTertium Ingot&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.12BFB3A0042443C4.quest_subtitle: "Obtain Tertium Ingot"
	quest.12C2D0D282DF3D8F.quest_desc: ["A little more effective than the &#00D9FFRing of Lesser Discount&r."]
	quest.12C2D0D282DF3D8F.quest_subtitle: "Obtain Ring of Greater Discount"
	quest.12C85BCE70ED31C5.quest_desc: ["Bring &#00D9FFMask of Hunger&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.12C85BCE70ED31C5.quest_subtitle: "Obtain Mask of Hunger"
	quest.12D05D82A45BE11D.quest_desc: ["This quest asks for &#00D9FFElevator Pulley&r. EMI shows the recipe if you press R while hovering over it."]
	quest.12D05D82A45BE11D.quest_subtitle: "Obtain Elevator Pulley"
	quest.12E1196AD5974EFA.quest_desc: ["The &#00D9FFIndustrial Fan&r from &#FFA500Create: Dreams n' Desires&r is built for larger-scale processing and ventilation. It gives stronger airflow for industrial uses and takes your mechanical systems further."]
	quest.12E1196AD5974EFA.quest_subtitle: "Obtain Industrial Fan"
	quest.13192DC94B174D39.quest_desc: ["Get hold of &#00D9FFClockwork Bearing&r. Hover over it in EMI and press R to see how it is made."]
	quest.13192DC94B174D39.quest_subtitle: "Obtain Clockwork Bearing"
	quest.132D9EA0F036CD02.quest_desc: ["The &#00D9FFElectrum Spool&r from &#FFA500Create Crafts and Additions&r links compatible &#00D9FFConnectors&r and carries electrical energy between them. It is crafted from 4 &#00D9FFElectrum Wires&r and 1 &#00D9FFEmpty Spool&r, and can transfer up to 5 kFE/t once connected." "Breaking a connected connector returns 4 &#00D9FFElectrum Wires&r."]
	quest.132D9EA0F036CD02.quest_subtitle: "Obtain Electrum Spool"
	quest.133C331AA268B845.quest_desc: ["The first piece of the &#00D9FFObsidian&r armor set. Get the boots to unlock the chestplate and leggings."]
	quest.133D89725EC765B5.quest_desc: ["Bring &#00D9FFLoblolly Pine Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.133D89725EC765B5.quest_subtitle: "Obtain Loblolly Pine Sapling"
	quest.1348D3FDE75B7B5B.quest_desc: ["Bring &#00D9FFProsperity Ingot&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1348D3FDE75B7B5B.quest_subtitle: "Obtain Prosperity Ingot"
	quest.13554DB4AF4713F8.quest_desc: ["The &#00D9FFEnchantment Library&r stores enchantments. Insert an enchanted book to deposit its enchantments." "Left-click a stored enchantment to take one level as a book, or &#00D9FFShift&r-click for the highest level available. Matching books add up, so you can extract higher levels than you put in, up to the library's limit." "Craft it from an &#00D9FFEnchanting Table&r, &#00D9FFEnder Chests&r and infused shelves."]
	quest.13554DB4AF4713F8.quest_subtitle: "Obtain Library"
	quest.135FD4B995F664FF.quest_desc: ["Earn the advancement: &#00D9FFSilver Dungeon&r."]
	quest.135FD4B995F664FF.quest_subtitle: "Defeat the Silver Dungeon boss"
	quest.13632B63C4745494.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.13632B63C4745494.quest_subtitle: "Obtain Advanced Smelting Factory"
	quest.136DEEEFAB0C08D2.quest_desc: ["This quest asks for &#00D9FFBreakfast Sampler&r. EMI shows the recipe if you press R while hovering over it."]
	quest.136DEEEFAB0C08D2.quest_subtitle: "Obtain Breakfast Sampler"
	quest.13760E36E4F2DCA8.quest_desc: ["Bring &#00D9FFStrider With Grilled Fungus&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.13760E36E4F2DCA8.quest_subtitle: "Obtain Strider With Grilled Fungus"
	quest.137B9F57460145F2.quest_desc: ["&#00D9FFCrusher&r spirits... crush things. Their main use is to crush Ore, which will be doubled (or more, depending on the spirit's tier). However, &#00D9FFCrushers&r also have several more unique recipes, necessary for gaining the &#00D9FFChalks&r required to contact stronger spirits."]
	quest.137B9F57460145F2.quest_subtitle: "Obtain Book of Binding Bound Foliot, Smart Filter, Smart Filter and 2 more items"
	quest.137B9F57460145F2.title: "Ritual: Summon Foliot Crusher"
	quest.13958E6550C66ED7.quest_desc: ["The &#00D9FFFuel Canister&r stores any kind of fuel and converts it into &#00D9FFFuel Amount&r. Put it in a furnace's fuel slot to smelt with that instead of coal, which lets you smelt more than one stack at a time."]
	quest.13958E6550C66ED7.quest_subtitle: "Obtain Fuel Canister"
	quest.13987F757E6B4B2C.quest_desc: ["Crushed fluorite is the first process in late game &#FFA500Mekanism&r."]
	quest.13987F757E6B4B2C.quest_subtitle: "Obtain Dust Fluorite"
	quest.139F56D548244906.quest_desc: ["This quest asks for &#00D9FFList Filter&r. EMI shows the recipe if you press R while hovering over it."]
	quest.139F56D548244906.quest_subtitle: "Obtain List Filter"
	quest.13A90265419D9D26.quest_desc: ["Obtain a &#00D9FFList Filter&r and a &#00D9FFNozzle&r from &#FFA500Create&r. The &#00D9FFList Filter&r lets you build a custom list of items that a filtered component should allow or deny." "The Nozzle works with &#FFA500Create&r's item transport to direct item movement, and both help with precise factory logistics."]
	quest.13A90265419D9D26.quest_subtitle: "Obtain Filter and Nozzle"
	quest.13A90265419D9D26.title: "List Filter and Nozzle"
	quest.13C8A8DB6D074BA0.quest_desc: ["Upgrade an &#00D9FFInfused Seashelf&r with &#00D9FFPrismarine Crystals&r." "It gives &#00D9AA+5&r &#00D9FFEterna&r (up to 60), &#00D9AA+3&r &#00D9FFQuanta&r and &#00D9AA+5&r &#00D9FFArcana&r."]
	quest.13C8A8DB6D074BA0.quest_subtitle: "Obtain Crystal Seashelf"
	quest.13C985C0873385E5.quest_desc: ["&#00D9FFCrystallized Moths&r drift through &#FFA500Eternal Starlight&r and attack in groups when disturbed." "Their bodies hold starlight crystals, which makes them dangerous but also a source of rare materials."]
	quest.13C985C0873385E5.quest_subtitle: "Defeat Crystallized Moth"
	quest.13C985C0873385E5.title: "Crystallized Moth"
	quest.13DF5B6A31ADB780.quest_desc: ["The &#00D9FFStorage Bus&r allows you to use a chest or other storage box a network for your &#00D9FFME System&r to connect to rather than a &#00D9FFStorage Drive&r."]
	quest.13DF5B6A31ADB780.quest_subtitle: "Obtain Storage Bus, Tag Storage Bus, Mod Storage Bus and Precise Storage Bus"
	quest.13E05AEB3936EE36.quest_desc: ["As stated before, you can upgrade your bronze machines into steel machines. &#FFA500Create&r &#00D9FFthe Steel Upgrade&r and install it onto any bronze machine using a smithing table or packer."]
	quest.13E05AEB3936EE36.quest_subtitle: "Obtain 2x Steel Upgrade"
	quest.13E05AEB3936EE36.title: "Faster Machines?"
	quest.13E7A2741C00B1FA.quest_desc: ["The &#00D9FFStarlit Diamond Hoe&r is a late-game farming tool crafted from &#00D9FFStarlit Diamond&r materials." "It prepares farmland in advanced biomes and is the top farming tier before celestial endgame materials."]
	quest.13E7A2741C00B1FA.quest_subtitle: "Obtain Starlit Diamond Hoe"
	quest.13F51A40B2CADBBF.quest_desc: ["Smelts 96 items."]
	quest.13F51A40B2CADBBF.quest_subtitle: "Obtain Imperium Coal"
	quest.13F76A0774D92858.quest_desc: ["Bring &#00D9FFSpeed Upgrade&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.13F76A0774D92858.quest_subtitle: "Obtain Speed Upgrade"
	quest.13F949F9A2E8F6E0.quest_desc: ["Reduces cost of mana for a spell."]
	quest.13F949F9A2E8F6E0.quest_subtitle: "Obtain Ring of Lesser Discount"
	quest.14030A18523919B2.quest_desc: ["This quest asks for &#00D9FFDragonfly&r. EMI shows the recipe if you press R while hovering over it."]
	quest.14030A18523919B2.quest_subtitle: "Obtain Dragonfly"
	quest.1411DEB6C8440EBD.quest_desc: ["Get hold of &#00D9FFEnchanter&r. Hover over it in EMI and press R to see how it is made."]
	quest.1411DEB6C8440EBD.quest_subtitle: "Obtain Enchanter"
	quest.141FBD9B9BC67566.quest_desc: ["Upgrade an &#00D9FFEndshelf&r with a &#00D9FFDragon Head and Ender Pearls&r." "It gives a large &#00D9AA+20&r &#00D9FFEterna&r and is the only shelf that reaches up to 100. You need these for the highest enchanting levels."]
	quest.141FBD9B9BC67566.quest_subtitle: "Obtain Draconic Endshelf"
	quest.145017C20C780244.quest_desc: ["Craft a &#00D9FFBlack Steel Shovel&r from &#FFA500Cataclysm&r. It offers high durability and digging efficiency, and belongs to the &#00D9FFBlack Steel&r set."]
	quest.145017C20C780244.quest_subtitle: "Obtain Black Steel Shovel"
	quest.1450406D9E9A04A7.quest_desc: ["&#FFA500Aquaculture&r 2 adds the &#00D9FFLockbox&r, a rare container you can catch while fishing. Open it to get the valuable rewards inside."]
	quest.1450406D9E9A04A7.quest_subtitle: "Obtain Lockbox"
	quest.1454B24C3A787D2E.quest_desc: ["This quest asks for &#00D9FFEnchanted Golden Egg&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1454B24C3A787D2E.quest_subtitle: "Obtain Enchanted Golden Egg"
	quest.14550A7149BBD5F7.quest_desc: ["This metal can be found in the &#00D9FFNether&r, disguised as &#00D9FFNetherrack&r. Seeing through the &#00D9FFThird Eye&r reveals its true form. You might want to bring a &#00D9FFDivination Rod&r."]
	quest.14550A7149BBD5F7.quest_subtitle: "Obtain Iesnium Ingot"
	quest.145B79B6509C0830.quest_desc: ["Bring &#00D9FFFire Clay Bricks&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.145B79B6509C0830.quest_subtitle: "Obtain Fire Clay Bricks"
	quest.145B79B6509C0830.title: "Almost Steam?"
	quest.1466163B3F15C7F5.quest_desc: ["Bring &#00D9FFCardiac Trap&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1466163B3F15C7F5.quest_subtitle: "Obtain Cardiac Trap"
	quest.147B67253D4538B8.quest_desc: ["A &#00D9FFSculk Transmitter&r can be found in the secret chest of an &#00D9FFAncient Temple&r." "Link it to a container to open that container from far away, even from another dimension."]
	quest.147B67253D4538B8.quest_subtitle: "Obtain Sculk Transmitter"
	quest.147E628709281002.quest_desc: ["Replaces part of the backpack inventory with fluid storage."]
	quest.147E628709281002.quest_subtitle: "Obtain Tank Upgrade"
	quest.147F4F7F3D7B769C.quest_desc: ["Simple version: senses the facing target, with a selectable target category, target filter, block state filter and optional redstone emission. Advanced version: adds filtering and offset AOE, and needs power."]
	quest.147F4F7F3D7B769C.quest_subtitle: "Obtain Smart Filter"
	quest.14865238E12275FD.quest_desc: ["Collect 5 diamonds by exploring the deep layers of the world. They are very rare and are needed for the best tools, weapons and equipment."]
	quest.14865238E12275FD.quest_subtitle: "Obtain 5x Diamond"
	quest.14865238E12275FD.title: "Diamonds!"
	quest.149AB1571D50D9C8.quest_desc: ["The first piece of the &#00D9FFTertium&r armor set. Get the boots to unlock the chestplate and leggings."]
	quest.149B5F0D54E66454.quest_desc: ["Used in the creation of some glyphs."]
	quest.149B5F0D54E66454.quest_subtitle: "Obtain Manipulation Essence"
	quest.149D94556CE25DE2.quest_desc: ["Bring &#00D9FFRock Soup&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.149D94556CE25DE2.quest_subtitle: "Obtain Rock Soup"
	quest.14A87EFA130E4688.quest_desc: ["The &#00D9FFAethersent Hood&r is crafted from &#00D9FFAethersent Ingots&r in &#FFA500Eternal Starlight&r." "It is part of the &#00D9FFAethersent&r armor set, tied to meteors and celestial materials found in the dimension."]
	quest.14A87EFA130E4688.quest_subtitle: "Obtain Aethersent Hood"
	quest.14AB1B53308ADADD.quest_desc: ["The Basket from &#FFA500Farmer's Delight&r stores and carries food and cooking ingredients. It is a convenient addition to any farm or kitchen."]
	quest.14AB1B53308ADADD.quest_subtitle: "Obtain Bamboo Basket"
	quest.14B9D1356F52B2BF.quest_desc: ["Defeat 5 &#00D9FFCindaria&r from &#FFA500Cataclysm&r."]
	quest.14B9D1356F52B2BF.quest_subtitle: "Defeat Cindaria"
	quest.14B9D1356F52B2BF.title: "Cindaria"
	quest.14C86C69BBC5FAB6.quest_desc: ["Get hold of &#00D9FFAsh Sapling&r. Hover over it in EMI and press R to see how it is made."]
	quest.14C86C69BBC5FAB6.quest_subtitle: "Obtain Ash Sapling"
	quest.14E0CD2112C11AE9.quest_desc: ["Earn the advancement: &#00D9FFBrass Dungeon&r."]
	quest.14E0CD2112C11AE9.quest_subtitle: "Defeat the Brass Dungeon boss"
	quest.14ED7BC08D07EE4D.quest_desc: ["Get hold of &#00D9FFNitro Crystal Seeds&r. Hover over it in EMI and press R to see how it is made."]
	quest.14ED7BC08D07EE4D.quest_subtitle: "Obtain Nitro Crystal Seeds"
	quest.14F16D8D569EECD3.quest_desc: ["Has a chance to catch two things at once."]
	quest.14F16D8D569EECD3.quest_subtitle: "Obtain Double Hook"
	quest.14F2303C727E7DC8.quest_desc: ["The &#00D9FFScepter of Life Draining&r is dropped by the &#00D9FFTwilight Lich&r. It drains health from enemies and restores your own." "It is aggressive and risky, but a strong option in long fights."]
	quest.14F2303C727E7DC8.quest_subtitle: "Obtain Lifedrain Scepter"
	quest.1514C0B9D5222E13.quest_desc: ["Bring &#00D9FFThermo Generator Blazing&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1514C0B9D5222E13.quest_subtitle: "Obtain Thermo Generator Blazing"
	quest.15229AA4CC996D9B.quest_desc: ["This quest asks for &#00D9FFAwakened Supremium Ingot&r. EMI shows the recipe if you press R while hovering over it."]
	quest.15229AA4CC996D9B.quest_subtitle: "Obtain Awakened Supremium Ingot"
	quest.152EEC97AF91E1BE.quest_desc: ["Magically turn day into night."]
	quest.152EEC97AF91E1BE.quest_subtitle: "Obtain Ritual Moonfall"
	quest.15360B319F422436.quest_desc: ["This quest asks for &#00D9FFPrudentium Helmet&r, &#00D9FFPrudentium Chestplate&r, &#00D9FFPrudentium Leggings and Prudentium Boots&r. EMI shows the recipe if you press R while hovering over it."]
	quest.15360B319F422436.quest_subtitle: "Obtain Prudentium Helmet, Prudentium Chestplate, Prudentium Leggings and Prudentium Boots"
	quest.15360B319F422436.title: "Prudentium Armor"
	quest.15370113B5193049.quest_desc: ["&#00D9FFBlack Chalk&r is the stablest of all. Its power keeps even the strongest spirits in check."]
	quest.15370113B5193049.quest_subtitle: "Obtain Chalk Black Impure"
	quest.153D240870FB2BA3.quest_desc: ["The &#00D9FFCryomancer Hood&r is the headpiece of the &#00D9FFCryomancer Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. It gives &#00D9AA+3&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFIce Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "Craft it from 5 &#00D9FFArcane Cloth&r and 1 &#00D9FFIce Rune&r."]
	quest.153D240870FB2BA3.quest_subtitle: "Obtain Cryomancer Helmet"
	quest.153D9130D79E2515.quest_desc: ["Bring &#00D9FFKanthal Coil&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.153D9130D79E2515.quest_subtitle: "Obtain Kanthal Coil"
	quest.153D9130D79E2515.title: "Electric Better Furnace"
	quest.154BD7201A093AD0.quest_desc: ["The &#00D9FFBasic Bin&r is a storage block which can hold 4096 of a single item. It will retain its inventory when broken."]
	quest.154BD7201A093AD0.quest_subtitle: "Obtain Basic Bin"
	quest.154C8033DEBECA8B.quest_desc: ["Greatly reduces the duration of negative effects."]
	quest.154C8033DEBECA8B.quest_subtitle: "Obtain Antidote Vessel"
	quest.154D78C1C61DDB21.quest_desc: ["By setting up two &#00D9FFQuantum Rings&r, you can connect your &#00D9FFME System&r to anywhere in the world. Connect the first one to your &#00D9FFME System&r and the second one where you wish to have your &#00D9FFME System&r linked. You'll need 2 &#00D9FFEntangled Singularities&r, place one of them in each &#00D9FFQuantum Ring&r, after which they'll be linked together."]
	quest.154D78C1C61DDB21.quest_subtitle: "Obtain 8x Quantum Ring and Quantum Link"
	quest.154D78C1C61DDB21.title: "Quantum Ring"
	quest.155C4E8D84DF774A.quest_desc: ["This quest asks for &#00D9FFSilicon Seeds&r. EMI shows the recipe if you press R while hovering over it."]
	quest.155C4E8D84DF774A.quest_subtitle: "Obtain Silicon Seeds"
	quest.156A2A1758D28D5C.quest_desc: ["Get hold of &#00D9FFConfigurable Honeycomb&r. Hover over it in EMI and press R to see how it is made."]
	quest.156A2A1758D28D5C.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.15788ADD723D2974.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.15788ADD723D2974.quest_subtitle: "Obtain Elite Compressing Factory"
	quest.157A7E16F2188BB9.quest_desc: ["&#00D9FFMechanical Belts&r are cheap, essential for early contraptions, still useful for high-speed ones, and can be dyed. The Transportation items move and store items, enable more kinds of motion and even generate renewable power from the atmosphere."]
	quest.157A7E16F2188BB9.quest_subtitle: "Obtain Belt Connector"
	quest.158350D5C89C3B61.quest_desc: ["The leggings of the &#00D9FFLeather&r armor set. Together with the chestplate, they unlock the helmet."]
	quest.15972082612D297D.quest_desc: ["Raises the maximum stack size to about 2.1 billion. You only need one per backpack."]
	quest.15972082612D297D.quest_subtitle: "Obtain Stack Upgrade Omega Tier"
	quest.15975A8CA81B044B.quest_desc: ["&#00D9FFEnergized Core&r is a crafting ingredient in &#FFA500Iron's Spells 'n Spellbooks&r, used to make the Rod o' &#00D9FFLightning&r. It is crafted from 1 &#00D9FFBlock of Copper&r and 8 &#00D9FFBottles&r o' &#00D9FFLightning&r." "During a thunderstorm, use it on a placed &#00D9FFLightning Rod&r. A lightning strike hits and the rod becomes the Rod o' &#00D9FFLightning&r."]
	quest.15975A8CA81B044B.quest_subtitle: "Obtain Energized Core"
	quest.159DEF36B99DDB83.quest_desc: ["Bring &#00D9FFCopper Backpack&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.159DEF36B99DDB83.quest_subtitle: "Obtain Copper Backpack"
	quest.15A266FD3813B256.quest_desc: ["This quest asks for &#00D9FFMusic Disc&r 11. EMI shows the recipe if you press R while hovering over it."]
	quest.15A266FD3813B256.quest_subtitle: "Obtain Music Disc 11"
	quest.15A29F9AD8AF4CB3.quest_desc: ["The Sludge drops &#00D9FFResonarium&r." "Craft 4 &#00D9FFResonarium&r with 4 scutes to make a &#00D9FFResonarium Plate&r, which is used to upgrade diamond gear."]
	quest.15A29F9AD8AF4CB3.quest_subtitle: "Obtain Resonarium and Resonarium Plate"
	quest.15A593F96530A08A.quest_desc: ["Flux Storage keeps excess energy and only fills once every &#00D9FFFlux Point&r has received enough. Stored energy can only leave through a &#00D9FFFlux Point&r. This tier has a transfer limit of 120,000. Networks do not need storage to work."]
	quest.15A593F96530A08A.quest_subtitle: "A bigger energy buffer for your network"
	quest.15AE2E07125474FA.quest_desc: ["Get hold of &#00D9FFGold Fishing Rod&r. Hover over it in EMI and press R to see how it is made."]
	quest.15AE2E07125474FA.quest_subtitle: "Obtain Gold Fishing Rod"
	quest.15B4F5548C454816.quest_desc: ["The &#00D9FFCooking Pot&r is an essential &#FFA500Farmer's Delight&r tool. It combines different ingredients into a wide range of meals and is central to your food production."]
	quest.15B4F5548C454816.quest_subtitle: "Obtain Cooking Pot"
	quest.15BC56B43507E7A2.quest_desc: ["The chestplate of the &#00D9FFIronwood&r armor set. Together with the leggings, it unlocks the helmet."]
	quest.15BEF31B2D998B67.quest_desc: ["The Blacksmith can upgrade other occult familiars. It can also repair your equipment as you mine stone."]
	quest.15BEF31B2D998B67.quest_subtitle: "Earn the advancement: Familiar Blacksmith"
	quest.15C77383F356A0DD.quest_desc: ["Get hold of &#00D9FFGhasta&r. Hover over it in EMI and press R to see how it is made."]
	quest.15C77383F356A0DD.quest_subtitle: "Obtain Ghasta"
	quest.15C8DBDF264F87AE.quest_desc: ["The &#00D9FFBlaze Forger&r from &#FFA500Create: Enchantment Industry&r is an automated anvil powered by &#00D9FFBlaze&r. It can apply, combine, split and remove enchantments." "It also supports &#00D9FFSuper Enchanting&r, which goes beyond the normal enchantment level limits when configured for it."]
	quest.15C8DBDF264F87AE.quest_subtitle: "Obtain Blaze Forger"
	quest.15D1EBC09A6C236F.quest_desc: ["The &#00D9FFSkoglin Trophy&r is a decorative block from &#FFA500My Nether's Delight&r. It adds a &#00D9FFNether&r-themed accent to your base."]
	quest.15D1EBC09A6C236F.quest_subtitle: "Obtain Skoglin Trophy"
	quest.15D71004975A0E99.quest_desc: ["Earn the advancement: &#00D9FFBlue Aercloud&r."]
	quest.15D71004975A0E99.quest_subtitle: "Earn the advancement: Blue Aercloud"
	quest.15E211D921345353.quest_desc: ["Bring &#00D9FFCooked Loin&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.15E211D921345353.quest_subtitle: "Obtain Cooked Loin"
	quest.15E59453FDD9EED0.quest_desc: ["The &#00D9FFStarfire Hoe&r is a farming tool from &#FFA500Eternal Starlight&r in the &#00D9FFStarfire&r equipment tier." "It tills soil and belongs to the late-game &#00D9FFStarfire&r tool set."]
	quest.15E59453FDD9EED0.quest_subtitle: "Obtain Starfire Hoe"
	quest.15F664DBB06A9898.quest_desc: ["This quest asks for &#00D9FFItem Storage Cell&r 16m. EMI shows the recipe if you press R while hovering over it."]
	quest.15F664DBB06A9898.quest_subtitle: "Obtain Item Storage Cell 16m"
	quest.160186A0309E3792.quest_desc: ["Get hold of &#00D9FFItem Storage Cell&r 4m. Hover over it in EMI and press R to see how it is made."]
	quest.160186A0309E3792.quest_subtitle: "Obtain Item Storage Cell 4m"
	quest.160CDC75E020FC5B.quest_desc: ["&#00D9FFPyrium Ingot&r is a rare crafting material in &#FFA500Iron's Spells 'n Spellbooks&r, found in &#00D9FFCitadel Vaults&r. It is used for the &#00D9FFPyrium Staff&r and to upgrade the &#00D9FFDecrepit Scythe&r into the &#00D9FFHellrazor&r and the &#00D9FFDecrepit Flamberge&r into the &#00D9FFLegionnaire Flamberge&r." "Blasting a &#00D9FFPyrium Ingot&r also yields 5 &#00D9FFAncient Debris&r, which makes it valuable in the late game."]
	quest.160CDC75E020FC5B.quest_subtitle: "Obtain Pyrium Ingot"
	quest.162289747D9A3F7A.title: "Snow Queen"
	quest.162767740FEA093A.quest_desc: ["The &#00D9FFTerminite Shovel&r is a digging tool forged from &#00D9FFTerminite Ingots&r, with better durability than the &#00D9FFThallasium&r version." "Use it for excavation while you work toward higher-tier gear."]
	quest.162767740FEA093A.quest_subtitle: "Obtain Terminite Shovel"
	quest.16364894BEBAF285.quest_desc: ["The &#00D9FFUltimate Fluid Tank&r is an upgraded version of the &#00D9FFElite Fluid Tank&r that can hold &#00D9AA112000 mB&r of liquid. You can toggle its &#00D9FFBucket Mode&r on and off by shift-right clicking while holding it. When &#00D9FFBucket Mode&r is on it can collect water and lava like a bucket. When &#00D9FFBucket Mode&r is off it can be placed like a block so you can attach &#00D9FFMechanical Pipe&r to it."]
	quest.16364894BEBAF285.quest_subtitle: "Obtain Ultimate Fluid Tank"
	quest.164235783BF2AC9C.quest_desc: ["Generates power from coal at &#00D9AA20 FE&r/t."]
	quest.164235783BF2AC9C.quest_subtitle: "Obtain Furnator Starter"
	quest.166215EEE5EF74C8.quest_desc: ["The first piece of the &#00D9FFPrudentium&r armor set. Get the boots to unlock the chestplate and leggings."]
	quest.166477C6DB0639A5.quest_desc: ["Get hold of &#00D9FFWrench&r. Hover over it in EMI and press R to see how it is made."]
	quest.166477C6DB0639A5.quest_subtitle: "Obtain Wrench"
	quest.1666AFB812FCCE59.quest_desc: ["Tier 1 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.1666AFB812FCCE59.quest_subtitle: "Obtain Glyph Break"
	quest.166A7343ACB26F03.quest_desc: ["This quest asks for &#00D9FFFlowering Crabapple Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.166A7343ACB26F03.quest_subtitle: "Obtain Flowering Crabapple Sapling"
	quest.166BA3DD2557B883.quest_desc: ["The &#00D9FFNature Upgrade Orb&r is an upgrade material in &#FFA500Iron's Spells 'n Spellbooks&r. Applied at the &#00D9FFArcane Anvil&r, it gives &#00D9AA+5%&r &#00D9FFNature Spell Power&r." "Craft it from 1 &#00D9FFEmpty Upgrade Orb&r and 8 &#00D9FFNature Runes&r."]
	quest.166BA3DD2557B883.quest_subtitle: "Obtain Nature Upgrade Orb"
	quest.1696E45280550FA6.quest_desc: ["This quest asks for &#00D9FFSweet Berry Cheesecake&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1696E45280550FA6.quest_subtitle: "Obtain Sweet Berry Cheesecake"
	quest.1698658107DDD33D.quest_desc: ["Used to create magical trinkets (you may need to make a couple)."]
	quest.1698658107DDD33D.quest_subtitle: "Obtain Dull Trinket"
	quest.16A30377B0DB77A3.quest_desc: ["Bring &#00D9FFGravitite Helmet&r, &#00D9FFGravitite Chestplate&r, &#00D9FFGravitite Leggings&r and 2 more items into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.16A30377B0DB77A3.quest_subtitle: "Obtain Gravitite Helmet, Gravitite Chestplate, Gravitite Leggings and 2 more items"
	quest.16A30377B0DB77A3.title: "Defying Gravity"
	quest.16B29FD743B12BBD.quest_desc: ["This quest asks for &#00D9FFElectronic Circuit&r. EMI shows the recipe if you press R while hovering over it."]
	quest.16B29FD743B12BBD.quest_subtitle: "Obtain Electronic Circuit"
	quest.16B29FD743B12BBD.title: "The Power of Silicon"
	quest.16B81DBB1E02C13D.quest_desc: ["This quest asks for &#00D9FFFerricore Chestplate&r. EMI shows the recipe if you press R while hovering over it."]
	quest.16B81DBB1E02C13D.quest_subtitle: "Obtain Ferricore Chestplate"
	quest.16B949AA9C525115.quest_desc: ["&#00D9FFAmethyst Resonance Charm&r - when worn this charm will grant you a &#00D9AA15%&r mana regen boost."]
	quest.16B949AA9C525115.quest_subtitle: "Obtain Amethyst Resonance Charm"
	quest.16C4BD183D4ACD12.quest_desc: ["Multiplies the number of items that fit in each slot by 8."]
	quest.16C4BD183D4ACD12.quest_subtitle: "Obtain Stack Upgrade Tier 3"
	quest.16C750A43D5E3FFB.quest_desc: ["Craft wooden tools: an axe, a pickaxe and a shovel. They let you gather resources and mine, and they are your first step toward better crafting."]
	quest.16C750A43D5E3FFB.quest_subtitle: "Obtain Wooden Pickaxe, Wooden Sword and Wooden Axe"
	quest.16C750A43D5E3FFB.title: "&#6A3B1DWooden &#A56701Tools"
	quest.16CE7A1C699FE62A.quest_desc: ["Tier 2 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.16CE7A1C699FE62A.quest_subtitle: "Obtain Glyph Aoe"
	quest.16CE82DED0F5AA55.quest_desc: ["They are crafted by causing a reaction between &#00D9FFEnder Pearl&r or &#00D9FFEnder Dust&r and a &#00D9FFSingularity&r. Any explosive force should be enough to trigger the reaction. Nearly any explosion - even creepers - will work. They are always produced in matching pairs, to create a connection place 1 of the pairs of &#00D9FFQuantum Entangled Singularity&r into the &#00D9FFME Quantum Link Chamber&r of the bridge on each side. It might be a good idea to label these with names when you create them using the vanilla &#00D9FFAnvil&r."]
	quest.16CE82DED0F5AA55.quest_subtitle: "Obtain Singularity"
	quest.16CE82DED0F5AA55.title: "Singularities"
	quest.16E1B07466047CD3.quest_desc: ["Bring &#00D9FFBayad&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.16E1B07466047CD3.quest_subtitle: "Obtain Bayad"
	quest.16EE891F075D0DF3.quest_desc: ["Get hold of &#00D9FFEnergy Cell Nitro&r. Hover over it in EMI and press R to see how it is made."]
	quest.16EE891F075D0DF3.quest_subtitle: "Obtain Energy Cell Nitro"
	quest.16F033001A7702A3.quest_desc: ["Defeat a &#00D9FFShattered&r, a sculk-covered husk roaming the &#00D9FFOtherside&r." "It drops &#00D9FFSculk Bones&r."]
	quest.16F033001A7702A3.quest_subtitle: "Defeat Shattered"
	quest.16F033001A7702A3.title: "Shattered"
	quest.16F6409BD4C95F1E.quest_desc: ["Get hold of &#00D9FFCooked Rice&r. Hover over it in EMI and press R to see how it is made."]
	quest.16F6409BD4C95F1E.quest_subtitle: "Obtain Cooked Rice"
	quest.16FB9BA0A5DE939F.quest_desc: ["Bring &#00D9FFPepper Powder&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.16FB9BA0A5DE939F.quest_subtitle: "Obtain Pepper Powder"
	quest.17090446B4EA1841.quest_desc: ["&#00D9FFCopper Wire&r is a basic electrical part from &#FFA500Create Crafts and Additions&r, made in the &#00D9FFRolling Mill&r. It is used in electrical components and connections, and is an early step toward a network for machines that run on &#00D9FFForge Energy&r."]
	quest.17090446B4EA1841.quest_subtitle: "Obtain Copper Wire"
	quest.170CEFC42AB6A4E1.quest_desc: ["Like &#00D9FFthe Filter Upgrade&r, with more filtering options."]
	quest.170CEFC42AB6A4E1.quest_subtitle: "Obtain Advanced Filter Upgrade"
	quest.170FF5C56AFDC0D3.quest_desc: ["It is a third the weight of steel, yet ductile and highly malleable. It's made from heating up and extracting it from &#00D9FFBauxite&r. You can do this in your newly formed EBF. Make sure to automate &#00D9FFAluminum&r production as you'll end up using A LOT of it."]
	quest.170FF5C56AFDC0D3.quest_subtitle: "Obtain Aluminum Ingot"
	quest.170FF5C56AFDC0D3.title: "Aluminum"
	quest.171080B4FDD5AD85.quest_desc: ["Get hold of &#00D9FFImperium Ingot&r. Hover over it in EMI and press R to see how it is made."]
	quest.171080B4FDD5AD85.quest_subtitle: "Obtain Imperium Ingot"
	quest.17109D741DAF807D.quest_desc: ["Simple point-to-point item transportation, power transmission, or low-key ski lift for players, you decide!"]
	quest.17109D741DAF807D.quest_subtitle: "Obtain Chain Conveyor"
	quest.171500CC6AA946ED.quest_desc: ["The &#00D9FFLarge Cog Crank&r from &#FFA500Create: Dreams n' Desires&r is an upgraded hand-powered source of rotational force. Its larger size drives machinery more strongly by hand, which helps when you lack a full power setup."]
	quest.171500CC6AA946ED.quest_subtitle: "Obtain Large Cog Crank"
	quest.171D5D4D3055AB9A.quest_desc: ["An autocrafting setup combines an &#00D9FFME Crafting CPU&r, &#00D9FFMolecular Assemblers&r, &#00D9FFPattern Providers&r, and encoded patterns. Connect the components to your network and configure a recipe in the &#00D9FFPattern Encoding Terminal&r."]
	quest.171ED91027624636.quest_desc: ["Obtain an &#00D9FFItem Hatch&r from &#FFA500Create&r. Added in &#FFA500Create&r 6.0, it lets you quickly deposit items into connected storage such as an &#00D9FFItem Vault&r." "It is especially handy for large automated storage setups."]
	quest.171ED91027624636.quest_subtitle: "Obtain Item Hatch"
	quest.1720955CF74E1247.quest_desc: ["Get hold of &#00D9FFEnergizing Rod Hardened&r. Hover over it in EMI and press R to see how it is made."]
	quest.1720955CF74E1247.quest_subtitle: "Obtain Energizing Rod Hardened"
	quest.172DDA3AECF85097.quest_desc: ["Expands the inventory of the shulker box."]
	quest.172DDA3AECF85097.quest_subtitle: "Obtain Iron Shulker Box"
	quest.173E3DA59859D23E.quest_desc: ["Most quests in this chapter are best done in order, even though no lines connect them. Start with this one."]
	quest.173E3DA59859D23E.quest_subtitle: "Create a portal to the Twilight Forest"
	quest.174F0336ABCE3ACD.quest_desc: ["You may need several of these to make magical belts."]
	quest.174F0336ABCE3ACD.quest_subtitle: "Obtain Mundane Belt"
	quest.1759DCF48125657E.quest_desc: ["Induction Cells provide the bulk storage of the battery. Capacity: 25.60 GFE."]
	quest.1759DCF48125657E.quest_subtitle: "Obtain Advanced Induction Cell"
	quest.17698BDFE2AEA5A5.quest_desc: ["Bring &#00D9FFUraninite Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.17698BDFE2AEA5A5.quest_subtitle: "Obtain Uraninite Seeds"
	quest.176E5316582F715A.quest_desc: ["Get hold of &#00D9FFDried Ghast With Milk&r. Hover over it in EMI and press R to see how it is made."]
	quest.176E5316582F715A.quest_subtitle: "Obtain Dried Ghast With Milk"
	quest.177AFF67090D1CA1.quest_desc: ["This quest asks for &#00D9FFScroll&r. EMI shows the recipe if you press R while hovering over it."]
	quest.177AFF67090D1CA1.quest_subtitle: "Obtain Scroll"
	quest.17808416F8C42937.quest_desc: ["Bring &#00D9FFPlate of Ghasta With Cream&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.17808416F8C42937.quest_subtitle: "Obtain Plate of Ghasta With Cream"
	quest.1784C36BE8D3FC28.quest_desc: ["Wireless charging is set up in the &#00D9FFWireless Charging&r tab. A network accepts only one controller, and its output is the energy sent out through wireless charging. Networks work fine without one."]
	quest.1784C36BE8D3FC28.quest_subtitle: "Enables wireless inventory charging across dimensions"
	quest.179059CFEABE9346.quest_desc: ["The &#00D9FFHDPE Sheet&r is used in many late mod machines for &#FFA500Mekanism&r. They can, also, be used to make plastic blocks or upgrades for you &#00D9FFMekSuit&r."]
	quest.179059CFEABE9346.quest_subtitle: "Obtain Hdpe Sheet"
	quest.1797771CDA098AB2.quest_desc: ["Make &#00D9FFthe Warden Axe&r in a &#00D9FFMechanical Crafter&r using a &#00D9FFNetherite Axe&r, &#00D9FFEcho Ingots&r, a &#00D9FFReinforced Echo Shard&r and a &#00D9FFWarden Upgrade Template&r."]
	quest.1797771CDA098AB2.quest_subtitle: "Obtain Warden Axe"
	quest.17A9D6014754C3DF.title: "Knight Phantom"
	quest.17ADFDBED5731221.quest_desc: ["Besides crafting, you can find glyphs by looting structures, including vanilla ones, the &#00D9FFRuined Warp Portal and Arcane Library&r from &#00D9FFArs Additions&r, and structures from other mods. Using a T1 &#00D9FFCodex&r unlocks a random Tier 1 glyph."]
	quest.17ADFDBED5731221.quest_subtitle: "Obtain Glyph Underfoot, Glyph Amplify, Glyph Randomize and 29 more items"
	quest.17ADFDBED5731221.title: "Tier 1 Glyphs"
	quest.17B52067C82448AA.quest_desc: ["Bring &#00D9FFIronwood Helmet&r, &#00D9FFIronwood Chestplate&r, &#00D9FFIronwood Leggings and Ironwood Boots&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.17B52067C82448AA.quest_subtitle: "Craft a full set of Ironwood Armor"
	quest.17B52067C82448AA.title: "Ironwood Armorer"
	quest.17D450F7B8EA1882.quest_desc: ["Tier 3 glyph. Craft it at the &#00D9FFScribe&r\'s &#00D9FFTable&r."]
	quest.17D450F7B8EA1882.quest_subtitle: "Obtain Glyph Linger"
	quest.17E8945A7FF031CD.quest_desc: ["This quest asks for &#00D9FFInferium Farmland&r. EMI shows the recipe if you press R while hovering over it."]
	quest.17E8945A7FF031CD.quest_subtitle: "Obtain Inferium Farmland"
	quest.17F226AC0BC87390.quest_desc: ["Bring &#00D9FFFish Stew&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.17F226AC0BC87390.quest_subtitle: "Obtain Fish Stew"
	quest.17F30C290F27DC10.quest_desc: ["This quest asks for &#00D9FFConfigurable Honeycomb&r. EMI shows the recipe if you press R while hovering over it."]
	quest.17F30C290F27DC10.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.182439CC27EEAC24.quest_desc: ["Watch out, it stings."]
	quest.182439CC27EEAC24.quest_subtitle: "Obtain Jellyfish"
	quest.1837B1BC0388E050.quest_desc: ["Bring Hiveheart into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1837B1BC0388E050.quest_subtitle: "Obtain Hiveheart"
	quest.184BC23123526D9E.quest_desc: ["Bring &#00D9FFNight Fuchsia Sapling&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.184BC23123526D9E.quest_subtitle: "Obtain Night Fuchsia Sapling"
	quest.184CD552981F91CF.quest_desc: ["Smelts 192 items."]
	quest.184CD552981F91CF.quest_subtitle: "Obtain Supremium Coal"
	quest.184D200F7ECB219A.quest_desc: ["This quest asks for &#00D9FFMemory Stick&r. EMI shows the recipe if you press R while hovering over it."]
	quest.184D200F7ECB219A.quest_subtitle: "Obtain Memory Stick"
	quest.18553FC2093F3AEC.quest_desc: ["The Straw from &#FFA500Create Crafts and Additions&r can be applied to a &#00D9FFBlaze Burner&r to give it an internal &#00D9AA4000 mB&r fluid tank, so it can burn flammable fluids. Fill it by hand or through fluid pipes to automate fueling without solid fuel." "The current 1.21.1 version also adds an alternative &#00D9FFStraw&r recipe."]
	quest.18553FC2093F3AEC.quest_subtitle: "Obtain Straw"
	quest.1859AB76684AFFFC.quest_desc: ["The &#00D9FFTidal Claws&r are legendary &#FFA500Cataclysm&r claw weapons infused with the power of the sea, built for swift and devastating attacks." "You can recover them from the depths ruled by &#00D9FFThe Leviathan&r."]
	quest.1859AB76684AFFFC.quest_subtitle: "Obtain Tidal Claws"
	quest.1859AB76684AFFFC.title: "Tidal Claws"
	quest.18602E98C88BBCB3.quest_desc: ["Adds a furnace to the backpack."]
	quest.18602E98C88BBCB3.quest_subtitle: "Obtain Smelting Upgrade"
	quest.186549FCD8183009.quest_desc: ["The &#00D9FFGlacite Axe&r is crafted from &#00D9FFGlacite Ingots&r in &#FFA500Eternal Starlight&r." "It chops wood in cold biomes and offers better durability and combat efficiency than earlier tools."]
	quest.186549FCD8183009.quest_subtitle: "Obtain Glacite Axe"
	quest.186759DBB2AA89CD.quest_desc: ["Useful for really big crafts."]
	quest.186759DBB2AA89CD.quest_subtitle: "Obtain 1m Crafting Storage"
	quest.186759DBB2AA89CD.title: "Mega Crafting Storage"
	quest.187F2F47EDB2629E.quest_desc: ["Used to create &#00D9FFME Storage Cells&r."]
	quest.187F2F47EDB2629E.quest_subtitle: "Obtain Cell Component 64k"
	quest.188395E73A18E2D2.quest_desc: ["Get hold of &#00D9FFCinder Essence&r. Hover over it in EMI and press R to see how it is made."]
	quest.188395E73A18E2D2.quest_subtitle: "Obtain Cinder Essence"
	quest.188B7D550C58FE5D.quest_desc: ["Pistons use rotational force to extend a rod out with a lot of possible force. This is very useful for compressing things, as well as packing things. You should automate these."]
	quest.188B7D550C58FE5D.quest_subtitle: "Obtain Piston"
	quest.188B7D550C58FE5D.title: "Pistons"
	quest.189C761B83F6E852.quest_desc: ["&#00D9FFAffix Gear&r comes in five rarities: Common, &#00D9FFUncommon&r, &#00D9FFRare&r, &#00D9FFEpic and Mythic&r. Higher rarities have more &#00D9FFAffixes&r, more &#00D9FFGem Sockets&r and stronger stats." "To reach the &#00D9FFFrontier&r, equip a full set of &#00D9FFCommon Affix Gear&r: helmet, chestplate, leggings, boots and weapon. Press Ctrl + T to manage your &#00D9FFWorld Tier&r."]
	quest.189C761B83F6E852.quest_subtitle: "Reach World Tier: Frontier"
	quest.189C761B83F6E852.title: "The Frontier"
	quest.189DE02A719EC12A.quest_desc: ["The &#00D9FFSurvival Infinity Upgrade&r turns selected backpack slots into infinite item sources. Any item placed in such a slot can be taken out endlessly while the upgrade stays active." "It is the survival-friendly version of the admin-only &#00D9FFInfinity Upgrade&r, and it is meant to be a true endgame reward."]
	quest.189DE02A719EC12A.quest_subtitle: "Obtain Survival Infinity Upgrade"
	quest.18A92E1070F9B46A.quest_desc: ["&#00D9FFBlessed Amethyst Crab Meat&r from &#FFA500Cataclysm&r is an enhanced version of the crab's meat, carrying the power of amethyst."]
	quest.18A92E1070F9B46A.quest_subtitle: "Obtain Blessed Amethyst Crab Meat"
	quest.18B0058041A66C36.quest_desc: ["The &#00D9FFLarge Macerator&r can macerate recipes in batches of up to 8 at a &#00D9AA25%&r deduction of EU cost. Keep in mind, it will not do a mix of recipes, they must be the same type. If not, each type of recipe will be split into their batch of a max of 8."]
	quest.18B0058041A66C36.quest_subtitle: "Obtain Large Steam Macerator, 23x Bronze Plated Bricks, Bronze Item Input Hatch and Bronze Item Output Hatch"
	quest.18BCDC8C1100DDCA.quest_desc: ["The &#00D9FFAeternium Pickaxe&r is a top-tier mining tool, stronger and more durable than &#00D9FFNetherite&r." "&#00D9FFAeternium Ingots&r are forged from &#00D9FFTerminite and Netherite&r, or found as rare loot in &#00D9FFBetter End&r structures."]
	quest.18BCDC8C1100DDCA.quest_subtitle: "Obtain Aeternium Pickaxe"
	quest.18C8EBA59DCA24AA.quest_desc: ["Collect a few wood logs from nearby trees. Wood is used for tools, furniture and many other items you need to survive and explore."]
	quest.18C8EBA59DCA24AA.quest_subtitle: "Obtain 10x Smart Filter"
	quest.18C8EBA59DCA24AA.title: "&#A56701First &#6A3B1DWood"
	quest.18D84E57DFADA4A2.quest_desc: ["This quest asks for &#00D9FFBanana Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.18D84E57DFADA4A2.quest_subtitle: "Obtain Banana Sapling"
	quest.18E1DB3F8E6B99F2.quest_desc: ["This quest asks for &#00D9FFBlueprint&r. EMI shows the recipe if you press R while hovering over it."]
	quest.18E1DB3F8E6B99F2.quest_subtitle: "Obtain Blueprint"
	quest.18E1DB3F8E6B99F2.title: "Any Engineer's Blueprint"
	quest.18E4DC026F73EAA1.quest_desc: ["The BaBee upgrade will give a small chance for the bees living inside the hive to breed and produce new offsprings without your involvement."]
	quest.18E4DC026F73EAA1.quest_subtitle: "Obtain Upgrade Child"
	quest.18E813DEC361F52B.quest_desc: ["&#00D9FFLowest Tier Storage Cell&r in normal AE2, which can contain 4,096 bytes of storage. 4,096 bytes of storage can hold 508 &#00D9FFStacks&r of a single item. or 260 &#00D9FFStacks&r,while holding 63 &#00D9FFDifferent&r items."]
	quest.18E813DEC361F52B.quest_subtitle: "Obtain Item Storage Cell 4k"
	quest.18EA77D4FE2A7ED8.quest_desc: ["This quest asks for &#00D9FFVisibility Ring&r. EMI shows the recipe if you press R while hovering over it."]
	quest.18EA77D4FE2A7ED8.quest_subtitle: "Obtain Visibility Ring"
	quest.18EF44843CA54DFF.quest_desc: ["Bring &#00D9FFWayward Compass&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.18EF44843CA54DFF.quest_subtitle: "Obtain Wayward Compass"
	quest.18F9D32BC3F5888F.quest_desc: ["Get hold of &#00D9AA2x&r &#00D9FFSteel Energized&r. Hover over it in EMI and press R to see how it is made."]
	quest.18F9D32BC3F5888F.quest_subtitle: "Obtain 2x Steel Energized"
	quest.18F9D32BC3F5888F.title: "Energized Steel"
	quest.19098ED47E0DD410.quest_desc: ["&#00D9FFBlue Chalk&r allows summoning and binding &#00D9FFMarid&r."]
	quest.19098ED47E0DD410.quest_subtitle: "Obtain Chalk Blue Impure"
	quest.190A42FC30DD7F7B.quest_desc: ["Phantoms drop &#00D9FFPhantom Membranes&r." "Besides repairing an &#00D9FFElytra&r, they are the base ingredient for &#00D9FFBetter End's Enchanted Membrane&r in an &#00D9FFInfusion Ritual&r."]
	quest.190A42FC30DD7F7B.quest_subtitle: "Obtain Phantom Membrane"
	quest.190BFD00F21888A9.quest_desc: ["The leggings of the &#00D9FFFiery&r armor set. Together with the chestplate, they unlock the helmet."]
	quest.19107B35E9BE5AC1.quest_desc: ["&#00D9FFSteel Dust&r is produced by infusing an iron ingot with 10 units of carbon (producing &#00D9FFEnriched Iron&r) and then infusing that with a further 10 units of &#00D9FFCarbon&r. (&#00D9FFCarbon&r = &#00D9FFCoal&r, &#00D9FFCharcoal&r or &#00D9FFRefined Carbon&r)."]
	quest.19107B35E9BE5AC1.quest_subtitle: "Obtain Dust Steel"
	quest.19107B35E9BE5AC1.title: "Steel Dust"
	quest.19161579CDA9D76C.quest_desc: ["Get hold of &#00D9FFUpgrade Orb&r. Hover over it in EMI and press R to see how it is made."]
	quest.19161579CDA9D76C.quest_subtitle: "Obtain Upgrade Orb"
	quest.1917D159436BC120.quest_desc: ["Tier Installers are used to upgrade various machines into their &#00D9FFFactory&r equivalent. Right-click on the machine with the &#00D9FFTier Installer&r and it will upgrade that machine. its level (&#00D9FFBasic&r, Advanced, or &#00D9FFElite&r) depending on the level of the &#00D9FFTier Installer&r used."]
	quest.1917D159436BC120.quest_subtitle: "Obtain Ultimate Tier Installer"
	quest.191BBDD0FAF5BA85.quest_desc: ["The &#00D9FFWandering Magician Hood&r is part of the early-game &#00D9FFWandering Magician Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. It gives &#00D9AA+2&r &#00D9FFArmor&r and &#00D9AA+25&r &#00D9FFMax Mana&r." "Craft it by combining a &#00D9FFLeather Cap&r with &#00D9FFArcane Essence&r."]
	quest.191BBDD0FAF5BA85.quest_subtitle: "Obtain Wandering Magician Helmet"
	quest.191F435488BD2758.quest_desc: ["Scrolls are found around the world while exploring. A scroll you find only has one use if you cast it directly."]
	quest.191F435488BD2758.quest_subtitle: "Obtain Smart Filter"
	quest.191F435488BD2758.title: "Scroll"
	quest.1922CB9E65C10165.quest_desc: ["The &#00D9FFPortal Gun&r opens paired portals with left and right clicks. The &#00D9FFAdvanced Portal Gun&r opens portals to saved locations and uses power and &#00D9FFPortal Fluid&r."]
	quest.1922CB9E65C10165.quest_subtitle: "Obtain Smart Filter"
	quest.1924CB640D98A934.quest_desc: ["Get hold of &#00D9FFRing of Blades&r. Hover over it in EMI and press R to see how it is made."]
	quest.1924CB640D98A934.quest_subtitle: "Obtain Ring of Blades"
	quest.1931EC7F74EC86E4.quest_desc: ["The Khopesh is a curved ancient sword from &#FFA500Cataclysm&r carried by the &#00D9FFKoboletons&r in the &#00D9FFDesert Site&r." "Defeat them for a chance to get one."]
	quest.1931EC7F74EC86E4.quest_subtitle: "Obtain Khopesh"
	quest.193B63300EBF4ADE.quest_desc: ["Get hold of &#00D9FFNether Burger&r. Hover over it in EMI and press R to see how it is made."]
	quest.193B63300EBF4ADE.quest_subtitle: "Obtain Nether Burger"
	quest.194B527D9EF162D9.quest_desc: ["This quest asks for &#00D9FFPlate of Stuffed Hoglin Snout&r. EMI shows the recipe if you press R while hovering over it."]
	quest.194B527D9EF162D9.quest_subtitle: "Obtain Plate of Stuffed Hoglin Snout"
	quest.19568986E4E3F5A0.quest_desc: ["By putting a &#00D9FFFilter Upgrade&r in a pump over some water, the pump will produce &#00D9FFHeavy Water&r. &#00D9FFHeavy Water&r is also known as H3O. H3O is needed for making D-&#00D9FFT Fuel&r for the &#00D9FFFusion Reactor&r. To make &#00D9FFDeuterium&r, you need to put the &#00D9FFHeavy Water&r into an &#00D9FFElectrolytic Separator&r."]
	quest.19568986E4E3F5A0.quest_subtitle: "Obtain Upgrade Filter"
	quest.19616C156D7ED3CB.quest_desc: ["Combine an &#00D9FFEcho Shard&r, 2 &#00D9FFWarden Carapace&r, 2 &#00D9FFPhantom Membranes&r and &#00D9AA100 mB&r of &#00D9FFMolten Echo&r in a heated &#00D9FFMechanical Mixer&r." "Every piece of &#00D9FFWarden&r gear requires one."]
	quest.19616C156D7ED3CB.quest_subtitle: "Obtain Reinforced Echo Shard"
	quest.196B7B1A7E90AE07.quest_desc: ["This quest asks for &#00D9FFDisk Drive&r 64k. EMI shows the recipe if you press R while hovering over it."]
	quest.196B7B1A7E90AE07.quest_subtitle: "Obtain Disk Drive 64k"
	quest.1971A73786AFF363.quest_desc: ["The &#00D9FFDeer&r enhances your jumping ability."]
	quest.1971A73786AFF363.quest_subtitle: "Earn the advancement: Familiar Deer"
	quest.1973AECBD83C5D88.quest_desc: ["The &#00D9FFAbyssal Egg&r is a mysterious &#FFA500Cataclysm&r relic from the domain of &#00D9FFThe Leviathan&r." "It is one of the rarest treasures from the deepest parts of the ocean."]
	quest.1973AECBD83C5D88.quest_subtitle: "Obtain Abyssal Egg"
	quest.198969864EE843A8.quest_desc: ["The Wrath of the &#00D9FFDesert&r from &#FFA500Cataclysm&r is a legendary bow tied to the ancient desert civilization." "It lets you attack from range with the force of the sandstorm."]
	quest.198969864EE843A8.quest_subtitle: "Obtain Wrath of the Desert"
	quest.198969864EE843A8.title: "Wrath Of The Desert"
	quest.199CF90DC707CDB6.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.199CF90DC707CDB6.quest_subtitle: "Obtain Advanced Injecting Factory"
	quest.199D7BE7630280A7.quest_desc: ["it's all there right in its name."]
	quest.199D7BE7630280A7.quest_subtitle: "Obtain Display Board"
	quest.19A0BEAFC9E256F4.quest_desc: ["Factories are advanced forms of the basic machines aimed to assist in large scale resource processing."]
	quest.19A0BEAFC9E256F4.quest_subtitle: "Obtain Ultimate Combining Factory"
	quest.19AF09853BA99EF2.quest_desc: ["Look in caves or mountains for a shiny amethyst shard. These crystals can be used to craft powerful items."]
	quest.19AF09853BA99EF2.quest_subtitle: "Obtain 8x Amethyst Shard"
	quest.19AF09853BA99EF2.title: "Amethyst Shard"
	quest.19B89E5B0B9742AE.quest_desc: ["This is the &#00D9FFBronze Drill&r. This will give you the main ores that you'll need to expand further. Check the outputs in EMI and make sure you know that the drill has a chance of breaking, so don't just make 1."]
	quest.19B89E5B0B9742AE.quest_subtitle: "Obtain Bronze Drill"
	quest.19B89E5B0B9742AE.title: "Bronze Drill"
	quest.19C30AA67FE4CF1C.quest_desc: ["The &#00D9FFCog Crank&r from &#FFA500Create: Dreams n' Desires&r is a simple hand-powered part. Use it to supply rotational force manually and start your &#FFA500Create&r machinery when you have no other power source."]
	quest.19C30AA67FE4CF1C.quest_subtitle: "Obtain Cog Crank"
	quest.19E197A8960E062B.quest_desc: ["&#00D9FFKill the Ender Dragon&r, the &#00D9FFEnd's&r original boss, which guards the central island." "Once it is dead, &#00D9FFEnd Gateways&r appear and lead to the outer islands, where &#00D9FFBetter End's&r biomes and resources start."]
	quest.19E197A8960E062B.quest_subtitle: "Defeat Ender Dragon"
	quest.19E197A8960E062B.title: "Ender Dragon"
	quest.19E76733C5413B31.quest_desc: ["Bring &#00D9FFAnalog Circuit&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.19E76733C5413B31.quest_subtitle: "Obtain Analog Circuit"
	quest.19E8B2CABE3FAFF0.quest_desc: ["Get hold of &#00D9FFConfigurable Honeycomb&r. Hover over it in EMI and press R to see how it is made."]
	quest.19E8B2CABE3FAFF0.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.19F1A867A86B382C.quest_desc: ["Smelts faster and burns fuel more efficiently than the vanilla &#00D9FFFurnace&r."]
	quest.19F1A867A86B382C.quest_subtitle: "Obtain Iron Furnace"
	quest.1A4E815F549DB19E.quest_desc: ["The &#00D9FFAmaramber Axe&r was added in version 0.4.2 as part of the &#00D9FFAmaramber&r set in &#FFA500Eternal Starlight&r." "It is a basic tool for gathering wood from &#00D9FFTorreya&r trees."]
	quest.1A4E815F549DB19E.quest_subtitle: "Obtain Amaramber Axe"
	quest.1A535BEC9B5AEED7.quest_desc: ["This quest asks for &#00D9FFBronze Furnace&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1A535BEC9B5AEED7.quest_subtitle: "Obtain Bronze Furnace"
	quest.1A535BEC9B5AEED7.title: "Ten Times More Fuel Efficient"
	quest.1A5EF42D42A67CD2.quest_desc: ["This quest asks for &#00D9FFThread Kindling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1A5EF42D42A67CD2.quest_subtitle: "Obtain Thread Kindling"
	quest.1A611B8D50109E92.quest_desc: ["The &#00D9FFCoke Oven&r is a large structure, larger than only a single block. This multiblock structure is used to take &#00D9FFCoal&r or &#00D9FFCoal Dust&r and heat it in a location with the absence of air and producing &#00D9FFCoal Coke&r and occasionally some &#00D9FFCreosote Oil&r. You can use &#00D9FFCreosote Oil&r for the production of &#00D9FFLubricant and Coal Coke&r for &#00D9FFSteel Ingots&r or just a powerful fuel lasting &#00D9AA4x&r as long! The &#00D9FFCoke Oven&r block here is the role of the central controller. You will place other blocks surrounding it in a pattern that will eventually construct the full multiblock. Every multiblock is managed by a controller, but you usually cannot interact with the controller directly but instead through input and output hatches that you place in certain spots of the multiblock. You'll need a &#00D9FFFluid Input Hatch&r to handle an input of &#00D9FFSteam&r to power the &#00D9FFCoke Oven&r, an &#00D9FFItem Input Hatch&r as a way to input the &#00D9FFCoal&r and an &#00D9FFItem Output Hatch&r to output the &#00D9FFCoke&r. A &#00D9FFFluid Output Hatch&r is not required and will allow the multiblock to run without it, but with it you can extract the &#00D9FFCreosote Oil&r from the &#00D9FFCoal&r. Normally if you don't have enough of the correct hatches required, the multiblock will not function. If you hold a &#00D9FFWrench&r, a projection of the blocks needed for the rest of the multiblock will show after you've placed down the controller block. The specific holographic block will disappear if the correct block is placed, or will turn red if the block in that location is incorrect. If you hold a hatch in your hand, there will be green highlighted location where the hatches can go. If you placed the hatch outside of those highlighted locations, the multiblock will not recognize the hatch. One &#00D9FFthe Coke Oven&r controller states that it's shape is valid, you can insert &#00D9FFSteam&r though the &#00D9FFFluid Input Hatch&r. &#00D9FFPuting Coal&r or &#00D9FFCoal Dust&r into the &#00D9FFItem Input Hatch&r will allow the &#00D9FFCoke Oven&r to fire up and start producing. If it doesn't work, retrace your steps and find out what went wrong."]
	quest.1A611B8D50109E92.quest_subtitle: "Obtain Bronze Item Output Hatch, Bronze Fluid Input Hatch, Bronze Fluid Output Hatch and 3 more items"
	quest.1A611B8D50109E92.title: "Coke Oven"
	quest.1A690C193864B04B.quest_desc: ["&#00D9FFThermal Springstone&r can be refined into ingots infused with geothermal energy in &#FFA500Eternal Starlight&r." "They are used in advanced crafting, but the unstable heat makes the material hard to obtain."]
	quest.1A690C193864B04B.quest_subtitle: "Obtain Thermal Springstone Ingot"
	quest.1A690C193864B04B.title: "Thermal Springstone Ingot"
	quest.1A6BED71742FA711.quest_desc: ["The chestplate of the &#00D9FFAwakened Supremium&r armor set. Together with the leggings, it unlocks the helmet."]
	quest.1A6DFD28DBB7A316.quest_desc: ["The &#00D9FFThermal Springstone Leggings&r are crafted from &#00D9FFThermal Springstone Ingots&r in &#FFA500Eternal Starlight&r." "Each piece of this armor ignites attackers and reduces fire damage, which helps in hot, dangerous areas."]
	quest.1A6DFD28DBB7A316.quest_subtitle: "Obtain Thermal Springstone Leggings"
	quest.1A76FB12559E2D14.quest_desc: ["Connect/&#00D9FFChain&r up to a max of 64 machines of choice together."]
	quest.1A76FB12559E2D14.quest_subtitle: "Obtain Machine Chainer"
	quest.1A85E5BD6810BC7D.quest_desc: ["This quest asks for &#00D9FFBronze Compressor&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1A85E5BD6810BC7D.quest_subtitle: "Obtain Bronze Compressor"
	quest.1A85E5BD6810BC7D.title: "Automatic?"
	quest.1A891E49AE977E56.quest_desc: ["Bring &#00D9FFObsidian Seeds&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1A891E49AE977E56.quest_subtitle: "Obtain Obsidian Seeds"
	quest.1A9D03B5FA7A31B2.quest_desc: ["The chestplate of the &#00D9FFSteeleaf&r armor set. Together with the leggings, it unlocks the helmet."]
	quest.1AA5AEC43512737E.quest_desc: ["&#00D9FFCultist Armor&r is the chestpiece of the &#00D9FFCultist Armor&r set in &#FFA500Iron's Spells 'n Spellbooks&r. It gives &#00D9AA+8&r &#00D9FFArmor&r, &#00D9AA+125&r &#00D9FFMax Mana&r, &#00D9AA+10%&r &#00D9FFBlood Spell Power&r and &#00D9AA+5%&r &#00D9FFSpell Power&r." "The full set is &#00D9FFCultist Hood&r, &#00D9FFCultist Armor&r, &#00D9FFCultist Leggings and Cultist Boots&r. Craft the chestpiece from 8 &#00D9FFArcane Cloth&r and 1 &#00D9FFBlood Rune&r, or upgrade &#00D9FFWizard Robes&r with a &#00D9FFBlood Rune&r at a &#00D9FFSmithing Table&r on newer versions."]
	quest.1AA5AEC43512737E.quest_subtitle: "Obtain Cultist Chestplate"
	quest.1AA9C58A302CF6F0.quest_desc: ["Craft the &#FFA500Starcatcher&r Hook and attach it to your rod. It helps you catch fish more effectively and reel in rare finds."]
	quest.1AA9C58A302CF6F0.quest_subtitle: "Obtain Smart Filter"
	quest.1AA9C58A302CF6F0.title: "Starcatcher Hook"
	quest.1AC1508C74720853.quest_desc: ["This quest asks for &#00D9FFPurpleheart Sapling&r. EMI shows the recipe if you press R while hovering over it."]
	quest.1AC1508C74720853.quest_subtitle: "Obtain Purpleheart Sapling"
	quest.1AC26146E6B66060.quest_desc: ["Unlike &#00D9FFthe Glass Divination Rod&r, this rod is already attuned to the type of block of the &#00D9FFSulfur&r used to make it. It otherwise works the same. This one finds an &#00D9FFAbundant&r material."]
	quest.1AC26146E6B66060.quest_subtitle: "Obtain Sulfur Attuned Divination Rod Abundant"
	quest.1ACFC934783F0741.quest_desc: ["Get hold of &#00D9FFPneumatic Cylinder&r. Hover over it in EMI and press R to see how it is made."]
	quest.1ACFC934783F0741.quest_subtitle: "Obtain Pneumatic Cylinder"
	quest.1AD1ACCFF766FC79.quest_desc: ["The &#00D9FFAmaramber Hoe&r was added in version 0.4.2 as part of the &#00D9FFAmaramber&r set in &#FFA500Eternal Starlight&r." "It prepares farmland and fits early progression."]
	quest.1AD1ACCFF766FC79.quest_subtitle: "Obtain Amaramber Hoe"
	quest.1AD2134BF5DA9515.quest_desc: ["The Interface acts like a chest, you can set an item or fluid inside the &#00D9FFInterface&r and it will pull that item from the network to keep stock."]
	quest.1AD2134BF5DA9515.quest_subtitle: "Obtain Interface"
	quest.1AD5B0A568507993.quest_desc: ["Hooks and bobbers give the rod different bonuses. You can find them in &#00D9FFTreasure Chests&r or earn them by reaching fishing goals."]
	quest.1AD5B0A568507993.quest_subtitle: "Aid your journey with hooks and bobbers"
	quest.1AD5B0A568507993.title: "Hooks and Bobbers"
	quest.1AD6C5BBBFFE103B.quest_desc: ["Bring &#00D9FFTurbine Rotor&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1AD6C5BBBFFE103B.quest_subtitle: "Obtain Turbine Rotor"
	quest.1AD6E7B4983EFF3C.quest_desc: ["Replaces part of the backpack inventory with energy storage."]
	quest.1AD6E7B4983EFF3C.quest_subtitle: "Obtain Battery Upgrade"
	quest.1AD70D19CEABBD1D.quest_desc: ["&#FFA500Chisel&r adds decorative block variants for building. Explore its block selections to find alternate styles for common materials."]
	quest.1AD70D19CEABBD1D.title: "Getting Started"
	quest.1AF8D6E728DC5977.quest_desc: ["The &#00D9FFSmithing Upgrade&r builds a working smithing table into your backpack, so you can upgrade gear with smithing templates anywhere." "No need to carry a separate table."]
	quest.1AF8D6E728DC5977.quest_subtitle: "Obtain Smithing Upgrade"
	quest.1AFA3699C28EB37D.quest_desc: ["The Hellshelf is a good start for stronger enchanting. Craft it from &#00D9FFNether Bricks&r, a &#00D9FFBlaze Rod&r, a potion and a bookshelf." "It gives &#00D9AA+3&r &#00D9FFEterna&r (up to 45) and &#00D9AA+3&r &#00D9FFQuanta&r."]
	quest.1AFA3699C28EB37D.quest_subtitle: "Obtain Hellshelf"
	quest.1AFB83F956107321.quest_desc: ["This Rod can locate &#00D9FFPrecious&r materials."]
	quest.1AFB83F956107321.quest_subtitle: "Obtain Divination Rod T3"
	quest.1B00D8B833F32726.quest_desc: ["Simple: harvests and resets mature crops."]
	quest.1B00D8B833F32726.quest_subtitle: "Obtain Mechanical Harvester"
	quest.1B02005FF74832B0.quest_desc: ["The leggings of the &#00D9FFNano Quantum&r armor set. Together with the chestplate, they unlock the helmet."]
	quest.1B06483B9213DAE1.quest_desc: ["Bring &#00D9FFObsidian Nest&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1B06483B9213DAE1.quest_subtitle: "Obtain Obsidian Nest"
	quest.1B1083EE0C7C685D.quest_desc: ["Feeds you from the food stored in the backpack."]
	quest.1B1083EE0C7C685D.quest_subtitle: "Obtain Feeding Upgrade"
	quest.1B118921161500F2.quest_desc: ["Upgrade an &#00D9FFEndshelf&r with &#00D9FFEnd Rods and Ender Pearls&r." "It gives &#00D9AA+10&r &#00D9FFEterna&r (up to 90), &#00D9AA+7.5&r &#00D9FFQuanta&r and &#00D9AA+7.5&r &#00D9FFArcana&r."]
	quest.1B118921161500F2.quest_subtitle: "Obtain Pearl Endshelf"
	quest.1B1C1BE6BB26761B.quest_desc: ["The &#00D9FFGlacite Axe&r is a mid-tier axe crafted from &#00D9FFGlacite Ingots&r in &#FFA500Eternal Starlight&r." "It is used in cold biomes for harvesting wood and fighting, with better durability and efficiency than earlier tiers."]
	quest.1B1C1BE6BB26761B.quest_subtitle: "Obtain Starlit Diamond Axe"
	quest.1B26B5A7F0745D7E.quest_desc: ["You also need 10 unique golden fish for the &#00D9FFDiamond Trophy&r."]
	quest.1B26B5A7F0745D7E.quest_subtitle: "Catch 500 fish in total"
	quest.1B2B09B22DFF5336.quest_desc: ["Get hold of &#00D9AA27x&r &#00D9FFBlastbrick Reinforced and Hopper&r. Hover over it in EMI and press R to see how it is made."]
	quest.1B2B09B22DFF5336.quest_subtitle: "Obtain 27x Blastbrick Reinforced and Hopper"
	quest.1B2B09B22DFF5336.title: "Improved Blast Furnace"
	quest.1B445753B3FB4395.quest_desc: ["The &#00D9FFGolden Trophy&r is a decorative block from &#FFA500My Nether's Delight&r. Its gold finish makes a nice display piece for your collection."]
	quest.1B445753B3FB4395.quest_subtitle: "Obtain Golden Trophy"
	quest.1B4FD2B3BFB9B4F9.quest_desc: ["Bring &#00D9FFSmart Filter&r into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.1B4FD2B3BFB9B4F9.quest_subtitle: "Obtain Smart Filter"
	quest.1B54F62B4DC22C0D.quest_desc: ["Get hold of &#00D9FFSoursop Sapling&r. Hover over it in EMI and press R to see how it is made."]
