	quest.07A65D26D8CFC905.quest_subtitle: "Obtain Mega Item Cell Housing, Mega Fluid Cell Housing and Mega Chemical Cell Housing"
	quest.07AE92951CA0EA97.quest_desc: ["Redirects spell projectiles. Place an Observer next to it to detect when a spell hits the prism."]
	quest.07AE92951CA0EA97.quest_subtitle: "Obtain Spell Prism"
	quest.07B2A60C5B87A36D.quest_desc: ["The Amaramber Shovel was added in version 0.4.2 as part of the Amaramber set in Eternal Starlight." "It digs terrain and soft blocks."]
	quest.07B2A60C5B87A36D.quest_subtitle: "Obtain Amaramber Shovel"
	quest.07BE5BDA66B8ED52.quest_desc: ["The Printer from Create: Enchantment Industry automatically copies written books, enchanted books, name tags, train schedules and other supported items." "It uses the matching blank item as material and can use Liquid Experience when copying enchanted books. It can also copy package patterns or addresses for Create logistics."]
	quest.07BE5BDA66B8ED52.quest_subtitle: "Obtain Printer"
	quest.07D0F4B51DC6A59F.quest_desc: ["This quest asks for Poisonward Ring. EMI shows the recipe if you press R while hovering over it."]
	quest.07D0F4B51DC6A59F.quest_subtitle: "Obtain Poisonward Ring"
	quest.07DFC9127AFA1571.quest_desc: ["Allows short-term creative flight."]
	quest.07DFC9127AFA1571.quest_subtitle: "Obtain Ritual Flight"
	quest.07F0E5F57BA7A176.quest_desc: ["A ProsperiBee is obtained by right-clicking a Crystalline Bee with a block of prosperity."]
	quest.07F0E5F57BA7A176.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.07F160582D132F6E.quest_desc: ["This quest asks for Limited Diamond Barrel 4. EMI shows the recipe if you press R while hovering over it."]
	quest.07F160582D132F6E.quest_subtitle: "Obtain Limited Diamond Barrel 4"
	quest.0803F488F9A8EAB8.quest_desc: ["Used in the creation of some glyphs."]
