	quest.41192657317E9491.quest_desc: ["Golem Steel is an advanced material in Eternal Starlight, made by refining Oxidized Golem Steel Ingots dropped by the Starlight Golem." "The refined ingot is used for stronger equipment, weapons, tools and other recipes."]
	quest.41192657317E9491.quest_subtitle: "Obtain Golem Steel Ingot"
	quest.41192657317E9491.title: "Golem Steel Ingot"
	quest.413E8E13A187A52D.quest_desc: ["Used to create ME Storage Cells."]
	quest.413E8E13A187A52D.quest_subtitle: "Obtain Cell Component 16k"
	quest.41430B10472ACF81.quest_desc: ["The dynamic tank requires the edges and corners of the multiblock to be casings. Everything else can be valves or reactor glass. The list of blocks here can create the smallest tank that holds a little under 10,000,000 mb."]
	quest.41430B10472ACF81.quest_subtitle: "Obtain Dynamic Valve, 22x Dynamic Tank and 4x Reactor Glass"
	quest.414426B14AFDA0C6.quest_desc: ["A high-tier furnace with strong speed and fuel efficiency."]
	quest.414426B14AFDA0C6.quest_subtitle: "Obtain Emerald Furnace"
