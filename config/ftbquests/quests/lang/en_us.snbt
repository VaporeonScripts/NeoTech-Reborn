	quest.554166DF244AE6DC.quest_subtitle: "Obtain Black Cherry Sapling"
	quest.5563212C7059C690.quest_desc: ["Bring Butternut Sapling into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5563212C7059C690.quest_subtitle: "Obtain Butternut Sapling"
	quest.556B6540231D5D2A.quest_desc: ["This quest asks for Time Traveller Sapling. EMI shows the recipe if you press R while hovering over it."]
	quest.556B6540231D5D2A.quest_subtitle: "Obtain Time Traveller Sapling"
	quest.556CD406202CFA44.quest_desc: ["This quest asks for Energy Discharger Spirited. EMI shows the recipe if you press R while hovering over it."]
	quest.556CD406202CFA44.quest_subtitle: "Obtain Energy Discharger Spirited"
	quest.55964C3EF312FCC3.quest_desc: ["Kobolediators are strong elite warriors from Cataclysm that guard the depths of the Cursed Pyramid with heavy weapons." "They protect the path to the Ancient Remnant. Defeat one."]
	quest.55964C3EF312FCC3.quest_subtitle: "Defeat Kobolediator"
	quest.55964C3EF312FCC3.title: "Kobolediator"
	quest.55A7FB72B95316C1.quest_desc: ["This machine produces Compressed Air. To operate it, place any solid-fuel item that can burn in a Furnace into the fuel slot. Please note that fuel buckets are not compatible; for liquid fuels, use a Liquid Compressor instead."]
	quest.55A7FB72B95316C1.quest_subtitle: "Obtain Air Compressor"
	quest.55AE2E483A7378B7.quest_desc: ["Ether is a volatile liquid in Eternal Starlight that you can collect with a bucket." "Unlike lava it does not destroy items, but it is still dangerous to handle."]
	quest.55AE2E483A7378B7.quest_subtitle: "Obtain Ether Bucket"
	quest.55C59AEBE1A1E96B.quest_desc: ["Get hold of Mixed Salad. Hover over it in EMI and press R to see how it is made."]
	quest.55C59AEBE1A1E96B.quest_subtitle: "Obtain Mixed Salad"
	quest.55D73B77B111F117.quest_desc: ["The Pump Upgrade lets your storage transfer fluids to and from connected fluid systems, which makes automated fluid handling easier." "The Advanced Pump Upgrade adds more control and filtering options. The Experience Pump Upgrade lets your storage handle experience and transfer it when needed."]
	quest.55D73B77B111F117.quest_subtitle: "Obtain Pump Upgrade, Advanced Pump Upgrade and Xp Pump Upgrade"
	quest.55D73B77B111F117.title: "Pump, Advanced Pump and Experience Pump Upgrade"
	quest.55DE7DCF31A45D9E.quest_desc: ["Get hold of Stuffed Potato. Hover over it in EMI and press R to see how it is made."]
	quest.55DE7DCF31A45D9E.quest_subtitle: "Obtain Stuffed Potato"
	quest.55DEBC832812CF8F.quest_desc: ["Bring 36x Reactor Basic into your inventory. Check EMI with R on the item if you are unsure how to get it."]
