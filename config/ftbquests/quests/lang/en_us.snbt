	quest.33B6251CF0B25772.quest_desc: ["Variants to find: &#00D9FFBasalt&r, &#00D9FFBirch&r, &#00D9FFCrimson&r, &#00D9FFDark Forest&r, &#00D9FFDesert&r, End, Icy, &#00D9FFJungle&r, &#00D9FFNether&r, &#00D9FFOcean&r, &#00D9FFSavanna&r, &#00D9FFSoul&r, &#00D9FFStone&r, &#00D9FFSwamp&r, &#00D9FFTaiga and Warped&r."]
