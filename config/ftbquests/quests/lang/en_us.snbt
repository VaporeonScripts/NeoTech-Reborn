	quest.1E756592BDE0C97B.quest_desc: ["Flux Storage keeps excess energy and only fills once every Flux Point has received enough. Stored energy can only leave through a Flux Point. This tier has a transfer limit of 1,440,000. Networks do not need storage to work."]
	quest.1E756592BDE0C97B.quest_subtitle: "The largest energy buffer for your network"
