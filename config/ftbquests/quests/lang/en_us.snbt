	quest.532AA97F7EA39DD6.quest_subtitle: "Obtain Energy Hopper Hardened"
	quest.53329AA1FCDDAEDB.quest_desc: ["You can have my Extendo Grip.."]
	quest.53329AA1FCDDAEDB.quest_subtitle: "Obtain Extendo Grip"
	quest.5338A64F0DBEBCAD.quest_desc: ["Earn the advancement: Coke Oven."]
	quest.5338A64F0DBEBCAD.quest_subtitle: "Earn the advancement: Coke Oven"
