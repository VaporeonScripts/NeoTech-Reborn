	quest.086818AFF19AC2F4.quest_desc: ["Bring Binding Card Dim into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.086818AFF19AC2F4.quest_subtitle: "Obtain Binding Card Dim"
	quest.086DF56E0F338DBB.quest_desc: ["The Glacite Boots is crafted from Glacite materials in Eternal Starlight." "Glacite armor protects against freezing environments and slows enemies that attack you."]
	quest.086DF56E0F338DBB.quest_subtitle: "Obtain Glacite Boots"
	quest.08710F87B744144D.quest_desc: ["Heals you for a share of the melee damage you deal. As it ranks up it gains kill streaks, a heal on kills and Absorption hearts."]
	quest.08710F87B744144D.quest_subtitle: "Obtain Vampiric Glove"
	quest.088518E226474E58.quest_desc: ["Makes the spawner ignore normal spawning conditions."]
	quest.088518E226474E58.quest_subtitle: "Obtain Ignore Conditions Spawner Rune"
	quest.088518E226474E58.title: "Ignore Conditions Spawner Rune"
	quest.0889C2C61B1B19D7.quest_desc: ["A fatal hit teleports the wearer somewhere else instead."]
	quest.0889C2C61B1B19D7.quest_subtitle: "Obtain Chorus Totem"
	quest.089C7A7F4A5E70D4.quest_desc: ["Upgrade a Deepshelf with an Echo Shard and candles." "It gives +5 Eterna (up to 75) and +15 Arcana. A great pick for rare enchantments."]
	quest.089C7A7F4A5E70D4.quest_subtitle: "Obtain Echoing Deepshelf"
	quest.08A9E5F3D5AC7FA5.quest_desc: ["The Thallasium Ingot is the base metal of Better End's tool and armor progression." "Smelt Thallasium ore from across the End, then forge the ingots into plating and tool heads with an Anvil and Smith Hammer."]
	quest.08A9E5F3D5AC7FA5.quest_subtitle: "Obtain Thallasium Ingot"
	quest.08ACE44CB5705E73.quest_desc: ["Priest Robes are the chestpiece of the Priest Armor set in Iron's Spells 'n Spellbooks. They give +8 Armor, +125 Max Mana, +10% Holy Spell Power and +5% Spell Power, and can hold 1 imbued spell." "Craft them from 8 Arcane Cloth and 1 Holy Rune, or upgrade Wizard Robes with 1 Holy Rune at a Smithing Table in Minecraft 1.20+."]
	quest.08ACE44CB5705E73.quest_subtitle: "Obtain Priest Chestplate"
	quest.08BDF067A6F94F07.quest_desc: ["Get hold of Plate of Stuffed Hoglin. Hover over it in EMI and press R to see how it is made."]
	quest.08BDF067A6F94F07.quest_subtitle: "Obtain Plate of Stuffed Hoglin"
	quest.08C5ED76A219F76B.quest_desc: ["This quest asks for Fusion Reactor. EMI shows the recipe if you press R while hovering over it."]
	quest.08C5ED76A219F76B.quest_subtitle: "Obtain Fusion Reactor"
	quest.08C5ED76A219F76B.title: "Enslaved Star Core"
