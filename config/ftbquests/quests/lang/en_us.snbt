	quest.1C92CA042AEB8D7A.quest_subtitle: "Obtain Elite Energy Cube"
	quest.1C9565B31D0A689A.quest_desc: ["Performs archaeology on normal sand and gravel within 3 blocks of its storage block. Bind it with the Dominion Wand. It needs source, and it consumes the blocks, so you have to place new sand or gravel."]
	quest.1C9565B31D0A689A.quest_subtitle: "Obtain Alakarkinos Charm"
	quest.1C97351EB6462785.quest_desc: ["This quest asks for Cast Time Ring. EMI shows the recipe if you press R while hovering over it."]
