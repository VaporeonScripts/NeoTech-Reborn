	quest.5353A2764C526C75.quest_subtitle: "Obtain Basic Upgrade"
	quest.5353A2764C526C75.title: "Machine Speedup"
	quest.5360FBB4DEBA2DFB.quest_desc: ["The Gem Cutting Table improves your Gems using Gem Dust and Rarity Materials."]
	quest.5360FBB4DEBA2DFB.quest_subtitle: "Obtain Gem Cutting Table"
	quest.5360FBB4DEBA2DFB.title: "Cut to Size"
	quest.536C62938DD74583.quest_desc: ["Increases the experience dropped by creatures."]
	quest.536C62938DD74583.quest_subtitle: "Obtain Golden Hook"
