	quest.59F535E72CDBF7D9.quest_subtitle: "Obtain Invar Seeds"
	quest.5A1EE986FD863870.quest_desc: ["Bring Limited Iron Barrel 2 into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.5A1EE986FD863870.quest_subtitle: "Obtain Limited Iron Barrel 2"
	quest.5A21EE5AEF40FFCD.quest_desc: ["The Vampiric Spell Book is a strong Blood magic spellbook from Iron's Spells 'n Spellbooks. It adds +1 level to Blood Slash and Blood Step, and gives +10% Blood Spell Power, +10% Spell Resistance and +200 Max Mana when equipped."]
	quest.5A21EE5AEF40FFCD.quest_subtitle: "Obtain Cursed Doll Spell Book"
