	quest.6114372D527B5903.quest_subtitle: "Earn the advancement: Read Lore"
	quest.61206C8A863A5203.quest_desc: ["The QIO Redstone Adapter monitors contents from the QIO System. It activates based on different filters you set."]
	quest.61206C8A863A5203.quest_subtitle: "Obtain Qio Redstone Adapter"
	quest.6125C73CE0DA081B.quest_desc: ["The machine frame of Powah, used in most machine recipes."]
	quest.6125C73CE0DA081B.quest_subtitle: "Obtain Dielectric Casing"
	quest.616C40032A91B84D.quest_desc: ["This Machine can collect Fluids from the world, It's also highly configurable!"]
	quest.616C40032A91B84D.quest_subtitle: "Obtain Fluidcollectort1"
	quest.61713E2E40B328BD.quest_desc: ["Guardians of order in an unpredicatble world of Chains, Belts, and Boxes."]
	quest.61713E2E40B328BD.quest_subtitle: "Obtain Repackager"
	quest.61736104E96470BD.quest_desc: ["Polonium is created by putting Nuclear Waste in a Solar Neutron Activator. Then, you put the polonium into a Pressurized Reaction Chamber with water and fluorite dust."]
	quest.61736104E96470BD.quest_subtitle: "Obtain Pellet Polonium"
	quest.61743EF197A17A12.quest_desc: ["The Scroll Forge crafts scrolls from Paper and Ink. Different focus items give different kinds of scrolls, and higher-tier ink unlocks rarer and more powerful scrolls."]
	quest.61743EF197A17A12.quest_subtitle: "Obtain Scroll Forge"
	quest.61766197A58086E4.quest_desc: ["Get hold of 4x Prosperity Shard. Hover over it in EMI and press R to see how it is made."]
	quest.61766197A58086E4.quest_subtitle: "Obtain 4x Prosperity Shard"
	quest.61766197A58086E4.title: "Prosperity Shard"
	quest.619CC2A5B57E2148.quest_desc: ["Bring Steam Mining Drill into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.619CC2A5B57E2148.quest_subtitle: "Obtain Steam Mining Drill"
	quest.619CC2A5B57E2148.title: "Getting That 3x3 Going"
	quest.619E60387DC202AD.quest_desc: ["Defeat Cryomancer."]
	quest.619E60387DC202AD.quest_subtitle: "Defeat Cryomancer"
	quest.619E60387DC202AD.title: "Cryomancer"
