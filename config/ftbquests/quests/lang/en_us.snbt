	quest.1BA66437D2BECCDB.quest_subtitle: "Obtain Universal Transformer"
	quest.1BB74BEE471D3B07.quest_desc: ["This quest asks for Ender Gate Spirited. EMI shows the recipe if you press R while hovering over it."]
