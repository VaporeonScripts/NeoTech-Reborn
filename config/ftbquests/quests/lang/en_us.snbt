	quest.6879835A5EB411D3.quest_subtitle: "Obtain Advanced Sawing Factory"
	quest.68987C39EB057268.quest_desc: ["Bring Configurable Honeycomb into your inventory. Check EMI with R on the item if you are unsure how to get it."]
	quest.68987C39EB057268.quest_subtitle: "Obtain Configurable Honeycomb"
	quest.6898A9BD0F6445DF.quest_desc: ["The Elevator uses pressure to move you between floors with a Controller. One Elevator Base lets you go up 6 blocks, and stacking more bases adds 6 blocks each. Adding the same number of bases beside the first widens the elevator." "Place a Controller at eye level, beside the shaft, at every floor you want to use."]
	quest.6898A9BD0F6445DF.quest_subtitle: "Obtain 4x Elevator Base, 2x Elevator Caller and 16x Elevator Frame"
	quest.6898A9BD0F6445DF.title: "Elevator"
