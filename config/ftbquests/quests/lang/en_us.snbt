	quest.4168B09940D238C6.quest_subtitle: "Obtain Brazilwood Sapling"
	quest.4170C53128395EC8.quest_desc: ["Bees no longer leave the hive, and their trips to the flower block are simulated instead. Place the required flower block or feeding slab in front of the hive."]
