	quest.59C340E40A7FC0F7.quest_subtitle: "Obtain Creeper Seeds"
	quest.59CB785ED2B137B4.quest_desc: ["Pour the liquid into the world or chill it in an inventory with a Heat Frame to solidify it into Plastic Sheets. Using a Heat Frame may yield better results."]
	quest.59CB785ED2B137B4.quest_subtitle: "Obtain Plastic Bucket"
	quest.59CB785ED2B137B4.title: "Molten Plastic"
	quest.59E79D81F69C5C45.quest_desc: ["Get hold of Boxwood Sapling. Hover over it in EMI and press R to see how it is made."]
	quest.59E79D81F69C5C45.quest_subtitle: "Obtain Boxwood Sapling"
